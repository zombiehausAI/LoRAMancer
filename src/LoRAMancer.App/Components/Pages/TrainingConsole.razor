@page "/training"
@inject TrainingRunnerService TrainingRunner
@inject NativeFileDialogService FileDialogService
@inject AiToolkitSetupService ToolkitSetup
@inject NavigationManager NavManager
@inject IDialogService DialogService
@inject SettingsService Settings
@inject RemoteTrainingClientService RemoteClient
@inject LoraHistoryService HistoryService
@inject TrainingEstimationService EstimationService
@inject LoRAMancer.App.Engines.ProcessRunner ProcessRunner
@inject ISnackbar Snackbar
@implements IDisposable

<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--text-primary);">Training Orchestrator & Live Console</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Execute AI-Toolkit runs with live hardware acceleration telemetry and log streaming</MudText>
    </div>
    <div class="d-flex align-center flex-wrap gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="OpenRecipeStudio">
            Recipe Studio (Stage 2)
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Tune" OnClick="OpenTrainingWizardAsync">
            Quick Wizard
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Collections" OnClick="OpenDatasetCuratorAsync">
            Curate Dataset
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Insights" OnClick="OpenTensorBoardAsync">
            TensorBoard
        </MudButton>
        @if (TrainingRunner.IsRunning) {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Queue" OnClick="StartTrainingAsync" Disabled="@string.IsNullOrWhiteSpace(_configYamlPath)">
                Queue Training
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="CancelTraining">
                Stop Current
            </MudButton>
            @if (TrainingRunner.QueueCount > 0) {
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="CancelAll">
                    Cancel All &amp; Clear
                </MudButton>
            }
        } else {
            @if (TrainingRunner.CurrentProgress.Status == TrainingStatus.Failed) {
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryTrainingAsync">
                    Retry Training
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartTrainingAsync" Disabled="@string.IsNullOrWhiteSpace(_configYamlPath)">
                Launch Training
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Queue" OnClick="StartTrainingAsync" Disabled="@string.IsNullOrWhiteSpace(_configYamlPath)">
                Queue Training
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearLogs">
            Clear Logs
        </MudButton>
    </div>
</div>

@if (Settings.Current.ClientRemoteMode) {
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-4" Style="background-color: rgba(137, 180, 250, 0.15); color: #89b4fa;">
        <div class="d-flex align-center justify-space-between w-100">
            <div>
                <b>Remote Engine Mode Active:</b> Training commands and telemetry stream directly to/from AI PC at <code>@Settings.Current.ClientRemoteHostUrl</code>.
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => NavManager.NavigateTo("/settings"))">
                Settings
            </MudButton>
        </div>
    </MudAlert>
}

@if (!Settings.Current.ClientRemoteMode && !ToolkitSetup.IsInstalled()) {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4" Dense="false">
        <div class="d-flex align-center justify-space-between w-100">
            <div>
                <b>AI-Toolkit is not installed.</b> Training execution requires the <code>ostris/ai-toolkit</code> repository.
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => NavManager.NavigateTo("/settings"))">
                Configure in Settings
            </MudButton>
        </div>
    </MudAlert>
}

@if (!TrainingRunner.IsRunning && TrainingRunner.CurrentProgress.Status == TrainingStatus.Failed) {
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-4">
        <div class="d-flex align-center justify-space-between w-100 flex-wrap gap-2">
            <div>
                <b>Training Failed:</b> The previous training run encountered an error or crashed. Click <b>Edit in Wizard</b> to adjust parameters or model path, or <b>Retry Training</b> to resubmit.
            </div>
            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Surface" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tune" OnClick="EditFailedRunInWizardAsync">
                    Edit in Wizard
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Surface" Size="Size.Small" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryTrainingAsync">
                    Retry Training
                </MudButton>
            </div>
        </div>
    </MudAlert>
}

@if (!string.IsNullOrWhiteSpace(_preFlightWarning)) {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-4">
        <b>Pre-Flight VRAM Warning:</b> @_preFlightWarning
    </MudAlert>
}

<!-- Configuration Bar -->
<MudCard Elevation="1" Class="mb-4" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark);">
    <MudCardContent Class="py-3">
        <MudGrid Class="align-center">
            <MudItem xs="12" md="6">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_configYamlPath" Label="Training Config (.yaml)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Placeholder="Select AI-Toolkit .yaml config..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseConfigFileAsync">Browse...</MudButton>
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_venvPath" Label="Python Venv Directory" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Placeholder="Main .venv directory..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseVenvFolderAsync">Browse...</MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Studio Training Queue & Sequential Runner -->
<MudCard Elevation="1" Class="mb-4" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); border-radius: 8px;">
    <MudCardHeader Class="py-2 px-3" Style="border-bottom: 1px solid var(--border-dark); background-color: rgba(255, 255, 255, 0.02);">
        <CardHeaderContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Queue" Color="Color.Tertiary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Studio Training Queue</MudText>
                @if (TrainingRunner.IsRunning) {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="font-weight: 700; height: 20px;">
                        1 Active Run
                    </MudChip>
                }
                @if (TrainingRunner.QueueCount > 0) {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Style="font-weight: 700; height: 20px;">
                        @TrainingRunner.QueueCount Queued
                    </MudChip>
                } else if (!TrainingRunner.IsRunning) {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Style="font-weight: 600; height: 20px;">
                        Queue Idle
                    </MudChip>
                }
            </div>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (TrainingRunner.QueueCount > 0) {
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.ClearAll" OnClick="@(() => TrainingRunner.ClearQueue())">
                    Clear Queue
                </MudButton>
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pa-3">
        @if (TrainingRunner.CurrentJob != null) {
            <div class="pa-3 mb-2" style="background-color: rgba(166, 227, 161, 0.08); border: 1px solid rgba(166, 227, 161, 0.3); border-radius: 6px;">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div class="d-flex align-center gap-2">
                        <MudProgressCircular Color="Color.Success" Size="Size.Small" Indeterminate="true" Style="width: 18px; height: 18px;" />
                        <div>
                            <span style="font-weight: 700; color: #a6e3a1;">RUNNING:</span>
                            <span style="font-weight: 600; margin-left: 6px; color: var(--text-primary);">@TrainingRunner.CurrentJob.Name</span>
                            <span class="text-secondary ml-2" style="font-size: 0.75rem; font-family: monospace;">(@Path.GetFileName(TrainingRunner.CurrentJob.ConfigYamlPath))</span>
                        </div>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Step @TrainingRunner.CurrentProgress.CurrentStep / @TrainingRunner.CurrentProgress.TotalSteps
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Stop" OnClick="CancelTraining" Style="font-size: 0.7rem; height: 24px; padding: 0 8px;">
                            Stop
                        </MudButton>
                    </div>
                </div>
            </div>
        }

        @if (TrainingRunner.QueueCount > 0) {
            <div class="d-flex flex-column gap-2">
                @for (int i = 0; i < TrainingRunner.Queue.Count; i++) {
                    var queuedJob = TrainingRunner.Queue[i];
                    var jobIndex = i;
                    <div class="d-flex align-center justify-space-between px-3 py-2" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-dark); border-radius: 6px;">
                        <div class="d-flex align-center gap-3">
                            <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled" Style="font-weight: 700; height: 20px;">
                                #@(jobIndex + 1)
                            </MudChip>
                            <div>
                                <span style="font-weight: 600; color: var(--text-primary);">@queuedJob.Name</span>
                                <span class="text-secondary ml-2" style="font-size: 0.75rem; font-family: monospace;">@Path.GetFileName(queuedJob.ConfigYamlPath)</span>
                            </div>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudTooltip Text="Move Up">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Default" Disabled="@(jobIndex == 0)" OnClick="@(() => TrainingRunner.MoveJobUp(queuedJob.Id))" />
                            </MudTooltip>
                            <MudTooltip Text="Move Down">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Color="Color.Default" Disabled="@(jobIndex == TrainingRunner.Queue.Count - 1)" OnClick="@(() => TrainingRunner.MoveJobDown(queuedJob.Id))" />
                            </MudTooltip>
                            <MudTooltip Text="Remove from Queue">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="@(() => TrainingRunner.RemoveJob(queuedJob.Id))" />
                            </MudTooltip>
                        </div>
                    </div>
                }
            </div>
        } else if (TrainingRunner.CurrentJob == null) {
            <div class="d-flex align-center gap-2 py-1 text-secondary" style="font-size: 0.8rem;">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Secondary" />
                <span>Single GPU safe: Queue multiple training runs. They will execute sequentially with automatic VRAM cooldown between jobs.</span>
            </div>
        }
    </MudCardContent>
</MudCard>

<!-- Metrics & Telemetry Grid -->
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudCard Elevation="0" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); padding: 12px; border-radius: 8px;">
            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                @if (!TrainingRunner.IsRunning && TrainingRunner.CurrentProgress.Status == TrainingStatus.Failed) {
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" Style="font-size: 0.7rem; padding: 2px 8px; height: 22px;" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryTrainingAsync">
                        Retry
                    </MudButton>
                }
            </div>
            <div class="d-flex align-center mt-1">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(TrainingRunner.CurrentProgress.Status)">
                    @TrainingRunner.CurrentProgress.Status
                </MudChip>
            </div>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard Elevation="0" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); padding: 12px; border-radius: 8px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Step Progress</MudText>
            <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--accent-blue);">
                @TrainingRunner.CurrentProgress.CurrentStep / @TrainingRunner.CurrentProgress.TotalSteps
            </MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard Elevation="0" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); padding: 12px; border-radius: 8px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Current Loss</MudText>
            <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--accent-green);">
                @(TrainingRunner.CurrentProgress.CurrentLoss > 0 ? TrainingRunner.CurrentProgress.CurrentLoss.ToString("0.0000") : "-")
            </MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard Elevation="0" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); padding: 12px; border-radius: 8px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Elapsed / ETA</MudText>
            <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--accent-purple);">
                @FormatTimeSpan(TrainingRunner.CurrentProgress.Elapsed) / @FormatTimeSpan(TrainingRunner.CurrentProgress.EstimatedRemaining)
            </MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12">
        <MudProgressLinear Color="Color.Primary" Value="@TrainingRunner.CurrentProgress.ProgressPercentage" Class="my-2" Style="height: 6px; border-radius: 3px;" />
    </MudItem>
</MudGrid>

<!-- Real-time Terminal Window -->
<div class="terminal-window p-3" style="height: 480px; overflow-y: auto;" id="terminal-log-box">
    @{
        string[] logs = GetLogsSnapshot();
    }
    @if (logs.Length == 0) {
        <div class="text-secondary" style="font-style: italic;">Awaiting training job initiation... Output and telemetry will stream here in real-time.</div>
    } else {
        @foreach (string log in logs) {
            <div class="terminal-line @GetLogClass(log)">@log</div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "config")]
    public string? QueryConfig { get; set; }

    [SupplyParameterFromQuery(Name = "autostart")]
    public bool? QueryAutoStart { get; set; }

    private string _configYamlPath = string.Empty;
    private string _venvPath = AiToolkitSetupService.GetDefaultVenvPath();
    private readonly List<string> _logs = new();
    private readonly object _logsLock = new();
    private const int MaxLogLines = 2000;
    private bool _autoStarted;
    private bool _disposed;
    private bool _renderScheduled;

    private string[] GetLogsSnapshot() {
        lock (_logsLock) {
            return _logs.ToArray();
        }
    }

    protected override void OnInitialized() {
        TrainingRunner.OnLogReceived += HandleLogReceived;
        TrainingRunner.OnProgressUpdated += HandleProgressUpdated;
        TrainingRunner.OnQueueUpdated += HandleQueueUpdated;

        if (TrainingRunner.CurrentJob != null) {
            _configYamlPath = TrainingRunner.CurrentJob.ConfigYamlPath;
            if (!string.IsNullOrWhiteSpace(TrainingRunner.CurrentJob.VenvPath)) {
                _venvPath = TrainingRunner.CurrentJob.VenvPath;
            }
        }

        var existingLogs = TrainingRunner.GetRecentLogs();
        if (existingLogs.Count > 0) {
            lock (_logsLock) {
                _logs.Clear();
                _logs.AddRange(existingLogs);
            }
        }

        if (!Directory.Exists(_venvPath)) {
            _venvPath = AiToolkitSetupService.GetDefaultVenvPath();
        }
    }

    protected override async Task OnParametersSetAsync() {
        if (!string.IsNullOrWhiteSpace(QueryConfig)) {
            _configYamlPath = QueryConfig;
        }

        if (QueryAutoStart == true && !_autoStarted && !string.IsNullOrWhiteSpace(_configYamlPath)) {
            _autoStarted = true;
            await StartTrainingAsync();
        }
    }

    private void HandleQueueUpdated() {
        if (_disposed) {
            return;
        }
        RequestRender();
    }

    private void RequestRender() {
        if (_disposed || _renderScheduled) {
            return;
        }
        _renderScheduled = true;
        try {
            _ = InvokeAsync(async () => {
                try {
                    await Task.Delay(100);
                    _renderScheduled = false;
                    if (!_disposed) {
                        StateHasChanged();
                    }
                } catch {
                    _renderScheduled = false;
                }
            });
        } catch {
            _renderScheduled = false;
        }
    }

    private void HandleLogReceived(string line) {
        if (_disposed) {
            return;
        }

        lock (_logsLock) {
            _logs.Add(line ?? string.Empty);
            if (_logs.Count > MaxLogLines) {
                _logs.RemoveRange(0, 100);
            }
        }
        RequestRender();
    }

    private void HandleProgressUpdated(TrainingProgress progress) {
        if (_disposed) {
            return;
        }
        RequestRender();
    }

    private async Task BrowseConfigFileAsync() {
        string? file = await FileDialogService.PickSafeTensorsFileAsync();
        if (!string.IsNullOrEmpty(file)) {
            _configYamlPath = file;
        }
    }

    private async Task BrowseVenvFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select .venv Directory");
        if (!string.IsNullOrEmpty(folder)) {
            _venvPath = folder;
        }
    }

    private async Task StartTrainingAsync() {
        if (string.IsNullOrWhiteSpace(_configYamlPath)) {
            Snackbar.Add("Please select or clone a training configuration YAML file first.", Severity.Warning);
            return;
        }

        if (!File.Exists(_configYamlPath)) {
            Snackbar.Add($"Training configuration file not found: {_configYamlPath}", Severity.Error);
            return;
        }

        // Run Pre-Flight VRAM & Disk Check
        var preCheck = EstimationService.RunPreFlightCheck("FLUX.1-dev", Path.GetDirectoryName(_configYamlPath) ?? "", 1);
        if (preCheck.Warnings.Count > 0) {
            _preFlightWarning = string.Join(" ", preCheck.Warnings);
            Snackbar.Add($"Pre-flight alert: {preCheck.Warnings[0]}", Severity.Warning);
        } else {
            _preFlightWarning = null;
        }

        try {
            if (Settings.Current.ClientRemoteMode) {
                _logs.Add($"[REMOTE] Sending job to AI PC at: {Settings.Current.ClientRemoteHostUrl}");
                string yamlContent = await File.ReadAllTextAsync(_configYamlPath);
                string runName = Path.GetFileNameWithoutExtension(_configYamlPath);

                StartRemoteTrainingRequest remoteReq = new() {
                    RunName = runName,
                    ConfigYaml = yamlContent,
                    BaseArchitecture = "flux1"
                };

                bool started = await RemoteClient.StartRemoteTrainingAsync(remoteReq);
                if (started) {
                    Snackbar.Add("Training job launched successfully on remote AI PC!", Severity.Success);
                    _ = Task.Run(async () => {
                        try {
                            await RemoteClient.StartTelemetryStreamAsync(telemetry => {
                                if (_disposed) {
                                    return;
                                }
                                if (telemetry.EventType == "log" && !string.IsNullOrWhiteSpace(telemetry.Message)) {
                                    lock (_logsLock) {
                                        _logs.Add(telemetry.Message);
                                        if (_logs.Count > MaxLogLines) {
                                            _logs.RemoveRange(0, 100);
                                        }
                                    }
                                    RequestRender();
                                } else if (telemetry.EventType == "step") {
                                    TrainingRunner.CurrentProgress.CurrentStep = telemetry.Step;
                                    TrainingRunner.CurrentProgress.TotalSteps = telemetry.TotalSteps;
                                    TrainingRunner.CurrentProgress.CurrentLoss = telemetry.Loss;
                                    TrainingRunner.CurrentProgress.Status = TrainingStatus.Training;
                                    RequestRender();
                                } else if (telemetry.EventType == "failed") {
                                    TrainingRunner.CurrentProgress.Status = TrainingStatus.Failed;
                                    RequestRender();
                                } else if (telemetry.EventType == "completed") {
                                    TrainingRunner.CurrentProgress.Status = TrainingStatus.Completed;
                                    RequestRender();
                                }
                            }, CancellationToken.None);
                        } catch {
                            // Telemetry disconnected
                        }
                    });
                } else {
                    TrainingRunner.CurrentProgress.Status = TrainingStatus.Failed;
                    Snackbar.Add("Failed to start remote training job. Check connection.", Severity.Error);
                }
                return;
            }

            string toolkitScript = ToolkitSetup.GetRunScriptPath();
            if (!File.Exists(toolkitScript)) {
                toolkitScript = Path.Combine(_venvPath, "run.py");
                if (!File.Exists(toolkitScript)) {
                    toolkitScript = "run.py";
                }
            }

            var job = TrainingRunner.EnqueueJob(_configYamlPath, _venvPath, toolkitScript);
            if (TrainingRunner.IsRunning && TrainingRunner.QueueCount > 1) {
                Snackbar.Add($"Training job '{job.Name}' added to queue ({TrainingRunner.QueueCount} pending).", Severity.Info);
            } else {
                Snackbar.Add($"Training job '{job.Name}' started.", Severity.Success);
            }
        } catch (Exception ex) {
            TrainingRunner.CurrentProgress.Status = TrainingStatus.Failed;
            Snackbar.Add($"Training failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task RetryTrainingAsync() {
        lock (_logsLock) {
            _logs.Add(string.Empty);
            _logs.Add("================================================================================");
            _logs.Add($"[RETRY] Resubmitting training job for: {_configYamlPath}");
            _logs.Add("================================================================================");
        }
        TrainingRunner.CurrentProgress.Status = TrainingStatus.Initializing;
        await StartTrainingAsync();
    }

    private void CancelTraining() {
        if (Settings.Current.ClientRemoteMode) {
            _ = RemoteClient.StopRemoteTrainingAsync();
            Snackbar.Add("Cancellation command sent to remote AI PC.", Severity.Info);
            return;
        }

        TrainingRunner.CancelTraining();
        Snackbar.Add("Current training cancellation requested.", Severity.Info);
    }

    private void CancelAll() {
        if (Settings.Current.ClientRemoteMode) {
            _ = RemoteClient.StopRemoteTrainingAsync();
            Snackbar.Add("Cancellation command sent to remote AI PC.", Severity.Info);
            return;
        }

        TrainingRunner.CancelAll();
        Snackbar.Add("Cancelled all training jobs and cleared queue.", Severity.Info);
    }

    private void ClearLogs() {
        TrainingRunner.ClearLogs();
        lock (_logsLock) {
            _logs.Clear();
        }
    }

    private void OpenRecipeStudio() {
        NavManager.NavigateTo("/recipe");
    }

    private async Task OpenTrainingWizardAsync() {
        DialogOptions options = new() {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };
        await DialogService.ShowAsync<TrainingWizardDialog>("New Training Wizard", options);
    }

    private async Task OpenDatasetCuratorAsync() {
        DialogOptions options = new() {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.DatasetCuratorDialog>("Dataset Curator & Caption Studio", options);
    }

    private async Task EditFailedRunInWizardAsync() {
        LoraHistoryRecord? record = null;
        if (!string.IsNullOrWhiteSpace(_configYamlPath)) {
            var history = await HistoryService.GetHistoryAsync();
            record = history.FirstOrDefault(h => string.Equals(h.ConfigYamlPath, _configYamlPath, StringComparison.OrdinalIgnoreCase));
        }

        if (record == null && !string.IsNullOrWhiteSpace(_configYamlPath)) {
            record = new LoraHistoryRecord {
                Name = Path.GetFileNameWithoutExtension(_configYamlPath).Replace("_aitoolkit", string.Empty),
                ConfigYamlPath = _configYamlPath,
                Status = "Failed"
            };
        }

        DialogParameters<TrainingWizardDialog> parameters = new();
        if (record != null) {
            parameters.Add(x => x.HistoryRecord, record);
        }

        DialogOptions options = new() {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };
        await DialogService.ShowAsync<TrainingWizardDialog>("Edit Training Run in Wizard", parameters, options);
    }

    private static Color GetStatusColor(TrainingStatus status) => status switch {
        TrainingStatus.Training => Color.Success,
        TrainingStatus.Initializing => Color.Info,
        TrainingStatus.Completed => Color.Primary,
        TrainingStatus.Failed => Color.Error,
        TrainingStatus.Cancelled => Color.Warning,
        _ => Color.Default
    };

    private static string FormatTimeSpan(TimeSpan ts) {
        if (ts <= TimeSpan.Zero) {
            return "00:00:00";
        }
        int hours = (int)ts.TotalHours;
        return $"{hours:D2}:{ts.Minutes:D2}:{ts.Seconds:D2}";
    }

    private static string GetLogClass(string? log) {
        if (string.IsNullOrEmpty(log)) {
            return string.Empty;
        }
        if (log.Contains("error", StringComparison.OrdinalIgnoreCase) || log.Contains("exception", StringComparison.OrdinalIgnoreCase)) {
            return "error";
        }
        if (log.Contains("warning", StringComparison.OrdinalIgnoreCase) || log.Contains("warn", StringComparison.OrdinalIgnoreCase)) {
            return "warn";
        }
        if (log.Contains("step", StringComparison.OrdinalIgnoreCase) || log.Contains("epoch", StringComparison.OrdinalIgnoreCase)) {
            return "info";
        }
        if (log.Contains("completed", StringComparison.OrdinalIgnoreCase) || log.Contains("success", StringComparison.OrdinalIgnoreCase)) {
            return "success";
        }
        return string.Empty;
    }

    public void Dispose() {
        _disposed = true;
        TrainingRunner.OnLogReceived -= HandleLogReceived;
        TrainingRunner.OnProgressUpdated -= HandleProgressUpdated;
        TrainingRunner.OnQueueUpdated -= HandleQueueUpdated;
    }

    private string? _preFlightWarning;
    private bool _isTensorBoardRunning;

    private async Task OpenTensorBoardAsync() {
        try {
            string defaultVenv = AiToolkitSetupService.GetDefaultVenvPath();
            string pythonExe = Path.Combine(defaultVenv, "Scripts", "python.exe");
            if (!File.Exists(pythonExe)) {
                pythonExe = Settings.Current.PreferredPythonPath;
            }

            string logDir = "";
            if (!string.IsNullOrWhiteSpace(_configYamlPath) && File.Exists(_configYamlPath)) {
                logDir = Path.GetDirectoryName(_configYamlPath) ?? "";
            }
            if (string.IsNullOrWhiteSpace(logDir)) {
                logDir = Path.Combine(AppContext.BaseDirectory, "output");
            }
            Directory.CreateDirectory(logDir);

            if (!_isTensorBoardRunning) {
                _ = Task.Run(async () => {
                    try {
                        _isTensorBoardRunning = true;
                        await ProcessRunner.RunAsync(
                            pythonExe,
                            $"-m tensorboard.main --logdir \"{logDir}\" --port 6006 --bind_all",
                            AppContext.BaseDirectory,
                            ToolkitSetup.GetIsolatedEnvironmentVariables(),
                            _ => { },
                            _ => { },
                            CancellationToken.None
                        );
                    } catch {
                    } finally {
                        _isTensorBoardRunning = false;
                    }
                });
                await Task.Delay(1000);
            }

            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo {
                FileName = "http://localhost:6006",
                UseShellExecute = true
            });
            Snackbar.Add("Launched TensorBoard dashboard at http://localhost:6006", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Unable to launch TensorBoard: {ex.Message}", Severity.Error);
        }
    }
