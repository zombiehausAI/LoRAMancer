@page "/training"
@inject TrainingRunnerService TrainingRunner
@inject NativeFileDialogService FileDialogService
@inject AiToolkitSetupService ToolkitSetup
@inject NavigationManager NavManager
@inject IDialogService DialogService
@inject SettingsService Settings
@inject RemoteTrainingClientService RemoteClient
@inject LoraHistoryService HistoryService
@inject ISnackbar Snackbar
@implements IDisposable

<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--text-primary);">Training Orchestrator & Live Console</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Execute AI-Toolkit runs with live hardware acceleration telemetry and log streaming</MudText>
    </div>
    <div class="d-flex align-center flex-wrap gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="OpenTrainingWizardAsync">
            Training Wizard
        </MudButton>
        @if (TrainingRunner.IsRunning) {
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="CancelTraining">
                Stop Training
            </MudButton>
        } else {
            @if (TrainingRunner.CurrentProgress.Status == TrainingStatus.Failed) {
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryTrainingAsync">
                    Retry Training
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartTrainingAsync">
                Launch Training
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearLogs">
            Clear Logs
        </MudButton>
    </div>
</div>

@if (Settings.Current.ClientRemoteMode) {
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-4" Style="background-color: rgba(137, 180, 250, 0.15); color: #89b4fa;">
        <div class="d-flex align-center justify-space-between w-100">
            <div>
                <b>Remote Engine Mode Active:</b> Training commands and telemetry stream directly to/from AI PC at <code>@Settings.Current.ClientRemoteHostUrl</code>.
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => NavManager.NavigateTo("/settings"))">
                Settings
            </MudButton>
        </div>
    </MudAlert>
}

@if (!Settings.Current.ClientRemoteMode && !ToolkitSetup.IsInstalled()) {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4" Dense="false">
        <div class="d-flex align-center justify-space-between w-100">
            <div>
                <b>AI-Toolkit is not installed.</b> Training execution requires the <code>ostris/ai-toolkit</code> repository.
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => NavManager.NavigateTo("/settings"))">
                Configure in Settings
            </MudButton>
        </div>
    </MudAlert>
}

@if (!TrainingRunner.IsRunning && TrainingRunner.CurrentProgress.Status == TrainingStatus.Failed) {
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-4">
        <div class="d-flex align-center justify-space-between w-100 flex-wrap gap-2">
            <div>
                <b>Training Failed:</b> The previous training run encountered an error or crashed. Click <b>Edit in Wizard</b> to adjust parameters or model path, or <b>Retry Training</b> to resubmit.
            </div>
            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Surface" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tune" OnClick="EditFailedRunInWizardAsync">
                    Edit in Wizard
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Surface" Size="Size.Small" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryTrainingAsync">
                    Retry Training
                </MudButton>
            </div>
        </div>
    </MudAlert>
}

<!-- Configuration Bar -->
<MudCard Elevation="1" Class="mb-4" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark);">
    <MudCardContent Class="py-3">
        <MudGrid Class="align-center">
            <MudItem xs="12" md="6">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_configYamlPath" Label="Training Config (.yaml)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Placeholder="Select AI-Toolkit .yaml config..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseConfigFileAsync">Browse...</MudButton>
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_venvPath" Label="Python Venv Directory" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Placeholder="Main .venv directory..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseVenvFolderAsync">Browse...</MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Metrics & Telemetry Grid -->
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudCard Elevation="0" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); padding: 12px; border-radius: 8px;">
            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                @if (!TrainingRunner.IsRunning && TrainingRunner.CurrentProgress.Status == TrainingStatus.Failed) {
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" Style="font-size: 0.7rem; padding: 2px 8px; height: 22px;" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryTrainingAsync">
                        Retry
                    </MudButton>
                }
            </div>
            <div class="d-flex align-center mt-1">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(TrainingRunner.CurrentProgress.Status)">
                    @TrainingRunner.CurrentProgress.Status
                </MudChip>
            </div>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard Elevation="0" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); padding: 12px; border-radius: 8px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Step Progress</MudText>
            <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--accent-blue);">
                @TrainingRunner.CurrentProgress.CurrentStep / @TrainingRunner.CurrentProgress.TotalSteps
            </MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard Elevation="0" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); padding: 12px; border-radius: 8px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Current Loss</MudText>
            <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--accent-green);">
                @(TrainingRunner.CurrentProgress.CurrentLoss > 0 ? TrainingRunner.CurrentProgress.CurrentLoss.ToString("0.0000") : "-")
            </MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudCard Elevation="0" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); padding: 12px; border-radius: 8px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Elapsed / ETA</MudText>
            <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--accent-purple);">
                @TrainingRunner.CurrentProgress.Elapsed.ToString(@"hh\:mm\:ss") / @TrainingRunner.CurrentProgress.EstimatedRemaining.ToString(@"hh\:mm\:ss")
            </MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12">
        <MudProgressLinear Color="Color.Primary" Value="@TrainingRunner.CurrentProgress.ProgressPercentage" Class="my-2" Style="height: 6px; border-radius: 3px;" />
    </MudItem>
</MudGrid>

<!-- Real-time Terminal Window -->
<div class="terminal-window p-3" style="height: 480px; overflow-y: auto;" id="terminal-log-box">
    @if (_logs.Count == 0) {
        <div class="text-secondary" style="font-style: italic;">Awaiting training job initiation... Output and telemetry will stream here in real-time.</div>
    } else {
        @foreach (string log in _logs) {
            <div class="terminal-line @GetLogClass(log)">@log</div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "config")]
    public string? QueryConfig { get; set; }

    [SupplyParameterFromQuery(Name = "autostart")]
    public bool? QueryAutoStart { get; set; }

    private string _configYamlPath = string.Empty;
    private string _venvPath = Path.Combine(AppContext.BaseDirectory, ".venv");
    private readonly List<string> _logs = new();
    private const int MaxLogLines = 2000;
    private bool _autoStarted;

    protected override void OnInitialized() {
        TrainingRunner.OnLogReceived += HandleLogReceived;
        TrainingRunner.OnProgressUpdated += HandleProgressUpdated;

        if (!Directory.Exists(_venvPath)) {
            string repoVenv = Path.Combine(Directory.GetCurrentDirectory(), ".venv");
            if (Directory.Exists(repoVenv)) {
                _venvPath = repoVenv;
            }
        }
    }

    protected override async Task OnParametersSetAsync() {
        if (!string.IsNullOrWhiteSpace(QueryConfig)) {
            _configYamlPath = QueryConfig;
        }

        if (QueryAutoStart == true && !_autoStarted && !TrainingRunner.IsRunning && !string.IsNullOrWhiteSpace(_configYamlPath)) {
            _autoStarted = true;
            await StartTrainingAsync();
        }
    }

    private void HandleLogReceived(string line) {
        InvokeAsync(() => {
            _logs.Add(line);
            if (_logs.Count > MaxLogLines) {
                _logs.RemoveRange(0, 100);
            }
            StateHasChanged();
        });
    }

    private void HandleProgressUpdated(TrainingProgress progress) {
        InvokeAsync(StateHasChanged);
    }

    private async Task BrowseConfigFileAsync() {
        string? file = await FileDialogService.PickSafeTensorsFileAsync();
        if (!string.IsNullOrEmpty(file)) {
            _configYamlPath = file;
        }
    }

    private async Task BrowseVenvFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select .venv Directory");
        if (!string.IsNullOrEmpty(folder)) {
            _venvPath = folder;
        }
    }

    private async Task StartTrainingAsync() {
        if (string.IsNullOrWhiteSpace(_configYamlPath)) {
            Snackbar.Add("Please select or clone a training configuration YAML file first.", Severity.Warning);
            return;
        }

        if (!File.Exists(_configYamlPath)) {
            Snackbar.Add($"Training configuration file not found: {_configYamlPath}", Severity.Error);
            return;
        }

        try {
            if (Settings.Current.ClientRemoteMode) {
                _logs.Add($"[REMOTE] Sending job to AI PC at: {Settings.Current.ClientRemoteHostUrl}");
                string yamlContent = await File.ReadAllTextAsync(_configYamlPath);
                string runName = Path.GetFileNameWithoutExtension(_configYamlPath);

                StartRemoteTrainingRequest remoteReq = new() {
                    RunName = runName,
                    ConfigYaml = yamlContent,
                    BaseArchitecture = "flux1"
                };

                bool started = await RemoteClient.StartRemoteTrainingAsync(remoteReq);
                if (started) {
                    Snackbar.Add("Training job launched successfully on remote AI PC!", Severity.Success);
                    _ = Task.Run(async () => {
                        try {
                            await RemoteClient.StartTelemetryStreamAsync(telemetry => {
                                InvokeAsync(() => {
                                    if (telemetry.EventType == "log" && !string.IsNullOrWhiteSpace(telemetry.Message)) {
                                        _logs.Add(telemetry.Message);
                                    } else if (telemetry.EventType == "step") {
                                        TrainingRunner.CurrentProgress.CurrentStep = telemetry.Step;
                                        TrainingRunner.CurrentProgress.TotalSteps = telemetry.TotalSteps;
                                        TrainingRunner.CurrentProgress.CurrentLoss = telemetry.Loss;
                                        TrainingRunner.CurrentProgress.Status = TrainingStatus.Training;
                                        StateHasChanged();
                                    } else if (telemetry.EventType == "failed") {
                                        TrainingRunner.CurrentProgress.Status = TrainingStatus.Failed;
                                        StateHasChanged();
                                    } else if (telemetry.EventType == "completed") {
                                        TrainingRunner.CurrentProgress.Status = TrainingStatus.Completed;
                                        StateHasChanged();
                                    }
                                });
                            }, CancellationToken.None);
                        } catch {
                            // Telemetry disconnected
                        }
                    });
                } else {
                    TrainingRunner.CurrentProgress.Status = TrainingStatus.Failed;
                    Snackbar.Add("Failed to start remote training job. Check connection.", Severity.Error);
                }
                return;
            }

            string toolkitScript = ToolkitSetup.GetRunScriptPath();
            if (!File.Exists(toolkitScript)) {
                toolkitScript = Path.Combine(_venvPath, "run.py");
                if (!File.Exists(toolkitScript)) {
                    toolkitScript = "run.py";
                }
            }

            _logs.Add($"[HOST] Initiating training process for: {_configYamlPath}");
            await TrainingRunner.StartTrainingAsync(_venvPath, toolkitScript, _configYamlPath);
        } catch (Exception ex) {
            TrainingRunner.CurrentProgress.Status = TrainingStatus.Failed;
            Snackbar.Add($"Training failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task RetryTrainingAsync() {
        _logs.Add(string.Empty);
        _logs.Add("================================================================================");
        _logs.Add($"[RETRY] Resubmitting training job for: {_configYamlPath}");
        _logs.Add("================================================================================");
        TrainingRunner.CurrentProgress.Status = TrainingStatus.Initializing;
        await StartTrainingAsync();
    }

    private void CancelTraining() {
        if (Settings.Current.ClientRemoteMode) {
            _ = RemoteClient.StopRemoteTrainingAsync();
            Snackbar.Add("Cancellation command sent to remote AI PC.", Severity.Info);
            return;
        }

        TrainingRunner.CancelTraining();
        Snackbar.Add("Training cancellation requested.", Severity.Info);
    }

    private void ClearLogs() {
        _logs.Clear();
    }

    private async Task OpenTrainingWizardAsync() {
        DialogOptions options = new() {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };
        await DialogService.ShowAsync<TrainingWizardDialog>("New Training Wizard", options);
    }

    private async Task EditFailedRunInWizardAsync() {
        LoraHistoryRecord? record = null;
        if (!string.IsNullOrWhiteSpace(_configYamlPath)) {
            var history = await HistoryService.GetHistoryAsync();
            record = history.FirstOrDefault(h => string.Equals(h.ConfigYamlPath, _configYamlPath, StringComparison.OrdinalIgnoreCase));
        }

        if (record == null && !string.IsNullOrWhiteSpace(_configYamlPath)) {
            record = new LoraHistoryRecord {
                Name = Path.GetFileNameWithoutExtension(_configYamlPath).Replace("_aitoolkit", string.Empty),
                ConfigYamlPath = _configYamlPath,
                Status = "Failed"
            };
        }

        DialogParameters<TrainingWizardDialog> parameters = new();
        if (record != null) {
            parameters.Add(x => x.HistoryRecord, record);
        }

        DialogOptions options = new() {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };
        await DialogService.ShowAsync<TrainingWizardDialog>("Edit Training Run in Wizard", parameters, options);
    }

    private static Color GetStatusColor(TrainingStatus status) => status switch {
        TrainingStatus.Training => Color.Success,
        TrainingStatus.Initializing => Color.Info,
        TrainingStatus.Completed => Color.Primary,
        TrainingStatus.Failed => Color.Error,
        TrainingStatus.Cancelled => Color.Warning,
        _ => Color.Default
    };

    private static string GetLogClass(string log) {
        if (log.Contains("error", StringComparison.OrdinalIgnoreCase) || log.Contains("exception", StringComparison.OrdinalIgnoreCase)) {
            return "error";
        }
        if (log.Contains("warning", StringComparison.OrdinalIgnoreCase) || log.Contains("warn", StringComparison.OrdinalIgnoreCase)) {
            return "warn";
        }
        if (log.Contains("step", StringComparison.OrdinalIgnoreCase) || log.Contains("epoch", StringComparison.OrdinalIgnoreCase)) {
            return "info";
        }
        if (log.Contains("completed", StringComparison.OrdinalIgnoreCase) || log.Contains("success", StringComparison.OrdinalIgnoreCase)) {
            return "success";
        }
        return string.Empty;
    }

    public void Dispose() {
        TrainingRunner.OnLogReceived -= HandleLogReceived;
        TrainingRunner.OnProgressUpdated -= HandleProgressUpdated;
    }
}
