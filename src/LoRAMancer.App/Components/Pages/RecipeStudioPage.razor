    private async Task ExportYamlAsync() {
        try {
            string? effectiveAuxPath = null;
            if (_enableAuxiliaryLora && !string.IsNullOrWhiteSpace(_auxiliaryLoraPath) && File.Exists(_auxiliaryLoraPath)) {
                bool requiresSlicing = _auxiliaryPartPreset != "All" || _auxiliaryPartWeights.Values.Any(w => Math.Abs(w - 1.0) > 0.001);
                if (requiresSlicing) {
                    effectiveAuxPath = await ChopShopService.PrepareAuxiliarySliceAsync(
                        _auxiliaryLoraPath,
                        _auxiliaryPartWeights
                    );
                }
            }

            var config = BuildConfig(effectiveAuxPath);
            string yaml = ConfigBuilder.BuildAiToolkitYaml(config);
            string outDir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".loramancer", "recipes");
            Directory.CreateDirectory(outDir);
            string filePath = Path.Combine(outDir, $"{_runName}_aitoolkit.yaml");
            await File.WriteAllTextAsync(filePath, yaml);
            Snackbar.Add($"Exported YAML to: {filePath}", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to export YAML: {ex.Message}", Severity.Error);
        }
    }

