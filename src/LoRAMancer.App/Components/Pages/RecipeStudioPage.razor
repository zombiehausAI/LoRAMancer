    private async Task<string?> GenerateYamlFileAsync() {
        if (string.IsNullOrWhiteSpace(_runName)) {
            Snackbar.Add("Please enter a valid Run Name.", Severity.Warning);
            return null;
        }

        if (string.IsNullOrWhiteSpace(_datasetDirectory) || !Directory.Exists(_datasetDirectory)) {
            Snackbar.Add("Please select a valid dataset directory.", Severity.Warning);
            return null;
        }

        string? effectiveAuxPath = null;
        if (_enableAuxiliaryLora && !string.IsNullOrWhiteSpace(_auxiliaryLoraPath) && File.Exists(_auxiliaryLoraPath)) {
            bool requiresSlicing = _auxiliaryPartPreset != "All" || _auxiliaryPartWeights.Values.Any(w => Math.Abs(w - 1.0) > 0.001);
            if (requiresSlicing) {
                Snackbar.Add("Slicing Auxiliary LoRA with Chop-Shop parts filter...", Severity.Info);
                effectiveAuxPath = await ChopShopService.PrepareAuxiliarySliceAsync(
                    _auxiliaryLoraPath,
                    _auxiliaryPartWeights
                );
            }
        }

        var config = BuildConfig(effectiveAuxPath);
        string yaml = ConfigBuilder.BuildAiToolkitYaml(config);
        string dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".loramancer", "runs");
        Directory.CreateDirectory(dir);
        string configPath = Path.Combine(dir, $"{config.RunName}_aitoolkit.yaml");
        await File.WriteAllTextAsync(configPath, yaml);
        return configPath;
    }

