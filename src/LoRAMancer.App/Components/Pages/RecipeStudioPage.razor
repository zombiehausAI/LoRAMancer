    private void OnRecipeSelected(string recipeId) {
        _selectedRecipeId = recipeId;
        var recipe = _savedRecipes.FirstOrDefault(r => r.Id == recipeId);
        if (recipe == null) return;

        _targetBaseModel = recipe.TargetBaseModel;
        _networkDim = recipe.NetworkDim;
        _networkAlpha = recipe.NetworkAlpha;
        _learningRate = recipe.LearningRate;
        _unetLearningRate = recipe.UnetLearningRate;
        _textEncoderLearningRate = recipe.TextEncoderLearningRate;
        _optimizer = recipe.Optimizer;
        _lrScheduler = recipe.LrScheduler;
        _precision = recipe.Precision;
        _epochs = recipe.Epochs;
        _repeats = recipe.Repeats;
        _batchSize = recipe.BatchSize;
        _saveEveryNEpochs = recipe.SaveEveryNEpochs;
        _flipAug = recipe.FlipAug;
        _shuffleTokens = recipe.ShuffleTokens;

        if (!string.IsNullOrWhiteSpace(recipe.SamplePrompt1)) {
            _samplePrompt1 = recipe.SamplePrompt1;
        }
        if (!string.IsNullOrWhiteSpace(recipe.SamplePrompt2)) {
            _samplePrompt2 = recipe.SamplePrompt2;
        }
        if (!string.IsNullOrWhiteSpace(recipe.SamplePrompt3)) {
            _samplePrompt3 = recipe.SamplePrompt3;
        }
        if (!string.IsNullOrWhiteSpace(recipe.NegativePrompt)) {
            _negativePrompt = recipe.NegativePrompt;
        }

        if (!string.IsNullOrWhiteSpace(recipe.AuxiliaryLoraPath)) {
            _auxiliaryLoraPath = recipe.AuxiliaryLoraPath;
            _auxiliaryLoraWeight = recipe.AuxiliaryLoraWeight;
            _enableAuxiliaryLora = true;
        }

        Snackbar.Add($"Loaded recipe preset '{recipe.Name}'", Severity.Info);
    }

    private void OnSamplePresetSelected(string name) {
        if (string.IsNullOrWhiteSpace(name)) return;
        var p = _savedModusPrompts.FirstOrDefault(x => x.Name == name);
        if (p != null) {
            if (_activePromptTab == 1) {
                _samplePrompt2 = p.Positive;
            } else if (_activePromptTab == 2) {
                _samplePrompt3 = p.Positive;
            } else {
                _samplePrompt1 = p.Positive;
            }

            if (!string.IsNullOrWhiteSpace(p.Negative)) {
                _negativePrompt = p.Negative;
            }
        }
    }

    private double GetEstimatedVram() {
        var estimates = EstimationService.CalculateEstimates(_targetBaseModel, Math.Max(1, _datasetImageCount), _repeats, _epochs, _batchSize, _networkDim);
        var pre = EstimationService.RunPreFlightCheck(_targetBaseModel, _outputDirectory, _batchSize);
        _preFlightWarning = pre.Warnings.Count > 0 ? string.Join("; ", pre.Warnings) : null;
        return estimates.EstimatedVramGb;
    }

    private int GetCalculatedTotalSteps() {
        int images = Math.Max(1, _datasetImageCount);
        return (images * Math.Max(1, _repeats) * Math.Max(1, _epochs)) / Math.Max(1, _batchSize);
    }

    private TrainingConfig BuildConfig(string? auxiliaryPathOverride = null) {
        var samplePrompts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_samplePrompt1)) samplePrompts.Add(_samplePrompt1.Trim());
        if (!string.IsNullOrWhiteSpace(_samplePrompt2)) samplePrompts.Add(_samplePrompt2.Trim());
        if (!string.IsNullOrWhiteSpace(_samplePrompt3)) samplePrompts.Add(_samplePrompt3.Trim());

        return new TrainingConfig {
            RunName = _runName.Trim(),
            TargetBaseModel = !string.IsNullOrWhiteSpace(_customBaseModelPath) ? _customBaseModelPath : _targetBaseModel,
            DatasetDirectory = _datasetDirectory.Trim(),
            OutputDirectory = !string.IsNullOrWhiteSpace(_outputDirectory) ? _outputDirectory.Trim() : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".loramancer", "outputs"),
            TriggerWord = _triggerWord.Trim(),
            AuxiliaryLoraPath = _enableAuxiliaryLora ? (auxiliaryPathOverride ?? _auxiliaryLoraPath) : string.Empty,
            AuxiliaryLoraWeight = _auxiliaryLoraWeight,
            NetworkDim = _networkDim,
            NetworkAlpha = _networkAlpha,
            LearningRate = _learningRate,
            UnetLearningRate = _unetLearningRate,
            TextEncoderLearningRate = _textEncoderLearningRate,
            Optimizer = _optimizer,
            LrScheduler = _lrScheduler,
            Precision = _precision,
            MaxTrainEpochs = _epochs,
            Repeats = _repeats,
            BatchSize = _batchSize,
            SaveEveryNEpochs = _saveEveryNEpochs,
            CacheLatentsToDisk = _cacheLatentsToDisk,
            ShuffleTokens = _shuffleTokens,
            FlipAug = _flipAug,
            SamplePrompts = samplePrompts,
            NegativePrompt = _negativePrompt.Trim()
        };
    }

