</style>

@code {
    private string _datasetFolder = "";
    private bool _isLoading;
    private bool _isBatchMutating;
    private DatasetCuratorReport? _report;

    private string _tagFilter = "";
    private string _batchTagInput = "";
    private string _findText = "";
    private string _replaceText = "";
    private bool _matchCase;
    private bool _useRegex;
    private string _galleryFilter = "all";

    // Dynamic Card Grid & Full Caption Editor State
    private bool _isGridView = true;
    private int _cardMinWidth = 270;
    private DatasetCuratorItem? _editingItem;
    private int _editingIndex = -1;
    private string _editingCaptionDraft = "";
    private string _singleTaggingPath = string.Empty;

    // AI Tagging Focus & Style: Dataset Defaults & Per-Image Modal Overrides
    private string _datasetFocus = "general";
    private string _datasetCaptionStyle = "tags";
    private string _modalFocus = "general";
    private string _modalCaptionStyle = "tags";

    private void OpenCaptionEditor(DatasetCuratorItem item) {
        _editingItem = item;
        _editingIndex = FilteredGalleryItems.IndexOf(item);
        _editingCaptionDraft = item.CaptionText ?? "";
        _modalFocus = _datasetFocus;
        _modalCaptionStyle = _datasetCaptionStyle;
    }

    private void CloseCaptionEditor() {
        _editingItem = null;
        _editingIndex = -1;
        _editingCaptionDraft = "";
    }

    private void NavigatePreviousImage() {
        if (_editingIndex > 0 && _editingIndex - 1 < FilteredGalleryItems.Count) {
            _editingIndex--;
            _editingItem = FilteredGalleryItems[_editingIndex];
            _editingCaptionDraft = _editingItem.CaptionText ?? "";
        }
    }

    private void NavigateNextImage() {
        if (_editingIndex >= 0 && _editingIndex + 1 < FilteredGalleryItems.Count) {
            _editingIndex++;
            _editingItem = FilteredGalleryItems[_editingIndex];
            _editingCaptionDraft = _editingItem.CaptionText ?? "";
        }
    }

    private void RevertCaptionDraft() {
        if (_editingItem != null) {
            _editingCaptionDraft = _editingItem.CaptionText ?? "";
            Snackbar.Add("Reverted to saved caption.", Severity.Info);
        }
    }

    private async Task SaveCaptionDraftAsync() {
        if (_editingItem != null) {
            _editingItem.CaptionText = _editingCaptionDraft;
            await SaveSingleCaptionAsync(_editingItem);
        }
    }

    private async Task SaveAndAdvanceNextAsync() {
        await SaveCaptionDraftAsync();
        if (_editingIndex + 1 < FilteredGalleryItems.Count) {
            NavigateNextImage();
        } else {
            Snackbar.Add("Reached end of dataset.", Severity.Info);
        }
    }

    private void RemoveTagFromDraft(string tagToRemove) {
        var tags = GetParsedTags(_editingCaptionDraft);
        tags.RemoveAll(t => string.Equals(t, tagToRemove, StringComparison.OrdinalIgnoreCase));
        _editingCaptionDraft = string.Join(", ", tags);
    }

    private void PrependBatchTagToDraft() {
        if (string.IsNullOrWhiteSpace(_batchTagInput)) return;
        string tag = _batchTagInput.Trim().TrimEnd(',');
        var tags = GetParsedTags(_editingCaptionDraft);
        if (!tags.Any(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase))) {
            tags.Insert(0, tag);
            _editingCaptionDraft = string.Join(", ", tags);
        }
    }

    private static List<string> GetParsedTags(string? caption) {
        if (string.IsNullOrWhiteSpace(caption)) return new();
        return caption
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrEmpty(t))
            .ToList();
    }

    private static int GetWordCount(string? text) {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        return text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private readonly Dictionary<string, string> _thumbnailCache = new();
    private readonly CancellationTokenSource _cts = new();

    private string _radarTestToken = "";
    private string _radarFilter = "";
    private string _radarSeverityFilter = "all";
    private TokenCollisionReport? _singleTokenReport;
    private DatasetCollisionAudit? _datasetAudit;
    private bool _isAuditingDataset;
    private bool _isReplacingRadarToken;
    private static bool _isZipWorkingCopy;
    private static string _zipSourcePath = "";
    private bool _isSavingZip;

    protected override async Task OnInitializedAsync() {
        StudioSession.SetStage(StudioStage.Curate);
        _datasetFolder = StudioSession.DatasetFolder;
        if (!string.IsNullOrWhiteSpace(_datasetFolder) && Directory.Exists(_datasetFolder)) {
            await ScanFolderAsync();
        } else if (_isZipWorkingCopy) {
            _isZipWorkingCopy = false;
            _zipSourcePath = "";
        }
    }

    private async Task BrowseFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select Dataset Folder to Curate");
        if (!string.IsNullOrWhiteSpace(folder) && Directory.Exists(folder)) {
            if (_isZipWorkingCopy && !string.IsNullOrWhiteSpace(_datasetFolder) && Directory.Exists(_datasetFolder)) {
                try {
                    Directory.Delete(_datasetFolder, recursive: true);
                } catch { }
            }
            _isZipWorkingCopy = false;
            _zipSourcePath = "";
            _datasetFolder = folder;
            StudioSession.SetDatasetFolder(folder);
            await ScanFolderAsync();
        }
    }

    private async Task BrowseZipAsync() {
        string? zipFile = await FileDialogService.PickZipFileAsync("Select Dataset ZIP Archive to Import");
        if (string.IsNullOrWhiteSpace(zipFile) || !File.Exists(zipFile)) {
            return;
        }

        if (_isZipWorkingCopy && !string.IsNullOrWhiteSpace(_datasetFolder) && Directory.Exists(_datasetFolder)) {
            try {
                Directory.Delete(_datasetFolder, recursive: true);
            } catch { }
        }

        _isLoading = true;
        StateHasChanged();

        try {
            string tempDir = Path.Combine(Path.GetTempPath(), "loramancer_working_datasets", Guid.NewGuid().ToString("N"));
            Directory.CreateDirectory(tempDir);
            await Task.Run(() => ZipFile.ExtractToDirectory(zipFile, tempDir, overwriteFiles: true));

            _isZipWorkingCopy = true;
            _zipSourcePath = zipFile;
            _datasetFolder = tempDir;
            StudioSession.SetDatasetFolder(tempDir);

            await ScanFolderAsync();
            Snackbar.Add($"Imported {Path.GetFileName(zipFile)} to temporary working copy.", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to import ZIP: {ex.Message}", Severity.Error);
        } finally {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveToZipAsync() {
        if (!_isZipWorkingCopy || string.IsNullOrWhiteSpace(_zipSourcePath) || string.IsNullOrWhiteSpace(_datasetFolder) || !Directory.Exists(_datasetFolder)) {
            Snackbar.Add("No active ZIP working copy to save.", Severity.Warning);
            return;
        }

        _isSavingZip = true;
        StateHasChanged();

        try {
            string stagingZip = Path.Combine(Path.GetTempPath(), $"loramancer_save_{Guid.NewGuid():N}.zip");

            await Task.Run(() => {
                if (File.Exists(stagingZip)) {
                    File.Delete(stagingZip);
                }
                ZipFile.CreateFromDirectory(_datasetFolder, stagingZip, CompressionLevel.Optimal, includeBaseDirectory: false);
                File.Move(stagingZip, _zipSourcePath, overwrite: true);
            });

            Snackbar.Add($"Saved dataset changes back to {Path.GetFileName(_zipSourcePath)}.", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to save ZIP archive: {ex.Message}", Severity.Error);
        } finally {
            _isSavingZip = false;
            StateHasChanged();
        }
    }

    private void ClearDataset() {
        if (_isZipWorkingCopy && !string.IsNullOrWhiteSpace(_datasetFolder) && Directory.Exists(_datasetFolder)) {
            try {
                Directory.Delete(_datasetFolder, recursive: true);
            } catch { }
        }
        _isZipWorkingCopy = false;
        _zipSourcePath = "";
        _datasetFolder = "";
        _report = null;
        _datasetAudit = null;
        _singleTokenReport = null;
        _thumbnailCache.Clear();
        StudioSession.SetDatasetFolder("");
        Snackbar.Add("Dataset cleared and temporary files removed.", Severity.Info);
    }

    private async Task ScanFolderAsync() {
        if (string.IsNullOrWhiteSpace(_datasetFolder) || !Directory.Exists(_datasetFolder)) {
            Snackbar.Add("Selected folder does not exist.", Severity.Warning);
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try {
            _report = await CuratorService.ScanDatasetAsync(_datasetFolder);
            StudioSession.SetDatasetFolder(_datasetFolder);
            Snackbar.Add($"Scanned {_report.TotalImages} images and {_report.TotalCaptions} captions.", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Scan failed: {ex.Message}", Severity.Error);
        } finally {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private List<TagFrequencyEntry> FilteredTags {
        get {
            if (_report == null) return new();
            if (string.IsNullOrWhiteSpace(_tagFilter)) return _report.TagFrequencies;
            return _report.TagFrequencies
                .Where(t => t.Tag.Contains(_tagFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private List<DatasetCuratorItem> FilteredGalleryItems {
        get {
            if (_report == null) return new();
            return _galleryFilter switch {
                "missing" => _report.Items.Where(i => string.IsNullOrWhiteSpace(i.CaptionText)).ToList(),
                "corrupt" => _report.Items.Where(i => i.IsCorrupt).ToList(),
                _ => _report.Items
            };
        }
    }

    private List<TokenCollisionReport> FilteredAuditTokens {
        get {
            if (_datasetAudit?.HighRiskTokens == null) return new();
            var query = _datasetAudit.HighRiskTokens.AsEnumerable();

            if (_radarSeverityFilter == "critical_high") {
                query = query.Where(t => t.Severity is CollisionSeverity.CriticalBleed or CollisionSeverity.HighRisk);
            } else if (_radarSeverityFilter == "moderate") {
                query = query.Where(t => t.Severity == CollisionSeverity.ModerateRisk);
            }

            if (!string.IsNullOrWhiteSpace(_radarFilter)) {
                query = query.Where(t =>
                    t.Token.Contains(_radarFilter, StringComparison.OrdinalIgnoreCase) ||
                    t.Explanation.Contains(_radarFilter, StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains(_radarFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private void PopulateReplaceFind(string tag) {
        _findText = tag;
        Snackbar.Add($"Selected '{tag}' for find/replace.", Severity.Info);
    }

    private async Task PrependTagAsync() {
        if (string.IsNullOrWhiteSpace(_batchTagInput) || string.IsNullOrWhiteSpace(_datasetFolder)) return;

        _isBatchMutating = true;
        StateHasChanged();
        try {
            await CuratorService.CreateCaptionBackupAsync(_datasetFolder);
            int count = await CuratorService.BatchPrependTagAsync(_datasetFolder, _batchTagInput);
            Snackbar.Add($"Prepended '{_batchTagInput}' to {count} files (auto-backup created).", Severity.Success);
            StudioSession.SetTriggerWord(_batchTagInput);
            _batchTagInput = "";
            await ScanFolderAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Prepend failed: {ex.Message}", Severity.Error);
        } finally {
            _isBatchMutating = false;
            StateHasChanged();
        }
    }

    private async Task AppendTagAsync() {
        if (string.IsNullOrWhiteSpace(_batchTagInput) || string.IsNullOrWhiteSpace(_datasetFolder)) return;

        _isBatchMutating = true;
        StateHasChanged();
        try {
            await CuratorService.CreateCaptionBackupAsync(_datasetFolder);
            int count = await CuratorService.BatchAppendTagAsync(_datasetFolder, _batchTagInput);
            Snackbar.Add($"Appended '{_batchTagInput}' to {count} files (auto-backup created).", Severity.Success);
            _batchTagInput = "";
            await ScanFolderAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Append failed: {ex.Message}", Severity.Error);
        } finally {
            _isBatchMutating = false;
            StateHasChanged();
        }
    }

    private async Task DeleteTagAsync(string tag) {
        _isBatchMutating = true;
        StateHasChanged();
        try {
            await CuratorService.CreateCaptionBackupAsync(_datasetFolder);
            int count = await CuratorService.BatchDeleteTagAsync(_datasetFolder, tag);
            Snackbar.Add($"Removed '{tag}' from {count} caption files.", Severity.Success);
            await ScanFolderAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Tag deletion failed: {ex.Message}", Severity.Error);
        } finally {
            _isBatchMutating = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteFindReplaceAsync() {
        if (string.IsNullOrEmpty(_findText) || string.IsNullOrWhiteSpace(_datasetFolder)) return;

        _isBatchMutating = true;
        StateHasChanged();
        try {
            await CuratorService.CreateCaptionBackupAsync(_datasetFolder);
            int count = await CuratorService.BatchFindReplaceAsync(_datasetFolder, _findText, _replaceText, _matchCase, _useRegex);
            Snackbar.Add($"Replaced occurrences across {count} caption files (auto-backup created).", Severity.Success);
            await ScanFolderAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Find/Replace failed: {ex.Message}", Severity.Error);
        } finally {
            _isBatchMutating = false;
            StateHasChanged();
        }
    }

    private async Task SaveSingleCaptionAsync(DatasetCuratorItem item) {
        try {
            await CuratorService.SaveItemCaptionAsync(item, item.CaptionText);
            Snackbar.Add($"Saved caption for {Path.GetFileName(item.ImagePath)}", Severity.Success);
            if (_report != null) {
                _report.TagFrequencies = CuratorService.ComputeTagFrequencies(_report.Items);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Failed to save caption: {ex.Message}", Severity.Error);
        }
    }

    private string GetImageSrc(string path) {
        if (string.IsNullOrWhiteSpace(path) || !File.Exists(path)) return string.Empty;
        if (_thumbnailCache.TryGetValue(path, out var cached)) return cached;

        try {
            byte[] bytes = File.ReadAllBytes(path);
            string ext = Path.GetExtension(path).ToLowerInvariant();
            string mime = ext switch {
                ".png" => "image/png",
                ".webp" => "image/webp",
                _ => "image/jpeg"
            };
            string uri = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            _thumbnailCache[path] = uri;
            return uri;
        } catch {
            return string.Empty;
        }
    }

    private void AnalyzeProposedToken() {
        if (string.IsNullOrWhiteSpace(_radarTestToken)) return;
        _singleTokenReport = CollisionService.AnalyzeToken(_radarTestToken);
    }

    private void AdoptSyntheticToken(string synthetic) {
        _radarTestToken = synthetic;
        _batchTagInput = synthetic;
        AnalyzeProposedToken();
        Snackbar.Add($"Copied '{synthetic}' to batch trigger input!", Severity.Success);
    }

    private async Task ScanDatasetRadarAsync() {
        if (string.IsNullOrWhiteSpace(_datasetFolder) || !Directory.Exists(_datasetFolder)) {
            Snackbar.Add("Please select a valid dataset directory first.", Severity.Warning);
            return;
        }

        _isAuditingDataset = true;
        StateHasChanged();
        try {
            _datasetAudit = await CollisionService.AuditDatasetFolderAsync(_datasetFolder, _cts.Token);
            if (_datasetAudit.HighRiskTokens.Count > 0) {
                Snackbar.Add($"Found {_datasetAudit.HighRiskTokens.Count} colliding tags in dataset!", Severity.Warning);
            } else {
                Snackbar.Add("All tags in dataset are clean!", Severity.Success);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Audit error: {ex.Message}", Severity.Error);
        } finally {
            _isAuditingDataset = false;
            StateHasChanged();
        }
    }

    private async Task CleanseCollidingTokenAsync(string oldToken, string newToken) {
        if (string.IsNullOrWhiteSpace(_datasetFolder)) return;

        _isReplacingRadarToken = true;
        StateHasChanged();
        try {
            int modified = await CollisionService.ReplaceCollidingTokenInDatasetAsync(_datasetFolder, oldToken, newToken, _cts.Token);
            Snackbar.Add($"Replaced '{oldToken}' with '{newToken}' across {modified} caption files!", Severity.Success);
            await ScanFolderAsync();
            await ScanDatasetRadarAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Cleanse error: {ex.Message}", Severity.Error);
        } finally {
            _isReplacingRadarToken = false;
            StateHasChanged();
        }
    }

    private async Task OpenOllamaTaggerAsync() {
        var parameters = new DialogParameters<LoRAMancer.App.Components.Dialogs.OllamaTaggerDialog> {
            { x => x.InitialInputPath, _datasetFolder },
            { x => x.InitialTriggerWord, StudioSession.TriggerWord },
            { x => x.InitialFocus, _datasetFocus },
            { x => x.InitialCaptionStyle, _datasetCaptionStyle }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.OllamaTaggerDialog>("Ollama Vision LoRA Tagger", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) {
            if (!string.IsNullOrWhiteSpace(_datasetFolder) && Directory.Exists(_datasetFolder)) {
                await ScanFolderAsync();
                Snackbar.Add("Dataset refreshed with newly generated Ollama captions!", Severity.Success);
            }
        }
    }

    private async Task OpenZipDatasetDialogAsync() {
        if (string.IsNullOrWhiteSpace(_datasetFolder) || !Directory.Exists(_datasetFolder)) {
            Snackbar.Add("Please select a valid dataset folder first.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<LoRAMancer.App.Components.Dialogs.ZipDatasetDialog> {
            { x => x.DatasetFolder, _datasetFolder },
            { x => x.TotalImages, _report?.TotalImages ?? 0 },
            { x => x.TotalCaptions, _report?.TotalCaptions ?? 0 }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.ZipDatasetDialog>("Zip Dataset Archive", parameters, options);
    }

    private async Task AutoTagSingleItemAsync(DatasetCuratorItem? item, string? focusOverride = null, string? styleOverride = null) {
        if (item == null || string.IsNullOrWhiteSpace(item.ImagePath) || !File.Exists(item.ImagePath)) return;

        string effectiveFocus = focusOverride ?? _datasetFocus;
        string effectiveStyle = styleOverride ?? _datasetCaptionStyle;
        string customPrompt = GetPromptForFocusAndStyle(effectiveFocus, effectiveStyle);

        _singleTaggingPath = item.ImagePath;
        StateHasChanged();

        try {
            string model = !string.IsNullOrWhiteSpace(Settings.Current.OllamaDefaultModel) 
                ? Settings.Current.OllamaDefaultModel 
                : "llama3.2-vision";
            string url = !string.IsNullOrWhiteSpace(Settings.Current.OllamaEndpointUrl)
                ? Settings.Current.OllamaEndpointUrl
                : "http://localhost:11434";

            var parameters = new Dictionary<string, object?> {
                ["image_path"] = item.ImagePath,
                ["model"] = model,
                ["ollama_url"] = url,
                ["api_key"] = Settings.Current.OllamaApiKey ?? "",
                ["trigger_word"] = StudioSession.TriggerWord,
                ["caption_style"] = effectiveStyle,
                ["custom_prompt"] = customPrompt,
                ["write_txt"] = true
            };

            var pluginResult = await PluginManager.ExecutePluginAsync("ollama-lora-tagger", "tag_single_image", parameters);
            if (!pluginResult.Success || string.IsNullOrEmpty(pluginResult.Data?.ToString())) {
                throw new InvalidOperationException(pluginResult.Message ?? "Failed to execute Ollama single tagger.");
            }

            using var doc = JsonDocument.Parse(pluginResult.Data.ToString()!);
            JsonElement root = doc.RootElement;
            string status = root.TryGetProperty("status", out var sElem) ? sElem.GetString() ?? "" : "";
            if (status != "success") {
                string msg = root.TryGetProperty("message", out var mElem) ? mElem.GetString() ?? "" : "Tagging failed";
                throw new InvalidOperationException(msg);
            }

            string newCaption = root.TryGetProperty("caption", out var cElem) ? cElem.GetString() ?? "" : "";
            item.CaptionText = newCaption;
            if (_editingItem?.ImagePath == item.ImagePath) {
                _editingCaptionDraft = newCaption;
            }

            if (_report != null) {
                _report.TagFrequencies = CuratorService.ComputeTagFrequencies(_report.Items);
            }

            Snackbar.Add($"AI Tagged {Path.GetFileName(item.ImagePath)} [{effectiveFocus} / {effectiveStyle}]!", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"AI Tagging failed: {ex.Message}", Severity.Error);
        } finally {
            _singleTaggingPath = string.Empty;
            StateHasChanged();
        }
    }

    private static string GetPromptForFocusAndStyle(string focus, string style) {
        bool isNatural = style == "natural";
        return focus switch {
            "person" => isNatural
                ? "Describe this image in 1-2 detailed sentences for training a text-to-image AI model, focusing heavily on the person. Thoroughly describe their facial expression, eye direction, hairstyle, hair color, clothing and attire details, posture, lighting, and background setting. Do not say 'This is an image of'. Be descriptive and direct."
                : "Analyze the person in this image in detail for machine learning training. Describe the subject, hairstyle and hair color, facial expression, eye direction, attire, body pose, framing, lighting, and background setting. Do not include conversational filler or markdown. Output ONLY comma-separated tags.",
            "object" => isNatural
                ? "Describe this image in 1-2 detailed sentences for training a text-to-image AI model, focusing on the main object, vehicle, or product. Describe its design, materials, primary and secondary colors, surface textures, wear/condition, viewing angle, and background context. Do not say 'This is an image of'. Be descriptive and direct."
                : "Analyze the primary object or product in this image in detail for machine learning training. Describe the object type, shape, colors, materials, surface textures, condition, viewing angle, and background context. Do not include conversational filler or markdown. Output ONLY comma-separated tags.",
            "scenery" => isNatural
                ? "Describe this scene in 1-2 detailed sentences for training a text-to-image AI model, focusing on the environment and architecture. Describe the setting, architectural style, structures, environmental elements, atmosphere, time of day, weather, and lighting conditions. Do not say 'This is an image of'. Be descriptive and direct."
                : "Analyze the environment and scene in this image in detail for machine learning training. Describe architectural structures, landscape elements, foliage, weather, time of day, lighting conditions, atmosphere, and perspective. Do not include conversational filler or markdown. Output ONLY comma-separated tags.",
            "style" => isNatural
                ? "Describe this image in 1-2 detailed sentences for training a text-to-image AI model, highlighting the artistic style and medium. Describe the composition, artistic medium (e.g. digital painting, oil, anime, photograph), color palette, rendering quality, texture, and aesthetic technique. Do not say 'This is an image of'. Be descriptive and direct."
                : "Analyze the artistic style and visual medium of this image for machine learning training. Describe the art medium, rendering technique, linework, brushwork, texture, color palette, lighting atmosphere, and visual composition. Do not include conversational filler or markdown. Output ONLY comma-separated tags.",
            _ => isNatural
                ? "Describe this image thoroughly in 1-2 detailed sentences for training a text-to-image AI model. Focus on subject appearance, posture, clothing, colors, setting, and lighting. Do not say 'This is an image of' or 'The picture shows'. Be descriptive and direct."
                : "Analyze this image in detail for machine learning training. Provide a concise, comma-separated list of visual tags describing: the subject, attire, hair, expression, pose, background, lighting, and artistic style. Do not include conversational filler, introductory words, or markdown. Output ONLY comma-separated tags."
        };
    }

    private static Color GetRadarSeverityColor(CollisionSeverity sev) {
        return sev switch {
            CollisionSeverity.Clean => Color.Success,
            CollisionSeverity.LowRisk => Color.Info,
            CollisionSeverity.ModerateRisk => Color.Warning,
            CollisionSeverity.HighRisk => Color.Error,
            CollisionSeverity.CriticalBleed => Color.Error,
            _ => Color.Default
        };
    }

    private static Color GetRadarProgressColor(int score) {
        if (score < 25) return Color.Success;
        if (score < 60) return Color.Warning;
        return Color.Error;
    }

    public void Dispose() {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
