    private async Task OnSelectRecipeAsync(string? recipeName) {
        _selectedRecipeName = recipeName;
        if (string.IsNullOrWhiteSpace(recipeName)) {
            return;
        }

        var saved = _savedRecipes.FirstOrDefault(r => string.Equals(r.RecipeName, recipeName, StringComparison.OrdinalIgnoreCase));
        if (saved != null) {
            await ApplyRecipeAsync(saved);
        }
    }

    private void ClearSelectedRecipe() {
        _selectedRecipeName = null;
    }

    private async Task ApplyRecipeAsync(ChopShopRecipe savedRecipe) {
        if (savedRecipe == null) return;

        int missing = 0;
        foreach (var d in savedRecipe.Donors) {
            var existing = _donors.FirstOrDefault(x => x.FilePath == d.FilePath || x.Id == d.Id);
            if (existing == null) {
                if (File.Exists(d.FilePath)) {
                    try {
                        var inspected = await ChopShop.InspectDonorAsync(d.FilePath);
                        inspected.Id = d.Id;
                        _donors.Add(inspected);
                    } catch {
                        _donors.Add(d);
                    }
                } else {
                    missing++;
                    _donors.Add(d);
                }
            }
        }

        _recipe = new ChopShopRecipe {
            RecipeName = savedRecipe.RecipeName,
            Description = savedRecipe.Description,
            Donors = _donors.ToList(),
            PartAssignments = savedRecipe.PartAssignments.Select(p => new ChopPartAssignment {
                Category = p.Category,
                PartName = p.PartName,
                Description = p.Description,
                Icon = p.Icon,
                SelectedDonorId = p.SelectedDonorId,
                Weight = p.Weight,
                TargetBlocksDescription = p.TargetBlocksDescription
            }).ToList(),
            AdvancedOverrides = savedRecipe.AdvancedOverrides.Select(o => new AdvancedBlockOverride {
                BlockName = o.BlockName,
                FunctionalGroup = o.FunctionalGroup,
                SelectedDonorId = o.SelectedDonorId,
                Weight = o.Weight
            }).ToList(),
            TargetRank = savedRecipe.TargetRank,
            UseDenoisingTies = savedRecipe.UseDenoisingTies,
            OutputPath = string.IsNullOrWhiteSpace(savedRecipe.OutputPath)
                ? Path.Combine(Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".loramancer", "chopshop"), $"{savedRecipe.RecipeName}.safetensors")
                : savedRecipe.OutputPath
        };

        if (missing > 0) {
            Snackbar.Add($"Loaded recipe preset '{savedRecipe.RecipeName}'! ({missing} donor files not found at original paths)", Severity.Warning);
        } else {
            Snackbar.Add($"Loaded recipe preset '{savedRecipe.RecipeName}' successfully!", Severity.Success);
        }
        StateHasChanged();
    }

    private void OpenSaveRecipeDialog() {
        _recipeSaveName = _recipe?.RecipeName ?? "ChopShop_Recipe";
        _recipeSaveDescription = _recipe?.Description ?? "";
        _saveRecipeDialogOpen = true;
    }

    private async Task ConfirmSaveRecipeAsync() {
        if (_recipe == null || string.IsNullOrWhiteSpace(_recipeSaveName)) return;

        try {
            _recipe.Donors = _donors.ToList();
            _recipe.RecipeName = _recipeSaveName.Trim();
            _recipe.Description = _recipeSaveDescription.Trim();
            string savedPath = await ChopShop.SaveRecipeAsync(_recipe, _recipeSaveName);
            await LoadSavedRecipesAsync();
            _selectedRecipeName = _recipeSaveName;
            _saveRecipeDialogOpen = false;
            Snackbar.Add($"Recipe saved: {Path.GetFileName(savedPath)} in ~/.loramancer/chopshop_recipes", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to save recipe: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteSelectedRecipeAsync() {
        if (string.IsNullOrWhiteSpace(_selectedRecipeName)) return;

        try {
            bool deleted = ChopShop.DeleteRecipe(_selectedRecipeName);
            if (deleted) {
                Snackbar.Add($"Deleted recipe preset '{_selectedRecipeName}'.", Severity.Info);
                _selectedRecipeName = null;
                await LoadSavedRecipesAsync();
            }
        } catch (Exception ex) {
            Snackbar.Add($"Error deleting recipe: {ex.Message}", Severity.Error);
        }
    }

    private void OpenRecipeFolder() {
        try {
            string dir = LoraChopShopService.GetRecipeDirectory();
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo {
                FileName = dir,
                UseShellExecute = true
            });
        } catch (Exception ex) {
            Snackbar.Add($"Could not open recipes folder: {ex.Message}", Severity.Warning);
        }
    }
