    private void EnsureChopShopInitialized() {
        if (_chopRecipe == null) {
            string outDir = !string.IsNullOrWhiteSpace(_primaryLoraPath) && File.Exists(_primaryLoraPath)
                ? (Path.GetDirectoryName(_primaryLoraPath) ?? "")
                : Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
            _chopRecipe = new ChopShopRecipe {
                PartAssignments = LoraChopShopService.CreateDefaultPartAssignments(),
                OutputPath = Path.Combine(outDir, "ChopShop_FrankenLoRA.safetensors")
            };
        }
        if (!string.IsNullOrWhiteSpace(_primaryLoraPath) && File.Exists(_primaryLoraPath) && !_chopDonors.Any(d => d.FilePath == _primaryLoraPath)) {
            _ = AddInitialChassisDonorAsync(_primaryLoraPath);
        }
    }

    private async Task AddInitialChassisDonorAsync(string path) {
        try {
            var donor = await ChopShop.InspectDonorAsync(path);
            if (!_chopDonors.Any(d => d.FilePath == path)) {
                _chopDonors.Insert(0, donor);
                if (_chopRecipe != null) {
                    _chopRecipe.Donors = _chopDonors.ToList();
                    string dir = Path.GetDirectoryName(path) ?? "";
                    string baseName = Path.GetFileNameWithoutExtension(path);
                    _chopRecipe.RecipeName = $"{baseName}_ChopShop_Franken";
                    _chopRecipe.OutputPath = Path.Combine(dir, $"{_chopRecipe.RecipeName}.safetensors");
                    foreach (var p in _chopRecipe.PartAssignments) {
                        p.SelectedDonorId ??= donor.Id;
                    }
                }
                StateHasChanged();
            }
        } catch { }
    }

    private async Task AddDonorLoRAAsync() {
        string? file = await FileDialogService.PickSafeTensorsFileAsync();
        if (string.IsNullOrWhiteSpace(file) || !File.Exists(file)) return;
        if (_chopDonors.Any(d => d.FilePath == file)) {
            Snackbar.Add("This LoRA is already in the garage!", Severity.Info);
            return;
        }
        _isInspectingDonor = true;
        StateHasChanged();
        try {
            var donor = await ChopShop.InspectDonorAsync(file);
            _chopDonors.Add(donor);
            if (_chopRecipe != null) {
                _chopRecipe.Donors = _chopDonors.ToList();
                if (_chopDonors.Count == 2) {
                    AutoCraftChopRecipe();
                }
            }
            Snackbar.Add($"Added donor #{_chopDonors.Count}: {donor.FileName} ({donor.DominantFeature})", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to inspect donor: {ex.Message}", Severity.Error);
        } finally {
            _isInspectingDonor = false;
            StateHasChanged();
        }
    }

    private void RemoveDonor(string id) {
        _chopDonors.RemoveAll(d => d.Id == id);
        if (_chopRecipe != null) {
            _chopRecipe.Donors = _chopDonors.ToList();
            foreach (var p in _chopRecipe.PartAssignments.Where(p => p.SelectedDonorId == id)) {
                p.SelectedDonorId = _chopDonors.FirstOrDefault()?.Id;
            }
            _chopRecipe.AdvancedOverrides.RemoveAll(o => o.SelectedDonorId == id);
        }
    }

    private void AutoCraftChopRecipe() {
        if (_chopDonors.Count < 2 || _chopRecipe == null) return;
        string outDir = Path.GetDirectoryName(_chopRecipe.OutputPath) ?? "";
        if (string.IsNullOrWhiteSpace(outDir)) {
            outDir = Path.GetDirectoryName(_chopDonors[0].FilePath) ?? "";
        }
        var newRecipe = ChopShop.GenerateSmartAutoGraftRecipe(_chopDonors, outDir);
        _chopRecipe.PartAssignments = newRecipe.PartAssignments;
        _chopRecipe.RecipeName = newRecipe.RecipeName;
        _chopRecipe.OutputPath = newRecipe.OutputPath;
        _chopRecipe.TargetRank = newRecipe.TargetRank;
        Snackbar.Add("Auto-crafted optimal anatomical & style grafting recipe!", Severity.Success);
    }

    private void ResetChopShop() {
        _chopDonors.Clear();
        _chopResult = null;
        if (_chopRecipe != null) {
            _chopRecipe.Donors.Clear();
            _chopRecipe.AdvancedOverrides.Clear();
            _chopRecipe.PartAssignments = LoraChopShopService.CreateDefaultPartAssignments();
        }
        if (!string.IsNullOrWhiteSpace(_primaryLoraPath) && File.Exists(_primaryLoraPath)) {
            _ = AddInitialChassisDonorAsync(_primaryLoraPath);
        }
        Snackbar.Add("Chop-Shop garage reset", Severity.Info);
    }

    private void SetBlockOverride(string blockName, string role, string? donorId) {
        if (_chopRecipe == null) return;
        var existing = _chopRecipe.AdvancedOverrides.FirstOrDefault(o => o.BlockName == blockName);
        if (string.IsNullOrWhiteSpace(donorId)) {
            if (existing != null) _chopRecipe.AdvancedOverrides.Remove(existing);
        } else {
            if (existing != null) {
                existing.SelectedDonorId = donorId;
            } else {
                _chopRecipe.AdvancedOverrides.Add(new AdvancedBlockOverride {
                    BlockName = blockName,
                    FunctionalGroup = role,
                    SelectedDonorId = donorId,
                    Weight = 1.0
                });
            }
        }
    }

    private async Task BakeChopShopLoraAsync() {
        if (_chopRecipe == null || _chopDonors.Count == 0) return;
        _isAssemblingChop = true;
        _chopResult = null;
        _chopLogs.Clear();
        StateHasChanged();
        try {
            _chopResult = await ChopShop.AssembleChopShopLoraAsync(
                _chopRecipe,
                onLog: line => {
                    _chopLogs.Add(line);
                    StateHasChanged();
                }
            );
            if (_chopResult.Success) {
                Snackbar.Add($"Franken-LoRA baked successfully: {Path.GetFileName(_chopResult.OutputPath)}!", Severity.Success);
            } else {
                Snackbar.Add($"Assembly error: {_chopResult.Message}", Severity.Error);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Chop-Shop exception: {ex.Message}", Severity.Error);
        } finally {
            _isAssemblingChop = false;
            StateHasChanged();
        }
    }

    private void PromoteChopResultToActive() {
        if (_chopResult == null || string.IsNullOrWhiteSpace(_chopResult.OutputPath) || !File.Exists(_chopResult.OutputPath)) return;
        _primaryLoraPath = _chopResult.OutputPath;
        StudioSession.SetActiveLora(_chopResult.OutputPath);
        DetectModelArchitecture();
        Snackbar.Add($"Franken-LoRA promoted to active target: {Path.GetFileName(_primaryLoraPath)}", Severity.Success);
    }

    public void Dispose() { }
