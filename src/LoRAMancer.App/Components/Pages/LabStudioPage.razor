@page "/lab"
@using LoRAMancer.App.Engines
@using LoRAMancer.App.Models
@using LoRAMancer.App.Services
@implements IDisposable
@inject ModelArchitectureRegistry ArchitectureRegistry
@inject StudioSessionService StudioSession
@inject LoraSurgeryService SurgeryService
@inject LoraDiffService DiffService
@inject OverbakeRadarService OverbakeRadar
@inject LoraEchoHunterService EchoHunter
@inject LoraDeAnonymizerService DeAnonymizer
@inject LoraChopShopService ChopShop
@inject NativeFileDialogService FileDialogService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Style="font-weight: 700;">STAGE 3</MudChip>
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--text-primary);">LoRA Diagnostic Lab &amp; Surgery Studio</MudText>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Layer surgery, block weight manipulation, vector gene therapy, SVD radar, ghost hunting, and forensic de-anonymization
        </MudText>
    </div>

    <div class="d-flex align-center gap-2">
        @if (!string.IsNullOrWhiteSpace(_primaryLoraPath)) {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearPrimaryLora">
                Clear Current LoRA
            </MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileOpen" OnClick="BrowsePrimaryLoraAsync">
            Load Target LoRA
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Layers" OnClick="OpenSurgeryDialogAsync">
            Open Advanced Surgery
        </MudButton>
    </div>
</div>

<!-- Active LoRA Target Bar -->
<MudCard Elevation="0" Class="pa-3 mb-4" Style="background-color: var(--bg-dark-surface, #181825); border: 1px solid var(--border-dark, #313244); border-radius: 8px;">
    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
        <div class="d-flex align-center gap-2 flex-grow-1" style="min-width: 280px;">
            <MudIcon Icon="@Icons.Material.Filled.Biotech" Color="Color.Info" Size="Size.Small" />
            <MudText Typo="Typo.body2" Style="font-family: 'JetBrains Mono', monospace; font-weight: 600; color: #cdd6f4;">
                @(string.IsNullOrWhiteSpace(_primaryLoraPath) ? "No LoRA target loaded" : _primaryLoraPath)
            </MudText>
        </div>
        @if (!string.IsNullOrWhiteSpace(_primaryLoraPath) && File.Exists(_primaryLoraPath)) {
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@GetFileSize(_primaryLoraPath)</MudChip>
                <!-- Detected Base Model Badge & Dropdown Selector -->
                <MudMenu Dense="true" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                    <ActivatorContent>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Memory" Style="cursor: pointer;">
                            @(_detectedArchitecture?.DisplayName ?? "Detecting Model...")
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        @foreach (var arch in ArchitectureRegistry.GetAll()) {
                            <MudMenuItem OnClick="@(() => SetActiveArchitecture(arch))">
                                <div class="d-flex align-center justify-space-between gap-3">
                                    <span>@arch.DisplayName</span>
                                    <span style="font-size:0.75rem; color:#a6adc8;">@arch.Family</span>
                                </div>
                            </MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Ready for Surgery</MudChip>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearPrimaryLora">
                    Clear Current LoRA
                </MudButton>
            </div>
        }
    </div>
</MudCard>

@if (!string.IsNullOrWhiteSpace(_primaryLoraPath) && File.Exists(_primaryLoraPath)) {
    <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Color="Color.Dark" Style="background-color: var(--bg-dark-surface, #181825); border: 1px solid #313244; border-radius: 8px;">
        <!-- Tab 1: Layer Surgery & Block Pruner -->
        <MudTabPanel Text="Layer Surgery &amp; Pruning" Icon="@Icons.Material.Filled.ContentCut">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mt-1 mb-3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Adjust layer weights, prune zero-impact ranks, and rescale cross-attention blocks to eliminate style bleed or reduce file footprint.
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Target: @Path.GetFileName(_primaryLoraPath)</MudChip>
            </div>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Class="pa-4 h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #cdd6f4;" Class="mb-2">Cross-Attention &amp; TE Scaling</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                            Rescale text encoder vs unet/transformer blocks to tune prompt responsiveness.
                        </MudText>

                        <div class="mb-3">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.caption">Text Encoder Multiplier</MudText>
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #89b4fa;">@_teScale.ToString("F2")x</MudText>
                            </div>
                            <MudSlider @bind-Value="_teScale" Min="0.0" Max="2.0" Step="0.05" Color="Color.Primary" />
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.caption">UNet / Transformer Backbone Multiplier</MudText>
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #a6e3a1;">@_unetScale.ToString("F2")x</MudText>
                            </div>
                            <MudSlider @bind-Value="_unetScale" Min="0.0" Max="2.0" Step="0.05" Color="Color.Success" />
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Tune" OnClick="ApplySurgeryScalesAsync" Disabled="_isProcessing">
                            @(_isProcessing ? "Processing Tensors..." : "Apply Layer Rescale & Save")
                        </MudButton>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Class="pa-4 h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #cdd6f4;" Class="mb-2">Rank Pruning &amp; SVD Compression</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                            Compress high-rank LoRAs (e.g. rank 64 down to rank 16) using Singular Value Decomposition truncation without losing concept fidelity.
                        </MudText>

                        <div class="mb-4">
                            <MudSelect T="int" @bind-Value="_targetRank" Label="Target Rank Compression" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem Value="8">Rank 8 (Ultra-compact ~16MB)</MudSelectItem>
                                <MudSelectItem Value="16">Rank 16 (Standard production ~32MB)</MudSelectItem>
                                <MudSelectItem Value="32">Rank 32 (High fidelity ~64MB)</MudSelectItem>
                                <MudSelectItem Value="64">Rank 64 (Full capacity)</MudSelectItem>
                            </MudSelect>
                        </div>

                        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Compress" OnClick="ApplyRankPruneAsync" Disabled="_isProcessing">
                            @(_isProcessing ? "Compressing SVD..." : "Compress to Target Rank")
                        </MudButton>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- Tab 2: LoRA Gene Therapy -->
        <MudTabPanel Text="Vector Gene Therapy" Icon="@Icons.Material.Filled.Biotech">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3 mt-1">
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">Vector Gene Therapy &amp; Block Health</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Target: @Path.GetFileName(_primaryLoraPath)</MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Isolate and suppress toxic weight eigenvectors that produce noisy skin artifacts, high-contrast overbake, or corrupted eyes
                    </MudText>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Biotech" OnClick="AnalyzeActiveGeneTherapyAsync" Disabled="_isAnalyzingGeneTherapy || _isCleaningGeneTherapy">
                        @(_isAnalyzingGeneTherapy ? "Analyzing Blocks..." : (_geneTherapyAnalysis == null ? "Analyze Active LoRA" : "Re-Analyze Blocks"))
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenGeneTherapyDialogAsync">
                        Open Full Suite
                    </MudButton>
                </div>
            </div>

            <!-- Active Target Context & Quick Action -->
            @if (_geneTherapyAnalysis == null && !_isAnalyzingGeneTherapy) {
                <MudCard Elevation="0" Class="pa-4 mb-3" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                        <div>
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #cdd6f4;">Active Model Loaded: @Path.GetFileName(_primaryLoraPath)</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Ready for Surgery</MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                Scan the attention and feed-forward blocks of this model to detect extreme outlier weight eigenvalues, or launch the interactive suite.
                            </MudText>
                        </div>
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Biotech" OnClick="AnalyzeActiveGeneTherapyAsync">
                                Scan Active LoRA Blocks
                            </MudButton>
                        </div>
                    </div>
                </MudCard>
            }

            @if (_geneTherapyAnalysis != null) {
                <!-- Metrics Ribbon -->
                <MudGrid Spacing="3" Class="mb-3">
                    <MudItem xs="6" sm="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Architecture</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #89b4fa;">@_geneTherapyAnalysis.DetectedArchitecture</MudText>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Blocks</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">@_geneTherapyAnalysis.Blocks.Count</MudText>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Toxic Outliers</MudText>
                            <MudText Typo="Typo.subtitle1" Style="@($"font-weight: 700; color: {(_geneTherapyAnalysis.ToxicBlockCount > 0 ? "#f38ba8" : "#a6e3a1")};")">
                                @_geneTherapyAnalysis.ToxicBlockCount
                            </MudText>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Dead / Inactive Blocks</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #fab387;">@_geneTherapyAnalysis.DeadBlockCount</MudText>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                @if (_geneTherapyAnalysis.ToxicBlockCount > 0) {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3">
                        Detected @_geneTherapyAnalysis.ToxicBlockCount toxic outlier block(s) with extreme energy spikes in the active model. This commonly causes oversaturated skin, corrupted eyes, and chromatic burnout.
                    </MudAlert>

                    <MudCard Elevation="0" Class="pa-4 mb-3" Style="background-color: #11111b; border: 1px solid #f38ba8; border-radius: 8px;">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                            <div style="max-width: 600px;">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #f38ba8;" Class="mb-1">Quick Cleanse: Auto-Purge Toxic Blocks</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                                    Zero out or attenuate the identified toxic blocks and export a purified model saved directly to the active session.
                                </MudText>
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.caption">Attenuation Factor:</MudText>
                                    <MudSlider @bind-Value="_geneAttenuationFactor" Min="0.0f" Max="0.5f" Step="0.05f" Color="Color.Error" Style="width: 140px;" />
                                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #f38ba8;">@(_geneAttenuationFactor == 0.0f ? "0.0x (Purge)" : $"{_geneAttenuationFactor:F2}x")</MudText>
                                </div>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Healing" OnClick="PurgeToxicBlocksAsync" Disabled="_isCleaningGeneTherapy">
                                @(_isCleaningGeneTherapy ? "Purifying LoRA..." : "Purge Toxic Blocks & Clean")
                            </MudButton>
                        </div>
                    </MudCard>
                } else {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" Class="mb-3">
                        Healthy model! No toxic outlier blocks detected. Weight energy across all @_geneTherapyAnalysis.Blocks.Count blocks is well-balanced.
                    </MudAlert>
                }

                <!-- Block Energy Heatmap Table -->
                <MudTable Items="@_geneTherapyAnalysis.Blocks" Dense="true" Hover="true" Elevation="0" Style="background-color: transparent;" Outlined="true" Height="300px" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>Block Identifier</MudTh>
                        <MudTh Style="width: 120px;">Layers</MudTh>
                        <MudTh Style="width: 140px;">Avg Norm</MudTh>
                        <MudTh Style="width: 140px;">Max Norm</MudTh>
                        <MudTh Style="width: 140px;">Weight %</MudTh>
                        <MudTh Style="width: 140px; text-align: right;">Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #cdd6f4;">@context.BlockName</span>
                        </MudTd>
                        <MudTd>
                            <span style="font-size: 0.8rem; color: #a6adc8;">@context.LayerCount</span>
                        </MudTd>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #89b4fa;">@context.AverageNorm.ToString("F3")</span>
                        </MudTd>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #fab387;">@context.MaxNorm.ToString("F3")</span>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex align-center gap-2">
                                <MudProgressLinear Color="@(context.IsToxic ? Color.Error : Color.Info)" Value="@((int)context.WeightPercentage)" Size="Size.Small" Style="width: 60px;" />
                                <span style="font-size: 0.75rem;">@context.WeightPercentage.ToString("F1")%</span>
                            </div>
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            @if (context.IsToxic) {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Toxic Outlier</MudChip>
                            } else if (context.IsDead) {
                                <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Outlined">Dead / Empty</MudChip>
                            } else {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">Healthy</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- Tab 3: Visual Diff & Weights -->
        <MudTabPanel Text="Visual Diff &amp; Inspection" Icon="@Icons.Material.Filled.Difference">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3 mt-1">
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">Visual Diff &amp; Layer Weight Inspection</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Model A: @Path.GetFileName(_primaryLoraPath)</MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Inspect layer weight magnitudes, Frobenius norms, and compare against reference models or intermediate epoch checkpoints
                    </MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenDiffDialogAsync">
                    Open Full Diff Inspector
                </MudButton>
            </div>

            <MudCard Elevation="0" Class="pa-4 mb-3" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">Model A (Baseline / Reference)</MudText>
                        <div class="d-flex align-center gap-2 pa-2" style="background-color: #181825; border: 1px solid #313244; border-radius: 6px;">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Info" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #89b4fa; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @Path.GetFileName(_primaryLoraPath)
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="ml-auto">Active Target</MudChip>
                        </div>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">Model B (Comparison Checkpoint)</MudText>
                        <div class="d-flex align-center gap-2">
                            <MudTextField @bind-Value="_diffComparisonPath" Placeholder="Select comparison LoRA or epoch checkpoint..." Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="BrowseDiffComparisonModelAsync" StartIcon="@Icons.Material.Filled.FolderOpen">
                                Browse
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>

                <div class="d-flex justify-end gap-2 mt-3 pt-2" style="border-top: 1px solid #313244;">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Difference" OnClick="RunDiffComparisonAsync" Disabled="_isComparingDiff || string.IsNullOrWhiteSpace(_diffComparisonPath)">
                        @(_isComparingDiff ? "Comparing Models..." : "Compare Active vs Model B")
                    </MudButton>
                </div>
            </MudCard>

            @if (_diffSummary != null) {
                <MudGrid Spacing="3" Class="mb-3">
                    <MudItem xs="6" sm="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cosine Similarity</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #a6e3a1;">@_diffSummary.AverageCosineSimilarity.ToString("F4")</MudText>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Average Drift</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #89b4fa;">@_diffSummary.AverageDriftScore.ToString("F4")</MudText>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Matched Layers</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">@_diffSummary.SharedTensorsCount / @_diffSummary.TotalTensorsA</MudText>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="mt-1">@_diffSummary.CompatibilityStatus</MudChip>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudTable Items="@_diffSummary.LayerDiffs" Dense="true" Hover="true" Elevation="0" Style="background-color: transparent;" Outlined="true" Height="300px" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>Layer Name</MudTh>
                        <MudTh Style="width: 130px;">Cosine Sim</MudTh>
                        <MudTh Style="width: 150px;">Norm A → B</MudTh>
                        <MudTh Style="width: 120px;">Rel Delta</MudTh>
                        <MudTh Style="width: 140px; text-align: right;">Divergence</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #cdd6f4;">@context.LayerName</span>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex align-center gap-2">
                                <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">@context.CosineSimilarity.ToString("F4")</span>
                                <MudProgressLinear Color="@(context.CosineSimilarity > 0.95 ? Color.Success : Color.Warning)" Value="@((int)(context.CosineSimilarity * 100))" Style="width: 40px; height: 5px;" />
                            </div>
                        </MudTd>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">@context.NormA.ToString("F3") → @context.NormB.ToString("F3")</span>
                        </MudTd>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 600; color: @(context.RelativeDeltaPct >= 0 ? "#f9e2af" : "#89b4fa");">
                                @(context.RelativeDeltaPct >= 0 ? "+" : "")@context.RelativeDeltaPct.ToString("F1")%
                            </span>
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Style="font-size: 0.65rem;">
                                @context.DivergenceLevel
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- Tab 4: SVD Spectral Decay & Overbake Radar -->
        <MudTabPanel Text="SVD Overbake Radar" Icon="@Icons.Material.Filled.Radar">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3 mt-1">
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">SVD Spectral Energy Decay &amp; Overbake Radar</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Target: @Path.GetFileName(_primaryLoraPath)</MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Detect catastrophic rank collapse, singular value monopolization, and mathematical overbaking
                    </MudText>
                </div>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Analytics" OnClick="RunOverbakeAnalysisAsync" Disabled="_isAnalyzingOverbake">
                        @(_isAnalyzingOverbake ? "Computing SVD..." : "Run SVD Analysis")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="AnalyzeEpochFolderAsync" Disabled="_isAnalyzingOverbake">
                        Audit Epoch Checkpoints
                    </MudButton>
                </div>
            </div>

            @if (_overbakeReport != null) {
                <MudGrid Spacing="3" Class="mb-3">
                    <MudItem xs="12" md="4">
                        <MudCard Elevation="0" Class="pa-4 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Overbake Severity Index</MudText>
                            <div class="d-flex flex-column align-center justify-center my-3">
                                <MudProgressCircular Color="@GetOverbakeColor(_overbakeReport.OverallStatus)" Value="@_overbakeReport.OverbakeScore" Size="Size.Large" StrokeWidth="8" />
                                <span style="font-weight: 800; font-size: 1.1rem; color: #cdd6f4; margin-top: 8px;">@_overbakeReport.OverbakeScore%</span>
                            </div>
                            <MudChip T="string" Color="@GetOverbakeColor(_overbakeReport.OverallStatus)" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 700;">
                                @_overbakeReport.OverallStatus
                            </MudChip>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="8">
                        <MudCard Elevation="0" Class="pa-4 h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #cdd6f4;" Class="mb-1">Mathematical Diagnosis</MudText>
                            <MudText Typo="Typo.body2" Style="color: #a6e3a1;" Class="mb-2">@_overbakeReport.Verdict</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">@_overbakeReport.Recommendation</MudText>

                            <div class="d-flex gap-3 flex-wrap pt-2" style="border-top: 1px solid #313244;">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Avg Frobenius Norm</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight: 700; color: #89b4fa;">@_overbakeReport.AverageFrobeniusNorm.ToString("F3")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Peak Layer Norm</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight: 700; color: #fab387;">@_overbakeReport.MaxFrobeniusNorm.ToString("F3")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Spectral Entropy</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight: 700; color: #cba6f7;">@_overbakeReport.AverageSpectralEntropy.ToString("F3") / 1.0</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Analyzed Layers</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight: 700; color: #cdd6f4;">@_overbakeReport.TotalLoRALayers</MudText>
                                </div>
                            </div>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudTable Items="@_overbakeReport.LayerMetrics" Dense="true" Hover="true" Elevation="0" Style="background-color: transparent;" Outlined="true" Height="340px" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>Layer Name</MudTh>
                        <MudTh Style="width: 140px;">Frobenius Norm</MudTh>
                        <MudTh Style="width: 140px;">Top SVD (σ₁)</MudTh>
                        <MudTh Style="width: 160px;">Top-1 Dominance</MudTh>
                        <MudTh Style="width: 160px;">Spectral Entropy</MudTh>
                        <MudTh Style="width: 140px; text-align: right;">Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #cdd6f4;">@context.LayerName</span>
                        </MudTd>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #89b4fa;">@context.FrobeniusNorm</span>
                        </MudTd>
                        <MudTd>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #fab387;">@context.TopSingularValue</span>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex align-center gap-2">
                                <MudProgressLinear Color="@(context.DominancePct > 70 ? Color.Error : Color.Tertiary)" Value="@context.DominancePct" Size="Size.Small" Style="width: 60px;" />
                                <span style="font-size: 0.75rem;">@context.DominancePct.ToString("F1")%</span>
                            </div>
                        </MudTd>
                        <MudTd>
                            <span style="font-size: 0.8rem; color: #a6adc8;">@context.SpectralEntropy.ToString("F3")</span>
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            <MudChip T="string" Color="@GetOverbakeColor(context.Status)" Size="Size.Small" Variant="Variant.Outlined">
                                @context.Status
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudTable>
            }

            @if (_sequenceReport != null) {
                <MudCard Elevation="0" Class="pa-4 mt-4" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Stars" Color="Color.Success" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #a6e3a1;">Epoch Sequence Sweet Spot Radar</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@_sequenceReport.SummaryMessage</MudText>

                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var item in _sequenceReport.Trajectory) {
                            <MudCard Elevation="0" Class="pa-3 text-center" Style="@($"background-color: #181825; border: 1px solid {(item.IsRecommendedSweetSpot ? "#a6e3a1" : "#313244")}; border-radius: 6px; min-width: 140px;")">
                                <div class="d-flex align-center justify-center gap-1 mb-1">
                                    <MudText Typo="Typo.caption" Style="font-weight: 700;">Epoch @item.EpochNumber</MudText>
                                    @if (item.IsRecommendedSweetSpot) {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    }
                                </div>
                                <MudText Typo="Typo.h6" Style="@($"font-weight: 700; color: {(item.IsRecommendedSweetSpot ? "#a6e3a1" : "#cdd6f4")};")">
                                    @item.OverbakeScore%
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="@GetOverbakeColor(item.Status)" Variant="Variant.Filled" Class="mt-1">
                                    @item.Status
                                </MudChip>
                            </MudCard>
                        }
                    </div>
                </MudCard>
            }
        </MudTabPanel>

        <!-- Tab 5: Ghost & Echo Hunter + Style Decoupler -->
        <MudTabPanel Text="Ghost Hunter &amp; Decoupler" Icon="@Icons.Material.Filled.AutoFixHigh">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mt-1 mb-3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Decouple art style bleed from character identity, or project out toxic negative vectors and unwanted traits via orthogonal repulsion.
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Target: @Path.GetFileName(_primaryLoraPath)</MudChip>
            </div>

            <MudGrid Spacing="3">
                <!-- Style vs Identity Decoupler -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Class="pa-4 h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Color="Color.Secondary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">Style vs. Identity Decoupler</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                            Attenuate backbone / cross-attention blocks that dictate artistic style, lighting, and palette while locking in the core character facial and structural identity.
                        </MudText>

                        <div class="mb-3">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.caption">Identity Retention (Face &amp; Anatomy)</MudText>
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #89b4fa;">@_identityRetention.ToString("F2")x</MudText>
                            </div>
                            <MudSlider @bind-Value="_identityRetention" Min="0.1" Max="2.0" Step="0.05" Color="Color.Primary" />
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.caption">Style Bleed Attenuation</MudText>
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #f38ba8;">@_styleAttenuation.ToString("F2")x</MudText>
                            </div>
                            <MudSlider @bind-Value="_styleAttenuation" Min="0.0" Max="1.0" Step="0.05" Color="Color.Error" />
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FilterTiltShift" OnClick="DecoupleStyleAsync" Disabled="_isProcessingEcho">
                            @(_isProcessingEcho ? "Decoupling Vectors..." : "Decouple Identity from Style")
                        </MudButton>
                    </MudCard>
                </MudItem>

                <!-- Ghost & Echo Repulsion -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Class="pa-4 h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.GppBad" Color="Color.Error" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">Negative Vector &amp; Ghost Repulsion</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                            Perform orthogonal subtraction of failure vectors from a donor LoRA or bad run (e.g. eliminating overbaked hands or an unwanted art bias).
                        </MudText>

                        <div class="d-flex align-center gap-2 mb-3">
                            <MudTextField @bind-Value="_ghostDonorPath" Label="Donor / Negative Vector LoRA" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Placeholder="Select bad checkpoint or unwanted style LoRA..." />
                            <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Variant="Variant.Filled" OnClick="BrowseGhostDonorAsync" />
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.caption">Orthogonal Repulsion Strength</MudText>
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #fab387;">@_ghostRepulsionStrength.ToString("F2")x</MudText>
                            </div>
                            <MudSlider @bind-Value="_ghostRepulsionStrength" Min="0.1" Max="2.0" Step="0.05" Color="Color.Warning" />
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.FlashOn" OnClick="RepelGhostVectorAsync" Disabled="@(_isProcessingEcho || string.IsNullOrWhiteSpace(_ghostDonorPath))">
                            @(_isProcessingEcho ? "Repelling Ghost Vector..." : "Repel & Purify LoRA")
                        </MudButton>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- Tab 6: LoRA Forensic De-Anonymizer -->
        <MudTabPanel Text="Forensic De-Anonymizer" Icon="@Icons.Material.Filled.Fingerprint">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3 mt-1">
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">LoRA Reverse-Engineering &amp; De-Anonymizer</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Target: @Path.GetFileName(_primaryLoraPath)</MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Reconstruct architecture fingerprint, rank/alpha scaling, trained trigger keywords, and training hyperparameters from raw weights
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Search" OnClick="RunDeAnonymizerAsync" Disabled="_isDeAnonymizing">
                    @(_isDeAnonymizing ? "Forensic Scan in Progress..." : "De-Anonymize Model")
                </MudButton>
            </div>

            @if (_forensicReport != null) {
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-3">
                    @_forensicReport.ForensicSummary
                </MudAlert>

                <MudGrid Spacing="3" Class="mb-3">
                    <MudItem xs="12" md="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Architecture</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #89b4fa;">@_forensicReport.DetectedArchitecture</MudText>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Class="mt-1">
                                @_forensicReport.ArchitectureConfidence.ToString("F0")% Confidence
                            </MudChip>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Rank &amp; Alpha</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #fab387;">Rank @_forensicReport.EffectiveRank / α @_forensicReport.EffectiveAlpha.ToString("F1")</MudText>
                            <MudText Typo="Typo.caption" Style="color: #a6adc8;">Ratio: @_forensicReport.AlphaRankRatio.ToString("F2")</MudText>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Precision &amp; Size</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #a6e3a1;">@_forensicReport.Precision</MudText>
                            <MudText Typo="Typo.caption" Style="color: #a6adc8;">@_forensicReport.FormattedSize</MudText>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudCard Elevation="0" Class="pa-3 text-center h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Components</MudText>
                            <div class="d-flex justify-center gap-1 mt-1">
                                <MudChip T="string" Size="Size.Small" Color="@(_forensicReport.HasTextEncoderWeights ? Color.Primary : Color.Dark)" Variant="Variant.Filled">TE</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@(_forensicReport.HasUnetBackboneWeights ? Color.Success : Color.Dark)" Variant="Variant.Filled">UNet/Transformer</MudChip>
                            </div>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <!-- Trigger Words Recovery -->
                <MudCard Elevation="0" Class="pa-4 mb-3" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #cdd6f4;" Class="mb-2">Recovered Concept &amp; Trigger Words</MudText>
                    @if (_forensicReport.RecoveredTriggerTokens.Count > 0) {
                        <div class="d-flex align-center gap-2 flex-wrap">
                            @foreach (var token in _forensicReport.RecoveredTriggerTokens) {
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => SetActiveTrigger(token.Token))" Style="cursor: pointer;">
                                    <span style="font-weight: 700;">@token.Token</span>
                                    <span style="font-size: 0.75rem; margin-left: 6px; opacity: 0.85;">(@token.TokenCategory - @token.ConfidencePct.ToString("F0")%)</span>
                                </MudChip>
                            }
                        </div>
                    } else {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No distinct trigger tags identified in metadata or tensor keys.</MudText>
                    }
                </MudCard>

                <!-- Recovered Training Hyperparameters Table -->
                <MudCard Elevation="0" Class="pa-4" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #cdd6f4;" Class="mb-2">Extracted Hyperparameters &amp; Training Spec</MudText>
                    <MudSimpleTable Dense="true" Hover="true" Style="background-color: transparent;" Outlined="true">
                        <thead>
                            <tr>
                                <th style="color: #89b4fa; width: 280px;">Parameter</th>
                                <th style="color: #cdd6f4;">Extracted Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kvp in _forensicReport.RecoveredHyperparameters) {
                                <tr>
                                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; font-weight: 600; color: #bac2de;">@kvp.Key</td>
                                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #a6e3a1;">@kvp.Value</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudCard>
            }
        </MudTabPanel>

        <!-- Tab 7: LoRA Chop-Shop Studio -->
        <MudTabPanel Text="LoRA Chop-Shop" Icon="@Icons.Material.Filled.Handyman">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3 mt-1">
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">LoRA Vehicle Chop-Shop: Multi-Model Anatomical &amp; Style Grafting</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled">Franken-LoRA Studio</MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Selectively harvest visual components across donor models (face, eyes, hair, clothing, lighting, textures) and forge a single unified LoRA.
                    </MudText>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddPhotoAlternate" OnClick="AddDonorLoRAAsync" Disabled="_isInspectingDonor || _isAssemblingChop">
                        @(_isInspectingDonor ? "Analyzing Donor..." : "Add Donor LoRA")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="AutoCraftChopRecipe" Disabled="_chopDonors.Count < 2 || _isAssemblingChop">
                        Auto-Craft Recipe
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ResetChopShop" Disabled="_chopDonors.Count == 0 || _isAssemblingChop">
                        Reset Garage
                    </MudButton>
                </div>
            </div>

            <!-- The Garage (Donor Shelf) -->
            <MudCard Elevation="0" Class="pa-4 mb-4" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                <div class="d-flex align-center justify-space-between mb-3">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Garage" Color="Color.Info" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #cdd6f4;">The Garage: Loaded Donor Models (@_chopDonors.Count)</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Load 2 or more models to begin anatomical part grafting</MudText>
                </div>

                @if (_chopDonors.Count == 0) {
                    <div class="pa-6 text-center" style="border: 1px dashed #313244; border-radius: 6px;">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No donor models in the garage. Click "Add Donor LoRA" to load your parts sources.</MudText>
                    </div>
                } else {
                    <MudGrid Spacing="2">
                        @foreach (var (donor, idx) in _chopDonors.Select((d, i) => (d, i))) {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard Elevation="0" Class="pa-3 position-relative" Style="background-color: #181825; border: 1px solid #313244; border-radius: 6px;">
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <MudChip T="string" Size="Size.Small" Color="@(idx == 0 ? Color.Primary : Color.Secondary)" Variant="Variant.Filled" Style="font-weight: 700; font-size: 0.7rem;">
                                            @(idx == 0 ? "DONOR #1 (BASE CHASSIS)" : $"DONOR #{idx + 1}")
                                        </MudChip>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="@(() => RemoveDonor(donor.Id))" Disabled="_isAssemblingChop" />
                                    </div>
                                    <MudText Typo="Typo.body2" Style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; font-weight: 600; color: #89b4fa; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@donor.FileName">
                                        @donor.FileName
                                    </MudText>
                                    <div class="d-flex align-center gap-1 my-2 flex-wrap">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled" Style="font-size: 0.65rem;">@donor.Architecture</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled" Style="font-size: 0.65rem;">Rank @donor.Rank</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined" Style="font-size: 0.65rem;">@donor.DominantFeature</MudChip>
                                    </div>
                                    @if (donor.InferredTags.Count > 0) {
                                        <div class="d-flex gap-1 flex-wrap mt-1">
                                            @foreach (var tag in donor.InferredTags.Take(4)) {
                                                <span style="font-size: 0.65rem; background: #313244; color: #cdd6f4; padding: 2px 6px; border-radius: 4px;">@tag</span>
                                            }
                                        </div>
                                    }
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudCard>

            @if (_chopDonors.Count >= 2 && _chopRecipe != null) {
                <!-- The Assembly Bay (Visual High-Level Parts) -->
                <div class="mb-3">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Tertiary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">The Assembly Bay: Anatomical &amp; Style Component Grafting</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                        Choose which donor model provides each specific visual attribute, and adjust the grafting intensity multiplier.
                    </MudText>

                    <MudGrid Spacing="3">
                        @foreach (var part in _chopRecipe.PartAssignments) {
                            <MudItem xs="12" md="6">
                                <MudCard Elevation="0" Class="pa-4 h-100" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <div class="d-flex align-center gap-2">
                                            <MudIcon Icon="@GetPartIcon(part.Category)" Color="Color.Info" Size="Size.Small" />
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #cdd6f4;">@part.PartName</MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined" Style="font-size: 0.65rem;">
                                            @part.TargetBlocksDescription
                                        </MudChip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                                        @part.Description
                                    </MudText>

                                    <!-- Donor Selection Dropdown -->
                                    <MudSelect T="string" @bind-Value="part.SelectedDonorId" Label="Donor LoRA Source" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-3">
                                        <MudSelectItem Value="@((string?)null)">None (Bypass / Base Foundation)</MudSelectItem>
                                        @foreach (var d in _chopDonors) {
                                            <MudSelectItem Value="@d.Id">
                                                <div class="d-flex align-center justify-space-between gap-2">
                                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;">@d.FileName</span>
                                                    <span style="font-size: 0.7rem; color: #a6adc8;">(@d.DominantFeature)</span>
                                                </div>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>

                                    <!-- Grafting Multiplier Slider -->
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Grafting Strength</MudText>
                                        <MudText Typo="Typo.caption" Style="font-weight: 700; color: #89b4fa;">@part.Weight.ToString("F2")x</MudText>
                                    </div>
                                    <MudSlider @bind-Value="part.Weight" Min="0.0" Max="2.0" Step="0.05" Color="Color.Primary" />
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </div>

                <!-- Advanced Block-by-Block Matrix Overrides -->
                <MudExpansionPanels Elevation="0" Class="mb-4">
                    <MudExpansionPanel Text="Advanced Block-by-Block Matrix Overrides (Power User)" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                            Directly route specific U-Net or DiT transformer blocks to explicit donors. Individual block overrides take precedence over the high-level category cards above.
                        </MudText>
                        <MudGrid Spacing="2">
                            @foreach (var block in GetPresetBlocksForArchitecture()) {
                                var existingOverride = _chopRecipe.AdvancedOverrides.FirstOrDefault(o => o.BlockName == block.name);
                                <MudItem xs="12" sm="6" md="4">
                                    <div class="pa-2" style="background-color: #181825; border: 1px solid #313244; border-radius: 6px;">
                                        <div class="d-flex justify-space-between align-center mb-1">
                                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 700; color: #cdd6f4;">@block.name</span>
                                            <span style="font-size: 0.65rem; color: #a6adc8;">@block.role</span>
                                        </div>
                                        <MudSelect T="string" Value="@(existingOverride?.SelectedDonorId)" ValueChanged="@(id => SetBlockOverride(block.name, block.role, id))" Label="Block Donor" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                            <MudSelectItem Value="@((string?)null)">Default Category Rule</MudSelectItem>
                                            @foreach (var d in _chopDonors) {
                                                <MudSelectItem Value="@d.Id">@d.FileName</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                <!-- Bake & Export Station -->
                <MudCard Elevation="0" Class="pa-4 mb-4" Style="background-color: #11111b; border: 1px solid #fab387; border-radius: 8px;">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Whatshot" Color="Color.Warning" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;">Bake Station: SVD Matrix Re-Compression &amp; Export</MudText>
                        </div>
                        <MudSwitch @bind-Value="_chopRecipe.UseDenoisingTies" Color="Color.Primary">
                            <span style="font-size: 0.8rem; color: #cdd6f4;">Resolve Vector Interference (TIES Denoising)</span>
                        </MudSwitch>
                    </div>

                    <MudGrid Spacing="2" Class="mb-3">
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_chopRecipe.RecipeName" Label="Franken-LoRA Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int" @bind-Value="_chopRecipe.TargetRank" Label="Output SVD Rank" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem Value="8">Rank 8 (~16MB Ultra-Compact)</MudSelectItem>
                                <MudSelectItem Value="16">Rank 16 (~32MB Standard Production)</MudSelectItem>
                                <MudSelectItem Value="32">Rank 32 (~64MB High Fidelity)</MudSelectItem>
                                <MudSelectItem Value="64">Rank 64 (~128MB Full Capacity)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <div class="d-flex align-center justify-space-between flex-wrap gap-3 pt-2" style="border-top: 1px solid #313244;">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Destination:</MudText>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #89b4fa;">@_chopRecipe.OutputPath</span>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Large" StartIcon="@Icons.Material.Filled.BuildCircle" OnClick="BakeChopShopLoraAsync" Disabled="_isAssemblingChop">
                            @(_isAssemblingChop ? "Assembling Franken-LoRA..." : "Bake Assembled Franken-LoRA")
                        </MudButton>
                    </div>

                    @if (_chopResult != null) {
                        <MudAlert Severity="@(_chopResult.Success ? Severity.Success : Severity.Error)" Variant="Variant.Filled" Dense="true" Class="mt-3">
                            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                <span>@_chopResult.Message (Duration: @_chopResult.Duration.TotalSeconds.ToString("F1")s)</span>
                                @if (_chopResult.Success) {
                                    <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" OnClick="PromoteChopResultToActive">
                                        Set As Active Target LoRA
                                    </MudButton>
                                }
                            </div>
                        </MudAlert>
                    }
                </MudCard>
            }
        </MudTabPanel>
    </MudTabs>
} else {
    <!-- Empty State -->
    <MudCard Elevation="0" Class="pa-8 text-center my-6" Style="background-color: var(--bg-dark-surface, #181825); border: 1px dashed #313244; border-radius: 12px;">
        <MudIcon Icon="@Icons.Material.Filled.Biotech" Color="Color.Info" Size="Size.Large" Class="mb-3" />
        <MudText Typo="Typo.h6" Style="font-weight: 700;">No Target LoRA Selected</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mb-4" Style="max-width: 500px; margin: 0 auto;">
            Load any trained .safetensors model to inspect layer weight distributions, perform block weight surgery, or repair overtrained artifacts.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.FileOpen" OnClick="BrowsePrimaryLoraAsync">
            Browse Target LoRA...
        </MudButton>
    </MudCard>
}

@code {
    private string _primaryLoraPath = "";
    private double _teScale = 1.0;
    private double _unetScale = 1.0;
    private int _targetRank = 16;
    private bool _isProcessing;
    private bool _isAnalyzingOverbake;
    private bool _isProcessingEcho;
    private bool _isDeAnonymizing;
    private double _identityRetention = 1.0;
    private double _styleAttenuation = 0.20;
    private string _ghostDonorPath = "";
    private double _ghostRepulsionStrength = 0.60;
    private OverbakeModelReport? _overbakeReport;
    private EpochSequenceRadarReport? _sequenceReport;
    private LoraForensicReport? _forensicReport;
    private GeneTherapyAnalysis? _geneTherapyAnalysis;
    private bool _isAnalyzingGeneTherapy;
    private bool _isCleaningGeneTherapy;
    private float _geneAttenuationFactor = 0.0f;
    private string _diffComparisonPath = "";
    private bool _isComparingDiff;
    private LoraDiffSummary? _diffSummary;
    private ModelArchitectureInfo? _detectedArchitecture;
    private ChopShopRecipe? _chopRecipe;
    private readonly List<ChopDonorModel> _chopDonors = new();
    private bool _isInspectingDonor;
    private bool _isAssemblingChop;
    private ChopShopResult? _chopResult;
    private readonly List<string> _chopLogs = new();

    [SupplyParameterFromQuery(Name = "tab")]
    public int? InitialTab { get; set; }

    [SupplyParameterFromQuery(Name = "autoRun")]
    public bool AutoRun { get; set; }

    private int _activeTabIndex;

    protected override void OnInitialized() {
        StudioSession.SetStage(StudioStage.Lab);
        _primaryLoraPath = StudioSession.ActiveLoraPath;
        DetectModelArchitecture();
        EnsureChopShopInitialized();

        if (InitialTab.HasValue && InitialTab.Value >= 0 && InitialTab.Value <= 6) {
            _activeTabIndex = InitialTab.Value;
        }
    }

    private void DetectModelArchitecture() {
        if (!string.IsNullOrWhiteSpace(_primaryLoraPath) && File.Exists(_primaryLoraPath)) {
            if (!string.IsNullOrWhiteSpace(StudioSession.BaseModel) && ArchitectureRegistry.TryGet(StudioSession.BaseModel, out var sessionArch)) {
                _detectedArchitecture = sessionArch;
                return;
            }
            _detectedArchitecture = ArchitectureRegistry.InferFromPathOrMetadata(_primaryLoraPath, new Dictionary<string, string>());
        }
    }

    private void SetActiveArchitecture(ModelArchitectureInfo arch) {
        _detectedArchitecture = arch;
        StudioSession.SetBaseModel(arch.DisplayName);
        Snackbar.Add($"Target architecture set to {arch.DisplayName} ({arch.Family})", Severity.Info);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender && AutoRun && !string.IsNullOrWhiteSpace(_primaryLoraPath) && File.Exists(_primaryLoraPath)) {
            if (_activeTabIndex == 3 && _overbakeReport == null) {
                await RunOverbakeAnalysisAsync();
            } else if (_activeTabIndex == 5 && _forensicReport == null) {
                await RunDeAnonymizerAsync();
            }
        }
    }

    private async Task BrowsePrimaryLoraAsync() {
        string? file = await FileDialogService.PickSafeTensorsFileAsync();
        if (!string.IsNullOrWhiteSpace(file) && File.Exists(file)) {
            _primaryLoraPath = file;
            _overbakeReport = null;
            _sequenceReport = null;
            _forensicReport = null;
            _geneTherapyAnalysis = null;
            _diffSummary = null;
            DetectModelArchitecture();
            StudioSession.SetActiveLora(file, _detectedArchitecture?.DisplayName);
            EnsureChopShopInitialized();
            Snackbar.Add($"Loaded LoRA: {Path.GetFileName(file)}", Severity.Success);
        }
    }

    private void ClearPrimaryLora() {
        _primaryLoraPath = "";
        _detectedArchitecture = null;
        _overbakeReport = null;
        _sequenceReport = null;
        _forensicReport = null;
        _geneTherapyAnalysis = null;
        _diffSummary = null;
        StudioSession.SetActiveLora(string.Empty);
        ResetChopShop();
        Snackbar.Add("Current target LoRA cleared", Severity.Info);
    }

    private async Task BrowseGhostDonorAsync() {
        string? file = await FileDialogService.PickSafeTensorsFileAsync();
        if (!string.IsNullOrWhiteSpace(file) && File.Exists(file)) {
            _ghostDonorPath = file;
        }
    }

    private async Task DecoupleStyleAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath)) return;
        _isProcessingEcho = true;
        StateHasChanged();
        try {
            string dir = Path.GetDirectoryName(_primaryLoraPath) ?? "";
            string fname = Path.GetFileNameWithoutExtension(_primaryLoraPath) + "_decoupled.safetensors";
            string output = Path.Combine(dir, fname);
            var result = await EchoHunter.DecoupleStyleAndIdentityAsync(_primaryLoraPath, output, (float)_identityRetention, (float)_styleAttenuation);
            if (result.Success) {
                Snackbar.Add(result.Message, Severity.Success);
                _primaryLoraPath = output;
                StudioSession.SetActiveLora(output);
            } else {
                Snackbar.Add($"Decouple failed: {result.Message}", Severity.Warning);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Operation error: {ex.Message}", Severity.Error);
        } finally {
            _isProcessingEcho = false;
            StateHasChanged();
        }
    }

    private async Task RepelGhostVectorAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath) || string.IsNullOrWhiteSpace(_ghostDonorPath)) return;
        _isProcessingEcho = true;
        StateHasChanged();
        try {
            string dir = Path.GetDirectoryName(_primaryLoraPath) ?? "";
            string fname = Path.GetFileNameWithoutExtension(_primaryLoraPath) + "_purified.safetensors";
            string output = Path.Combine(dir, fname);
            var result = await EchoHunter.HuntAndRepelGhostVectorAsync(_primaryLoraPath, _ghostDonorPath, output, EchoHunterMode.OrthogonalRepulsion, (float)_ghostRepulsionStrength);
            if (result.Success) {
                Snackbar.Add(result.Message, Severity.Success);
                _primaryLoraPath = output;
                StudioSession.SetActiveLora(output);
            } else {
                Snackbar.Add($"Repulsion failed: {result.Message}", Severity.Warning);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Operation error: {ex.Message}", Severity.Error);
        } finally {
            _isProcessingEcho = false;
            StateHasChanged();
        }
    }

    private async Task RunDeAnonymizerAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath)) return;
        _isDeAnonymizing = true;
        StateHasChanged();
        try {
            _forensicReport = await DeAnonymizer.ReverseEngineerLoraAsync(_primaryLoraPath);
            Snackbar.Add($"De-anonymization complete: {_forensicReport.DetectedArchitecture} ({_forensicReport.EffectiveRank} rank)", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Forensic analysis failed: {ex.Message}", Severity.Error);
        } finally {
            _isDeAnonymizing = false;
            StateHasChanged();
        }
    }

    private void SetActiveTrigger(string token) {
        StudioSession.SetTriggerWord(token);
        Snackbar.Add($"Active trigger word set to '{token}' across Studio session", Severity.Info);
    }

    private async Task ApplySurgeryScalesAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath)) return;
        _isProcessing = true;
        StateHasChanged();
        try {
            string dir = Path.GetDirectoryName(_primaryLoraPath) ?? "";
            string fname = Path.GetFileNameWithoutExtension(_primaryLoraPath) + "_attenuated.safetensors";
            string output = Path.Combine(dir, fname);
            var blocks = new List<string> { "lora_te", "lora_unet" };
            var result = await SurgeryService.PruneOrAttenuateBlocksAsync(_primaryLoraPath, output, blocks, (float)_teScale);
            if (result.Success) {
                Snackbar.Add($"Attenuated LoRA saved: {fname}", Severity.Success);
                _primaryLoraPath = output;
                StudioSession.SetActiveLora(output);
            } else {
                Snackbar.Add($"Operation message: {result.Message}", Severity.Warning);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Surgery failed: {ex.Message}", Severity.Error);
        } finally {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ApplyRankPruneAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath)) return;
        _isProcessing = true;
        StateHasChanged();
        try {
            string dir = Path.GetDirectoryName(_primaryLoraPath) ?? "";
            string fname = Path.GetFileNameWithoutExtension(_primaryLoraPath) + $"_rank{_targetRank}.safetensors";
            string output = Path.Combine(dir, fname);
            var result = await SurgeryService.ResizeLoraAsync(_primaryLoraPath, output, _targetRank);
            if (result.Success) {
                Snackbar.Add($"Compressed LoRA saved to rank {_targetRank}: {fname}", Severity.Success);
                _primaryLoraPath = output;
                StudioSession.SetActiveLora(output);
            } else {
                Snackbar.Add($"Resize message: {result.Message}", Severity.Warning);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Compression failed: {ex.Message}", Severity.Error);
        } finally {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task OpenSurgeryDialogAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var parameters = new DialogParameters<LoRAMancer.App.Components.Dialogs.LoraSurgeryDialog>();
        if (!string.IsNullOrWhiteSpace(_primaryLoraPath)) {
            parameters.Add(x => x.InitialLoraPath, _primaryLoraPath);
        }
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraSurgeryDialog>("LoRA Surgery & Merger Studio", parameters, options);
    }

    private async Task OpenGeneTherapyDialogAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var parameters = new DialogParameters<LoRAMancer.App.Components.Dialogs.LoraGeneTherapyDialog>();
        if (!string.IsNullOrWhiteSpace(_primaryLoraPath)) {
            parameters.Add(x => x.InitialLoraPath, _primaryLoraPath);
        }
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraGeneTherapyDialog>("LoRA Gene Therapy Studio", parameters, options);
    }

    private async Task OpenDiffDialogAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var parameters = new DialogParameters<LoRAMancer.App.Components.Dialogs.LoraDiffDialog>();
        if (!string.IsNullOrWhiteSpace(_primaryLoraPath)) {
            parameters.Add(x => x.InitialPathA, _primaryLoraPath);
        }
        if (!string.IsNullOrWhiteSpace(_diffComparisonPath)) {
            parameters.Add(x => x.InitialPathB, _diffComparisonPath);
        }
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraDiffDialog>("LoRA Visual Diff Inspector", parameters, options);
    }

    private async Task AnalyzeActiveGeneTherapyAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath)) return;
        _isAnalyzingGeneTherapy = true;
        StateHasChanged();
        try {
            _geneTherapyAnalysis = await SurgeryService.AnalyzeLayerBlocksAsync(_primaryLoraPath);
            if (_geneTherapyAnalysis != null) {
                if (_geneTherapyAnalysis.ToxicBlockCount > 0) {
                    Snackbar.Add($"Analysis found {_geneTherapyAnalysis.ToxicBlockCount} toxic outlier blocks in {Path.GetFileName(_primaryLoraPath)}!", Severity.Warning);
                } else {
                    Snackbar.Add($"Analysis completed! All {_geneTherapyAnalysis.Blocks.Count} blocks are healthy.", Severity.Success);
                }
            } else {
                Snackbar.Add("Failed to analyze layer blocks.", Severity.Error);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Analysis error: {ex.Message}", Severity.Error);
        } finally {
            _isAnalyzingGeneTherapy = false;
            StateHasChanged();
        }
    }

    private async Task PurgeToxicBlocksAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath) || _geneTherapyAnalysis == null) return;
        var toxicBlocks = _geneTherapyAnalysis.Blocks.Where(x => x.IsToxic).Select(x => x.BlockName).ToList();
        if (toxicBlocks.Count == 0) {
            Snackbar.Add("No toxic blocks identified to purge.", Severity.Info);
            return;
        }
        _isCleaningGeneTherapy = true;
        StateHasChanged();
        try {
            string dir = Path.GetDirectoryName(_primaryLoraPath) ?? "";
            string fname = Path.GetFileNameWithoutExtension(_primaryLoraPath) + "_cleansed.safetensors";
            string output = Path.Combine(dir, fname);
            var result = await SurgeryService.PruneOrAttenuateBlocksAsync(_primaryLoraPath, output, toxicBlocks, _geneAttenuationFactor);
            if (result.Success) {
                Snackbar.Add($"Applied Gene Therapy! Purged {toxicBlocks.Count} blocks to {fname}", Severity.Success);
                _primaryLoraPath = output;
                StudioSession.SetActiveLora(output);
                _geneTherapyAnalysis = await SurgeryService.AnalyzeLayerBlocksAsync(_primaryLoraPath);
            } else {
                Snackbar.Add($"Gene Therapy failed: {result.Message}", Severity.Error);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Gene Therapy error: {ex.Message}", Severity.Error);
        } finally {
            _isCleaningGeneTherapy = false;
            StateHasChanged();
        }
    }

    private async Task BrowseDiffComparisonModelAsync() {
        string? file = await FileDialogService.PickSafeTensorsFileAsync();
        if (!string.IsNullOrWhiteSpace(file) && File.Exists(file)) {
            _diffComparisonPath = file;
        }
    }

    private async Task RunDiffComparisonAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath)) return;
        if (string.IsNullOrWhiteSpace(_diffComparisonPath) || !File.Exists(_diffComparisonPath)) {
            Snackbar.Add("Please select a comparison model (Model B) first.", Severity.Warning);
            return;
        }
        _isComparingDiff = true;
        StateHasChanged();
        try {
            _diffSummary = await DiffService.CompareLorasAsync(_primaryLoraPath, _diffComparisonPath, deepTensorAnalysis: true);
            Snackbar.Add($"Diff completed! Cosine similarity: {_diffSummary.AverageCosineSimilarity:F4}", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Diff error: {ex.Message}", Severity.Error);
        } finally {
            _isComparingDiff = false;
            StateHasChanged();
        }
    }

    private static string GetFileSize(string path) {
        try {
            var fi = new FileInfo(path);
            double mb = fi.Length / (1024.0 * 1024.0);
            return $"{mb:F1} MB";
        } catch {
            return "";
        }
    }

    private async Task RunOverbakeAnalysisAsync() {
        if (string.IsNullOrWhiteSpace(_primaryLoraPath) || !File.Exists(_primaryLoraPath)) return;
        _isAnalyzingOverbake = true;
