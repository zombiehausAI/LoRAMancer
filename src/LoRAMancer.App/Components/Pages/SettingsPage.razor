    private bool _isTestingOllama;
    private bool _ollamaReachable;
    private string _ollamaStatusMessage = string.Empty;
    private readonly List<string> _discoveredVisionModels = new();

    private async Task TestOllamaConnectionAsync() {
        _isTestingOllama = true;
        _ollamaStatusMessage = string.Empty;
        _discoveredVisionModels.Clear();
        StateHasChanged();

        string cleanUrl = (_settings.OllamaEndpointUrl ?? "http://localhost:11434").Trim().TrimEnd('/');
        if (string.IsNullOrWhiteSpace(cleanUrl)) cleanUrl = "http://localhost:11434";

        var candidates = new List<string> { cleanUrl };
        if (cleanUrl.Contains("localhost")) {
            candidates.Add(cleanUrl.Replace("localhost", "127.0.0.1"));
        } else if (cleanUrl.Contains("127.0.0.1")) {
            candidates.Add(cleanUrl.Replace("127.0.0.1", "localhost"));
        }

        bool connected = false;
        string lastError = string.Empty;

        foreach (var url in candidates) {
            try {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                using var request = new HttpRequestMessage(HttpMethod.Get, $"{url}/api/tags");
                if (!string.IsNullOrWhiteSpace(_settings.OllamaApiKey)) {
                    request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _settings.OllamaApiKey.Trim());
                }

                using var response = await Http.SendAsync(request, cts.Token);
                if (response.IsSuccessStatusCode) {
                    string json = await response.Content.ReadAsStringAsync(cts.Token);
                    using var doc = System.Text.Json.JsonDocument.Parse(json);
                    if (doc.RootElement.TryGetProperty("models", out var modelsElem) && modelsElem.ValueKind == System.Text.Json.JsonValueKind.Array) {
                        foreach (var m in modelsElem.EnumerateArray()) {
                            string name = m.TryGetProperty("name", out var n) ? n.GetString() ?? "" : "";
                            if (!string.IsNullOrEmpty(name) && !_discoveredVisionModels.Contains(name)) {
                                _discoveredVisionModels.Add(name);
                            }
                        }
                    }
                    connected = true;
                    _ollamaReachable = true;
                    _ollamaStatusMessage = $"Successfully connected to Ollama at {url}! Found {_discoveredVisionModels.Count} model(s).";
                    break;
                } else {
                    lastError = $"HTTP {(int)response.StatusCode}";
                }
            } catch (Exception ex) {
                lastError = ex.Message;
            }
        }

        if (!connected) {
            _ollamaReachable = false;
            _ollamaStatusMessage = $"Could not reach Ollama: {lastError}. Ensure `ollama serve` is running.";
        }

        _isTestingOllama = false;
        StateHasChanged();
    }
}
