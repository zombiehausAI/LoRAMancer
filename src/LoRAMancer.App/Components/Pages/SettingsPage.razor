    // Custom Accent Color Studio State
    private int _accentR = 203;
    private int _accentG = 166;
    private int _accentB = 247;
    private string _accentHex = "#cba6f7";

    private void SyncRgbFromHex(string? hex) {
        if (string.IsNullOrWhiteSpace(hex)) {
            hex = ThemeManager.EffectivePrimaryColor;
        }
        string clean = hex.Trim().TrimStart('#');
        if (clean.Length == 6 &&
            int.TryParse(clean.Substring(0, 2), System.Globalization.NumberStyles.HexNumber, null, out int r) &&
            int.TryParse(clean.Substring(2, 2), System.Globalization.NumberStyles.HexNumber, null, out int g) &&
            int.TryParse(clean.Substring(4, 2), System.Globalization.NumberStyles.HexNumber, null, out int b)) {
            _accentR = r;
            _accentG = g;
            _accentB = b;
            _accentHex = $"#{clean.ToUpperInvariant()}";
        }
    }

    private async Task OnRgbSliderChangedAsync(string channel, object? val) {
        if (val != null && int.TryParse(val.ToString(), out int intVal)) {
            intVal = Math.Clamp(intVal, 0, 255);
            if (channel == "R") {
                _accentR = intVal;
            } else if (channel == "G") {
                _accentG = intVal;
            } else if (channel == "B") {
                _accentB = intVal;
            }

            _accentHex = $"#{_accentR:X2}{_accentG:X2}{_accentB:X2}";
            await SetAccentColorAsync(_accentHex);
        }
    }

    private async Task OnNativeColorPickedAsync(ChangeEventArgs e) {
        string? val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val)) {
            SyncRgbFromHex(val);
            await SetAccentColorAsync(_accentHex);
        }
    }

    private async Task OnHexInputChangedAsync(string val) {
        _accentHex = val;
        if (!val.StartsWith("#")) {
            val = "#" + val;
