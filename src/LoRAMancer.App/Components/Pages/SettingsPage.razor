            Password = _settings.PgPassword,
            SslMode = _settings.PgSslMode
        };
    }

    private async Task SwitchEngineAsync(string provider) {
        _settings.DatabaseProvider = provider;
        await Settings.SaveSettingsAsync(_settings);
        await DatabaseService.SwitchDatabaseProviderAsync(provider);
        Snackbar.Add($"Switched active database engine to {provider}!", Severity.Success);
        StateHasChanged();
    }

    private async Task TestPgConnectionAsync() {
        _isTestingPg = true;
        _pgStatusMessage = "Testing PostgreSQL connection...";
        _pgStatusSuccess = null;
        StateHasChanged();

        try {
            var config = GetPgConfig();
            var result = await DatabaseService.TestPostgreSqlConnectionAsync(config);
            _pgStatusSuccess = result.Success;
            if (result.Success) {
                _pgStatusMessage = $"{result.Message} (Roundtrip latency: {result.Latency.TotalMilliseconds:F1}ms)";
                Snackbar.Add("Connected to PostgreSQL successfully!", Severity.Success);
            } else {
                _pgStatusMessage = result.Message;
                Snackbar.Add($"PostgreSQL connection failed: {result.Message}", Severity.Error);
            }
        } catch (Exception ex) {
            _pgStatusSuccess = false;
            _pgStatusMessage = ex.Message;
            Snackbar.Add($"PostgreSQL error: {ex.Message}", Severity.Error);
        } finally {
            _isTestingPg = false;
            StateHasChanged();
        }
    }

    private async Task MigrateSqliteToPgAsync() {
        _isMigrating = true;
        _migrationStatus = "Starting SQLite to PostgreSQL migration...";
        _migrationProgress = 0.05;
        StateHasChanged();

        try {
            var config = GetPgConfig();
            int count = await DatabaseService.MigrateSqliteToPostgreSqlAsync(config, (status, progress) => {
