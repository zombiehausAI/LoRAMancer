@page "/settings"
@implements IDisposable
@inject SettingsService Settings
@inject HuggingFaceService HfService
@inject AiToolkitSetupService ToolkitSetup
@inject NativeFileDialogService FileDialogService
@inject NetworkServerService NetworkServer
@inject PublicTunnelService PublicTunnel
@inject RemoteTrainingClientService RemoteClient
@inject AuthTokenManagerService TokenManager
@inject ThemeService ThemeManager
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--text-primary);">System Settings & Admin Console</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Configure GPU PyTorch wheels (AMD / NVIDIA / Intel), appearance themes, AI-Toolkit, and API keys</MudText>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetDefaultsAsync">
            Reset Defaults
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync">
            Save Settings
        </MudButton>
    </div>
</div>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); border-radius: 8px;">
    <!-- GPU & PyTorch Wheels Tab -->
    <MudTabPanel Text="GPU & PyTorch Wheels" Icon="@Icons.Material.Filled.Memory">
        <div class="px-4 pb-4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-3" Style="background-color: rgba(203, 166, 247, 0.15); color: #cba6f7;">
                LoRAMancer supports AMD, NVIDIA, and Intel GPUs. Each card profile defaults to optimal vendor wheels, with full support for custom wheel URLs and index repositories.
            </MudAlert>

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-3" Style="background-color: var(--bg-dark-base); border: 1px solid var(--border-dark); border-radius: 8px;">
                <!-- AMD Radeon (ROCm) Sub-Tab -->
                <MudTabPanel Text="AMD Radeon (ROCm)" Icon="@Icons.Material.Filled.Memory">
                    <div class="pa-3">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cba6f7;">AMD ROCm Wheels</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default: Official AMD ROCm 7.2.1 Windows wheels from repo.radeon.com</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAmdDefaults">
                                Reset AMD Defaults
                            </MudButton>
                        </div>

                        <MudGrid>
                            <MudItem xs="12" md="8">
                                <MudTextField @bind-Value="_settings.RocmBaseUrl" Label="ROCm Release Base URL" Variant="Variant.Outlined" Placeholder="https://repo.radeon.com/rocm/windows/rocm-rel-7.2.1" HelperText="Root HTTP directory containing AMD-compiled wheels" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_settings.PyTorchVersion" Label="PyTorch Version Tag" Variant="Variant.Outlined" Placeholder="2.9.1+rocm7.2.1" HelperText="Version identifier (e.g. 2.9.1+rocm7.2.1)" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="AutoGenerateUrls">
                                    Auto-Generate Wheel URLs from Base & Version
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.NetworkCheck" Class="ml-2" Disabled="_isTestingUrls" OnClick="TestAllWheelUrlsAsync">
                                    @(_isTestingUrls ? "Testing Reachability..." : "Test All Links")
                                </MudButton>
                            </MudItem>

                            <MudItem xs="12">
                                <MudDivider Class="my-2" Style="border-color: #313244;" />
                                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">Direct Wheel URLs</MudText>
                            </MudItem>

                            <!-- Torch Wheel -->
                            <MudItem xs="12">
                                <div class="d-flex align-center gap-2">
                                    <MudTextField @bind-Value="_settings.TorchWheelUrl" Label="Torch Wheel (.whl)" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => TestSingleUrlAsync(_settings.TorchWheelUrl, "torch"))">
                                        Test
                                    </MudButton>
                                </div>
                                @if (_urlStatuses.TryGetValue("torch", out var torchStatus)) {
                                    <MudChip T="string" Size="Size.Small" Color="@(torchStatus.Reachable ? Color.Success : Color.Error)" Class="mt-1">
                                        @torchStatus.Message
                                    </MudChip>
                                }
                            </MudItem>

                            <!-- TorchVision Wheel -->
                            <MudItem xs="12">
                                <div class="d-flex align-center gap-2">
                                    <MudTextField @bind-Value="_settings.TorchVisionWheelUrl" Label="TorchVision Wheel (.whl)" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => TestSingleUrlAsync(_settings.TorchVisionWheelUrl, "torchvision"))">
                                        Test
                                    </MudButton>
                                </div>
                                @if (_urlStatuses.TryGetValue("torchvision", out var tvStatus)) {
                                    <MudChip T="string" Size="Size.Small" Color="@(tvStatus.Reachable ? Color.Success : Color.Error)" Class="mt-1">
                                        @tvStatus.Message
                                    </MudChip>
                                }
                            </MudItem>

                            <!-- TorchAudio Wheel -->
                            <MudItem xs="12">
                                <div class="d-flex align-center gap-2">
                                    <MudTextField @bind-Value="_settings.TorchAudioWheelUrl" Label="TorchAudio Wheel (.whl)" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => TestSingleUrlAsync(_settings.TorchAudioWheelUrl, "torchaudio"))">
                                        Test
                                    </MudButton>
                                </div>
                                @if (_urlStatuses.TryGetValue("torchaudio", out var taStatus)) {
                                    <MudChip T="string" Size="Size.Small" Color="@(taStatus.Reachable ? Color.Success : Color.Error)" Class="mt-1">
                                        @taStatus.Message
                                    </MudChip>
                                }
                            </MudItem>

                            <!-- ROCm SDK Wheels -->
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1" Color="Color.Primary">ROCm SDK Wheels & Packages</MudText>
                                @for (int i = 0; i < _settings.RocmSdkWheels.Count; i++) {
                                    int index = i;
                                    <div class="d-flex align-center gap-2 mb-2">
                                        <MudTextField @bind-Value="_settings.RocmSdkWheels[index]" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveSdkWheel(index))" />
                                    </div>
                                }
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddSdkWheel">
                                    Add SDK Wheel URL
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <!-- NVIDIA (CUDA) Sub-Tab -->
                <MudTabPanel Text="NVIDIA (CUDA)" Icon="@Icons.Material.Filled.Bolt">
                    <div class="pa-3">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #89b4fa;">NVIDIA CUDA Wheels</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default: Official PyTorch CUDA 12.4 index (download.pytorch.org/whl/cu124)</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetNvidiaDefaults">
                                Reset NVIDIA Defaults
                            </MudButton>
                        </div>

                        <MudSwitch @bind-Value="_settings.NvidiaUseCustomWheels" Color="Color.Primary" Label="Use Custom Wheels / Direct URLs instead of PyTorch Index" Class="mb-3" />

                        <MudGrid>
                            @if (!_settings.NvidiaUseCustomWheels) {
                                <MudItem xs="12" md="8">
                                    <MudTextField @bind-Value="_settings.NvidiaIndexUrl" Label="PyTorch CUDA Index URL" Variant="Variant.Outlined" HelperText="Official or mirror PyTorch index (e.g. https://download.pytorch.org/whl/cu124 or cu121)" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField @bind-Value="_settings.NvidiaPackageSpec" Label="Package Specification" Variant="Variant.Outlined" HelperText="Packages to install (e.g. torch torchvision torchaudio)" />
                                </MudItem>
                            } else {
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_settings.NvidiaCustomWheelUrls" Label="Custom Wheel URLs or Direct Path" Variant="Variant.Outlined" Lines="3" HelperText="Space-separated wheel URLs or local .whl file paths" Placeholder="https://custom-repo.com/torch.whl https://custom-repo.com/torchvision.whl" />
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.NetworkCheck" OnClick="@(() => TestSingleUrlAsync(_settings.NvidiaIndexUrl, "nvidia"))">
                                    Test NVIDIA Index Reachability
                                </MudButton>
                                @if (_urlStatuses.TryGetValue("nvidia", out var nvStatus)) {
                                    <MudChip T="string" Size="Size.Small" Color="@(nvStatus.Reachable ? Color.Success : Color.Error)" Class="ml-2">
                                        @nvStatus.Message
                                    </MudChip>
                                }
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <!-- Intel Arc / XPU Sub-Tab -->
                <MudTabPanel Text="Intel Arc (XPU)" Icon="@Icons.Material.Filled.DeveloperBoard">
                    <div class="pa-3">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #a6e3a1;">Intel Arc / XPU Wheels</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default: Official PyTorch XPU index (download.pytorch.org/whl/xpu) with native PyTorch 2.5+ Intel acceleration</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetIntelDefaults">
                                Reset Intel Defaults
                            </MudButton>
                        </div>

                        <MudSwitch @bind-Value="_settings.IntelUseCustomWheels" Color="Color.Primary" Label="Use Custom Wheels / Direct URLs instead of Official XPU Index" Class="mb-3" />

                        <MudGrid>
                            @if (!_settings.IntelUseCustomWheels) {
                                <MudItem xs="12" md="8">
                                    <MudTextField @bind-Value="_settings.IntelIndexUrl" Label="PyTorch XPU Index URL" Variant="Variant.Outlined" HelperText="Official PyTorch Intel XPU index (https://download.pytorch.org/whl/xpu)" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField @bind-Value="_settings.IntelPackageSpec" Label="Package Specification" Variant="Variant.Outlined" HelperText="Packages to install (e.g. torch torchvision torchaudio)" />
                                </MudItem>
                            } else {
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_settings.IntelCustomWheelUrls" Label="Custom Wheel URLs or Direct Path" Variant="Variant.Outlined" Lines="3" HelperText="Space-separated wheel URLs or local .whl file paths" Placeholder="https://custom-repo.com/torch-xpu.whl" />
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.NetworkCheck" OnClick="@(() => TestSingleUrlAsync(_settings.IntelIndexUrl, "intel"))">
                                    Test Intel Index Reachability
                                </MudButton>
                                @if (_urlStatuses.TryGetValue("intel", out var intelStatus)) {
                                    <MudChip T="string" Size="Size.Small" Color="@(intelStatus.Reachable ? Color.Success : Color.Error)" Class="ml-2">
                                        @intelStatus.Message
                                    </MudChip>
                                }
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <!-- CPU Fallback Sub-Tab -->
                <MudTabPanel Text="CPU Fallback" Icon="@Icons.Material.Filled.Computer">
                    <div class="pa-3">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #a6adc8;">CPU Fallback Wheels</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Default: Official PyTorch CPU build (download.pytorch.org/whl/cpu)</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetCpuDefaults">
                                Reset CPU Defaults
                            </MudButton>
                        </div>

                        <MudGrid>
                            <MudItem xs="12" md="8">
                                <MudTextField @bind-Value="_settings.CpuIndexUrl" Label="PyTorch CPU Index URL" Variant="Variant.Outlined" HelperText="Official PyTorch CPU index" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_settings.CpuPackageSpec" Label="Package Specification" Variant="Variant.Outlined" HelperText="Packages to install (e.g. torch torchvision torchaudio)" />
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </MudTabPanel>

    <!-- AI-Toolkit Engine & Updates Tab -->
    <MudTabPanel Text="AI-Toolkit Engine" Icon="@Icons.Material.Filled.Build">
        <div class="px-4 pb-4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-4" Style="background-color: rgba(137, 180, 250, 0.15); color: #89b4fa;">
                AI-Toolkit is LoRAMancer's primary training engine. You can clone, provision, and update it via Git into your isolated AMD ROCm/PyTorch .venv automatically below.
            </MudAlert>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Style="background-color: #11111b; border: 1px solid #313244; padding: 16px; border-radius: 8px;">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Engine Status</MudText>
                            @if (ToolkitSetup.IsInstalled()) {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Installed & Ready</MudChip>
                            } else {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Not Installed</MudChip>
                            }
                        </div>

                        <div style="font-size:0.8rem; color:#a6adc8;" class="mb-1">
                            Path: <code>@ToolkitSetup.GetInstallDirectory()</code>
                        </div>

                        @if (!string.IsNullOrEmpty(_toolkitCommit)) {
                            <div style="font-size:0.75rem; color:#89b4fa;" class="mb-3">
                                Commit: <code>@_toolkitCommit</code>
                            </div>
                        } else {
                            <div class="mb-3"></div>
                        }

                        <div class="d-flex gap-2">
                            @if (ToolkitSetup.IsInstalled()) {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Disabled="@(_isSettingUpToolkit || _isUpdatingToolkit)" OnClick="UpdateAiToolkitAsync">
                                    @(_isUpdatingToolkit ? "Updating AI-Toolkit..." : "Update AI-Toolkit (git pull)")
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@(_isSettingUpToolkit || _isUpdatingToolkit)" OnClick="AutoSetupAiToolkitAsync">
                                    Reinstall / Clean Setup
                                </MudButton>
                            } else {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Disabled="@(_isSettingUpToolkit || _isUpdatingToolkit)" OnClick="AutoSetupAiToolkitAsync">
                                    @(_isSettingUpToolkit ? "Setting Up AI-Toolkit..." : "Auto-Setup / Clone AI-Toolkit")
                                </MudButton>
                            }
                        </div>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_settings.AiToolkitRepoUrl" Label="Git Repository URL" Variant="Variant.Outlined" HelperText="Official or custom AI-Toolkit fork" Class="mb-3" />
                    <MudTextField @bind-Value="_settings.AiToolkitPath" Label="Custom Installation Directory (Optional)" Variant="Variant.Outlined" Placeholder="Leave blank for default (tools/ai-toolkit)" />
                </MudItem>

                @if (_toolkitLogs.Count > 0) {
                    <MudItem xs="12">
                        <div class="d-flex align-center justify-space-between mb-1">
                            <MudText Typo="Typo.subtitle2">Setup & Update Telemetry Log</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => _toolkitLogs.Clear())">Clear Log</MudButton>
                        </div>
                        <div class="terminal-window p-3" style="height: 240px; overflow-y: auto;">
                            @foreach (var log in _toolkitLogs) {
                                <div class="terminal-line">@log</div>
                            }
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>
    </MudTabPanel>

    <!-- User Profile & API Keys Tab -->
    <MudTabPanel Text="User Profile & API Keys" Icon="@Icons.Material.Filled.Person">
        <div class="px-4 pb-4">
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mb-4" Style="background-color: rgba(137, 180, 250, 0.1); border-color: #89b4fa; color: #cdd6f4;">
                <MudIcon Icon="@Icons.Material.Filled.FolderShared" Size="Size.Small" Class="mr-2" />
                All profile data, API keys, and application configurations are saved in your user profile: <code>@Settings.SettingsFilePath</code>. Nothing is committed or stored in the repository.
            </MudAlert>

            <MudGrid>
                <!-- User Profile Info -->
                <MudItem xs="12">
                    <MudCard Elevation="0" Style="background-color: #11111b; border: 1px solid #313244; padding: 16px; border-radius: 8px;">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">User Profile Information</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                            Personalize your local instance and training metadata. Stored locally in <code>~/.loramancer/</code>.
                        </MudText>

                        <div class="d-flex gap-4">
                            <MudTextField @bind-Value="_settings.UserDisplayName" Label="Display Name / Author" Placeholder="e.g. PromptAlchemist" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1;" />
                            <MudTextField @bind-Value="_settings.UserEmail" Label="User Email Address" Placeholder="e.g. user@example.com" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1;" />
                        </div>
                    </MudCard>
                </MudItem>

                <!-- HuggingFace Token -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Style="background-color: #11111b; border: 1px solid #313244; padding: 16px; border-radius: 8px; height: 100%;">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Token" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">HuggingFace Settings</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                            Required to download gated base models (e.g. <b>FLUX.1-dev</b>) and push LoRA checkpoints.
                        </MudText>

                        <MudTextField @bind-Value="_settings.HuggingFaceToken" Label="Hugging Face User Access Token" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                        <MudTextField @bind-Value="_settings.HfHomeCachePath" Label="Custom HF_HOME Cache Path (Optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.VerifiedUser" Disabled="_isValidatingHf" OnClick="ValidateHfTokenAsync">
                                @(_isValidatingHf ? "Verifying..." : "Verify Token")
                            </MudButton>
                            @if (!string.IsNullOrEmpty(_hfValidationMessage)) {
                                <MudChip T="string" Size="Size.Small" Color="@(_hfTokenValid ? Color.Success : Color.Error)">
                                    @_hfValidationMessage
                                </MudChip>
                            }
                        </div>
                    </MudCard>
                </MudItem>

                <!-- Civitai API Key -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Style="background-color: #11111b; border: 1px solid #313244; padding: 16px; border-radius: 8px; height: 100%;">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Secondary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Civitai Integration</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                            Used for instant hash lookups of donor LoRAs to fetch trigger words, preview thumbnails, and sample prompts.
                        </MudText>

                        <MudTextField @bind-Value="_settings.CivitaiApiKey" Label="Civitai API Key (Optional for private models)" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Style="font-size:0.8rem; color:#a6adc8;">
                            Public models on Civitai can be inspected without a key; adding your key enables higher rate limits and access to your private models.
                        </MudAlert>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </div>
    </MudTabPanel>

    <!-- Remote Server & Worker Tab -->
    <MudTabPanel Text="Remote Server & Worker" Icon="@Icons.Material.Filled.Dns">
        <div class="px-4 pb-4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-4" Style="background-color: rgba(203, 166, 247, 0.15); color: #cba6f7;">
                Enable your AI PC as a Network Server so Linux PCs, Macs, and tablets can access the full LoRAMancer UI in their web browser with zero installation, or connect from another Windows PC in Remote Client mode.
            </MudAlert>

            <MudGrid>
                <!-- Host Server Mode (AI PC) -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Style="background-color: #11111b; border: 1px solid #313244; padding: 16px; border-radius: 8px; height: 100%;">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Router" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Host Engine & Web UI</MudText>
                            </div>
                            <div class="d-flex gap-1">
                                @if (NetworkServer.IsRunning) {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Port @_settings.ServerPort</MudChip>
                                    @if (!string.IsNullOrWhiteSpace(NetworkServer.PublicInternetUrl)) {
                                        <MudChip T="string" Color="Color.Tertiary" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Public">Internet Live</MudChip>
                                    }
                                } else {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">Stopped</MudChip>
                                }
                            </div>
                        </div>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                            Hosts the training venv, hardware GPU runner, embedded web server, and Progressive Web App (PWA).
                        </MudText>

                        <MudSwitch @bind-Value="_settings.ServerEnabled" Label="Enable Network Server & Web View" Color="Color.Primary" Class="mb-2" />

                        <div class="d-flex gap-3 mb-2">
                            <MudTextField @bind-Value="_settings.ServerPort" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 120px;" />
                            <MudTextField @bind-Value="_settings.ServerBindAddress" Label="Bind IP" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="0.0.0.0 for LAN, 127.0.0.1 for local" Style="flex: 1;" />
                        </div>

                        <div class="d-flex align-center gap-2 mb-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Security" OnClick="ConfigureWindowsFirewallAsync" Disabled="_isConfiguringFirewall">
                                @(_isConfiguringFirewall ? "Configuring Firewall..." : "Auto-Configure Windows Firewall")
                            </MudButton>
                            @if (!string.IsNullOrEmpty(_firewallStatusMessage)) {
                                <MudChip T="string" Size="Size.Small" Color="@(_firewallSuccess ? Color.Success : Color.Warning)">
                                    @_firewallStatusMessage
                                </MudChip>
                            }
                        </div>

                        <div class="d-flex gap-3 mb-2">
                            <MudTextField @bind-Value="_settings.ServerAccessToken" Label="Auth Token" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Secret key required for all incoming connections" Style="flex: 1;" />
                            <MudSwitch @bind-Value="_settings.RequireAuthForWebAccess" Label="Strict Auth (Deny Missing Token)" Color="Color.Error" Class="mt-1" />
                        </div>

                        <MudText Typo="Typo.caption" Style="color: #f38ba8;" Class="d-block mb-2">
                            🔒 <strong>Strict Token Enforcement:</strong> Every request without this token (via Bearer header, <code>?token=</code> query, or session cookie) is immediately denied with HTTP 401 Unauthorized.
                        </MudText>

                        <MudDivider Class="my-2" />

                        <MudText Typo="Typo.subtitle2" Class="mb-1" Style="font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" Class="mr-1" /> External / Custom Server Setup (WAN)
                        </MudText>

                        <MudTextField @bind-Value="_settings.PublicCustomDomainUrl" Label="Custom Server / Domain URL (Optional)" Placeholder="e.g. https://lora.yourdomain.com or http://192.168.1.150:8420" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Your own server domain, reverse proxy (Nginx, Caddy), or static WAN IP" Class="mb-2" />

                        <MudExpansionPanels Dense="true" Elevation="0" Class="mb-2">
                            <MudExpansionPanel Text="Cloudflare Quick Tunnel (Alternative for automatic HTTPS without domain)">
                                <MudSwitch @bind-Value="_settings.EnablePublicInternetTunnel" Label="Use Temporary Cloudflare Quick Tunnel" Color="Color.Tertiary" />
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        @if (NetworkServer.IsRunning) {
                            var displayUrl = !string.IsNullOrWhiteSpace(_settings.PublicCustomDomainUrl) 
                                ? _settings.PublicCustomDomainUrl 
                                : (!string.IsNullOrWhiteSpace(NetworkServer.PublicInternetUrl) ? NetworkServer.PublicInternetUrl : NetworkServer.ListeningUrl);

                            <div class="d-flex align-center justify-space-between p-2 mb-3" style="background: rgba(203, 166, 247, 0.1); border: 1px solid #cba6f7; border-radius: 6px;">
                                <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 80%;">
                                    <MudText Typo="Typo.caption" Color="Color.Tertiary" Style="font-weight: 700;">CONNECT URL:</MudText>
                                    <MudText Typo="Typo.body2" Style="font-family: monospace; color: #fff;">@displayUrl</MudText>
                                </div>
                                <MudTooltip Text="Copy Connect URL">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Tertiary" OnClick="@(() => CopyUrlToClipboard(displayUrl))" />
                                </MudTooltip>
                            </div>
                        }

                        <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3" Style="background-color: rgba(166, 227, 161, 0.08); color: #a6e3a1; font-size: 0.78rem;">
                            📲 <strong>Installable Web App (PWA):</strong> Open your server URL in any browser on Linux, Mac, Android, or iOS. Tap "Install App" or "Add to Home Screen" to install LoRAMancer as a standalone application.
                        </MudAlert>

                        <div class="d-flex align-center gap-2">
                            @if (NetworkServer.IsRunning) {
                                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopServerAsync">
                                    Stop Server
                                </MudButton>
                            } else {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartServerAsync">
                                    Start Server Now
                                </MudButton>
                            }
                        </div>
                    </MudCard>
                </MudItem>

                <!-- Remote Client Mode (Second PC) -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Style="background-color: #11111b; border: 1px solid #313244; padding: 16px; border-radius: 8px; height: 100%;">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Secondary" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Remote Client Mode</MudText>
                            </div>
                            @if (_settings.ClientRemoteMode) {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">Remote Mode Active</MudChip>
                            } else {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">Local Hardware Mode</MudChip>
                            }
                        </div>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                            Connect this Windows app to your AI PC over the network. Datasets and commands are dispatched remotely.
                        </MudText>

                        <MudSwitch @bind-Value="_settings.ClientRemoteMode" Label="Connect to Remote AI PC" Color="Color.Secondary" Class="mb-2" />
                        <MudTextField @bind-Value="_settings.ClientRemoteHostUrl" Label="Remote AI PC URL" Placeholder="http://192.168.1.150:8420" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                        <MudTextField @bind-Value="_settings.ClientRemoteAccessToken" Label="Remote Access Token / PIN" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.NetworkCheck" Disabled="_isTestingRemoteHost" OnClick="TestRemoteHostAsync">
                                @(_isTestingRemoteHost ? "Connecting..." : "Test Connection")
                            </MudButton>
                            @if (!string.IsNullOrEmpty(_remoteHostStatusMessage)) {
                                <MudChip T="string" Size="Size.Small" Color="@(_remoteHostReachable ? Color.Success : Color.Error)">
                                    @_remoteHostStatusMessage
                                </MudChip>
                            }
                        </div>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </div>
    </MudTabPanel>

    <!-- General Preferences Tab -->
    <MudTabPanel Text="General & Paths" Icon="@Icons.Material.Filled.Tune">
        <div class="px-4 pb-4">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_settings.PreferredPythonPath" Label="Preferred Python Executable" Variant="Variant.Outlined" HelperText="Name on PATH or full path to python.exe (Python 3.12+ required)" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_settings.UpdateManifestUrl" Label="Auto-Update Manifest URL" Variant="Variant.Outlined" HelperText="Remote endpoint serving version.json updates" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Default Checkpoints Output Directory</MudText>
                    <div class="d-flex align-center gap-2">
                        <MudTextField @bind-Value="_settings.DefaultOutputDirectory" ReadOnly="true" Variant="Variant.Outlined" Placeholder="Select default LoRA export directory..." FullWidth="true" />
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="BrowseOutputFolderAsync">
                            Browse...
                        </MudButton>
                    </div>
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_settings.AutoCheckUpdatesOnStartup" Label="Check for updates automatically on application startup" Color="Color.Primary" />
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_settings.MinimizeToTrayOnClose" Label="Run in system tray on close (keep application active in background notification area)" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </div>
    </MudTabPanel>

    <!-- Appearance & Themes Tab -->
    <MudTabPanel Text="Appearance & Themes" Icon="@Icons.Material.Filled.Palette">
        <div class="px-4 pb-4">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: var(--text-primary);">Theme Engine</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Select from built-in high contrast dark/light palettes or import/export custom JSON themes</MudText>
                </div>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.FileDownload" Size="Size.Small" OnClick="OpenImportThemeDialog">
                        Import Theme (JSON)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="ExportCurrentTheme">
                        Export Current Theme
                    </MudButton>
                </div>
            </div>

            @if (_showImportThemeModal) {
                <MudCard Elevation="0" Class="pa-4 mb-4" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--accent-purple); border-radius: 8px;">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: var(--accent-purple);">Import Custom Theme (JSON)</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _showImportThemeModal = false)" />
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Choose a <code style="color: var(--accent-purple);">.json</code> theme file from disk or paste valid theme JSON below.
                    </MudText>
                    <div class="d-flex gap-2 mb-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="ImportThemeFromFileAsync">
                            Pick .json File...
                        </MudButton>
                    </div>
                    <MudTextField @bind-Value="_importThemeJsonText" Label="Or Paste Theme JSON Content" Variant="Variant.Outlined" Lines="4" Margin="Margin.Dense" Placeholder="{ &quot;name&quot;: &quot;My Custom Theme&quot;, &quot;isDark&quot;: true, ... }" Class="mb-3" />
                    <div class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="@(() => _showImportThemeModal = false)">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" OnClick="ImportThemeFromText">Import & Activate</MudButton>
                    </div>
                </MudCard>
            }

            <MudGrid>
                @foreach (var theme in ThemeService.AvailableThemes) {
                    bool isActive = string.Equals(ThemeManager.CurrentThemeId, theme.Id, StringComparison.OrdinalIgnoreCase);
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="isActive ? 3 : 0" Class="theme-preview-card pa-3 h-100 d-flex flex-column justify-space-between" Style="@($"background-color: {theme.Surface}; border: {(isActive ? "2px solid " + theme.Primary : "1px solid " + theme.Border)}; border-radius: 10px; transition: all 0.2s ease;")">
                            <div>
                                <div class="d-flex align-center justify-space-between mb-2">
                                    <div class="d-flex align-center gap-1">
                                        <MudText Typo="Typo.subtitle1" Style="@($"font-weight: 700; color: {theme.TextPrimary};")">
                                            @theme.Name
                                        </MudText>
                                        @if (theme.IsCustom) {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined" Class="ml-1" Style="font-size: 0.65rem;">Custom</MudChip>
                                        }
                                    </div>
                                    @if (isActive) {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Active</MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Style="@($"color: {theme.TextSecondary};")" Class="mb-3 d-block">
                                    @theme.Description
                                </MudText>

                                <!-- Color Swatches Preview -->
                                <div class="d-flex align-center gap-2 mb-3">
                                    <div style="@($"width: 22px; height: 22px; border-radius: 6px; background-color: {theme.Primary}; border: 1px solid rgba(255,255,255,0.2);")" title="Primary Accent"></div>
                                    <div style="@($"width: 22px; height: 22px; border-radius: 6px; background-color: {theme.Secondary}; border: 1px solid rgba(255,255,255,0.2);")" title="Secondary Accent"></div>
                                    <div style="@($"width: 22px; height: 22px; border-radius: 6px; background-color: {theme.Tertiary}; border: 1px solid rgba(255,255,255,0.2);")" title="Tertiary Accent"></div>
                                    <div style="@($"width: 22px; height: 22px; border-radius: 6px; background-color: {theme.Background}; border: 1px solid {theme.Border};")" title="Background"></div>
                                    <div style="@($"width: 22px; height: 22px; border-radius: 6px; background-color: {theme.Surface}; border: 1px solid {theme.Border};")" title="Surface"></div>
                                </div>
                            </div>

                            <div class="d-flex align-center gap-2 mt-2">
                                <MudButton Variant="@(isActive ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" Style="flex: 1;" OnClick="@(() => SelectTheme(theme.Id))">
                                    @(isActive ? "Current Theme" : "Apply Theme")
                                </MudButton>
                                <MudTooltip Text="Copy Theme JSON">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => ExportTheme(theme.Id))" />
                                </MudTooltip>
                                @if (theme.IsCustom) {
                                    <MudTooltip Text="Delete Custom Theme">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteTheme(theme.Id))" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </div>
    </MudTabPanel>

    <!-- Auth Token Manager Tab -->
    <MudTabPanel Text="Auth Tokens" Icon="@Icons.Material.Filled.VpnKey">
        <div class="px-4 pb-4">
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mb-4" Style="background-color: rgba(203, 166, 247, 0.08); border-color: #313244; color: #cdd6f4;">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #cba6f7;">Core Authentication & API Token Manager</MudText>
                        <MudText Typo="Typo.caption" Style="color: #a6adc8;">
                            Issue and manage access tokens for remote web clients, background workers, and automation scripts. Tokens are always visible in plain text to administrators.
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateTokenCard">
                        Issue New Token
                    </MudButton>
                </div>
            </MudAlert>

            <!-- Stats Bar -->
            <MudGrid Class="mb-4">
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Tokens</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #cdd6f4;">@_tokenList.Count</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Active Tokens</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #a6e3a1;">@_tokenList.Count(t => t.IsActive)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Blocked Tokens</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #f38ba8;">@_tokenList.Count(t => t.IsBlocked)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Auth Events</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #89b4fa;">@_tokenList.Sum(t => t.UsageCount)</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_showCreateTokenCard) {
                <MudCard Elevation="2" Class="mb-4 pa-4" Style="background-color: #1e1e2e; border: 1px solid #45475a; border-radius: 8px;">
                    <div class="d-flex align-center justify-space-between mb-3">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #cba6f7;">
                            <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" Class="mr-1" />
                            Create Authentication Token
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Inherit" OnClick="@(() => _showCreateTokenCard = false)" />
                    </div>

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_newTokenName" Label="Client / Assignee Name *" Variant="Variant.Outlined" Placeholder="e.g. Remote Laptop, Alice, Automated Pipeline" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect @bind-Value="_newTokenRole" Label="Role / Permissions" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("Admin")">Admin (Full Control)</MudSelectItem>
                                <MudSelectItem Value="@("Trainer")">Trainer (Jobs & Datasets)</MudSelectItem>
                                <MudSelectItem Value="@("ReadOnly")">ReadOnly (Monitor Only)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect @bind-Value="_newTokenExpiryPreset" Label="Expiration" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("never")">Never Expires</MudSelectItem>
                                <MudSelectItem Value="@("7days")">7 Days</MudSelectItem>
                                <MudSelectItem Value="@("30days")">30 Days</MudSelectItem>
                                <MudSelectItem Value="@("90days")">90 Days</MudSelectItem>
                                <MudSelectItem Value="@("1year")">1 Year</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="8">
                            <div class="d-flex align-center gap-2">
                                <MudTextField @bind-Value="_newTokenSecret" Label="Token Secret (Leave empty to auto-generate secure lrm_...)" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Style="font-family: 'JetBrains Mono', monospace;" />
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="GenerateTokenValue">
                                    Generate
                                </MudButton>
                            </div>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_newTokenDescription" Label="Notes / Description" Variant="Variant.Outlined" Placeholder="Optional context or deployment notes" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end gap-2 mt-2">
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => _showCreateTokenCard = false)">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="ConfirmCreateToken">
                                Create & Save Token
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudCard>
            }

            <!-- Tokens Filter & Search -->
            <div class="d-flex align-center justify-space-between gap-3 mb-3 flex-wrap">
                <MudTextField @bind-Value="_tokenSearchQuery" Placeholder="Search tokens by name, secret, or role..." Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width: 400px;" />
                <div class="d-flex gap-2">
                    <MudChip T="string" Color="@(_statusFilter == "all" ? Color.Primary : Color.Dark)" Variant="@(_statusFilter == "all" ? Variant.Filled : Variant.Outlined)" Size="Size.Small" OnClick="@(() => _statusFilter = "all")">All</MudChip>
                    <MudChip T="string" Color="@(_statusFilter == "active" ? Color.Success : Color.Dark)" Variant="@(_statusFilter == "active" ? Variant.Filled : Variant.Outlined)" Size="Size.Small" OnClick="@(() => _statusFilter = "active")">Active</MudChip>
                    <MudChip T="string" Color="@(_statusFilter == "blocked" ? Color.Error : Color.Dark)" Variant="@(_statusFilter == "blocked" ? Variant.Filled : Variant.Outlined)" Size="Size.Small" OnClick="@(() => _statusFilter = "blocked")">Blocked</MudChip>
                </div>
            </div>

            <!-- Token History Table -->
            <MudTable Items="@FilteredTokens" Dense="true" Hover="true" Elevation="0" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                <HeaderContent>
                    <MudTh>Auth Token (Plain Text)</MudTh>
                    <MudTh>Client / Name</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Created</MudTh>
                    <MudTh>Last Used</MudTh>
                    <MudTh>Usage</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Auth Token">
                        <div class="d-flex align-center gap-1">
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #89b4fa; background-color: #181825; padding: 3px 8px; border-radius: 4px; border: 1px solid #313244; word-break: break-all;">
                                @context.Token
                            </span>
                            <MudTooltip Text="Copy auth token to clipboard">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Inherit" OnClick="@(() => CopyTokenAsync(context.Token))" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Name">
                        <div style="font-weight: 600; color: #cdd6f4;">@context.Name</div>
                        @if (!string.IsNullOrWhiteSpace(context.Description)) {
                            <div style="font-size: 0.75rem; color: #a6adc8;">@context.Description</div>
                        }
                    </MudTd>
                    <MudTd DataLabel="Role">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.Role == "Admin" ? Color.Primary : context.Role == "Trainer" ? Color.Secondary : Color.Dark)">
                            @context.Role
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsBlocked) {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Blocked</MudChip>
                        } else if (context.IsExpired) {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Expired</MudChip>
                        } else {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Active</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Created">
                        <div style="font-size: 0.8rem; color: #a6adc8;">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    </MudTd>
                    <MudTd DataLabel="Last Used">
                        <div style="font-size: 0.8rem; color: #a6adc8;">@(context.LastUsedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</div>
                    </MudTd>
                    <MudTd DataLabel="Usage">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                            @context.UsageCount hits
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <div class="d-flex justify-end gap-1">
                            @if (context.IsBlocked) {
                                <MudTooltip Text="Unblock Token (Allow Access)">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => UnblockToken(context))" />
                                </MudTooltip>
                            } else {
                                <MudTooltip Text="Block Token (Revoke Access)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Warning" Size="Size.Small" OnClick="@(() => BlockToken(context))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="Delete Token Permanently">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteToken(context))" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4 text-center text-secondary">
                        No authentication tokens found. Click "Issue New Token" to create one.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudTabPanel>
</MudTabs>

@code {
    private AppSettings _settings = new();
    private bool _isTestingUrls;
    private readonly Dictionary<string, (bool Reachable, string Message)> _urlStatuses = new();

    private bool _isSettingUpToolkit;
    private bool _isUpdatingToolkit;
    private string _toolkitCommit = string.Empty;
    private readonly List<string> _toolkitLogs = new();

    private bool _isValidatingHf;
    private bool _hfTokenValid;
    private string _hfValidationMessage = string.Empty;

    // Auth Token Management State
    private List<AuthToken> _tokenList = new();
    private bool _showCreateTokenCard;
    private string _newTokenName = string.Empty;
    private string _newTokenRole = "Admin";
    private string _newTokenExpiryPreset = "never";
    private string _newTokenSecret = string.Empty;
    private string _newTokenDescription = string.Empty;
    private string _tokenSearchQuery = string.Empty;
    private string _statusFilter = "all";

    private IEnumerable<AuthToken> FilteredTokens => _tokenList.Where(t => {
        if (_statusFilter == "active" && !t.IsActive) {
            return false;
        }
        if (_statusFilter == "blocked" && !t.IsBlocked) {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_tokenSearchQuery)) {
            string q = _tokenSearchQuery.Trim();
            return t.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                   t.Token.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                   t.Role.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                   t.Description.Contains(q, StringComparison.OrdinalIgnoreCase);
        }
        return true;
    });

    protected override async Task OnInitializedAsync() {
        _settings = Settings.Current;
        if (ToolkitSetup.IsInstalled()) {
            _toolkitCommit = await ToolkitSetup.GetCurrentCommitAsync();
        }

        LoadTokensFromService();
        TokenManager.OnTokensChanged += OnTokensChangedHandler;
    }

    public void Dispose() {
        TokenManager.OnTokensChanged -= OnTokensChangedHandler;
    }

    private void OnTokensChangedHandler() {
        _ = InvokeAsync(() => {
            LoadTokensFromService();
            StateHasChanged();
        });
    }

    private void LoadTokensFromService() {
        _tokenList = TokenManager.GetAllTokens().ToList();
    }

    private void OpenCreateTokenCard() {
        _showCreateTokenCard = true;
        _newTokenSecret = AuthTokenManagerService.GenerateSecureToken();
        _newTokenName = string.Empty;
        _newTokenDescription = string.Empty;
        _newTokenRole = "Admin";
        _newTokenExpiryPreset = "never";
    }

    private void GenerateTokenValue() {
        _newTokenSecret = AuthTokenManagerService.GenerateSecureToken();
    }

    private void ConfirmCreateToken() {
        if (string.IsNullOrWhiteSpace(_newTokenName)) {
            Snackbar.Add("Please enter a client or assignee name for this token.", Severity.Warning);
            return;
        }

        DateTimeOffset? expiresAt = _newTokenExpiryPreset switch {
            "7days" => DateTimeOffset.UtcNow.AddDays(7),
            "30days" => DateTimeOffset.UtcNow.AddDays(30),
            "90days" => DateTimeOffset.UtcNow.AddDays(90),
            "1year" => DateTimeOffset.UtcNow.AddYears(1),
            _ => null
        };

        try {
            TokenManager.CreateToken(
                _newTokenName,
                string.IsNullOrWhiteSpace(_newTokenSecret) ? null : _newTokenSecret,
                _newTokenRole,
                _newTokenDescription,
                expiresAt
            );
            _showCreateTokenCard = false;
            Snackbar.Add($"Auth token '{_newTokenName}' created successfully!", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to create token: {ex.Message}", Severity.Error);
        }
    }

    private async Task CopyTokenAsync(string token) {
        if (!string.IsNullOrWhiteSpace(token)) {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(token);
            Snackbar.Add("Auth token copied to clipboard!", Severity.Success);
        }
    }

    private void BlockToken(AuthToken token) {
        TokenManager.BlockToken(token.Id);
        Snackbar.Add($"Token '{token.Name}' has been blocked.", Severity.Warning);
    }

    private void UnblockToken(AuthToken token) {
        TokenManager.UnblockToken(token.Id);
        Snackbar.Add($"Token '{token.Name}' has been unblocked.", Severity.Success);
    }

    private void DeleteToken(AuthToken token) {
        TokenManager.DeleteToken(token.Id);
        Snackbar.Add($"Token '{token.Name}' has been removed.", Severity.Info);
    }

    private void ResetAmdDefaults() {
        _settings.ResetAmdToDefault();
        Snackbar.Add("Reset AMD ROCm settings to official defaults.", Severity.Info);
    }

    private void ResetNvidiaDefaults() {
        _settings.ResetNvidiaToDefault();
        Snackbar.Add("Reset NVIDIA CUDA settings to official defaults.", Severity.Info);
    }

    private void ResetIntelDefaults() {
        _settings.ResetIntelToDefault();
        Snackbar.Add("Reset Intel XPU settings to official defaults.", Severity.Info);
    }

    private void ResetCpuDefaults() {
        _settings.ResetCpuToDefault();
        Snackbar.Add("Reset CPU settings to official defaults.", Severity.Info);
    }

    private bool _showImportThemeModal;
    private string _importThemeJsonText = string.Empty;

    private void OpenImportThemeDialog() {
        _showImportThemeModal = !_showImportThemeModal;
    }

    private async Task ImportThemeFromFileAsync() {
        try {
            FilePickerFileType jsonType = new(new Dictionary<DevicePlatform, IEnumerable<string>> {
                { DevicePlatform.WinUI, new[] { ".json" } }
            });
            var result = await FilePicker.Default.PickAsync(new PickOptions {
                PickerTitle = "Select Theme JSON file",
                FileTypes = jsonType
            });
            if (result != null) {
                string json = await File.ReadAllTextAsync(result.FullPath);
                if (ThemeManager.ImportTheme(json, out var imported, out var err)) {
                    _settings.ThemePreset = imported!.Id;
                    _showImportThemeModal = false;
                    _importThemeJsonText = string.Empty;
                    Snackbar.Add($"Theme '{imported.Name}' imported and activated!", Severity.Success);
                } else {
                    Snackbar.Add(err ?? "Failed to import theme.", Severity.Error);
                }
            }
        } catch (Exception ex) {
            Snackbar.Add($"Error reading theme file: {ex.Message}", Severity.Error);
        }
    }

    private void ImportThemeFromText() {
        if (string.IsNullOrWhiteSpace(_importThemeJsonText)) {
            Snackbar.Add("Please paste theme JSON content first.", Severity.Warning);
            return;
        }

        if (ThemeManager.ImportTheme(_importThemeJsonText, out var imported, out var err)) {
            _settings.ThemePreset = imported!.Id;
            _showImportThemeModal = false;
            _importThemeJsonText = string.Empty;
            Snackbar.Add($"Theme '{imported.Name}' imported and activated!", Severity.Success);
        } else {
            Snackbar.Add(err ?? "Invalid theme JSON structure.", Severity.Error);
        }
    }

    private async Task ExportCurrentTheme() {
        await ExportTheme(ThemeManager.CurrentThemeId);
    }

    private async Task ExportTheme(string themeId) {
        string json = ThemeManager.ExportTheme(themeId);
        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(json);
        Snackbar.Add($"Theme JSON copied to clipboard!", Severity.Success);
    }

    private void DeleteTheme(string themeId) {
        if (ThemeManager.DeleteCustomTheme(themeId)) {
            _settings.ThemePreset = ThemeManager.CurrentThemeId;
            Snackbar.Add("Custom theme removed.", Severity.Info);
        }
    }

    private void SelectTheme(string themeId) {
        ThemeManager.SetTheme(themeId);
        _settings.ThemePreset = themeId;
        Snackbar.Add($"Theme switched to '{ThemeManager.CurrentTheme.Name}'!", Severity.Success);
    }

    private void AutoGenerateUrls() {
        _settings.UpdateFromBaseUrl(_settings.RocmBaseUrl, _settings.PyTorchVersion);
        Snackbar.Add("Updated wheel URLs from Base URL & Version!", Severity.Success);
    }

    private async Task TestSingleUrlAsync(string url, string key) {
        Snackbar.Add($"Testing reachability of {key}...", Severity.Info);
        var result = await Settings.TestWheelUrlAsync(url);
        _urlStatuses[key] = (result.Reachable, result.StatusMessage);
        StateHasChanged();
    }

    private async Task TestAllWheelUrlsAsync() {
        _isTestingUrls = true;
        try {
            await TestSingleUrlAsync(_settings.TorchWheelUrl, "torch");
            await TestSingleUrlAsync(_settings.TorchVisionWheelUrl, "torchvision");
            await TestSingleUrlAsync(_settings.TorchAudioWheelUrl, "torchaudio");
            Snackbar.Add("All links tested.", Severity.Info);
        } finally {
            _isTestingUrls = false;
        }
    }

    private void AddSdkWheel() {
        _settings.RocmSdkWheels.Add(string.Empty);
    }

    private void RemoveSdkWheel(int index) {
        if (index >= 0 && index < _settings.RocmSdkWheels.Count) {
            _settings.RocmSdkWheels.RemoveAt(index);
        }
    }

    private async Task UpdateAiToolkitAsync() {
        _isUpdatingToolkit = true;
        _toolkitLogs.Clear();
        _toolkitLogs.Add("[LoRAMancer] Updating AI-Toolkit via Git...");

        try {
            string venvPath = Path.Combine(Directory.GetCurrentDirectory(), ".venv");
            await ToolkitSetup.UpdateAiToolkitAsync(venvPath, line => {
                InvokeAsync(() => {
                    _toolkitLogs.Add(line);
                    StateHasChanged();
                });
            });
            _toolkitCommit = await ToolkitSetup.GetCurrentCommitAsync();
            Snackbar.Add("AI-Toolkit updated to latest version!", Severity.Success);
        } catch (Exception ex) {
            _toolkitLogs.Add($"[ERROR] {ex.Message}");
            Snackbar.Add($"AI-Toolkit update failed: {ex.Message}", Severity.Error);
        } finally {
            _isUpdatingToolkit = false;
        }
    }

    private async Task AutoSetupAiToolkitAsync() {
        _isSettingUpToolkit = true;
        _toolkitLogs.Clear();
        _toolkitLogs.Add("[LoRAMancer] Initiating AI-Toolkit automated setup...");

        try {
            string venvPath = Path.Combine(Directory.GetCurrentDirectory(), ".venv");
            await ToolkitSetup.SetupAiToolkitAsync(venvPath, line => {
                InvokeAsync(() => {
                    _toolkitLogs.Add(line);
                    StateHasChanged();
                });
            });
            _toolkitCommit = await ToolkitSetup.GetCurrentCommitAsync();
            Snackbar.Add("AI-Toolkit setup completed successfully!", Severity.Success);
        } catch (Exception ex) {
            _toolkitLogs.Add($"[ERROR] {ex.Message}");
            Snackbar.Add($"AI-Toolkit setup failed: {ex.Message}", Severity.Error);
        } finally {
            _isSettingUpToolkit = false;
        }
    }

    private async Task ValidateHfTokenAsync() {
        _isValidatingHf = true;
        try {
            var (valid, user, details) = await HfService.ValidateTokenAsync(_settings.HuggingFaceToken);
            _hfTokenValid = valid;
            _hfValidationMessage = valid ? $"Verified: {user}" : details;
            Snackbar.Add(valid ? $"HuggingFace authenticated as {user}" : details, valid ? Severity.Success : Severity.Warning);
        } finally {
            _isValidatingHf = false;
        }
    }

    private async Task BrowseOutputFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select Default Output Directory");
        if (!string.IsNullOrEmpty(folder)) {
            _settings.DefaultOutputDirectory = folder;
        }
    }

    private async Task SaveSettingsAsync() {
        try {
            _settings.ThemePreset = ThemeManager.CurrentThemeId;
            await Settings.SaveSettingsAsync(_settings);
            Snackbar.Add("Settings saved successfully!", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to save settings: {ex.Message}", Severity.Error);
        }
    }

    private async Task ResetDefaultsAsync() {
        _settings = await Settings.ResetToDefaultsAsync();
        ThemeManager.SetTheme("dark-purple");
        _urlStatuses.Clear();
        _hfValidationMessage = string.Empty;
        Snackbar.Add("Settings reset to factory defaults.", Severity.Warning);
    }

    private bool _isTestingRemoteHost;
    private bool _remoteHostReachable;
    private string _remoteHostStatusMessage = string.Empty;

    private async Task StartServerAsync() {
        try {
            await NetworkServer.StartServerAsync(_settings.ServerPort, _settings.ServerBindAddress, _settings.ServerAccessToken);
            Snackbar.Add($"LoRAMancer Server listening at {NetworkServer.ListeningUrl}", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to start server: {ex.Message}", Severity.Error);
        }
    }

    private async Task StopServerAsync() {
        try {
            await NetworkServer.StopServerAsync();
            Snackbar.Add("LoRAMancer Server stopped.", Severity.Info);
        } catch (Exception ex) {
            Snackbar.Add($"Error stopping server: {ex.Message}", Severity.Error);
        }
    }

    private async Task CopyUrlToClipboard(string url) {
        if (!string.IsNullOrWhiteSpace(url)) {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(url);
            Snackbar.Add("Connect URL copied to clipboard!", Severity.Success);
        }
    }

    private async Task TestRemoteHostAsync() {
        _isTestingRemoteHost = true;
        _remoteHostStatusMessage = string.Empty;

        try {
            var health = await RemoteClient.CheckHealthAsync(_settings.ClientRemoteHostUrl, _settings.ClientRemoteAccessToken);
            if (health != null) {
                _remoteHostReachable = true;
                _remoteHostStatusMessage = $"Connected to {health.MachineName} ({health.Status})";
                Snackbar.Add($"Connected to AI PC: {health.MachineName} ({health.GpuInfo})", Severity.Success);
            } else {
                _remoteHostReachable = false;
                _remoteHostStatusMessage = "Connection failed";
                Snackbar.Add("Failed to reach remote LoRAMancer server. Check URL, port, and firewall.", Severity.Error);
            }
        } catch (Exception ex) {
            _remoteHostReachable = false;
            _remoteHostStatusMessage = ex.Message;
            Snackbar.Add($"Connection error: {ex.Message}", Severity.Error);
        } finally {
            _isTestingRemoteHost = false;
        }
    }

    private bool _isConfiguringFirewall = false;
    private bool _firewallSuccess = false;
    private string _firewallStatusMessage = string.Empty;

    private async Task ConfigureWindowsFirewallAsync() {
        _isConfiguringFirewall = true;
        _firewallStatusMessage = string.Empty;
        await InvokeAsync(StateHasChanged);

        try {
            var port = _settings.ServerPort;
            if (port <= 0 || port > 65535) {
                _firewallSuccess = false;
                _firewallStatusMessage = "Invalid port";
                Snackbar.Add("Please enter a valid port between 1 and 65535.", Severity.Error);
                return;
            }

            var ruleName = "LoRAMancer Web Server";
            var arguments = $"/c \"netsh advfirewall firewall delete rule name=\\\"{ruleName}\\\" & netsh advfirewall firewall add rule name=\\\"{ruleName}\\\" dir=in action=allow protocol=TCP localport={port} profile=any\"";

            var psi = new System.Diagnostics.ProcessStartInfo {
                FileName = "cmd.exe",
                Arguments = arguments,
                Verb = "runas",
                UseShellExecute = true,
                CreateNoWindow = true,
                WindowStyle = System.Diagnostics.ProcessWindowStyle.Hidden
            };

            using var process = System.Diagnostics.Process.Start(psi);
            if (process != null) {
                await process.WaitForExitAsync();
                if (process.ExitCode == 0) {
                    _firewallSuccess = true;
                    _firewallStatusMessage = $"Port {port} Allowed";
                    Snackbar.Add($"Windows Firewall rule created for port {port} (TCP).", Severity.Success);
                } else {
                    _firewallSuccess = false;
                    _firewallStatusMessage = $"Failed (code {process.ExitCode})";
                    Snackbar.Add($"Firewall command exited with code {process.ExitCode}.", Severity.Warning);
                }
            } else {
                _firewallSuccess = false;
                _firewallStatusMessage = "Could not start process";
            }
        } catch (System.ComponentModel.Win32Exception winEx) when (winEx.NativeErrorCode == 1223) {
            _firewallSuccess = false;
            _firewallStatusMessage = "UAC prompt cancelled";
            Snackbar.Add("Administrator elevation was cancelled. Firewall rule was not added.", Severity.Normal);
        } catch (Exception ex) {
            _firewallSuccess = false;
            _firewallStatusMessage = "Error adding rule";
            Snackbar.Add($"Failed to configure Windows Firewall: {ex.Message}", Severity.Error);
        } finally {
            _isConfiguringFirewall = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
