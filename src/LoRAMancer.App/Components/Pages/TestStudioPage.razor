@page "/test"
@using LoRAMancer.App.Engines
@using LoRAMancer.App.Models
@using LoRAMancer.App.Services
@implements IDisposable
@inject ModelArchitectureRegistry ArchitectureRegistry
@inject StudioSessionService StudioSession
@inject ComfyUiService ComfyUi
@inject NativeFileDialogService FileDialogService
@inject ModusFlowPromptService PromptService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Style="font-weight: 700;">STAGE 4</MudChip>
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--text-primary);">ComfyUI Inference &amp; Test Studio</MudText>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Direct WebSocket test rendering, trigger word activation testing, and checkpoint benchmark sweeps
        </MudText>
    </div>

    <div class="d-flex align-center gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Insights" OnClick="OpenBenchmarkDialogAsync">
            Benchmark Matrix
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SmartToy" OnClick="OpenComfyTestDialogAsync">
            Open Advanced Tester
        </MudButton>
    </div>
</div>

<!-- Active Session Context Banner -->
<MudCard Elevation="0" Class="pa-3 mb-4" Style="background-color: var(--bg-dark-surface, #181825); border: 1px solid var(--border-dark, #313244); border-radius: 8px;">
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div class="d-flex align-center gap-3 flex-wrap">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Color="Color.Primary" Size="Size.Small" />
                <span style="font-size: 0.85rem; color: #a6adc8;">Concept:</span>
                <span style="font-weight: 700; color: #cdd6f4;">@StudioSession.ProjectName</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(StudioSession.TriggerWord)) {
                <div class="d-flex align-center gap-2">
                    <span style="font-size: 0.85rem; color: #a6adc8;">Trigger:</span>
                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled">@StudioSession.TriggerWord</MudChip>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_activeLoraPath)) {
                <div class="d-flex align-center gap-2">
                    <span style="font-size: 0.85rem; color: #a6adc8;">LoRA:</span>
                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #89b4fa;">@Path.GetFileName(_activeLoraPath)</span>
                </div>
            }
        </div>

        <div class="d-flex align-center gap-2">
            <MudChip T="string" Size="Size.Small" Color="@(_isComfyOnline ? Color.Success : Color.Warning)" Variant="Variant.Outlined" Icon="@(_isComfyOnline ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)">
                @(_isComfyOnline ? "ComfyUI Connected (127.0.0.1:8188)" : "ComfyUI Offline")
            </MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Secondary" OnClick="CheckComfyConnectionAsync" />
        </div>
    </div>
</MudCard>

<MudGrid Spacing="3">
    <!-- Left Column: Test Prompt Controls -->
    <MudItem xs="12" md="6">
        <MudCard Elevation="1" Class="pa-4 h-100" Style="background-color: var(--bg-dark-surface, #181825); border: 1px solid var(--border-dark, #313244); border-radius: 8px;">
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4;" Class="mb-3">Test Inference Controls</MudText>

            <!-- Saved Prompt Selector -->
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-1">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Small" Color="Color.Info" />
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #89dceb; letter-spacing: 0.5px;">SAVED PROMPTS</MudText>
                </div>
                <div class="d-flex align-center gap-1">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.BookmarkAdd" OnClick="OpenSavePromptDialogAsync"
                               Disabled="_isRendering || (string.IsNullOrWhiteSpace(_prompt) && string.IsNullOrWhiteSpace(_negativePrompt))">
                        Save Preset
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenPromptManagerDialogAsync">
                        Manage
                    </MudButton>
                </div>
            </div>
            <MudSelect T="string" Value="_selectedSavedPromptName" ValueChanged="OnSavedPromptSelected"
                       Label="Load ModusFlow Preset" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       ShrinkLabel="true" Class="mb-3" Disabled="_isRendering">
                <MudSelectItem Value="@("")">-- Freeform Prompt (Select to load ModusFlow preset) --</MudSelectItem>
                @foreach (var p in _savedPrompts) {
                    <MudSelectItem Value="@p.Name">
                        @(!string.IsNullOrWhiteSpace(p.Category) ? $"[{p.Category}] " : "")@p.Name
                    </MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_prompt" Label="Positive Prompt" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" HelperText="LoRA trigger words are automatically inserted" Class="mb-3" />
            <MudTextField @bind-Value="_negativePrompt" Label="Negative Prompt" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mb-3" />

            <div class="d-flex align-center justify-space-between mb-1">
                <MudText Typo="Typo.caption">LoRA Strength Weight</MudText>
                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #89b4fa;">@_loraWeight.ToString("F2")</MudText>
            </div>
            <MudSlider @bind-Value="_loraWeight" Min="0.0" Max="2.0" Step="0.05" Color="Color.Primary" Class="mb-4" />

            <div class="d-flex gap-2 flex-wrap mb-4">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="InsertTriggerWord">
                    Insert Trigger Word
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FileOpen" OnClick="BrowseLoraAsync">
                    Select LoRA Model
                </MudButton>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" StartIcon="@Icons.Material.Filled.PlayArrow" FullWidth="true" OnClick="RenderTestImageAsync" Disabled="_isRendering || !_isComfyOnline">
                @(_isRendering ? "Rendering in ComfyUI..." : "Render Test Image")
            </MudButton>
        </MudCard>
    </MudItem>

    <!-- Right Column: Rendered Output Canvas -->
    <MudItem xs="12" md="6">
        <MudCard Elevation="1" Class="pa-4 h-100 d-flex flex-column text-center" Style="background-color: var(--bg-dark-surface, #181825); border: 1px solid var(--border-dark, #313244); border-radius: 8px; min-height: 440px;">
            @if (!string.IsNullOrWhiteSpace(_renderedImageBase64)) {
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2 pb-2" style="border-bottom: 1px solid var(--border-dark, #313244);">
                    <div class="d-flex align-center gap-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Rendered in @_renderDuration.TotalSeconds.ToString("F1")s</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Weight @_loraWeight.ToString("F2")</MudChip>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.Fullscreen" OnClick="@(() => _isLightboxOpen = true)">
                            Fullscreen
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SaveAlt" OnClick="SaveRenderedImageAsync">
                            Save
                        </MudButton>
                    </div>
                </div>

                <!-- Letterboxed Viewport with strict aspect ratio preservation -->
                <div style="flex: 1; display: flex; align-items: center; justify-content: center; background: #08090d; border-radius: 6px; padding: 12px; min-height: 340px; max-height: 520px; overflow: hidden;">
                    <img src="@_renderedImageBase64" 
                         alt="ComfyUI Test Render" 
                         style="display: block; margin: 0 auto; width: auto; height: auto; max-width: 100%; max-height: 500px; object-fit: contain; aspect-ratio: auto; border-radius: 6px; box-shadow: 0 4px 20px rgba(0,0,0,0.5); cursor: zoom-in;" 
                         @onclick="@(() => _isLightboxOpen = true)"
                         title="Click to view full screen" />
                </div>
            } else if (_isRendering) {
                <div class="d-flex flex-column align-center justify-center h-100" style="min-height: 380px;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Sending to ComfyUI Engine...</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Generating latent diffusion sample via WebSocket</MudText>
                </div>
            } else {
                <div class="d-flex flex-column align-center justify-center h-100" style="min-height: 380px;">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Secondary" Size="Size.Large" Class="mb-2" Style="font-size: 3rem;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #a6adc8;">No Test Image Rendered</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="max-width: 320px;">
                        Ensure ComfyUI is running, enter your prompt, and click Render Test Image to test your LoRA in real time.
                    </MudText>
                </div>
            }
        </MudCard>
    </MudItem>
</MudGrid>

@if (_isLightboxOpen && !string.IsNullOrWhiteSpace(_renderedImageBase64)) {
    <div style="position: fixed; inset: 0; z-index: 99999; background: rgba(5, 6, 10, 0.95); display: flex; flex-direction: column; backdrop-filter: blur(8px);">
        <div class="d-flex align-center justify-space-between px-4 py-3" style="border-bottom: 1px solid #313244; background: #11111b;">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cba6f7;">ComfyUI Render Inspection</MudText>
            </div>
            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SaveAlt" OnClick="SaveRenderedImageAsync">
                    Save Image
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Medium" Color="Color.Error" OnClick="@(() => _isLightboxOpen = false)" />
            </div>
        </div>
        <div style="flex: 1; overflow: auto; display: flex; align-items: center; justify-content: center; padding: 24px;">
            <img src="@_renderedImageBase64" 
                 alt="Full Inspection" 
                 style="display: block; margin: 0 auto; width: auto; height: auto; max-width: 90vw; max-height: 85vh; object-fit: contain; aspect-ratio: auto; border-radius: 6px; box-shadow: 0 8px 32px rgba(0,0,0,0.8);" />
        </div>
    </div>
}

@code {
    private string _activeLoraPath = "";
    private string _prompt = "masterpiece, best quality, solo portrait";
    private string _negativePrompt = "blurry, low quality, distorted, extra limbs";
    private double _loraWeight = 0.85;
    private bool _isComfyOnline;
    private bool _isRendering;
    private string? _renderedImageBase64;
    private TimeSpan _renderDuration;
    private bool _isLightboxOpen;

    protected override async Task OnInitializedAsync() {
        StudioSession.SetStage(StudioStage.Test);
        _activeLoraPath = StudioSession.ActiveLoraPath;

        if (!string.IsNullOrWhiteSpace(StudioSession.TriggerWord)) {
            _prompt = $"{StudioSession.TriggerWord}, {_prompt}";
        }

        PromptService.OnPromptsUpdated += OnPromptsUpdatedHandler;
        await LoadSavedPromptsAsync();
        await CheckComfyConnectionAsync();
    }

    private async Task CheckComfyConnectionAsync() {
        try {
            var status = await ComfyUi.CheckConnectionAsync();
            _isComfyOnline = status.IsConnected;
        } catch {
            _isComfyOnline = false;
        }
        StateHasChanged();
    }

    private void InsertTriggerWord() {
        if (!string.IsNullOrWhiteSpace(StudioSession.TriggerWord) && !_prompt.Contains(StudioSession.TriggerWord)) {
            _prompt = $"{StudioSession.TriggerWord}, {_prompt}";
            Snackbar.Add($"Inserted trigger word '{StudioSession.TriggerWord}'", Severity.Success);
        }
    }

    private async Task BrowseLoraAsync() {
        string? file = await FileDialogService.PickSafeTensorsFileAsync();
        if (!string.IsNullOrWhiteSpace(file) && File.Exists(file)) {
            _activeLoraPath = file;
            StudioSession.SetActiveLora(file);
            Snackbar.Add($"Selected LoRA: {Path.GetFileName(file)}", Severity.Success);
        }
    }

    private async Task RenderTestImageAsync() {
        if (!_isComfyOnline) {
            Snackbar.Add("ComfyUI server is offline (expected at http://127.0.0.1:8188).", Severity.Warning);
            return;
        }

        _isRendering = true;
        StateHasChanged();
        var sw = System.Diagnostics.Stopwatch.StartNew();

        try {
            var parameters = new DialogParameters<LoRAMancer.App.Components.Dialogs.ComfyUiTestDialog> {
                { x => x.LoraFilePath, _activeLoraPath },
                { x => x.LoraName, string.IsNullOrWhiteSpace(_activeLoraPath) ? "Active LoRA" : Path.GetFileNameWithoutExtension(_activeLoraPath) },
                { x => x.BaseArchitecture, GetEffectiveArchitecture() },
                { x => x.TriggerWords, StudioSession.TriggerWord },
                { x => x.Prompt, _prompt },
                { x => x.NegativePrompt, _negativePrompt },
                { x => x.LoraWeight, _loraWeight }
            };
            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            var dialog = await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.ComfyUiTestDialog>("ComfyUI Interactive Test Studio", parameters, options);
            var result = await dialog.Result;
            if (result != null && !result.Canceled) {
                if (result.Data is LoRAMancer.App.Components.Dialogs.ComfyUiTestDialog.ComfyUiTestDialogResult dialogResult) {
                    _prompt = dialogResult.Prompt;
                    _negativePrompt = dialogResult.NegativePrompt;
                    _loraWeight = dialogResult.LoraWeight;
                    if (!string.IsNullOrWhiteSpace(dialogResult.RenderedBase64Image)) {
                        _renderedImageBase64 = $"data:image/png;base64,{dialogResult.RenderedBase64Image}";
                    }
                } else if (result.Data is string imagePath && File.Exists(imagePath)) {
                    byte[] bytes = await File.ReadAllBytesAsync(imagePath);
                    _renderedImageBase64 = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
                }
            }
        } catch (Exception ex) {
            Snackbar.Add($"Render error: {ex.Message}", Severity.Error);
        } finally {
            sw.Stop();
            _renderDuration = sw.Elapsed;
            _isRendering = false;
            StateHasChanged();
        }
    }

    private async Task OpenComfyTestDialogAsync() {
        var parameters = new DialogParameters<LoRAMancer.App.Components.Dialogs.ComfyUiTestDialog> {
            { x => x.LoraFilePath, _activeLoraPath },
            { x => x.LoraName, string.IsNullOrWhiteSpace(_activeLoraPath) ? "Active LoRA" : Path.GetFileNameWithoutExtension(_activeLoraPath) },
            { x => x.BaseArchitecture, GetEffectiveArchitecture() },
            { x => x.TriggerWords, StudioSession.TriggerWord },
            { x => x.Prompt, _prompt },
            { x => x.NegativePrompt, _negativePrompt },
            { x => x.LoraWeight, _loraWeight }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.ComfyUiTestDialog>("ComfyUI Interactive Test Studio", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is LoRAMancer.App.Components.Dialogs.ComfyUiTestDialog.ComfyUiTestDialogResult dialogResult) {
            _prompt = dialogResult.Prompt;
            _negativePrompt = dialogResult.NegativePrompt;
            _loraWeight = dialogResult.LoraWeight;
            if (!string.IsNullOrWhiteSpace(dialogResult.RenderedBase64Image)) {
                _renderedImageBase64 = $"data:image/png;base64,{dialogResult.RenderedBase64Image}";
            }
            StateHasChanged();
        }
    }

    private async Task OpenBenchmarkDialogAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraBenchmarkDialog>("AI Benchmark Matrix & Sweet Spot Finder", options);
    }

    private string GetEffectiveArchitecture() {
        if (!string.IsNullOrWhiteSpace(StudioSession.BaseModel)) {
            return StudioSession.BaseModel;
        }
        if (!string.IsNullOrWhiteSpace(_activeLoraPath)) {
            var arch = ArchitectureRegistry.InferFromPathOrMetadata(_activeLoraPath, new Dictionary<string, string>());
            return arch?.DisplayName ?? "FLUX.1-dev";
        }
        return "FLUX.1-dev";
    }

    private async Task SaveRenderedImageAsync() {
        if (string.IsNullOrWhiteSpace(_renderedImageBase64)) {
            return;
        }

        try {
            string base64Data = _renderedImageBase64;
            int commaIdx = base64Data.IndexOf(',');
            if (commaIdx >= 0) {
                base64Data = base64Data[(commaIdx + 1)..];
            }

            byte[] bytes = Convert.FromBase64String(base64Data);
            string desktop = Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
            string safeName = string.Join("_", (Path.GetFileNameWithoutExtension(_activeLoraPath) ?? "render").Split(Path.GetInvalidFileNameChars()));
            string path = Path.Combine(desktop, $"{safeName}_{DateTime.Now:yyyyMMdd_HHmmss}.png");
            await File.WriteAllBytesAsync(path, bytes);
            Snackbar.Add($"Saved render to {path}", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to save image: {ex.Message}", Severity.Error);
        }
    }

    public void Dispose() {
        PromptService.OnPromptsUpdated -= OnPromptsUpdatedHandler;
    }

    private IReadOnlyList<ModusFlowPrompt> _savedPrompts = new List<ModusFlowPrompt>();
    private string _selectedSavedPromptName = string.Empty;

    private async Task LoadSavedPromptsAsync() {
        try {
            _savedPrompts = await PromptService.GetAllPromptsAsync();
        } catch {
            _savedPrompts = new List<ModusFlowPrompt>();
        }
    }

    private void OnPromptsUpdatedHandler() {
        _ = InvokeAsync(async () => {
            await LoadSavedPromptsAsync();
            StateHasChanged();
        });
    }

    private void OnSavedPromptSelected(string name) {
        _selectedSavedPromptName = name;
        if (string.IsNullOrWhiteSpace(name)) return;
        var match = _savedPrompts.FirstOrDefault(p => p.Name == name);
        if (match != null) {
            _prompt = match.Positive;
            _negativePrompt = match.Negative;
            Snackbar.Add($"Loaded prompt '{match.Name}'", Severity.Info);
        }
    }

    private async Task OpenSavePromptDialogAsync() {
        var parameters = new DialogParameters<SaveModusFlowPromptDialog> {
            { x => x.PositivePrompt, _prompt },
            { x => x.NegativePrompt, _negativePrompt },
            { x => x.InitialName, !string.IsNullOrWhiteSpace(StudioSession.ProjectName) ? $"{StudioSession.ProjectName} Preset" : "Prompt Preset" }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SaveModusFlowPromptDialog>("Save Prompt", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is ModusFlowPrompt saved) {
            await LoadSavedPromptsAsync();
            _selectedSavedPromptName = saved.Name;
        }
    }

    private async Task OpenPromptManagerDialogAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModusFlowPromptManagerDialog>("Saved Prompts", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is ModusFlowPrompt selected) {
            _prompt = selected.Positive;
            _negativePrompt = selected.Negative;
            _selectedSavedPromptName = selected.Name;
            Snackbar.Add($"Loaded prompt '{selected.Name}'", Severity.Info);
        }
        await LoadSavedPromptsAsync();
    }
}
