    public void Dispose() {
        _disposed = true;
        try {
            _cts.Cancel();
            _cts.Dispose();
        } catch { }
        LibraryService.OnLibraryUpdated -= HandleLibraryUpdated;
        LibraryService.OnLibrariesChanged -= HandleLibrariesChanged;
        LibraryService.OnScanProgress -= HandleScanProgress;
        LibraryService.OnScanStateChanged -= HandleScanStateChanged;
        LibraryService.OnEnrichStateChanged -= HandleEnrichStateChanged;
        LibraryService.OnEnrichProgress -= HandleEnrichProgress;
        LibraryService.OnLoraEnriched -= HandleLoraEnriched;
        UpdaterService.OnStateChanged -= HandleUpdaterStateChanged;
    }

