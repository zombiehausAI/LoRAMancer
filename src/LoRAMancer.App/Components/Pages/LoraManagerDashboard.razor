    protected override async Task OnInitializedAsync() {
        try {
            StudioSession.SetStage(StudioStage.Vault);
            try {
                ArchitectureRegistry.ScanAiToolkitInstallation();
            } catch {
                // Non-critical auto-discovery
            }
            LibraryService.OnLibraryUpdated += HandleLibraryUpdated;
            LibraryService.OnLibrariesChanged += HandleLibrariesChanged;
            LibraryService.OnScanProgress += HandleScanProgress;
            LibraryService.OnScanStateChanged += HandleScanStateChanged;
            LibraryService.OnEnrichStateChanged += HandleEnrichStateChanged;
            LibraryService.OnEnrichProgress += HandleEnrichProgress;
            LibraryService.OnLoraEnriched += HandleLoraEnriched;
            LibraryService.OnCategoriesChanged += HandleCategoriesChanged;
            LibraryService.OnCollectionsChanged += HandleCollectionsChanged;
            UpdaterService.OnStateChanged += HandleUpdaterStateChanged;

            // Directly sync from catalog database if items are not yet in memory
            if (LibraryService.Items.Count == 0) {
                await LibraryService.LoadFromDatabaseAsync();
            }
            await LibraryService.RefreshLibrariesAsync();

            UpdateFilteredList();
        } catch (Exception ex) {
            Snackbar.Add($"Library catalog notice: {ex.Message}", Severity.Warning);
        }
    }

