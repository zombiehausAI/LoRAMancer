    private async Task ToggleCollectionMembershipAsync(string collectionId, bool shouldBeMember) {
        if (_loraForCollections == null || string.IsNullOrWhiteSpace(_loraForCollections.FilePath)) {
            return;
        }
        if (shouldBeMember) {
            await LibraryService.AddLoraToCollectionAsync(collectionId, _loraForCollections.FilePath);
            _loraCollectionIds.Add(collectionId);
        } else {
            await LibraryService.RemoveLoraFromCollectionAsync(collectionId, _loraForCollections.FilePath);
            _loraCollectionIds.Remove(collectionId);
        }
        if (_selectedCollection != null && _selectedCollection.Id == collectionId) {
            await ReloadSelectedCollectionPathsAsync();
            UpdateFilteredList();
        }
        StateHasChanged();
    }

