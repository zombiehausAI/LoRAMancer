                            <div style="position: relative; width: 100%; height: 220px; background-color: var(--bg-dark-base); display: flex; align-items: center; justify-content: center; overflow: hidden;">
                        @{
                            string thumbSrc = GetImageSrc(lora.ThumbnailPath);
                        }
                        @if (!string.IsNullOrEmpty(thumbSrc)) {
                            <img src="@thumbSrc" alt="@lora.FileName" style="width: 100%; height: 100%; object-fit: cover;" />
                        } else {
                            <div class="d-flex flex-column align-center justify-center p-4 text-center" style="width: 100%; height: 100%; background: linear-gradient(135deg, rgba(203,166,247,0.1), rgba(137,180,250,0.05));">
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Large" Color="Color.Secondary" Style="opacity: 0.4;" Class="mb-1" />
                                <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">No Preview Thumbnail</MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => FetchSingleCivitaiAsync(lora))" Class="mt-1" Style="font-size: 0.7rem;">
                                    Find on Civitai
                                </MudButton>
                            </div>
                        }

                        <!-- Base Model Overlay Selector Badge -->
                        <div style="position: absolute; top: 10px; left: 10px; z-index: 2;">
                            <MudMenu Dense="true" Size="Size.Small">
                                <ActivatorContent>
                                    <MudChip T="string" Size="Size.Small" Color="@GetArchitectureColor(lora.EffectiveBaseModel)" Variant="Variant.Filled" Style="font-weight: 600; font-size: 0.7rem; cursor: pointer;">
                                        @lora.EffectiveBaseModel
                                    </MudChip>
                                </ActivatorContent>
                                <ChildContent>
                                    @foreach (var arch in GetBaseModelMenuOptions()) {
                                        <MudMenuItem OnClick="@(() => SetBaseModelAsync(lora, arch))">@arch</MudMenuItem>
                                    }
                                    <MudDivider />
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenTagEditorAsync(lora))">Assign Custom Base Model...</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" OnClick="@(() => SetBaseModelAsync(lora, null))">Reset to Auto (@lora.BaseModel)</MudMenuItem>
                                </ChildContent>
                            </MudMenu>
                        </div>

                        <!-- Favorite Toggle Button -->
                        <div style="position: absolute; top: 8px; right: 8px; z-index: 2;">
                            <MudTooltip Text="@(lora.IsFavorite ? "Remove from Favorites" : "Mark as Favorite")">
                                <MudIconButton Icon="@(lora.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)" 
                                               Color="@(lora.IsFavorite ? Color.Error : Color.Default)" 
                                               Size="Size.Small" 
                                               Style="@(lora.IsFavorite ? "background: rgba(0,0,0,0.5);" : "background: rgba(0,0,0,0.3);")"
                                               OnClick="@(() => ToggleFavoriteAsync(lora))" />
                            </MudTooltip>
                        </div>

                        <!-- Category Overlay Badge -->
                        <div style="position: absolute; bottom: 8px; left: 10px; z-index: 2;">
                            <MudMenu Dense="true" Size="Size.Small">
                                <ActivatorContent>
                                    @{
                                        var cardCat = GetCategoryObj(lora.Category);
                                    }
                                    <MudChip T="string" 
                                             Size="Size.Small" 
                                             Variant="Variant.Filled" 
                                             Icon="@cardCat?.Icon"
                                             Style="@($"font-size: 0.68rem; font-weight: 600; cursor: pointer; background-color: {(cardCat != null ? $"{cardCat.Color}33" : "rgba(0,0,0,0.5)")}; color: {(cardCat?.Color ?? "#cdd6f4")}; border: 1px solid {(cardCat?.Color ?? "rgba(255,255,255,0.2)")}; backdrop-filter: blur(4px);")">
                                        @(lora.Category ?? "+ Category")
                                    </MudChip>
                                </ActivatorContent>
                                <ChildContent>
                                    <MudMenuItem OnClick="@(() => SetCategoryAsync(lora, null))">None (Uncategorized)</MudMenuItem>
                                    <MudDivider />
                                    @foreach (var cat in LibraryService.Categories) {
                                        <MudMenuItem Icon="@cat.Icon" OnClick="@(() => SetCategoryAsync(lora, cat.Name))">
                                            @cat.Name
                                        </MudMenuItem>
                                    }
                                    <MudDivider />
                                    <MudMenuItem Icon="@Icons.Material.Filled.LocalOffer" OnClick="@(() => OpenTagEditorAsync(lora))">
                                        Assign Category &amp; Tags...
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="OpenCategoryManagerAsync">
                                        Manage Categories...
                                    </MudMenuItem>
                                </ChildContent>
                            </MudMenu>
                        </div>

                        <!-- Size Badge -->
                        <div style="position: absolute; bottom: 8px; right: 10px; background: var(--bg-dark-overlay); padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; color: var(--text-primary);">
                            @lora.FormattedSize
                        </div>
                    </div>

                    <MudCardContent Class="py-3 px-3" Style="flex: 1;">
                        <MudTooltip Text="@(lora.FileName ?? string.Empty)">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: var(--text-primary); line-height: 1.2; word-break: break-all;">
                                @(lora.CivitaiInfo != null && !string.IsNullOrWhiteSpace(lora.CivitaiInfo.ModelName) ? lora.CivitaiInfo.ModelName : (lora.FileName ?? "Unknown"))
                            </MudText>
                        </MudTooltip>
                        @if (lora.CivitaiInfo != null && !string.IsNullOrWhiteSpace(lora.CivitaiInfo.VersionName)) {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@lora.CivitaiInfo.VersionName</MudText>
                        }

                        @if (_showAllFlat || !string.IsNullOrWhiteSpace(_searchQuery)) {
                            <div class="mt-1" style="font-size: 0.7rem; color: #6c7086; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                📁 @GetRelativeSubfolder(lora.FilePath)
                            </div>
                        }

                        <!-- Custom Tags Chips -->
                        @if (lora.Tags != null && lora.Tags.Count > 0) {
                            <div class="d-flex align-center gap-1 flex-wrap my-1">
                                @foreach (var tag in lora.Tags.Take(4)) {
                                    <span style="font-size: 0.65rem; padding: 1px 6px; border-radius: 4px; background: rgba(137, 180, 250, 0.15); color: #89b4fa; border: 1px solid rgba(137, 180, 250, 0.3);">
                                        #@tag
                                    </span>
                                }
                                @if (lora.Tags.Count > 4) {
                                    <span style="font-size: 0.65rem; color: var(--text-secondary);">+@(lora.Tags.Count - 4)</span>
                                }
                            </div>
                        }

                        <!-- Trigger Word Badge -->
                        @if (GetPrimaryTrigger(lora) is string trigger && !string.IsNullOrWhiteSpace(trigger)) {
                            <div class="d-flex align-center justify-space-between p-1 px-2 my-2" style="background-color: var(--bg-dark-base); border: 1px solid var(--border-dark); border-radius: 6px;">
                                <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--accent-purple); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 170px;">
                                    @trigger
                                </div>
                                <MudTooltip Text="Copy trigger word">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary" OnClick="@(() => CopyToClipboardAsync(trigger))" />
                                </MudTooltip>
                            </div>
                        }

                        <!-- Hyperparameters Quick Matrix -->
                        <div class="d-grid mt-2" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; text-align: center;">
                            <div style="background-color: var(--bg-dark-base); padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: var(--text-secondary);">DIM/ALPHA</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: var(--text-primary);">@(lora.NetworkDim?.ToString() ?? "-")/@(lora.NetworkAlpha?.ToString() ?? "-")</div>
                            </div>
                            <div style="background-color: var(--bg-dark-base); padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: var(--text-secondary);">LR</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: var(--text-primary);">@(lora.LearningRate?.ToString("0.e+0") ?? "-")</div>
                            </div>
                            <div style="background-color: var(--bg-dark-base); padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: var(--text-secondary);">STEPS</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: var(--text-primary);">@(lora.TotalSteps?.ToString() ?? "-")</div>
                            </div>
                        </div>
                    </MudCardContent>

                    <!-- Card Actions -->
                    <MudCardActions Class="px-3 py-2 d-flex justify-space-between align-center" Style="border-top: 1px solid var(--border-dark);">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" OnClick="@(() => UseLoraTrainingSettings(lora))">
                            Use Settings
                        </MudButton>
                        <div class="d-flex gap-1">
                            <MudTooltip Text="Diagnostics &amp; Lab Suite">
                                <MudMenu Icon="@Icons.Material.Filled.Science" Size="Size.Small" Color="Color.Info" Dense="true">
                                    <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.7rem; font-weight: 700; color: #89b4fa;">
                                        DIAGNOSTICS &amp; LAB SUITE
                                    </div>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Radar" IconColor="Color.Warning" OnClick="@(() => RouteToDiagnostic(lora, 3, autoRun: true))">
                                        SVD Overbake Radar (Auto-Scan)
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Fingerprint" IconColor="Color.Primary" OnClick="@(() => RouteToDiagnostic(lora, 5, autoRun: true))">
                                        Forensic De-Anonymizer (Reverse-Engineer)
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.AutoFixHigh" IconColor="Color.Secondary" OnClick="@(() => RouteToDiagnostic(lora, 4))">
                                        Ghost Hunter &amp; Style Decoupler
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.ContentCut" IconColor="Color.Secondary" OnClick="@(() => RouteToDiagnostic(lora, 0))">
                                        Layer Surgery &amp; Resizing
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Biotech" IconColor="Color.Tertiary" OnClick="@(() => OpenLoraGeneTherapyAsync(lora))">
                                        Vector Gene Therapy Suite
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Difference" IconColor="Color.Info" OnClick="@(() => OpenLoraDiffAsync(lora))">
                                        Visual Diff &amp; Angle Drift Inspector
                                    </MudMenuItem>
                                    <MudDivider Class="my-1" />
                                    <MudMenuItem Icon="@Icons.Material.Filled.Science" IconColor="Color.Info" OnClick="@(() => SendToStudioLab(lora))">
                                        Open Full Diagnostic Lab (Stage 3)
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Speed" IconColor="Color.Success" OnClick="@(() => SendToStudioTest(lora))">
                                        Test in ComfyUI Canvas (Stage 4)
                                    </MudMenuItem>
                                </MudMenu>
                            </MudTooltip>
                            <MudTooltip Text="Send to Studio Test Canvas (Stage 4)">
                                <MudIconButton Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Color="Color.Success" OnClick="@(() => SendToStudioTest(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="Quick ComfyUI Test Modal">
                                <MudIconButton Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Color="Color.Tertiary" OnClick="@(() => OpenComfyUiTestAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="LoRA Surgery & SVD Resizing">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => OpenLoraSurgeryAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="LoRA Gene Therapy & Outlier Pruning">
                                <MudIconButton Icon="@Icons.Material.Filled.Biotech" Size="Size.Small" Color="Color.Tertiary" OnClick="@(() => OpenLoraGeneTherapyAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="LoRA Visual Diff Inspector">
                                <MudIconButton Icon="@Icons.Material.Filled.Difference" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenLoraDiffAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="Save & Copy Metadata JSON">
                                <MudIconButton Icon="@Icons.Material.Filled.DataObject" Size="Size.Small" Color="Color.Primary" OnClick="@(() => SaveLoraMetadataJsonAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="Fetch Civitai Info">
                                <MudIconButton Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" Color="Color.Tertiary" OnClick="@(() => FetchSingleCivitaiAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="Refresh from Disk">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Info" OnClick="@(() => RefreshLoraAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="Inspect Header">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => InspectLora(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="Reveal in Explorer">
                                <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Color="Color.Default" OnClick="@(() => OpenInExplorer(lora.FilePath))" />
                            </MudTooltip>
                        </div>
                    </MudCardActions>
                </MudCard>
            </ActivatorContent>
            <ChildContent>
                <!-- Section 1: Studio Pipeline Routing -->
                <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #cba6f7; letter-spacing: 0.5px;">
                    ⚡ STUDIO PIPELINE ROUTING
                </div>
                <MudMenuItem Icon="@Icons.Material.Filled.Science" IconColor="Color.Info" OnClick="@(() => SendToStudioLab(lora))">
                    Send to Diagnostic Lab (Stage 3)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Speed" IconColor="Color.Success" OnClick="@(() => SendToStudioTest(lora))">
                    Test in ComfyUI Canvas (Stage 4)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.AutoAwesome" IconColor="Color.Primary" OnClick="@(() => UseLoraTrainingSettings(lora))">
                    Clone Recipe into Trainer (Stage 2)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Collections" IconColor="Color.Secondary" OnClick="@(() => SeedConceptToCurator(lora))">
                    Seed Concept to Dataset Curator (Stage 1)
                </MudMenuItem>

                <MudDivider Class="my-1" />

                <!-- Section 2: Diagnostics & Surgery -->
                <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #89b4fa; letter-spacing: 0.5px;">
                    🔬 DIAGNOSTICS &amp; SURGERY
                </div>
                <MudMenuItem Icon="@Icons.Material.Filled.Radar" IconColor="Color.Warning" OnClick="@(() => RouteToDiagnostic(lora, 3, autoRun: true))">
                    SVD Overbake Radar (Auto-Scan)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Fingerprint" IconColor="Color.Primary" OnClick="@(() => RouteToDiagnostic(lora, 5, autoRun: true))">
                    Forensic De-Anonymizer (Reverse-Engineer)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.AutoFixHigh" IconColor="Color.Secondary" OnClick="@(() => RouteToDiagnostic(lora, 4))">
                    Ghost Hunter &amp; Style Decoupler
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.ContentCut" IconColor="Color.Secondary" OnClick="@(() => RouteToDiagnostic(lora, 0))">
                    Layer Surgery &amp; Resizing
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Biotech" IconColor="Color.Tertiary" OnClick="@(() => OpenLoraGeneTherapyAsync(lora))">
                    Vector Gene Therapy Suite
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Difference" IconColor="Color.Info" OnClick="@(() => OpenLoraDiffAsync(lora))">
                    Visual Diff &amp; Angle Drift Inspector
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Insights" IconColor="Color.Warning" OnClick="@(() => OpenBenchmarkDialogAsync(lora))">
                    Batch Benchmark &amp; Sweet Spot Matrix
                </MudMenuItem>

                <MudDivider Class="my-1" />

                <!-- Section 3: Prompts & Clipboard -->
                <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #a6e3a1; letter-spacing: 0.5px;">
                    📋 PROMPTS &amp; CLIPBOARD
                </div>
                <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" IconColor="Color.Success" OnClick="@(() => CopyTriggerWordAsync(lora))">
                    Copy Trigger Word
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.DataObject" IconColor="Color.Primary" OnClick="@(() => CopyLoraPromptSyntaxAsync(lora))">
                    Copy Prompt Syntax (&lt;lora:...&gt;)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.FolderZip" IconColor="Color.Default" OnClick="@(() => CopyFilePathAsync(lora))">
                    Copy Full File Path
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.DataObject" IconColor="Color.Tertiary" OnClick="@(() => SaveLoraMetadataJsonAsync(lora))">
                    Save &amp; Copy Metadata JSON
                </MudMenuItem>

                <MudDivider Class="my-1" />

                <!-- Section 4: Categories & Tags -->
                <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #fab387; letter-spacing: 0.5px;">
                    🏷️ CATEGORIES &amp; TAGS
                </div>
                <MudMenuItem Icon="@Icons.Material.Filled.LocalOffer" IconColor="Color.Primary" OnClick="@(() => OpenTagEditorAsync(lora))">
                    Assign Category &amp; Tags...
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Category" IconColor="Color.Warning" OnClick="OpenCategoryManagerAsync">
                    Manage Categories...
                </MudMenuItem>

                <MudDivider Class="my-1" />

                <!-- Section 5: Organizer & Collections -->
                <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #89dceb; letter-spacing: 0.5px;">
                    📁 ORGANIZER &amp; COLLECTIONS
                </div>
                <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" IconColor="Color.Info" OnClick="@(() => OpenMoveToLibraryDialog(lora))">
                    Move to Library...
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.AutoAwesomeMotion" IconColor="Color.Secondary" OnClick="@(() => OpenAssignCollectionsDialogAsync(lora))">
                    Add / Remove from Collections...
                </MudMenuItem>

                <MudDivider Class="my-1" />

                <!-- Section 6: Vault Actions -->
                <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #f9e2af; letter-spacing: 0.5px;">
                    🗄️ VAULT ACTIONS
                </div>
                <MudMenuItem Icon="@(lora.IsFavorite ? Icons.Material.Filled.FavoriteBorder : Icons.Material.Filled.Favorite)" IconColor="Color.Error" OnClick="@(() => ToggleFavoriteAsync(lora))">
                    @(lora.IsFavorite ? "Remove from Favorites" : "Mark as Favorite")
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.CloudDownload" IconColor="Color.Tertiary" OnClick="@(() => FetchSingleCivitaiAsync(lora))">
                    Fetch Civitai Info &amp; Preview
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Info" OnClick="@(() => RefreshLoraAsync(lora))">
                    Refresh from Disk
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Visibility" IconColor="Color.Secondary" OnClick="@(() => InspectLora(lora))">
                    Inspect Header Metadata
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.FolderOpen" IconColor="Color.Default" OnClick="@(() => OpenInExplorer(lora.FilePath))">
                    Reveal in Explorer
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudItem>
        }
    </MudGrid>

    @if (TotalPages > 1) {
        <div class="d-flex justify-center align-center gap-4 my-4">
            <MudPagination Count="@TotalPages" SelectedChanged="OnPageChanged" Selected="_currentPage" Color="Color.Primary" Size="Size.Medium" ShowFirstButton="true" ShowLastButton="true" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Page @_currentPage of @TotalPages (@FilteredCount items)
            </MudText>
        </div>
    }

    @if (FilteredCount == 0 && CurrentSubfoldersSnapshot.Count > 0) {
        <div class="pa-4 text-center mt-4" style="background-color: var(--bg-dark-surface); border: 1px dashed var(--border-dark); border-radius: 8px;">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                No direct LoRA files in this folder. Click any subfolder card above to view contained models.
            </MudText>
        </div>
    }
} else {
    <!-- Table View -->
    @if (!_showAllFlat && string.IsNullOrWhiteSpace(_searchQuery) && CurrentSubfoldersSnapshot.Count > 0) {
        <div class="d-flex flex-wrap gap-2 mb-3 align-center">
            <MudText Typo="Typo.body2" Style="color: var(--text-secondary); font-weight: 600;">Subfolders:</MudText>
            @foreach (var sub in CurrentSubfoldersSnapshot) {
                var registeredLib = GetRegisteredLibraryForSubfolder(sub.FullPath);
                bool isLib = registeredLib != null && !string.Equals(registeredLib.Id, LibraryService.ActiveLibrary?.Id, StringComparison.OrdinalIgnoreCase);
                if (isLib) {
                    <MudTooltip Text="@($"Library: '{registeredLib!.Name}' ({sub.LoraCount} models) - Click to switch library")">
                        <MudChip T="string" Icon="@Icons.Material.Filled.CollectionsBookmark" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => SwitchActiveLibraryAsync(registeredLib!.Id))" Style="cursor: pointer; font-weight: 600;">
                            @sub.Name (@sub.LoraCount) [Library]
                        </MudChip>
                    </MudTooltip>
                } else {
                    <MudChip T="string" Icon="@Icons.Material.Filled.Folder" Color="Color.Tertiary" Variant="Variant.Outlined" OnClick="@(() => NavigateToFolder(sub.FullPath))" Style="cursor: pointer; font-weight: 600;">
                        @sub.Name (@sub.LoraCount)
                    </MudChip>
                }
            }
        </div>
    }

    <MudTable Items="FilteredLorasSnapshot" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1" RowsPerPage="25" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); border-radius: 8px;">
        <HeaderContent>
            <MudTh Style="width: 48px;">Fav</MudTh>
            <MudTh>File Name</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Base Model</MudTh>
            <MudTh>Rank (Dim)</MudTh>
            <MudTh>Alpha</MudTh>
            <MudTh>LR</MudTh>
            <MudTh>Optimizer</MudTh>
            <MudTh>File Size</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fav">
                <MudIconButton Icon="@(context.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)" 
                               Color="@(context.IsFavorite ? Color.Error : Color.Default)" 
                               Size="Size.Small" 
                               OnClick="@(() => ToggleFavoriteAsync(context))" />
            </MudTd>
            <MudTd DataLabel="File Name">
                <MudMenu ActivationEvent="MouseEvent.RightClick" PositionAtCursor="true" Dense="true">
                    <ActivatorContent>
                        <div class="d-flex align-center" style="cursor: context-menu;">
                            <MudIcon Icon="@Icons.Material.Filled.Layers" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                            <div>
                                <div style="font-weight: 600; color: #cdd6f4;">@context.FileName</div>
                                <div style="font-size: 0.75rem; color: #6c7086;">@context.FilePath</div>
                            </div>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <!-- Section 1: Studio Pipeline Routing -->
                        <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #cba6f7; letter-spacing: 0.5px;">
                            ⚡ STUDIO PIPELINE ROUTING
                        </div>
                        <MudMenuItem Icon="@Icons.Material.Filled.Science" IconColor="Color.Info" OnClick="@(() => SendToStudioLab(context))">
                            Send to Diagnostic Lab (Stage 3)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Speed" IconColor="Color.Success" OnClick="@(() => SendToStudioTest(context))">
                            Test in ComfyUI Canvas (Stage 4)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.AutoAwesome" IconColor="Color.Primary" OnClick="@(() => UseLoraTrainingSettings(context))">
                            Clone Recipe into Trainer (Stage 2)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Collections" IconColor="Color.Secondary" OnClick="@(() => SeedConceptToCurator(context))">
                            Seed Concept to Dataset Curator (Stage 1)
                        </MudMenuItem>

                        <MudDivider Class="my-1" />

                        <!-- Section 2: Diagnostics & Surgery -->
                        <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #89b4fa; letter-spacing: 0.5px;">
                            🔬 DIAGNOSTICS &amp; SURGERY
                        </div>
                        <MudMenuItem Icon="@Icons.Material.Filled.Radar" IconColor="Color.Warning" OnClick="@(() => RouteToDiagnostic(context, 3, autoRun: true))">
                            SVD Overbake Radar (Auto-Scan)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Fingerprint" IconColor="Color.Primary" OnClick="@(() => RouteToDiagnostic(context, 5, autoRun: true))">
                            Forensic De-Anonymizer (Reverse-Engineer)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.AutoFixHigh" IconColor="Color.Secondary" OnClick="@(() => RouteToDiagnostic(context, 4))">
                            Ghost Hunter &amp; Style Decoupler
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.ContentCut" IconColor="Color.Secondary" OnClick="@(() => RouteToDiagnostic(context, 0))">
                            Layer Surgery &amp; Resizing
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Biotech" IconColor="Color.Tertiary" OnClick="@(() => OpenLoraGeneTherapyAsync(context))">
                            Vector Gene Therapy Suite
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Difference" IconColor="Color.Info" OnClick="@(() => OpenLoraDiffAsync(context))">
                            Visual Diff &amp; Angle Drift Inspector
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Insights" IconColor="Color.Warning" OnClick="@(() => OpenBenchmarkDialogAsync(context))">
                            Batch Benchmark &amp; Sweet Spot Matrix
                        </MudMenuItem>

                        <MudDivider Class="my-1" />

                        <!-- Section 3: Prompts & Clipboard -->
                        <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #a6e3a1; letter-spacing: 0.5px;">
                            📋 PROMPTS &amp; CLIPBOARD
                        </div>
                        <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" IconColor="Color.Success" OnClick="@(() => CopyTriggerWordAsync(context))">
                            Copy Trigger Word
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.DataObject" IconColor="Color.Primary" OnClick="@(() => CopyLoraPromptSyntaxAsync(context))">
                            Copy Prompt Syntax (&lt;lora:...&gt;)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.FolderZip" IconColor="Color.Default" OnClick="@(() => CopyFilePathAsync(context))">
                            Copy Full File Path
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.DataObject" IconColor="Color.Tertiary" OnClick="@(() => SaveLoraMetadataJsonAsync(context))">
                            Save &amp; Copy Metadata JSON
                        </MudMenuItem>

                        <MudDivider Class="my-1" />

                        <!-- Section 4: Categories & Tags -->
                        <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #fab387; letter-spacing: 0.5px;">
                            🏷️ CATEGORIES &amp; TAGS
                        </div>
                        <MudMenuItem Icon="@Icons.Material.Filled.LocalOffer" IconColor="Color.Primary" OnClick="@(() => OpenTagEditorAsync(context))">
                            Assign Category &amp; Tags...
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Category" IconColor="Color.Warning" OnClick="OpenCategoryManagerAsync">
                            Manage Categories...
                        </MudMenuItem>

                        <MudDivider Class="my-1" />

                        <!-- Section: Organizer & Collections -->
                        <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #89dceb; letter-spacing: 0.5px;">
                            📁 ORGANIZER &amp; COLLECTIONS
                        </div>
                        <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" IconColor="Color.Info" OnClick="@(() => OpenMoveToLibraryDialog(context))">
                            Move to Library...
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.AutoAwesomeMotion" IconColor="Color.Secondary" OnClick="@(() => OpenAssignCollectionsDialogAsync(context))">
                            Add / Remove from Collections...
                        </MudMenuItem>

                        <MudDivider Class="my-1" />

                        <!-- Section 5: Vault Actions -->
                        <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.68rem; font-weight: 700; color: #f9e2af; letter-spacing: 0.5px;">
                            🗄️ VAULT ACTIONS
                        </div>
                        <MudMenuItem Icon="@(context.IsFavorite ? Icons.Material.Filled.FavoriteBorder : Icons.Material.Filled.Favorite)" IconColor="Color.Error" OnClick="@(() => ToggleFavoriteAsync(context))">
                            @(context.IsFavorite ? "Remove from Favorites" : "Mark as Favorite")
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.CloudDownload" IconColor="Color.Tertiary" OnClick="@(() => FetchSingleCivitaiAsync(context))">
                            Fetch Civitai Info &amp; Preview
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Info" OnClick="@(() => RefreshLoraAsync(context))">
                            Refresh from Disk
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility" IconColor="Color.Secondary" OnClick="@(() => InspectLora(context))">
                            Inspect Header Metadata
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.FolderOpen" IconColor="Color.Default" OnClick="@(() => OpenInExplorer(context.FilePath))">
                            Reveal in Explorer
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudTd>
            <MudTd DataLabel="Category">
                <MudMenu Dense="true" Size="Size.Small">
                    <ActivatorContent>
                        @{
                            var rowCat = GetCategoryObj(context.Category);
                        }
                        <MudChip T="string" 
                                 Size="Size.Small" 
                                 Variant="Variant.Filled" 
                                 Icon="@rowCat?.Icon"
                                 Style="@($"font-size: 0.7rem; font-weight: 600; cursor: pointer; background-color: {(rowCat != null ? $"{rowCat.Color}22" : "rgba(255,255,255,0.06)")}; color: {(rowCat?.Color ?? "var(--text-secondary)")}; border: 1px solid {(rowCat?.Color ?? "var(--border-dark)")};")">
                            @(context.Category ?? "None")
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => SetCategoryAsync(context, null))">None (Uncategorized)</MudMenuItem>
                        <MudDivider />
                        @foreach (var cat in LibraryService.Categories) {
                            <MudMenuItem Icon="@cat.Icon" OnClick="@(() => SetCategoryAsync(context, cat.Name))">
                                @cat.Name
                            </MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.LocalOffer" OnClick="@(() => OpenTagEditorAsync(context))">
                            Assign Category &amp; Tags...
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="OpenCategoryManagerAsync">
                            Manage Categories...
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudTd>
            <MudTd DataLabel="Base Model">
                <MudMenu Dense="true" Size="Size.Small">
                    <ActivatorContent>
                        <MudChip T="string" Size="Size.Small" Color="@GetArchitectureColor(context.EffectiveBaseModel)" Variant="Variant.Outlined" Style="cursor: pointer;">
                            @context.EffectiveBaseModel
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        @foreach (var arch in GetBaseModelMenuOptions()) {
                            <MudMenuItem OnClick="@(() => SetBaseModelAsync(context, arch))">@arch</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenTagEditorAsync(context))">Assign Custom Base Model...</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" OnClick="@(() => SetBaseModelAsync(context, null))">Reset to Auto (@context.BaseModel)</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudTd>
            <MudTd DataLabel="Rank (Dim)">@(context.NetworkDim?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="Alpha">@(context.NetworkAlpha?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="LR">@(context.LearningRate?.ToString("0.#####e+00") ?? "-")</MudTd>
            <MudTd DataLabel="Optimizer">@(string.IsNullOrEmpty(context.Optimizer) ? "-" : context.Optimizer)</MudTd>
            <MudTd DataLabel="File Size">@context.FormattedSize</MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" OnClick="@(() => UseLoraTrainingSettings(context))" Class="mr-1">
                    Use Settings
                </MudButton>
                <MudTooltip Text="Diagnostics &amp; Lab Suite">
                    <MudMenu Icon="@Icons.Material.Filled.Science" Size="Size.Small" Color="Color.Info" Dense="true">
                        <div class="px-3 py-1" style="border-bottom: 1px solid var(--border-dark); font-size: 0.7rem; font-weight: 700; color: #89b4fa;">
                            DIAGNOSTICS &amp; LAB SUITE
                        </div>
                        <MudMenuItem Icon="@Icons.Material.Filled.Radar" IconColor="Color.Warning" OnClick="@(() => RouteToDiagnostic(context, 3, autoRun: true))">
                            SVD Overbake Radar (Auto-Scan)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Fingerprint" IconColor="Color.Primary" OnClick="@(() => RouteToDiagnostic(context, 5, autoRun: true))">
                            Forensic De-Anonymizer (Reverse-Engineer)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.AutoFixHigh" IconColor="Color.Secondary" OnClick="@(() => RouteToDiagnostic(context, 4))">
                            Ghost Hunter &amp; Style Decoupler
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.ContentCut" IconColor="Color.Secondary" OnClick="@(() => RouteToDiagnostic(context, 0))">
                            Layer Surgery &amp; Resizing
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Biotech" IconColor="Color.Tertiary" OnClick="@(() => OpenLoraGeneTherapyAsync(context))">
                            Vector Gene Therapy Suite
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Difference" IconColor="Color.Info" OnClick="@(() => OpenLoraDiffAsync(context))">
                            Visual Diff &amp; Angle Drift Inspector
                        </MudMenuItem>
                        <MudDivider Class="my-1" />
                        <MudMenuItem Icon="@Icons.Material.Filled.Science" IconColor="Color.Info" OnClick="@(() => SendToStudioLab(context))">
                            Open Full Diagnostic Lab (Stage 3)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Speed" IconColor="Color.Success" OnClick="@(() => SendToStudioTest(context))">
                            Test in ComfyUI Canvas (Stage 4)
                        </MudMenuItem>
                    </MudMenu>
                </MudTooltip>
                <MudTooltip Text="Send to Studio Test Canvas (Stage 4)">
                    <MudIconButton Icon="@Icons.Material.Filled.Speed" Color="Color.Success" Size="Size.Small" OnClick="@(() => SendToStudioTest(context))" />
                </MudTooltip>
                <MudTooltip Text="LoRA Gene Therapy & Outlier Pruning">
                    <MudIconButton Icon="@Icons.Material.Filled.Biotech" Color="Color.Tertiary" Size="Size.Small" OnClick="@(() => OpenLoraGeneTherapyAsync(context))" />
                </MudTooltip>
                <MudTooltip Text="LoRA Visual Diff Inspector">
                    <MudIconButton Icon="@Icons.Material.Filled.Difference" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenLoraDiffAsync(context))" />
                </MudTooltip>
                <MudTooltip Text="Save & Copy Metadata JSON">
                    <MudIconButton Icon="@Icons.Material.Filled.DataObject" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SaveLoraMetadataJsonAsync(context))" />
                </MudTooltip>
                <MudTooltip Text="Fetch Civitai Info">
                    <MudIconButton Icon="@Icons.Material.Filled.CloudDownload" Color="Color.Tertiary" Size="Size.Small" OnClick="@(() => FetchSingleCivitaiAsync(context))" />
                </MudTooltip>
                <MudTooltip Text="Refresh from Disk">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" Size="Size.Small" OnClick="@(() => RefreshLoraAsync(context))" />
                </MudTooltip>
                <MudTooltip Text="Inspect Metadata">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => InspectLora(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
}

<!-- Metadata Inspector Drawer -->
<MetadataInspectorDrawer @bind-IsOpen="_drawerOpen" Metadata="_selectedLora" />

<!-- Move to Library Dialog -->
<MudDialog @bind-Visible="_moveDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Color="Color.Info" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Move LoRA to Library</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_loraToMove != null) {
            <MudText Typo="Typo.body2" Class="mb-3">
                Select a target library. The model file (<b>@_loraToMove.FileName</b>) and companion preview images will be physically moved to the destination library folder.
            </MudText>

            <MudSelect T="string" @bind-Value="_targetLibraryId" Label="Destination Library" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                @foreach (var lib in LibraryService.Libraries) {
                    bool isCurrent = string.Equals(lib.Id, _loraToMove.LibraryId, StringComparison.OrdinalIgnoreCase);
                    <MudSelectItem Value="@lib.Id">
                        @lib.Name @(isCurrent ? " (Current)" : "")
                    </MudSelectItem>
                }
            </MudSelect>

            @if (TargetMoveLibrary != null) {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2" Dense="true">
                    Target Folder: <span style="font-family: monospace; font-size: 0.75rem;">@TargetMoveLibrary.FolderPath</span>
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => _moveDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DriveFileMove" Disabled="@(_isMoving || string.IsNullOrWhiteSpace(_targetLibraryId))" OnClick="ExecuteMoveLoraAsync">
            @(_isMoving ? "Moving..." : "Move File")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Assign Collections Dialog -->
<MudDialog @bind-Visible="_assignCollectionsDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesomeMotion" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">LoRA Collections</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_loraForCollections != null) {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Assign <b>@_loraForCollections.FileName</b> to virtual collections. Collections organize models without moving any physical files.
            </MudText>

            @if (LibraryService.Collections.Count == 0) {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mb-3">
                    No collections created yet. Enter a name below to create your first collection.
                </MudAlert>
            } else {
                <div class="d-flex flex-column gap-1 mb-3" style="max-height: 240px; overflow-y: auto;">
                    @foreach (var col in LibraryService.Collections) {
                        bool inCol = _loraCollectionIds.Contains(col.Id);
                        <div class="d-flex align-center justify-space-between pa-2" style="background-color: rgba(255,255,255,0.03); border-radius: 6px;">
                            <MudCheckBox T="bool" Value="@inCol" ValueChanged="@((val) => ToggleCollectionMembershipAsync(col.Id, val))" Color="Color.Primary" Dense="true">
                                <span style="font-weight: 600;">@col.Name</span>
                                <span style="color: var(--text-secondary); font-size: 0.75rem; margin-left: 6px;">(@col.ModelCount models)</span>
                            </MudCheckBox>
                        </div>
                    }
                </div>
            }

            <MudDivider Class="my-2" />
            <div class="d-flex align-center gap-2 mt-2">
                <MudTextField @bind-Value="_newCollectionInlineName" Placeholder="New collection name..." Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@string.IsNullOrWhiteSpace(_newCollectionInlineName)" OnClick="CreateCollectionInlineAsync">
                    Add
                </MudButton>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => _assignCollectionsDialogOpen = false)">Done</MudButton>
    </DialogActions>
</MudDialog>

<!-- Manage Collections Dialog -->
<MudDialog @bind-Visible="_manageCollectionsDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Manage User Collections</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Collections are user-defined virtual buckets for grouping models regardless of their physical folders.
        </MudText>

        <MudCard Elevation="1" Class="pa-3 mb-4" Style="background-color: rgba(255,255,255,0.03); border: 1px solid var(--border-dark); border-radius: 8px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 600;">Create New Collection</MudText>
            <div class="d-flex gap-2">
                <MudTextField @bind-Value="_createColName" Label="Collection Name" Placeholder="e.g. Best Anime, Cyberpunk Kit, Character Favorites" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_createColDesc" Label="Description (Optional)" Placeholder="Notes about this collection" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Style="height: 40px; margin-top: 4px;" Disabled="@string.IsNullOrWhiteSpace(_createColName)" OnClick="CreateCollectionFromManagerAsync">
                    Create
                </MudButton>
            </div>
        </MudCard>

        <div class="d-flex flex-column gap-2" style="max-height: 320px; overflow-y: auto;">
            @if (LibraryService.Collections.Count == 0) {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No collections created yet.</MudAlert>
            } else {
                @foreach (var col in LibraryService.Collections) {
                    <div class="d-flex align-center justify-space-between pa-3" style="background-color: var(--bg-dark-base); border: 1px solid var(--border-dark); border-radius: 8px;">
                        <div>
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@col.Name</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@col.ModelCount models</MudChip>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(col.Description)) {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@col.Description</MudText>
                            }
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(async () => { _manageCollectionsDialogOpen = false; await SelectCollectionFilter(col); })">
                                View
                            </MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCollectionAsync(col.Id))" />
                        </div>
                    </div>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => _manageCollectionsDialogOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

<!-- Set Folder Path Dialog (Remote / RDP Fallback) -->
<MudDialog @bind-Visible="_manualFolderDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Set LoRA Library Folder</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Enter or paste the full directory path where your <code>.safetensors</code> models are stored on this server:
        </MudText>
        <MudTextField @bind-Value="_manualFolderPath" Label="Storage Directory" Placeholder="e.g. C:\AI\models\loras or D:\models\Lora"
                      Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => _manualFolderDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check"
                   Disabled="@string.IsNullOrWhiteSpace(_manualFolderPath)" OnClick="@(() => ApplySelectedFolder(_manualFolderPath.Trim()))">
            Scan &amp; Index Folder
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _drawerOpen;
    private LoraMetadata? _selectedLora;

    private LoraCollection? _selectedCollection;
    private HashSet<string> _collectionItemPaths = new(StringComparer.OrdinalIgnoreCase);

    private bool _moveDialogOpen;
    private LoraMetadata? _loraToMove;
    private string _targetLibraryId = string.Empty;
    private bool _isMoving;
    private LoraLibrary? TargetMoveLibrary => LibraryService.Libraries.FirstOrDefault(l => l.Id == _targetLibraryId);

    private bool _assignCollectionsDialogOpen;
    private LoraMetadata? _loraForCollections;
    private HashSet<string> _loraCollectionIds = new(StringComparer.OrdinalIgnoreCase);
    private string _newCollectionInlineName = string.Empty;

    private bool _manageCollectionsDialogOpen;
    private string _createColName = string.Empty;
    private string _createColDesc = string.Empty;

    private bool _manualFolderDialogOpen;
    private string _manualFolderPath = string.Empty;

    private bool _showAllFlat;
    private string _viewMode = "grid";
    private string _searchQuery = string.Empty;
    private string _selectedArchitecture = "all";

    private int _currentPage = 1;
    private const int _pageSize = 24;

    private bool _disposed;
    private readonly CancellationTokenSource _cts = new();
    private readonly object _filterLock = new();
    private static readonly ConcurrentDictionary<string, string> _thumbnailCache = new(StringComparer.OrdinalIgnoreCase);
    private static readonly ConcurrentDictionary<string, byte> _loadingThumbnails = new(StringComparer.OrdinalIgnoreCase);

    private sealed record SubfolderItem(string Name, string FullPath, string RelativePath, int LoraCount);
    private sealed record CrumbItem(string Name, string FullPath);

    private List<SubfolderItem> _currentSubfolders = new();
    private List<LoraMetadata> _filteredLoras = new();

    private IReadOnlyList<SubfolderItem> CurrentSubfoldersSnapshot {
        get {
            lock (_filterLock) {
                return _currentSubfolders?.ToList() ?? new List<SubfolderItem>();
            }
        }
    }

    private int FilteredCount {
        get {
            lock (_filterLock) {
                return _filteredLoras?.Count ?? 0;
            }
        }
    }

    private IReadOnlyList<LoraMetadata> FilteredLorasSnapshot {
        get {
            lock (_filterLock) {
                return _filteredLoras?.ToList() ?? new List<LoraMetadata>();
            }
        }
    }

    private int TotalPages {
        get {
            lock (_filterLock) {
                int count = _filteredLoras?.Count ?? 0;
                return Math.Max(1, (int)Math.Ceiling((double)count / _pageSize));
            }
        }
    }

    private IReadOnlyList<LoraMetadata> PagedLoras {
        get {
            try {
                lock (_filterLock) {
                    if (_filteredLoras == null || _filteredLoras.Count == 0) {
                        return Array.Empty<LoraMetadata>();
                    }
                    int totalPages = Math.Max(1, (int)Math.Ceiling((double)_filteredLoras.Count / _pageSize));
                    if (_currentPage > totalPages || _currentPage < 1) {
                        _currentPage = 1;
                    }
                    int skip = (_currentPage - 1) * _pageSize;
                    if (skip >= _filteredLoras.Count) {
                        skip = 0;
                        _currentPage = 1;
                    }
                    return _filteredLoras.Skip(skip).Take(_pageSize).ToList();
                }
            } catch {
                return Array.Empty<LoraMetadata>();
            }
        }
    }

    private string SearchQuery {
        get => _searchQuery;
        set {
            string newVal = value ?? string.Empty;
            if (_searchQuery != newVal) {
                _searchQuery = newVal;
                _currentPage = 1;
                UpdateFilteredList();
                _ = SafeInvokeAsync(StateHasChanged);
            }
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e) {
