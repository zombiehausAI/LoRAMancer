    private async Task LoadSingleLoraAsync(string filePath) {
        try {
            LoraMetadata meta = await MetadataReader.ReadMetadataAsync(filePath);
            LibraryService.FindLocalThumbnail(meta);
            await LibraryService.EnrichFromCivitaiAsync(meta);

            lock (_libraryLock) {
                _loraLibrary.RemoveAll(x => x.FilePath.Equals(filePath, StringComparison.OrdinalIgnoreCase));
                _loraLibrary.Insert(0, meta);
            }

            if (string.IsNullOrWhiteSpace(_rootFolder)) {
                string dir = Path.GetDirectoryName(filePath) ?? string.Empty;
                _rootFolder = dir;
                _currentFolder = dir;
            }

            Snackbar.Add($"Loaded {meta.FileName}", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to read {Path.GetFileName(filePath)}: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadFolderAsync(string folderPath) {
        _scanCts?.Cancel();
        _scanCts?.Dispose();
        _scanCts = new CancellationTokenSource();
        var token = _scanCts.Token;

        _rootFolder = folderPath;
        _currentFolder = folderPath;
        _showAllFlat = false;

        _isScanning = true;
        _scannedCount = 0;
        _totalFiles = 0;
        _currentScanningFile = "Discovering files recursively...";
        lock (_libraryLock) {
            _loraLibrary.Clear();
        }
        await InvokeAsync(StateHasChanged);

        _ = Task.Run(async () => {
            try {
                await LibraryService.ScanDirectoryStreamAsync(
                    folderPath,
                    async meta => {
                        lock (_libraryLock) {
                            _loraLibrary.Add(meta);
                        }
                        await InvokeAsync(StateHasChanged);
                    },
                    (file, current, total) => {
                        _currentScanningFile = file;
                        _scannedCount = current;
                        _totalFiles = total;
                        InvokeAsync(StateHasChanged);
                    },
                    token
                );

                await InvokeAsync(() => {
                    Snackbar.Add($"Indexed {_loraLibrary.Count} LoRAs across subfolders", Severity.Success);
                });
            } catch (OperationCanceledException) {
                await InvokeAsync(() => {
                    Snackbar.Add("Background scan stopped.", Severity.Info);
                });
            } catch (Exception ex) {
                await InvokeAsync(() => {
                    Snackbar.Add($"Folder scan failed: {ex.Message}", Severity.Error);
                });
            } finally {
                _isScanning = false;
                await InvokeAsync(StateHasChanged);
            }
        }, token);
    }

    private void CancelScan() {
        _scanCts?.Cancel();
    }

    protected override void OnInitialized() {
        UpdaterService.OnStateChanged += HandleUpdaterStateChanged;
    }

    private async void HandleUpdaterStateChanged() {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() {
        UpdaterService.OnStateChanged -= HandleUpdaterStateChanged;
        _scanCts?.Cancel();
        _scanCts?.Dispose();
    }

    private async Task FetchSingleCivitaiAsync(LoraMetadata lora) {
        Snackbar.Add($"Searching Civitai for {lora.FileName}...", Severity.Info);
        var info = await LibraryService.EnrichFromCivitaiAsync(lora);
        if (info != null) {
            Snackbar.Add($"Identified as '{info.ModelName}' from Civitai!", Severity.Success);
        } else {
            Snackbar.Add("No matching model found on Civitai.", Severity.Normal);
        }
        StateHasChanged();
    }

    private async Task EnrichAllCivitaiAsync() {
        _isEnrichingAll = true;
        _enrichProgress = 0;
        try {
            foreach (var lora in _loraLibrary) {
                if (lora.CivitaiInfo == null) {
                    await LibraryService.EnrichFromCivitaiAsync(lora);
                    _enrichProgress++;
                    await InvokeAsync(StateHasChanged);
                }
            }
            Snackbar.Add("Civitai metadata lookup complete!", Severity.Success);
        } finally {
            _isEnrichingAll = false;
        }
    }

