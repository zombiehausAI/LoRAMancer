@page "/"
@implements IDisposable
@inject SafeTensorsMetadataReader MetadataReader
@inject LoraLibraryService LibraryService
@inject CivitaiService Civitai
@inject NativeFileDialogService FileDialogService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject LoraUpdaterService UpdaterService
@using LoRAMancer.App.Components.Dialogs
@using System.Collections.Concurrent
@using System.Threading

<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--text-primary);">LoRA Library & Visual Browser</MudText>
            @if (LibraryService.ActiveLibrary != null) {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CollectionsBookmark" OnClick="OpenManageLibrariesAsync" Style="cursor: pointer;">
                    @LibraryService.ActiveLibrary.Name
                </MudChip>
            }
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Instant SQLite-backed model library with quick favorites, base model assignment, and Civitai metadata
        </MudText>
    </div>
    <div class="d-flex align-center flex-wrap gap-2">
        <MudMenu Label="@(LibraryService.ActiveLibrary != null ? $"Library: {LibraryService.ActiveLibrary.Name}" : "Select Library")" Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.CollectionsBookmark">
            @foreach (var lib in LibraryService.Libraries) {
                <MudMenuItem Icon="@(LibraryService.ActiveLibrary?.Id == lib.Id ? Icons.Material.Filled.Check : Icons.Material.Filled.Folder)" OnClick="@(() => SwitchActiveLibraryAsync(lib.Id))">
                    @lib.Name (@lib.ModelCount)
                </MudMenuItem>
            }
            <MudDivider Class="my-1" />
            <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="OpenManageLibrariesAsync">
                Manage Libraries...
            </MudMenuItem>
        </MudMenu>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="BrowseLibraryFolderAsync">
            Browse Folder...
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FileOpen" OnClick="BrowseLoraFileAsync">
            Add File...
        </MudButton>
        
        <MudMenu Label="Rescan / Sync" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Disabled="@(string.IsNullOrWhiteSpace(LibraryService.RootFolder) || LibraryService.IsScanning)">
            <MudMenuItem Icon="@Icons.Material.Filled.Sync" OnClick="RescanDeltaAsync">
                Rescan Library (Fast Delta)
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.FolderZip" OnClick="RescanCurrentFolderAsync">
                Rescan Current Folder
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" OnClick="ForceFullRescanAsync">
                Force Full Re-index
            </MudMenuItem>
        </MudMenu>

        @if (LibraryService.Items.Count > 0) {
            <MudButton Variant="Variant.Outlined" 
                       Color="@(LibraryService.IsEnriching ? Color.Warning : Color.Tertiary)" 
                       StartIcon="@(LibraryService.IsEnriching ? Icons.Material.Filled.Sync : Icons.Material.Filled.CloudDownload)" 
                       OnClick="ToggleEnrichAllCivitai">
                @(LibraryService.IsEnriching ? $"Stop Civitai ({LibraryService.EnrichCompleted}/{LibraryService.EnrichTotal})" : "Fetch Civitai Info")
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.SystemUpdateAlt" OnClick="OpenLoraUpdaterAsync">
            Lora Updater
        </MudButton>
    </div>
</div>

<!-- Search, Filter & View Toggle Bar -->
<MudCard Elevation="1" Class="mb-3" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark);">
    <MudCardContent Class="py-3">
        <MudGrid Class="align-center">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="SearchQuery" Placeholder="Search by file name, model title, trigger word, or path (press Enter or pause)..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="ExecuteSearchNow" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" DebounceInterval="1500" OnKeyDown="@HandleSearchKeyDown" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" Value="_selectedArchitecture" ValueChanged="OnArchitectureChanged" Label="Filter Library" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem Value="@("all")">All Architectures</MudSelectItem>
                    <MudSelectItem Value="@("favorites")">❤️ Favorites Only</MudSelectItem>
                    <MudSelectItem Value="@("FLUX.1")">FLUX.1</MudSelectItem>
                    <MudSelectItem Value="@("SDXL")">SDXL / Pony / Illustrious</MudSelectItem>
                    <MudSelectItem Value="@("Chroma")">Chroma</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3" Class="d-flex justify-end align-center gap-1">
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton Variant="@(_viewMode == "grid" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@Icons.Material.Filled.GridView" OnClick="@(() => _viewMode = "grid")">
                        Cards
                    </MudButton>
                    <MudButton Variant="@(_viewMode == "table" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TableRows" OnClick="@(() => _viewMode = "table")">
                        Table
                    </MudButton>
                </MudButtonGroup>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Subfolder Navigation & Breadcrumbs Bar -->
@if (!string.IsNullOrWhiteSpace(LibraryService.RootFolder)) {
    <MudCard Elevation="1" Class="pa-2 px-3 mb-3 d-flex align-center justify-space-between flex-wrap gap-2" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); border-radius: 8px;">
        <div class="d-flex align-center gap-1 flex-wrap">
            <MudTooltip Text="Up one level">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Primary" Disabled="@(string.Equals(LibraryService.CurrentFolder, LibraryService.RootFolder, StringComparison.OrdinalIgnoreCase) || _showAllFlat)" OnClick="NavigateUp" />
            </MudTooltip>
            
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="@(string.Equals(LibraryService.CurrentFolder, LibraryService.RootFolder, StringComparison.OrdinalIgnoreCase) && !_showAllFlat ? Color.Tertiary : Color.Primary)" StartIcon="@Icons.Material.Filled.FolderSpecial" OnClick="@(() => NavigateToFolder(LibraryService.RootFolder))">
                @(Path.GetFileName(LibraryService.RootFolder) is string rootName && !string.IsNullOrWhiteSpace(rootName) ? rootName : LibraryService.RootFolder)
            </MudButton>

            @if (!_showAllFlat && !string.Equals(LibraryService.CurrentFolder, LibraryService.RootFolder, StringComparison.OrdinalIgnoreCase)) {
                @foreach (var crumb in GetBreadcrumbs()) {
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="@(crumb.FullPath == LibraryService.CurrentFolder ? Color.Tertiary : Color.Primary)" OnClick="@(() => NavigateToFolder(crumb.FullPath))">
                        @crumb.Name
                    </MudButton>
                }

                <MudTooltip Text="Turn this subfolder into a separate, independent library">
                    <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Size="Size.Small" StartIcon="@Icons.Material.Filled.BookmarkAdd" Class="ml-2" OnClick="QuickConvertCurrentSubfolderToLibraryAsync">
                        Make Subfolder a Library
                    </MudButton>
                </MudTooltip>
            }
        </div>

        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @if (_showAllFlat) {
                    <span>Showing all @LibraryService.Items.Count LoRAs (Flat View)</span>
                } else if (!string.IsNullOrWhiteSpace(_searchQuery)) {
                    <span>Searching across all subfolders (@FilteredCount results)</span>
                } else {
                    <span>@FilteredCount LoRA@((FilteredCount == 1 ? "" : "s")) in this folder (@LibraryService.Items.Count total indexed)</span>
                }
            </MudText>

            <MudButton Variant="@(_showAllFlat ? Variant.Filled : Variant.Outlined)" Color="Color.Tertiary" Size="Size.Small" StartIcon="@(_showAllFlat ? Icons.Material.Filled.AccountTree : Icons.Material.Filled.Folder)" OnClick="ToggleShowAllFlat">
                @(_showAllFlat ? "Flat (All)" : "Subfolder View")
            </MudButton>
        </div>
    </MudCard>
}

@if (LibraryService.IsScanning) {
    <MudCard Elevation="0" Class="pa-3 mb-4" Style="background-color: rgba(203, 166, 247, 0.08); border: 1px solid #cba6f7; border-radius: 8px;">
        <div class="d-flex align-center justify-space-between mb-2">
            <div class="d-flex align-center gap-2">
                <MudProgressCircular Size="Size.Small" Color="Color.Tertiary" Indeterminate="@(LibraryService.TotalFiles == 0)" />
                <MudText Typo="Typo.body2" Style="color: var(--text-primary); font-weight: 600;">
                    Scanning LoRAs recursively in background: @LibraryService.ScannedCount of @LibraryService.TotalFiles (@LibraryService.CurrentScanningFile)
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelScan">
                Stop Scan
            </MudButton>
        </div>
        <MudProgressLinear Color="Color.Tertiary" Value="@(LibraryService.TotalFiles > 0 ? (double)LibraryService.ScannedCount / LibraryService.TotalFiles * 100 : 0)" Class="my-1" />
    </MudCard>
}

@if (LibraryService.IsEnriching) {
    <MudCard Elevation="0" Class="pa-3 mb-4" Style="background-color: rgba(203, 166, 247, 0.08); border: 1px solid #cba6f7; border-radius: 8px;">
        <div class="d-flex align-center justify-space-between mb-2">
            <div class="d-flex align-center gap-2">
                <MudProgressCircular Size="Size.Small" Color="Color.Tertiary" Indeterminate="@(LibraryService.EnrichTotal == 0)" />
                <MudText Typo="Typo.body2" Style="color: #cdd6f4; font-weight: 600;">
                    Fetching Civitai metadata in background: @LibraryService.CurrentEnrichingFile (@LibraryService.EnrichCompleted / @LibraryService.EnrichTotal)
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelEnrichment">
                Stop
            </MudButton>
        </div>
        @if (LibraryService.EnrichTotal > 0) {
            <MudProgressLinear Color="Color.Tertiary" Value="@((double)LibraryService.EnrichCompleted / LibraryService.EnrichTotal * 100)" Class="my-1" />
        }
    </MudCard>
}

@if (UpdaterService.IsRunning) {
    <MudCard Elevation="0" Class="pa-3 mb-4" Style="background-color: rgba(137, 180, 250, 0.08); border: 1px solid #89b4fa; border-radius: 8px;">
        <div class="d-flex align-center justify-space-between mb-2">
            <div class="d-flex align-center gap-2">
                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="@(UpdaterService.TotalFiles == 0)" />
                <MudText Typo="Typo.body2" Style="color: #cdd6f4; font-weight: 600;">
                    Lora Updater running in background: @UpdaterService.CurrentStatus
                </MudText>
            </div>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenLoraUpdaterAsync">
                    View Details
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="@(() => UpdaterService.Cancel())">
                    Stop
                </MudButton>
            </div>
        </div>
        @if (UpdaterService.TotalFiles > 0) {
            <MudProgressLinear Color="Color.Info" Value="@((double)UpdaterService.ProcessedFiles / UpdaterService.TotalFiles * 100)" Class="my-1" />
        }
    </MudCard>
}

@if (_filteredLoras.Count == 0 && _currentSubfolders.Count == 0) {
    @if (LibraryService.IsScanning) {
        <MudCard Elevation="0" Class="pa-8 text-center" Style="background-color: var(--bg-dark-surface); border: 1px dashed var(--border-dark); border-radius: 8px;">
            <MudProgressCircular Size="Size.Large" Color="Color.Tertiary" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.h6" Style="color: var(--text-primary);">Scanning Directory in Background...</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Reading model headers and local preview thumbnails. Discovered models will appear here in real time.
            </MudText>
        </MudCard>
    } else {
        <MudCard Elevation="0" Class="pa-8 text-center" Style="background-color: var(--bg-dark-surface); border: 1px dashed var(--border-dark); border-radius: 8px;">
            <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.h6" Style="color: var(--text-primary);">No LoRAs found</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @(string.IsNullOrWhiteSpace(LibraryService.RootFolder) 
                    ? "Click \"Browse Folder...\" to point to your LoRA storage directory." 
                    : (LibraryService.Items.Count == 0 
                        ? "Your library database is empty. Click \"Rescan / Sync\" to index your local LoRAs into SQLite." 
                        : "No models or subfolders match the current filter."))
            </MudText>
            @if (string.IsNullOrWhiteSpace(LibraryService.RootFolder)) {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="BrowseLibraryFolderAsync">
                    Select LoRA Folder
                </MudButton>
            } else if (LibraryService.Items.Count == 0) {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" OnClick="RescanDeltaAsync">
                    Scan Library Now
                </MudButton>
            }
        </MudCard>
    }
} else if (_viewMode == "grid") {
    <!-- Visual Card Grid -->
    <MudGrid>
        <!-- Subfolder Cards -->
        @if (!_showAllFlat && string.IsNullOrWhiteSpace(_searchQuery) && CurrentSubfoldersSnapshot.Count > 0) {
            @foreach (var sub in CurrentSubfoldersSnapshot) {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="1" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); border-radius: 10px; cursor: pointer; height: 100%; min-height: 140px; display: flex; flex-direction: column; justify-content: space-between;" Class="pa-4" @onclick="@(() => NavigateToFolder(sub.FullPath))">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Large" Color="Color.Tertiary" />
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: var(--text-primary); line-height: 1.2;">@sub.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@sub.LoraCount LoRA@((sub.LoraCount == 1 ? "" : "s"))</MudText>
                                </div>
                            </div>
                            <div class="d-flex align-center gap-1">
                                <MudTooltip Text="Turn this subfolder into a separate library">
                                    <MudIconButton Icon="@Icons.Material.Filled.BookmarkAdd" Size="Size.Small" Color="Color.Primary" OnClick="@((e) => ConvertFolderToLibraryAsync(sub.FullPath, sub.Name))" />
                                </MudTooltip>
                                <MudTooltip Text="Rescan Subfolder">
                                    <MudIconButton Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Color="Color.Tertiary" OnClick="@((e) => RescanSubfolder(sub.FullPath))" />
                                </MudTooltip>
                            </div>
                        </div>
                        <div class="d-flex align-center justify-space-between mt-3">
                            <MudText Typo="Typo.caption" Style="color: #6c7086; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 150px;">
                                @sub.RelativePath
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Browse</MudChip>
                        </div>
                    </MudCard>
                </MudItem>
            }
        }

        <!-- LoRA Model Cards (Paged) -->
        @foreach (var lora in PagedLoras) {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="1" Style="background-color: var(--bg-dark-surface); border: 1px solid var(--border-dark); border-radius: 10px; overflow: hidden; height: 100%; display: flex; flex-direction: column;">
                    <!-- Thumbnail Container -->
                    <div style="position: relative; width: 100%; height: 220px; background-color: var(--bg-dark-base); display: flex; align-items: center; justify-content: center; overflow: hidden;">
                        @{
                            string thumbSrc = GetImageSrc(lora.ThumbnailPath);
                        }
                        @if (!string.IsNullOrEmpty(thumbSrc)) {
                            <img src="@thumbSrc" alt="@lora.FileName" style="width: 100%; height: 100%; object-fit: cover;" />
                        } else {
                            <div class="d-flex flex-column align-center justify-center p-4 text-center" style="width: 100%; height: 100%; background: linear-gradient(135deg, rgba(203,166,247,0.1), rgba(137,180,250,0.05));">
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Large" Color="Color.Secondary" Style="opacity: 0.4;" Class="mb-1" />
                                <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">No Preview Thumbnail</MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => FetchSingleCivitaiAsync(lora))" Class="mt-1" Style="font-size: 0.7rem;">
                                    Find on Civitai
                                </MudButton>
                            </div>
                        }

                        <!-- Base Model Overlay Selector Badge -->
                        <div style="position: absolute; top: 10px; left: 10px; z-index: 2;">
                            <MudMenu Dense="true" Size="Size.Small">
                                <ActivatorContent>
                                    <MudChip T="string" Size="Size.Small" Color="@GetArchitectureColor(lora.EffectiveBaseModel)" Variant="Variant.Filled" Style="font-weight: 600; font-size: 0.7rem; cursor: pointer;">
                                        @lora.EffectiveBaseModel
                                    </MudChip>
                                </ActivatorContent>
                                <ChildContent>
                                    <MudMenuItem OnClick="@(() => SetBaseModelAsync(lora, "FLUX.1"))">FLUX.1</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => SetBaseModelAsync(lora, "SDXL"))">SDXL</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => SetBaseModelAsync(lora, "Pony"))">Pony</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => SetBaseModelAsync(lora, "Illustrious"))">Illustrious</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => SetBaseModelAsync(lora, "Chroma"))">Chroma</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => SetBaseModelAsync(lora, "SD 1.5"))">SD 1.5</MudMenuItem>
                                    <MudDivider />
                                    <MudMenuItem OnClick="@(() => SetBaseModelAsync(lora, null))">Reset to Auto (@lora.BaseModel)</MudMenuItem>
                                </ChildContent>
                            </MudMenu>
                        </div>

                        <!-- Favorite Toggle Button -->
                        <div style="position: absolute; top: 8px; right: 8px; z-index: 2;">
                            <MudTooltip Text="@(lora.IsFavorite ? "Remove from Favorites" : "Mark as Favorite")">
                                <MudIconButton Icon="@(lora.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)" 
                                               Color="@(lora.IsFavorite ? Color.Error : Color.Default)" 
                                               Size="Size.Small" 
                                               Style="@(lora.IsFavorite ? "background: rgba(0,0,0,0.5);" : "background: rgba(0,0,0,0.3);")"
                                               OnClick="@(() => ToggleFavoriteAsync(lora))" />
                            </MudTooltip>
                        </div>

                        <!-- Size Badge -->
                        <div style="position: absolute; bottom: 8px; right: 10px; background: var(--bg-dark-overlay); padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; color: var(--text-primary);">
                            @lora.FormattedSize
                        </div>
                    </div>

                    <MudCardContent Class="py-3 px-3" Style="flex: 1;">
                        <MudTooltip Text="@(lora.FileName ?? string.Empty)">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: var(--text-primary); line-height: 1.2; word-break: break-all;">
                                @(lora.CivitaiInfo != null && !string.IsNullOrWhiteSpace(lora.CivitaiInfo.ModelName) ? lora.CivitaiInfo.ModelName : (lora.FileName ?? "Unknown"))
                            </MudText>
                        </MudTooltip>
                        @if (lora.CivitaiInfo != null && !string.IsNullOrWhiteSpace(lora.CivitaiInfo.VersionName)) {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@lora.CivitaiInfo.VersionName</MudText>
                        }

                        @if (_showAllFlat || !string.IsNullOrWhiteSpace(_searchQuery)) {
                            <div class="mt-1" style="font-size: 0.7rem; color: #6c7086; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                📁 @GetRelativeSubfolder(lora.FilePath)
                            </div>
                        }

                        <!-- Trigger Word Badge -->
                        @if (GetPrimaryTrigger(lora) is string trigger && !string.IsNullOrWhiteSpace(trigger)) {
                            <div class="d-flex align-center justify-space-between p-1 px-2 my-2" style="background-color: var(--bg-dark-base); border: 1px solid var(--border-dark); border-radius: 6px;">
                                <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--accent-purple); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 170px;">
                                    @trigger
                                </div>
                                <MudTooltip Text="Copy trigger word">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary" OnClick="@(() => CopyToClipboardAsync(trigger))" />
                                </MudTooltip>
                            </div>
                        }

                        <!-- Hyperparameters Quick Matrix -->
                        <div class="d-grid mt-2" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; text-align: center;">
                            <div style="background-color: var(--bg-dark-base); padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: var(--text-secondary);">DIM/ALPHA</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: var(--text-primary);">@(lora.NetworkDim?.ToString() ?? "-")/@(lora.NetworkAlpha?.ToString() ?? "-")</div>
                            </div>
                            <div style="background-color: var(--bg-dark-base); padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: var(--text-secondary);">LR</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: var(--text-primary);">@(lora.LearningRate?.ToString("0.e+0") ?? "-")</div>
                            </div>
                            <div style="background-color: var(--bg-dark-base); padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: var(--text-secondary);">STEPS</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: var(--text-primary);">@(lora.TotalSteps?.ToString() ?? "-")</div>
                            </div>
                        </div>
                    </MudCardContent>

                    <!-- Card Actions -->
                    <MudCardActions Class="px-3 py-2 d-flex justify-space-between align-center" Style="border-top: 1px solid var(--border-dark);">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" OnClick="@(() => UseLoraTrainingSettings(lora))">
                            Use Settings
                        </MudButton>
                        <div class="d-flex gap-1">
                            <MudTooltip Text="Test / Render in ComfyUI">
                                <MudIconButton Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Color="Color.Success" OnClick="@(() => OpenComfyUiTestAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="LoRA Surgery & SVD Resizing">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => OpenLoraSurgeryAsync(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="LoRA Gene Therapy & Outlier Pruning">
