    private void NavigateUp() {
        string current = LibraryService.CurrentFolder;
        string root = LibraryService.RootFolder;
        if (string.IsNullOrWhiteSpace(current) || string.IsNullOrWhiteSpace(root)) {
            return;
        }
        if (string.Equals(current.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                          root.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                          StringComparison.OrdinalIgnoreCase)) {
            return;
        }

        string? parent = Path.GetDirectoryName(current.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
        if (!string.IsNullOrEmpty(parent) && parent.StartsWith(root, StringComparison.OrdinalIgnoreCase)) {
            LibraryService.SetCurrentSubfolder(parent);
        } else {
            LibraryService.SetCurrentSubfolder(root);
        }
        _currentPage = 1;
        UpdateFilteredList();
        StateHasChanged();
    }

    private string GetRelativeSubfolder(string? filePath) {
        if (string.IsNullOrWhiteSpace(filePath)) {
            return string.Empty;
        }
        try {
            string root = LibraryService.RootFolder;
            string? dir = Path.GetDirectoryName(filePath);
            if (string.IsNullOrEmpty(dir)) {
                return string.Empty;
            }
            if (string.IsNullOrWhiteSpace(root)) {
                return dir;
            }
            string rel = Path.GetRelativePath(root, dir);
            return rel == "." ? "Root" : rel;
        } catch {
            try {
                return Path.GetFileName(Path.GetDirectoryName(filePath)) ?? string.Empty;
            } catch {
                return string.Empty;
            }
        }
    }

