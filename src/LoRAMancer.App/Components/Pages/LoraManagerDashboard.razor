    private static string? GetPrimaryTrigger(LoraMetadata? lora) {
        if (lora == null) {
            return null;
        }
        try {
            if (lora.TrainedWords != null && lora.TrainedWords.Count > 0) {
                string? first = lora.TrainedWords.FirstOrDefault(w => !string.IsNullOrWhiteSpace(w));
                if (!string.IsNullOrWhiteSpace(first)) {
                    return first;
                }
            }
            if (lora.CivitaiInfo?.TrainedWords != null && lora.CivitaiInfo.TrainedWords.Count > 0) {
                string? firstCiv = lora.CivitaiInfo.TrainedWords.FirstOrDefault(w => !string.IsNullOrWhiteSpace(w));
                if (!string.IsNullOrWhiteSpace(firstCiv)) {
                    return firstCiv;
                }
            }
            if (lora.RawHeaderMetadata != null && lora.RawHeaderMetadata.TryGetValue("ss_tag_frequency", out var tags) && !string.IsNullOrWhiteSpace(tags)) {
                return tags.Split(new[] { ',', '{', '}', '"', ':', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                           .Select(t => t.Trim())
                           .FirstOrDefault(t => !string.IsNullOrWhiteSpace(t) && !int.TryParse(t, out _));
            }
        } catch { }
        return null;
    }

    private string GetImageSrc(string? path) {
        if (string.IsNullOrWhiteSpace(path) || _disposed) {
            return string.Empty;
        }
        if (_thumbnailCache.TryGetValue(path, out var cached)) {
            return cached;
        }
        if (_loadingThumbnails.TryAdd(path, 0)) {
            var token = _cts.Token;
            _ = Task.Run(async () => {
                try {
                    if (!_disposed && !token.IsCancellationRequested && File.Exists(path)) {
                        byte[] bytes = await File.ReadAllBytesAsync(path, token);
                        string ext = Path.GetExtension(path).ToLowerInvariant();
                        string mime = ext switch {
                            ".png" => "image/png",
                            ".webp" => "image/webp",
                            _ => "image/jpeg"
                        };
                        string dataUri = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
                        _thumbnailCache[path] = dataUri;
                        if (!_disposed && !token.IsCancellationRequested) {
                            await SafeInvokeAsync(StateHasChanged);
                        }
                    }
                } catch {
                    // Graceful fallback to prevent unhandled exception if file is locked or unreadable
                } finally {
                    _loadingThumbnails.TryRemove(path, out _);
                }
            }, token);
        }
        return string.Empty;
    }

    private static Color GetArchitectureColor(string? arch) {
        if (string.IsNullOrWhiteSpace(arch)) {
            return Color.Default;
        }
        if (arch.Contains("flux", StringComparison.OrdinalIgnoreCase)) return Color.Tertiary;
        if (arch.Contains("sdxl", StringComparison.OrdinalIgnoreCase)) return Color.Info;
        if (arch.Contains("pony", StringComparison.OrdinalIgnoreCase)) return Color.Secondary;
        return Color.Default;
    }

