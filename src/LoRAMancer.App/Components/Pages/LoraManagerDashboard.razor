                await SafeInvokeAsync(() => {
                    if (info != null) {
                        Snackbar.Add($"Identified as '{info.ModelName}' from Civitai!", Severity.Success);
                    } else {
                        Snackbar.Add($"No matching model found on Civitai for {lora.FileName}.", Severity.Normal);
                    }
                    UpdateFilteredList();
                    StateHasChanged();
                });
            } catch {
                // Suppress background lookup errors
            }
        });
    }

    private void ToggleEnrichAllCivitai() {
        if (LibraryService.IsEnriching) {
            LibraryService.CancelEnrichment();
            Snackbar.Add("Civitai background lookup stopped.", Severity.Info);
        } else {
            var count = LibraryService.Items.Count(x => x.CivitaiInfo == null);
            if (count == 0) {
                Snackbar.Add("All LoRAs already have Civitai metadata.", Severity.Info);
                return;
            }
            LibraryService.StartBackgroundEnrichment();
            Snackbar.Add($"Fetching Civitai metadata for {count} models in the background...", Severity.Info);
        }
    }

