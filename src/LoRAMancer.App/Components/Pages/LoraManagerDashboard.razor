<!-- Metadata Inspector Drawer -->
<MetadataInspectorDrawer @bind-IsOpen="_drawerOpen" Metadata="_selectedLora" />

@code {
    private bool _drawerOpen;
    private LoraMetadata? _selectedLora;

    private bool _showAllFlat;
    private string _viewMode = "grid";
    private string _searchQuery = string.Empty;
    private string _selectedArchitecture = "all";

    private int _currentPage = 1;
    private const int _pageSize = 24;

    private bool _disposed;
    private readonly CancellationTokenSource _cts = new();
    private readonly object _filterLock = new();
    private static readonly ConcurrentDictionary<string, string> _thumbnailCache = new(StringComparer.OrdinalIgnoreCase);
    private static readonly ConcurrentDictionary<string, byte> _loadingThumbnails = new(StringComparer.OrdinalIgnoreCase);

    private sealed record SubfolderItem(string Name, string FullPath, string RelativePath, int LoraCount);
    private sealed record CrumbItem(string Name, string FullPath);

    private List<SubfolderItem> _currentSubfolders = new();
    private List<LoraMetadata> _filteredLoras = new();

    private IReadOnlyList<SubfolderItem> CurrentSubfoldersSnapshot {
        get {
            lock (_filterLock) {
                return _currentSubfolders?.ToList() ?? new List<SubfolderItem>();
            }
        }
    }

    private int FilteredCount {
        get {
            lock (_filterLock) {
                return _filteredLoras?.Count ?? 0;
            }
        }
    }

    private IReadOnlyList<LoraMetadata> FilteredLorasSnapshot {
        get {
            lock (_filterLock) {
                return _filteredLoras?.ToList() ?? new List<LoraMetadata>();
            }
        }
    }

    private int TotalPages {
        get {
            lock (_filterLock) {
                int count = _filteredLoras?.Count ?? 0;
                return Math.Max(1, (int)Math.Ceiling((double)count / _pageSize));
            }
        }
    }

    private IReadOnlyList<LoraMetadata> PagedLoras {
        get {
            try {
                lock (_filterLock) {
                    if (_filteredLoras == null || _filteredLoras.Count == 0) {
                        return Array.Empty<LoraMetadata>();
                    }
                    int totalPages = Math.Max(1, (int)Math.Ceiling((double)_filteredLoras.Count / _pageSize));
                    if (_currentPage > totalPages || _currentPage < 1) {
                        _currentPage = 1;
                    }
                    int skip = (_currentPage - 1) * _pageSize;
                    if (skip >= _filteredLoras.Count) {
                        skip = 0;
                        _currentPage = 1;
                    }
                    return _filteredLoras.Skip(skip).Take(_pageSize).ToList();
                }
            } catch {
                return Array.Empty<LoraMetadata>();
            }
        }
    }

    private string SearchQuery {
        get => _searchQuery;
        set {
            string newVal = value ?? string.Empty;
            if (_searchQuery != newVal) {
                _searchQuery = newVal;
                _currentPage = 1;
                UpdateFilteredList();
                _ = SafeInvokeAsync(StateHasChanged);
            }
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            ExecuteSearchNow();
        }
    }

    private void ExecuteSearchNow() {
        _currentPage = 1;
        UpdateFilteredList();
        _ = SafeInvokeAsync(StateHasChanged);
    }

    private async Task SafeInvokeAsync(Action action) {
        if (_disposed) {
            return;
        }
        try {
            await InvokeAsync(() => {
                if (!_disposed) {
                    try {
                        action();
                    } catch {
                        // Suppress UI action exceptions
                    }
                }
            });
        } catch {
            // Suppress dispatcher teardown or cancellation exceptions
        }
    }

    private void UpdateFilteredList() {
        try {
            string current = LibraryService.CurrentFolder;
            string root = LibraryService.RootFolder;
            var items = LibraryService.Items;

            // Instantly compute subfolders directly from SQLite-loaded items without disk blocking
            UpdateSubfolders(current, root, items);

            // Update filtered LoRAs
            string query = _searchQuery?.Trim() ?? string.Empty;
            string arch = _selectedArchitecture ?? "all";

            var filtered = items.Where(l => {
                if (l == null) {
                    return false;
                }

                // Folder matching
                if (!_showAllFlat && string.IsNullOrWhiteSpace(query) && !string.IsNullOrWhiteSpace(current)) {
                    string dir = Path.GetDirectoryName(l.FilePath ?? string.Empty) ?? string.Empty;
                    if (!string.Equals(dir.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                                      current.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                                      StringComparison.OrdinalIgnoreCase)) {
                        return false;
                    }
                }

                // Architecture or Favorite matching
                if (string.Equals(arch, "favorites", StringComparison.OrdinalIgnoreCase)) {
                    if (!l.IsFavorite) {
                        return false;
                    }
                } else if (!string.Equals(arch, "all", StringComparison.OrdinalIgnoreCase)) {
                    string effective = l.EffectiveBaseModel;
                    if (string.IsNullOrWhiteSpace(effective) || !effective.Contains(arch, StringComparison.OrdinalIgnoreCase)) {
                        return false;
                    }
                }

                // Search query matching
                if (!string.IsNullOrWhiteSpace(query)) {
                    bool matchName = l.FileName != null && l.FileName.Contains(query, StringComparison.OrdinalIgnoreCase);
                    bool matchModel = l.CivitaiInfo?.ModelName != null && l.CivitaiInfo.ModelName.Contains(query, StringComparison.OrdinalIgnoreCase);
                    bool matchPath = l.FilePath != null && l.FilePath.Contains(query, StringComparison.OrdinalIgnoreCase);
                    bool matchTriggers = false;
                    try {
                        if (l.TrainedWords != null && l.TrainedWords.Count > 0) {
                            matchTriggers = l.TrainedWords.Any(w => !string.IsNullOrWhiteSpace(w) && w.Contains(query, StringComparison.OrdinalIgnoreCase));
                        }
                        if (!matchTriggers && l.CivitaiInfo?.TrainedWords != null && l.CivitaiInfo.TrainedWords.Count > 0) {
                            matchTriggers = l.CivitaiInfo.TrainedWords.Any(w => !string.IsNullOrWhiteSpace(w) && w.Contains(query, StringComparison.OrdinalIgnoreCase));
                        }
                        if (query.Length >= 3 && !matchTriggers && l.RawHeaderMetadata != null && l.RawHeaderMetadata.TryGetValue("ss_tag_frequency", out var tags) && !string.IsNullOrWhiteSpace(tags)) {
                            matchTriggers = tags.Contains(query, StringComparison.OrdinalIgnoreCase);
                        }
                    } catch { }

                    if (!matchName && !matchModel && !matchPath && !matchTriggers) {
                        return false;
                    }
                }

                return true;
            }).ToList();

            lock (_filterLock) {
                _filteredLoras = filtered;
            }

            if (_currentPage > TotalPages) {
                _currentPage = Math.Max(1, TotalPages);
            }
        } catch {
            lock (_filterLock) {
                _filteredLoras = new List<LoraMetadata>();
            }
            _currentSubfolders = new List<SubfolderItem>();
        }
    }

    private void UpdateSubfolders(string current, string root, IReadOnlyList<LoraMetadata> items) {
        if (_showAllFlat || string.IsNullOrWhiteSpace(current)) {
            _currentSubfolders = new List<SubfolderItem>();
            return;
        }

        try {
            string currentNorm = current.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
            var subfolderMap = new Dictionary<string, (string FullPath, int Count)>(StringComparer.OrdinalIgnoreCase);

            // Extract immediate child subfolders directly from SQLite database items
            foreach (var item in items) {
                if (string.IsNullOrWhiteSpace(item.FilePath)) continue;
                if (item.FilePath.StartsWith(currentNorm, StringComparison.OrdinalIgnoreCase)) {
                    string relPath = item.FilePath.Substring(currentNorm.Length);
                    int slashIdx = relPath.IndexOfAny(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar });
                    if (slashIdx > 0) {
                        string subName = relPath.Substring(0, slashIdx);
                        string fullSubPath = Path.Combine(current, subName);
                        if (subfolderMap.TryGetValue(subName, out var existing)) {
                            subfolderMap[subName] = (existing.FullPath, existing.Count + 1);
                        } else {
                            subfolderMap[subName] = (fullSubPath, 1);
                        }
                    }
                }
            }

            // Also check for empty folders on local disk if current directory exists
            if (Directory.Exists(current)) {
                try {
                    foreach (string dir in Directory.GetDirectories(current)) {
                        string name = Path.GetFileName(dir);
                        if (!name.StartsWith('.') && !subfolderMap.ContainsKey(name)) {
                            subfolderMap[name] = (dir, 0);
                        }
                    }
                } catch {
                    // Suppress any disk access permission errors
                }
            }

            var list = new List<SubfolderItem>();
            foreach (var kvp in subfolderMap) {
                string rel = string.IsNullOrWhiteSpace(root) ? kvp.Key : Path.GetRelativePath(root, kvp.Value.FullPath);
                list.Add(new SubfolderItem(kvp.Key, kvp.Value.FullPath, rel, kvp.Value.Count));
            }
            _currentSubfolders = list.OrderBy(s => s.Name).ToList();
        } catch {
            _currentSubfolders = new List<SubfolderItem>();
        }
    }

    private void OnArchitectureChanged(string arch) {
        _selectedArchitecture = arch;
        _currentPage = 1;
        UpdateFilteredList();
    }

    private void ToggleShowAllFlat() {
        _showAllFlat = !_showAllFlat;
        _currentPage = 1;
        UpdateFilteredList();
    }

    private void OnPageChanged(int page) {
        _currentPage = page;
        StateHasChanged();
    }

    private async Task ToggleFavoriteAsync(LoraMetadata lora) {
        await LibraryService.ToggleFavoriteAsync(lora);
        UpdateFilteredList();
        StateHasChanged();
    }

    private async Task SetBaseModelAsync(LoraMetadata lora, string? baseModel) {
        await LibraryService.SetUserBaseModelAsync(lora, baseModel);
        UpdateFilteredList();
        Snackbar.Add(baseModel != null ? $"Assigned '{baseModel}' to {lora.FileName}" : $"Reset {lora.FileName} to detected base model", Severity.Info);
        StateHasChanged();
    }

    private async Task RefreshLoraAsync(LoraMetadata lora) {
        await LibraryService.RefreshSingleLoraAsync(lora);
        UpdateFilteredList();
        Snackbar.Add($"Refreshed {lora.FileName}", Severity.Success);
        StateHasChanged();
    }

    private void RescanDeltaAsync() {
        if (!string.IsNullOrWhiteSpace(LibraryService.RootFolder)) {
            LibraryService.StartScan(LibraryService.RootFolder, forceClear: false);
            Snackbar.Add("Rescanning library for new or modified models...", Severity.Info);
        }
    }

    private void RescanCurrentFolderAsync() {
        string target = !string.IsNullOrWhiteSpace(LibraryService.CurrentFolder) ? LibraryService.CurrentFolder : LibraryService.RootFolder;
        if (!string.IsNullOrWhiteSpace(target)) {
            LibraryService.StartScan(target, forceClear: false);
            Snackbar.Add($"Rescanning {Path.GetFileName(target)}...", Severity.Info);
        }
    }

    private void ForceFullRescanAsync() {
        if (!string.IsNullOrWhiteSpace(LibraryService.RootFolder)) {
            LibraryService.StartScan(LibraryService.RootFolder, forceClear: true);
            Snackbar.Add("Initiated full library re-index...", Severity.Info);
        }
    }

    private void RescanSubfolder(string subfolderPath) {
        if (Directory.Exists(subfolderPath)) {
            LibraryService.StartScan(subfolderPath, forceClear: false);
            Snackbar.Add($"Rescanning {Path.GetFileName(subfolderPath)}...", Severity.Info);
        }
    }

    private List<CrumbItem> GetBreadcrumbs() {
        List<CrumbItem> crumbs = new();
        string root = LibraryService.RootFolder;
        string current = LibraryService.CurrentFolder;
        if (string.IsNullOrWhiteSpace(root) || string.IsNullOrWhiteSpace(current)) {
            return crumbs;
        }

        try {
            string rel = Path.GetRelativePath(root, current);
            if (string.IsNullOrWhiteSpace(rel) || rel == ".") {
                return crumbs;
            }

            string[] parts = rel.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries);
            string currentAccum = root;
            foreach (string part in parts) {
                currentAccum = Path.Combine(currentAccum, part);
                crumbs.Add(new CrumbItem(part, currentAccum));
            }
        } catch {
            // Fallback empty
        }

        return crumbs;
    }

    private void NavigateToFolder(string folderPath) {
        if (Directory.Exists(folderPath)) {
            LibraryService.SetCurrentSubfolder(folderPath);
            _showAllFlat = false;
            _currentPage = 1;
            UpdateFilteredList();
            StateHasChanged();
        }
    }

    private void NavigateUp() {
        string current = LibraryService.CurrentFolder;
        string root = LibraryService.RootFolder;
        if (string.IsNullOrWhiteSpace(current) || string.IsNullOrWhiteSpace(root)) {
            return;
        }
        if (string.Equals(current.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                          root.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                          StringComparison.OrdinalIgnoreCase)) {
            return;
        }

        string? parent = Path.GetDirectoryName(current.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
        if (!string.IsNullOrEmpty(parent) && parent.StartsWith(root, StringComparison.OrdinalIgnoreCase)) {
            LibraryService.SetCurrentSubfolder(parent);
        } else {
            LibraryService.SetCurrentSubfolder(root);
        }
        _currentPage = 1;
        UpdateFilteredList();
        StateHasChanged();
    }

    private string GetRelativeSubfolder(string? filePath) {
        if (string.IsNullOrWhiteSpace(filePath)) {
            return string.Empty;
        }
        try {
            string root = LibraryService.RootFolder;
            string? dir = Path.GetDirectoryName(filePath);
            if (string.IsNullOrEmpty(dir)) {
                return string.Empty;
            }
            if (string.IsNullOrWhiteSpace(root)) {
                return dir;
            }
            string rel = Path.GetRelativePath(root, dir);
            return rel == "." ? "Root" : rel;
        } catch {
            try {
                return Path.GetFileName(Path.GetDirectoryName(filePath)) ?? string.Empty;
            } catch {
                return string.Empty;
            }
        }
    }

    private async Task BrowseLoraFileAsync() {
        string? file = await FileDialogService.PickSafeTensorsFileAsync();
        if (!string.IsNullOrEmpty(file)) {
            await LoadSingleLoraAsync(file);
        }
    }

    private async Task BrowseLibraryFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select LoRA Storage Directory");
        if (!string.IsNullOrEmpty(folder)) {
            _showAllFlat = false;
            _currentPage = 1;
            LibraryService.StartScan(folder, forceClear: false);
            UpdateFilteredList();
            Snackbar.Add($"Indexing {Path.GetFileName(folder)} in background...", Severity.Info);
        }
    }

    private async Task LoadSingleLoraAsync(string filePath) {
        try {
            LoraMetadata meta = await MetadataReader.ReadMetadataAsync(filePath);
            LibraryService.FindLocalThumbnail(meta);
            LibraryService.AddOrUpdateLora(meta);

            if (string.IsNullOrWhiteSpace(LibraryService.RootFolder)) {
                string dir = Path.GetDirectoryName(filePath) ?? string.Empty;
                LibraryService.SetFolders(dir, dir);
            }

            UpdateFilteredList();
            Snackbar.Add($"Loaded {meta.FileName}", Severity.Success);

            // Fetch Civitai metadata asynchronously in background without blocking UI
            _ = Task.Run(async () => {
                try {
                    var info = await LibraryService.EnrichFromCivitaiAsync(meta);
                    if (info != null) {
                        await SafeInvokeAsync(() => {
                            UpdateFilteredList();
                            StateHasChanged();
                        });
                    }
                } catch {
                    // Suppress background lookup errors
                }
            });
        } catch (Exception ex) {
            Snackbar.Add($"Failed to read {Path.GetFileName(filePath)}: {ex.Message}", Severity.Error);
        }
    }

    private void CancelScan() {
        LibraryService.CancelScan();
        Snackbar.Add("Background scan stopped.", Severity.Info);
    }

    protected override async Task OnInitializedAsync() {
        LibraryService.OnLibraryUpdated += HandleLibraryUpdated;
        LibraryService.OnLibrariesChanged += HandleLibrariesChanged;
        LibraryService.OnScanProgress += HandleScanProgress;
        LibraryService.OnScanStateChanged += HandleScanStateChanged;
        LibraryService.OnEnrichStateChanged += HandleEnrichStateChanged;
        LibraryService.OnEnrichProgress += HandleEnrichProgress;
        LibraryService.OnLoraEnriched += HandleLoraEnriched;
        UpdaterService.OnStateChanged += HandleUpdaterStateChanged;

        // Directly sync from SQLite database if items are not yet in memory
        if (LibraryService.Items.Count == 0) {
            await LibraryService.LoadFromDatabaseAsync();
        }

        UpdateFilteredList();
    }

    private void HandleLibrariesChanged() {
        _ = SafeInvokeAsync(() => {
            UpdateFilteredList();
            StateHasChanged();
        });
    }

    private void HandleLibraryUpdated() {
        _ = SafeInvokeAsync(() => {
            UpdateFilteredList();
            StateHasChanged();
        });
    }

    private void HandleScanProgress(string file, int current, int total) {
        _ = SafeInvokeAsync(StateHasChanged);
    }

    private void HandleScanStateChanged(bool isScanning) {
        _ = SafeInvokeAsync(() => {
            UpdateFilteredList();
            StateHasChanged();
        });
