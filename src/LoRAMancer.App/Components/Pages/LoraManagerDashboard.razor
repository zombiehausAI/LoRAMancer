    }

    private async Task CreateCollectionFromManagerAsync() {
        string name = _createColName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(name)) return;

        try {
            var col = await LibraryService.CreateCollectionAsync(name, _createColDesc?.Trim());
            _createColName = string.Empty;
            _createColDesc = string.Empty;
            Snackbar.Add($"Created collection '{col.Name}'", Severity.Success);
            StateHasChanged();
        } catch (Exception ex) {
            Snackbar.Add($"Failed to create collection: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteCollectionAsync(string collectionId) {
        try {
            await LibraryService.DeleteCollectionAsync(collectionId);
            if (_selectedCollection?.Id == collectionId) {
                ClearCollectionFilter();
            }
            Snackbar.Add("Collection deleted", Severity.Info);
            StateHasChanged();
        } catch (Exception ex) {
            Snackbar.Add($"Failed to delete collection: {ex.Message}", Severity.Error);
        }
    }
}
