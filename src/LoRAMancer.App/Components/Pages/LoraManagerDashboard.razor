    private static string? GetPrimaryTrigger(LoraMetadata? lora) {
        if (lora == null) {
            return null;
        }
        try {
            if (lora.TrainedWords != null && lora.TrainedWords.Count > 0) {
                string? first = lora.TrainedWords.FirstOrDefault(w => !string.IsNullOrWhiteSpace(w));
                if (!string.IsNullOrWhiteSpace(first)) {
                    return first;
                }
            }
            if (lora.CivitaiInfo?.TrainedWords != null && lora.CivitaiInfo.TrainedWords.Count > 0) {
                string? firstCiv = lora.CivitaiInfo.TrainedWords.FirstOrDefault(w => !string.IsNullOrWhiteSpace(w));
                if (!string.IsNullOrWhiteSpace(firstCiv)) {
                    return firstCiv;
                }
            }
            if (lora.RawHeaderMetadata != null && lora.RawHeaderMetadata.TryGetValue("ss_tag_frequency", out var tags) && !string.IsNullOrWhiteSpace(tags)) {
                return tags.Split(new[] { ',', '{', '}', '"', ':', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                           .Select(t => t.Trim())
                           .FirstOrDefault(t => !string.IsNullOrWhiteSpace(t) && !int.TryParse(t, out _));
            }
        } catch { }
        return null;
    }

    private static bool IsSupportedImageHeader(ReadOnlySpan<byte> header) {
        if (header.Length < 4) {
            return false;
        }

        // PNG: 89 50 4E 47
        if (header[0] == 0x89 && header[1] == 0x50 && header[2] == 0x4E && header[3] == 0x47) {
            return true;
        }

        // JPEG: FF D8 FF
        if (header[0] == 0xFF && header[1] == 0xD8 && header[2] == 0xFF) {
            return true;
        }

        // GIF: GIF8
        if (header[0] == 0x47 && header[1] == 0x49 && header[2] == 0x46 && header[3] == 0x38) {
            return true;
        }

        // WebP: RIFF....WEBP
        if (header.Length >= 12 &&
            header[0] == 0x52 && header[1] == 0x49 && header[2] == 0x46 && header[3] == 0x46 &&
            header[8] == 0x57 && header[9] == 0x45 && header[10] == 0x42 && header[11] == 0x50) {
            return true;
        }

        return false;
    }

    private static async Task<string> CreateSafeThumbnailDataUriAsync(string path, CancellationToken token) {
        if (!File.Exists(path)) {
            return string.Empty;
        }

        FileInfo fileInfo = new(path);
        // Absolute safety ceiling: files over 80MB or 0 bytes are never valid display thumbnails
        if (fileInfo.Length == 0 || fileInfo.Length > 80 * 1024 * 1024) {
            return string.Empty;
        }

        await using FileStream stream = new(path, FileMode.Open, FileAccess.Read, FileShare.Read, 4096, useAsync: true);
        byte[] headerBytes = new byte[16];
        int headerRead = await stream.ReadAsync(headerBytes.AsMemory(0, 16), token);
        if (!IsSupportedImageHeader(headerBytes.AsSpan(0, headerRead))) {
            // Reject non-image payloads (such as MP4 video files saved with .png extensions)
            return string.Empty;
        }

        stream.Position = 0;

        // If file is already small (<= 1.5 MB), convert directly to base64
        if (stream.Length <= 1536 * 1024) {
            byte[] bytes = new byte[stream.Length];
            await stream.ReadExactlyAsync(bytes, token);
            string ext = Path.GetExtension(path).ToLowerInvariant();
            string mime = ext switch {
                ".png" => "image/png",
                ".webp" => "image/webp",
                _ => "image/jpeg"
            };
            return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }

        // For larger images (1.5MB - 80MB), downscale using Windows.Graphics.Imaging to avoid IPC limits
        try {
            using var randomAccessStream = System.IO.WindowsRuntimeStreamExtensions.AsRandomAccessStream(stream);
            var decoder = await Windows.Graphics.Imaging.BitmapDecoder.CreateAsync(randomAccessStream);

            uint origW = decoder.PixelWidth;
            uint origH = decoder.PixelHeight;
            const uint maxDim = 400;
            uint targetW = origW;
            uint targetH = origH;

            if (origW > maxDim || origH > maxDim) {
                if (origW >= origH) {
                    targetH = Math.Max(1, (uint)Math.Round((double)origH * maxDim / origW));
                    targetW = maxDim;
                } else {
                    targetW = Math.Max(1, (uint)Math.Round((double)origW * maxDim / origH));
                    targetH = maxDim;
                }
            }

            var transform = new Windows.Graphics.Imaging.BitmapTransform {
                ScaledWidth = targetW,
                ScaledHeight = targetH,
                InterpolationMode = Windows.Graphics.Imaging.BitmapInterpolationMode.Linear
            };

            var pixelData = await decoder.GetPixelDataAsync(
                Windows.Graphics.Imaging.BitmapPixelFormat.Bgra8,
                Windows.Graphics.Imaging.BitmapAlphaMode.Premultiplied,
                transform,
                Windows.Graphics.Imaging.ExifOrientationMode.RespectExifOrientation,
                Windows.Graphics.Imaging.ColorManagementMode.ColorManageToSRgb
            );

            byte[] pixels = pixelData.DetachPixelData();
            using var outStream = new Windows.Storage.Streams.InMemoryRandomAccessStream();
            var encoder = await Windows.Graphics.Imaging.BitmapEncoder.CreateAsync(Windows.Graphics.Imaging.BitmapEncoder.JpegEncoderId, outStream);
            encoder.SetPixelData(
                Windows.Graphics.Imaging.BitmapPixelFormat.Bgra8,
                Windows.Graphics.Imaging.BitmapAlphaMode.Premultiplied,
                targetW,
                targetH,
                96,
                96,
                pixels
            );
            await encoder.FlushAsync();

            using MemoryStream ms = new();
            outStream.Seek(0);
            await System.IO.WindowsRuntimeStreamExtensions.AsStreamForRead(outStream).CopyToAsync(ms, token);
            byte[] thumbBytes = ms.ToArray();
            return $"data:image/jpeg;base64,{Convert.ToBase64String(thumbBytes)}";
        } catch {
            return string.Empty;
        }
    }

    private string GetImageSrc(string? path) {
        if (string.IsNullOrWhiteSpace(path) || _disposed) {
            return string.Empty;
        }
        if (_thumbnailCache.TryGetValue(path, out var cached)) {
            return cached;
        }
        if (_loadingThumbnails.TryAdd(path, 0)) {
            var token = _cts.Token;
            _ = Task.Run(async () => {
                try {
                    if (!_disposed && !token.IsCancellationRequested) {
                        string dataUri = await CreateSafeThumbnailDataUriAsync(path, token);
                        _thumbnailCache[path] = dataUri;
                        if (!_disposed && !token.IsCancellationRequested && !string.IsNullOrEmpty(dataUri)) {
                            await SafeInvokeAsync(StateHasChanged);
                        }
                    }
                } catch {
                    _thumbnailCache[path] = string.Empty;
                } finally {
                    _loadingThumbnails.TryRemove(path, out _);
                }
            }, token);
        }
        return string.Empty;
    }

    private static Color GetArchitectureColor(string? arch) {
        if (string.IsNullOrWhiteSpace(arch)) {
            return Color.Default;
        }
        if (arch.Contains("flux", StringComparison.OrdinalIgnoreCase)) return Color.Tertiary;
        if (arch.Contains("sdxl", StringComparison.OrdinalIgnoreCase)) return Color.Info;
        if (arch.Contains("pony", StringComparison.OrdinalIgnoreCase)) return Color.Secondary;
        if (arch.Contains("illustrious", StringComparison.OrdinalIgnoreCase) || arch.Contains("noobai", StringComparison.OrdinalIgnoreCase)) return Color.Primary;
        if (arch.Contains("sd3.5", StringComparison.OrdinalIgnoreCase) || arch.Contains("sd 3.5", StringComparison.OrdinalIgnoreCase) || arch.Contains("sd3", StringComparison.OrdinalIgnoreCase)) return Color.Success;
        if (arch.Contains("sd1.5", StringComparison.OrdinalIgnoreCase) || arch.Contains("sd 1.5", StringComparison.OrdinalIgnoreCase) || arch.Contains("sd15", StringComparison.OrdinalIgnoreCase)) return Color.Warning;
        if (arch.Contains("sd2.1", StringComparison.OrdinalIgnoreCase) || arch.Contains("sd 2.1", StringComparison.OrdinalIgnoreCase) || arch.Contains("sd21", StringComparison.OrdinalIgnoreCase)) return Color.Dark;
        if (arch.Contains("chroma", StringComparison.OrdinalIgnoreCase)) return Color.Error;
        if (arch.Contains("wan", StringComparison.OrdinalIgnoreCase) || arch.Contains("hunyuan", StringComparison.OrdinalIgnoreCase)) return Color.Warning;
        return Color.Default;
    }

    private IReadOnlyList<(string Value, string Label)> GetArchitectureFilterOptions() {
        var options = new List<(string Value, string Label)> {
            ("all", $"All Architectures ({LibraryService.Items.Count})"),
            ("favorites", $"❤️ Favorites ({LibraryService.Items.Count(x => x.IsFavorite)})")
        };

        try {
            var counts = LibraryService.Items
                .Where(x => !string.IsNullOrWhiteSpace(x.EffectiveBaseModel))
                .GroupBy(x => x.EffectiveBaseModel, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);

            var known = ArchitectureRegistry.GetAll().Select(a => a.DisplayName).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct(StringComparer.OrdinalIgnoreCase);
            var allArchs = counts.Keys.Union(known, StringComparer.OrdinalIgnoreCase).OrderBy(a => a);
            foreach (var arch in allArchs) {
                int count = counts.TryGetValue(arch, out int c) ? c : 0;
                options.Add((arch, $"{arch} ({count})"));
            }
        } catch {
            // Defensive fallback
        }

        return options;
    }

