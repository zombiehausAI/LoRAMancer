@page "/"
@implements IDisposable
@inject SafeTensorsMetadataReader MetadataReader
@inject LoraLibraryService LibraryService
@inject CivitaiService Civitai
@inject NativeFileDialogService FileDialogService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject LoraUpdaterService UpdaterService
@using LoRAMancer.App.Components.Dialogs

<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #cdd6f4;">LoRA Library & Visual Browser</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Browse local models with embedded/Civitai thumbnails and right-click to train using donor recipes
        </MudText>
    </div>
    <div class="d-flex align-center flex-wrap gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="BrowseLibraryFolderAsync">
            Browse Folder...
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FileOpen" OnClick="BrowseLoraFileAsync">
            Add File...
        </MudButton>
        @if (_loraLibrary.Count > 0) {
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.CloudDownload" Disabled="_isEnrichingAll" OnClick="EnrichAllCivitaiAsync">
                @(_isEnrichingAll ? $"Enriching ({_enrichProgress}/{_loraLibrary.Count})..." : "Fetch Civitai Info")
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.SystemUpdateAlt" OnClick="OpenLoraUpdaterAsync">
            Lora Updater
        </MudButton>
    </div>
</div>

<!-- Search, Filter & View Toggle Bar -->
<MudCard Elevation="1" Class="mb-3" Style="background-color: #181825; border: 1px solid #313244;">
    <MudCardContent Class="py-3">
        <MudGrid Class="align-center">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_searchQuery" Placeholder="Search by file name, model title, trigger word, or path..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_selectedArchitecture" Label="Filter Architecture" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem Value="@("all")">All Architectures</MudSelectItem>
                    <MudSelectItem Value="@("FLUX.1")">FLUX.1</MudSelectItem>
                    <MudSelectItem Value="@("SDXL")">SDXL / Pony / Illustrious</MudSelectItem>
                    <MudSelectItem Value="@("Chroma")">Chroma</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3" Class="d-flex justify-end align-center gap-1">
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton Variant="@(_viewMode == "grid" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@Icons.Material.Filled.GridView" OnClick="@(() => _viewMode = "grid")">
                        Cards
                    </MudButton>
                    <MudButton Variant="@(_viewMode == "table" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TableRows" OnClick="@(() => _viewMode = "table")">
                        Table
                    </MudButton>
                </MudButtonGroup>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Subfolder Navigation & Breadcrumbs Bar -->
@if (!string.IsNullOrWhiteSpace(_rootFolder)) {
    <MudCard Elevation="1" Class="pa-2 px-3 mb-3 d-flex align-center justify-space-between flex-wrap gap-2" Style="background-color: #181825; border: 1px solid #313244; border-radius: 8px;">
        <div class="d-flex align-center gap-1 flex-wrap">
            <MudTooltip Text="Up one level">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Primary" Disabled="@(string.Equals(_currentFolder, _rootFolder, StringComparison.OrdinalIgnoreCase) || _showAllFlat)" OnClick="NavigateUp" />
            </MudTooltip>
            
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="@(string.Equals(_currentFolder, _rootFolder, StringComparison.OrdinalIgnoreCase) && !_showAllFlat ? Color.Tertiary : Color.Primary)" StartIcon="@Icons.Material.Filled.FolderSpecial" OnClick="@(() => NavigateToFolder(_rootFolder))">
                @(Path.GetFileName(_rootFolder) is string rootName && !string.IsNullOrWhiteSpace(rootName) ? rootName : _rootFolder)
            </MudButton>

            @if (!_showAllFlat && !string.Equals(_currentFolder, _rootFolder, StringComparison.OrdinalIgnoreCase)) {
                @foreach (var crumb in GetBreadcrumbs()) {
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="@(crumb.FullPath == _currentFolder ? Color.Tertiary : Color.Primary)" OnClick="@(() => NavigateToFolder(crumb.FullPath))">
                        @crumb.Name
                    </MudButton>
                }
            }
        </div>

        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @if (_showAllFlat) {
                    <span>Showing all @_loraLibrary.Count LoRAs (Flat View)</span>
                } else if (!string.IsNullOrWhiteSpace(_searchQuery)) {
                    <span>Searching across all subfolders (@FilteredLoras.Count results)</span>
                } else {
                    <span>@FilteredLoras.Count LoRA@((FilteredLoras.Count == 1 ? "" : "s")) in this folder (@_loraLibrary.Count total indexed)</span>
                }
            </MudText>

            <MudButton Variant="@(_showAllFlat ? Variant.Filled : Variant.Outlined)" Color="Color.Tertiary" Size="Size.Small" StartIcon="@(_showAllFlat ? Icons.Material.Filled.AccountTree : Icons.Material.Filled.Folder)" OnClick="@(() => _showAllFlat = !_showAllFlat)">
                @(_showAllFlat ? "Flat (All)" : "Subfolder View")
            </MudButton>
        </div>
    </MudCard>
}

@if (_isScanning) {
    <MudCard Elevation="0" Class="pa-3 mb-4" Style="background-color: rgba(203, 166, 247, 0.08); border: 1px solid #cba6f7; border-radius: 8px;">
        <div class="d-flex align-center justify-space-between mb-2">
            <div class="d-flex align-center gap-2">
                <MudProgressCircular Size="Size.Small" Color="Color.Tertiary" Indeterminate="true" />
                <MudText Typo="Typo.body2" Style="color: #cdd6f4; font-weight: 600;">
                    Scanning LoRAs recursively in background: @_scannedCount of @_totalFiles (@_currentScanningFile)
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelScan">
                Stop Scan
            </MudButton>
        </div>
        <MudProgressLinear Color="Color.Tertiary" Value="@(_totalFiles > 0 ? (double)_scannedCount / _totalFiles * 100 : 0)" Class="my-1" />
    </MudCard>
}

@if (UpdaterService.IsRunning) {
    <MudCard Elevation="0" Class="pa-3 mb-4" Style="background-color: rgba(137, 180, 250, 0.08); border: 1px solid #89b4fa; border-radius: 8px;">
        <div class="d-flex align-center justify-space-between mb-2">
            <div class="d-flex align-center gap-2">
                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="@(UpdaterService.TotalFiles == 0)" />
                <MudText Typo="Typo.body2" Style="color: #cdd6f4; font-weight: 600;">
                    Lora Updater running in background: @UpdaterService.CurrentStatus
                </MudText>
            </div>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenLoraUpdaterAsync">
                    View Details
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="@(() => UpdaterService.Cancel())">
                    Stop
                </MudButton>
            </div>
        </div>
        @if (UpdaterService.TotalFiles > 0) {
            <MudProgressLinear Color="Color.Info" Value="@((double)UpdaterService.ProcessedFiles / UpdaterService.TotalFiles * 100)" Class="my-1" />
        }
    </MudCard>
}

@if (FilteredLoras.Count == 0 && CurrentSubfolders.Count == 0) {
    @if (_isScanning) {
        <MudCard Elevation="0" Class="pa-8 text-center" Style="background-color: #181825; border: 1px dashed #313244; border-radius: 8px;">
            <MudProgressCircular Size="Size.Large" Color="Color.Tertiary" Indeterminate="true" Class="mb-3" />
            <MudText Typo="Typo.h6" Style="color: #cdd6f4;">Scanning Directory in Background...</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Reading model headers and local preview thumbnails. Discovered models will appear here in real time.
            </MudText>
        </MudCard>
    } else {
        <MudCard Elevation="0" Class="pa-8 text-center" Style="background-color: #181825; border: 1px dashed #313244; border-radius: 8px;">
            <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.h6" Style="color: #cdd6f4;">No LoRAs found</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @(string.IsNullOrWhiteSpace(_rootFolder) ? "Click \"Browse Folder...\" to point to your LoRA storage directory." : "No models or subfolders found in this directory.")
            </MudText>
            @if (string.IsNullOrWhiteSpace(_rootFolder)) {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="BrowseLibraryFolderAsync">
                    Select LoRA Folder
                </MudButton>
            }
        </MudCard>
    }
} else if (_viewMode == "grid") {
    <!-- Visual Card Grid -->
    <MudGrid>
        <!-- Subfolder Cards -->
        @if (!_showAllFlat && string.IsNullOrWhiteSpace(_searchQuery) && CurrentSubfolders.Count > 0) {
            @foreach (var sub in CurrentSubfolders) {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="1" Style="background: linear-gradient(145deg, #1e1e2e, #181825); border: 1px solid #45475a; border-radius: 10px; cursor: pointer; height: 100%; min-height: 140px; display: flex; flex-direction: column; justify-content: space-between;" Class="pa-4" @onclick="@(() => NavigateToFolder(sub.FullPath))">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Large" Color="Color.Tertiary" />
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #cdd6f4; line-height: 1.2;">@sub.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@sub.LoraCount LoRA@((sub.LoraCount == 1 ? "" : "s"))</MudText>
                                </div>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Secondary" />
                        </div>
                        <div class="d-flex align-center justify-space-between mt-3">
                            <MudText Typo="Typo.caption" Style="color: #6c7086; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 150px;">
                                @sub.RelativePath
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Browse</MudChip>
                        </div>
                    </MudCard>
                </MudItem>
            }
        }

        <!-- LoRA Model Cards -->
        @foreach (var lora in FilteredLoras) {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="1" Style="background-color: #181825; border: 1px solid #313244; border-radius: 10px; overflow: hidden; height: 100%; display: flex; flex-direction: column;">
                    <!-- Thumbnail Container -->
                    <div style="position: relative; width: 100%; height: 220px; background-color: #11111b; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                        @if (!string.IsNullOrWhiteSpace(lora.ThumbnailPath) && File.Exists(lora.ThumbnailPath)) {
                            <img src="@GetImageSrc(lora.ThumbnailPath)" alt="@lora.FileName" style="width: 100%; height: 100%; object-fit: cover;" />
                        } else {
                            <div class="d-flex flex-column align-center justify-center p-4 text-center" style="width: 100%; height: 100%; background: linear-gradient(135deg, rgba(203,166,247,0.1), rgba(137,180,250,0.05));">
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Large" Color="Color.Secondary" Style="opacity: 0.4;" Class="mb-1" />
                                <MudText Typo="Typo.caption" Style="color: #6c7086;">No Preview Thumbnail</MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => FetchSingleCivitaiAsync(lora))" Class="mt-1" Style="font-size: 0.7rem;">
                                    Find on Civitai
                                </MudButton>
                            </div>
                        }

                        <!-- Base Model Overlay Badge -->
                        <div style="position: absolute; top: 10px; left: 10px;">
                            <MudChip T="string" Size="Size.Small" Color="@GetArchitectureColor(lora.BaseModel)" Variant="Variant.Filled" Style="font-weight: 600; font-size: 0.7rem;">
                                @lora.BaseModel
                            </MudChip>
                        </div>

                        <!-- Size Badge -->
                        <div style="position: absolute; bottom: 8px; right: 10px; background: rgba(17,17,27,0.85); padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; color: #cdd6f4;">
                            @lora.FormattedSize
                        </div>
                    </div>

                    <MudCardContent Class="py-3 px-3" Style="flex: 1;">
                        <MudTooltip Text="@lora.FileName">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #fff; line-height: 1.2; word-break: break-all;">
                                @(lora.CivitaiInfo != null ? lora.CivitaiInfo.ModelName : lora.FileName)
                            </MudText>
                        </MudTooltip>
                        @if (lora.CivitaiInfo != null && !string.IsNullOrWhiteSpace(lora.CivitaiInfo.VersionName)) {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@lora.CivitaiInfo.VersionName</MudText>
                        }

                        @if (_showAllFlat || !string.IsNullOrWhiteSpace(_searchQuery)) {
                            <div class="mt-1" style="font-size: 0.7rem; color: #6c7086; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                📁 @GetRelativeSubfolder(lora.FilePath)
                            </div>
                        }

                        <!-- Trigger Word Badge -->
                        @if (GetPrimaryTrigger(lora) is string trigger && !string.IsNullOrWhiteSpace(trigger)) {
                            <div class="d-flex align-center justify-space-between p-1 px-2 my-2" style="background-color: #11111b; border: 1px solid #313244; border-radius: 6px;">
                                <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #cba6f7; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 170px;">
                                    @trigger
                                </div>
                                <MudTooltip Text="Copy trigger word">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary" OnClick="@(() => CopyToClipboardAsync(trigger))" />
                                </MudTooltip>
                            </div>
                        }

                        <!-- Hyperparameters Quick Matrix -->
                        <div class="d-grid mt-2" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; text-align: center;">
                            <div style="background-color: #11111b; padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: #a6adc8;">DIM/ALPHA</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: #cdd6f4;">@(lora.NetworkDim?.ToString() ?? "-")/@(lora.NetworkAlpha?.ToString() ?? "-")</div>
                            </div>
                            <div style="background-color: #11111b; padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: #a6adc8;">LR</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: #cdd6f4;">@(lora.LearningRate?.ToString("0.e+0") ?? "-")</div>
                            </div>
                            <div style="background-color: #11111b; padding: 4px; border-radius: 4px;">
                                <div style="font-size: 0.6rem; color: #a6adc8;">STEPS</div>
                                <div style="font-weight: 700; font-size: 0.75rem; color: #cdd6f4;">@(lora.TotalSteps?.ToString() ?? "-")</div>
                            </div>
                        </div>
                    </MudCardContent>

                    <!-- Card Actions -->
                    <MudCardActions Class="px-3 py-2 d-flex justify-space-between align-center" Style="border-top: 1px solid #313244;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" OnClick="@(() => UseLoraTrainingSettings(lora))">
                            Use Settings
                        </MudButton>
                        <div class="d-flex gap-1">
                            <MudTooltip Text="Inspect Header">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => InspectLora(lora))" />
                            </MudTooltip>
                            <MudTooltip Text="Reveal in Explorer">
                                <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Color="Color.Default" OnClick="@(() => OpenInExplorer(lora.FilePath))" />
                            </MudTooltip>
                        </div>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (FilteredLoras.Count == 0 && CurrentSubfolders.Count > 0) {
        <div class="pa-4 text-center mt-4" style="background-color: #181825; border: 1px dashed #313244; border-radius: 8px;">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                No direct LoRA files in this folder. Click any subfolder card above to view contained models.
            </MudText>
        </div>
    }
} else {
    <!-- Table View -->
    @if (!_showAllFlat && string.IsNullOrWhiteSpace(_searchQuery) && CurrentSubfolders.Count > 0) {
        <div class="d-flex flex-wrap gap-2 mb-3 align-center">
            <MudText Typo="Typo.body2" Style="color: #a6adc8; font-weight: 600;">Subfolders:</MudText>
            @foreach (var sub in CurrentSubfolders) {
                <MudChip T="string" Icon="@Icons.Material.Filled.Folder" Color="Color.Tertiary" Variant="Variant.Outlined" OnClick="@(() => NavigateToFolder(sub.FullPath))" Style="cursor: pointer; font-weight: 600;">
                    @sub.Name (@sub.LoraCount)
                </MudChip>
            }
        </div>
    }

    <MudTable Items="FilteredLoras" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1" Style="background-color: #181825; border: 1px solid #313244; border-radius: 8px;">
        <HeaderContent>
            <MudTh>File Name</MudTh>
            <MudTh>Base Model</MudTh>
            <MudTh>Rank (Dim)</MudTh>
            <MudTh>Alpha</MudTh>
            <MudTh>LR</MudTh>
            <MudTh>Optimizer</MudTh>
            <MudTh>File Size</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="File Name">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Layers" Color="Color.Primary" Size="Size.Small" Class="mr-2" />
                    <div>
                        <div style="font-weight: 600; color: #cdd6f4;">@context.FileName</div>
                        <div style="font-size: 0.75rem; color: #6c7086;">@context.FilePath</div>
                    </div>
                </div>
            </MudTd>
            <MudTd DataLabel="Base Model">
                <MudChip T="string" Size="Size.Small" Color="@GetArchitectureColor(context.BaseModel)" Variant="Variant.Outlined">@context.BaseModel</MudChip>
            </MudTd>
            <MudTd DataLabel="Rank (Dim)">@(context.NetworkDim?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="Alpha">@(context.NetworkAlpha?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="LR">@(context.LearningRate?.ToString("0.#####e+00") ?? "-")</MudTd>
            <MudTd DataLabel="Optimizer">@(string.IsNullOrEmpty(context.Optimizer) ? "-" : context.Optimizer)</MudTd>
            <MudTd DataLabel="File Size">@context.FormattedSize</MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" OnClick="@(() => UseLoraTrainingSettings(context))" Class="mr-1">
                    Use Settings
                </MudButton>
                <MudTooltip Text="Inspect Metadata">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => InspectLora(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<!-- Metadata Inspector Drawer -->
<MetadataInspectorDrawer @bind-IsOpen="_drawerOpen" Metadata="_selectedLora" />

@code {
    private readonly List<LoraMetadata> _loraLibrary = new();
    private readonly object _libraryLock = new();
    private bool _drawerOpen;
    private LoraMetadata? _selectedLora;

    private string _rootFolder = string.Empty;
    private string _currentFolder = string.Empty;
    private bool _showAllFlat;

    private string _viewMode = "grid";
    private string _searchQuery = string.Empty;
    private string _selectedArchitecture = "all";

    private bool _isEnrichingAll;
    private int _enrichProgress;

    private CancellationTokenSource? _scanCts;
    private bool _isScanning;
    private int _scannedCount;
    private int _totalFiles;
    private string _currentScanningFile = string.Empty;

    private sealed record SubfolderItem(string Name, string FullPath, string RelativePath, int LoraCount);
    private sealed record CrumbItem(string Name, string FullPath);

    private List<SubfolderItem> CurrentSubfolders {
        get {
            if (string.IsNullOrWhiteSpace(_currentFolder) || !Directory.Exists(_currentFolder) || _showAllFlat) {
                return new List<SubfolderItem>();
            }

            try {
                string[] subDirs = Directory.GetDirectories(_currentFolder);
                List<SubfolderItem> result = new();

                lock (_libraryLock) {
                    foreach (string dir in subDirs) {
                        string dirName = Path.GetFileName(dir);
                        if (dirName.StartsWith('.')) {
                            continue;
                        }

                        string prefix = dir.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
                        int count = _loraLibrary.Count(l => l.FilePath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
                        string rel = string.IsNullOrWhiteSpace(_rootFolder) ? dirName : Path.GetRelativePath(_rootFolder, dir);

                        result.Add(new SubfolderItem(dirName, dir, rel, count));
                    }
                }

                return result.OrderBy(s => s.Name).ToList();
            } catch {
                return new List<SubfolderItem>();
            }
        }
    }

    private List<LoraMetadata> FilteredLoras {
        get {
            lock (_libraryLock) {
                return _loraLibrary
                    .Where(l => {
                        if (_showAllFlat || !string.IsNullOrWhiteSpace(_searchQuery) || string.IsNullOrWhiteSpace(_currentFolder)) {
                            return true;
                        }
                        string dir = Path.GetDirectoryName(l.FilePath) ?? string.Empty;
                        return string.Equals(dir.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                                             _currentFolder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                                             StringComparison.OrdinalIgnoreCase);
                    })
                    .Where(l => string.IsNullOrWhiteSpace(_searchQuery)
                        || l.FileName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                        || (l.CivitaiInfo != null && l.CivitaiInfo.ModelName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
                        || l.TrainedWords.Any(w => w.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
                        || l.FilePath.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
                    .Where(l => _selectedArchitecture == "all" || l.BaseModel.Contains(_selectedArchitecture, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
        }
    }

    private List<CrumbItem> GetBreadcrumbs() {
        List<CrumbItem> crumbs = new();
        if (string.IsNullOrWhiteSpace(_rootFolder) || string.IsNullOrWhiteSpace(_currentFolder)) {
            return crumbs;
        }

        try {
            string rel = Path.GetRelativePath(_rootFolder, _currentFolder);
            if (string.IsNullOrWhiteSpace(rel) || rel == ".") {
                return crumbs;
            }

            string[] parts = rel.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries);
            string currentAccum = _rootFolder;
            foreach (string part in parts) {
                currentAccum = Path.Combine(currentAccum, part);
                crumbs.Add(new CrumbItem(part, currentAccum));
            }
        } catch {
            // Fallback empty
        }

        return crumbs;
    }

    private void NavigateToFolder(string folderPath) {
        if (Directory.Exists(folderPath)) {
            _currentFolder = folderPath;
            _showAllFlat = false;
            StateHasChanged();
        }
    }

    private void NavigateUp() {
        if (string.IsNullOrWhiteSpace(_currentFolder) || string.IsNullOrWhiteSpace(_rootFolder)) {
            return;
        }
        if (string.Equals(_currentFolder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                          _rootFolder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                          StringComparison.OrdinalIgnoreCase)) {
            return;
        }

        string? parent = Path.GetDirectoryName(_currentFolder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
        if (!string.IsNullOrEmpty(parent) && parent.StartsWith(_rootFolder, StringComparison.OrdinalIgnoreCase)) {
            _currentFolder = parent;
        } else {
            _currentFolder = _rootFolder;
        }
        StateHasChanged();
    }

    private string GetRelativeSubfolder(string filePath) {
        if (string.IsNullOrWhiteSpace(_rootFolder)) {
            return Path.GetDirectoryName(filePath) ?? string.Empty;
        }
        string? dir = Path.GetDirectoryName(filePath);
        if (string.IsNullOrEmpty(dir)) {
            return string.Empty;
        }
        try {
            string rel = Path.GetRelativePath(_rootFolder, dir);
            return rel == "." ? "Root" : rel;
        } catch {
            return dir;
        }
    }

