    private async Task ExecuteMoveLoraAsync() {
        if (_loraToMove == null || string.IsNullOrWhiteSpace(_targetLibraryId)) {
            return;
        }
        var targetLib = LibraryService.Libraries.FirstOrDefault(l => l.Id == _targetLibraryId);
        if (targetLib == null) {
            Snackbar.Add("Selected library not found.", Severity.Error);
            return;
        }

        _isMoving = true;
        try {
            string oldName = _loraToMove.FileName ?? Path.GetFileName(_loraToMove.FilePath ?? "");
            string newPath = await LibraryService.MoveLoraToLibraryAsync(_loraToMove, targetLib);
            if (!string.IsNullOrWhiteSpace(newPath)) {
                _moveDialogOpen = false;
                Snackbar.Add($"Moved '{oldName}' to library '{targetLib.Name}' successfully.", Severity.Success);
                UpdateFilteredList();
            } else {
                Snackbar.Add("Failed to move LoRA. Check log for details.", Severity.Error);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Move error: {ex.Message}", Severity.Error);
        } finally {
            _isMoving = false;
            StateHasChanged();
        }
    }

