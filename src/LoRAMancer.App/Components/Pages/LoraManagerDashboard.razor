        string target = folderPath.Trim().TrimEnd('/', '\\').Replace('\\', '/');
        return LibraryService.Libraries.FirstOrDefault(l => 
            !string.IsNullOrWhiteSpace(l.FolderPath) && 
            string.Equals(l.FolderPath.Trim().TrimEnd('/', '\\').Replace('\\', '/'), target, StringComparison.OrdinalIgnoreCase));
    }

