    private static void OpenInExplorer(string? filePath) {
        if (!string.IsNullOrWhiteSpace(filePath) && File.Exists(filePath)) {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo {
                FileName = "explorer.exe",
                Arguments = $"/select,\"{filePath}\"",
                UseShellExecute = true
            });
        }
    }

    private async Task CopyToClipboardAsync(string text) {
        if (!string.IsNullOrWhiteSpace(text)) {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add($"Copied '{text}' to clipboard!", Severity.Success);
        }
    }

    private static string? GetPrimaryTrigger(LoraMetadata lora) {
        if (lora.TrainedWords != null && lora.TrainedWords.Count > 0) {
            return lora.TrainedWords.First();
        }
        if (lora.RawHeaderMetadata.TryGetValue("ss_tag_frequency", out var tags) && !string.IsNullOrWhiteSpace(tags)) {
            return tags.Split(',').FirstOrDefault()?.Trim();
        }
        return null;
    }

    private static string GetImageSrc(string path) {
        byte[] bytes = File.ReadAllBytes(path);
        string ext = Path.GetExtension(path).ToLowerInvariant();
        string mime = ext switch {
            ".png" => "image/png",
            ".webp" => "image/webp",
            _ => "image/jpeg"
        };
        return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
    }

    private static Color GetArchitectureColor(string arch) {
        if (arch.Contains("flux", StringComparison.OrdinalIgnoreCase)) return Color.Tertiary;
        if (arch.Contains("sdxl", StringComparison.OrdinalIgnoreCase)) return Color.Info;
        if (arch.Contains("pony", StringComparison.OrdinalIgnoreCase)) return Color.Secondary;
        return Color.Default;
    }

    private async Task OpenLoraUpdaterAsync() {
        DialogParameters parameters = new() {
            ["InitialFolder"] = !string.IsNullOrWhiteSpace(_rootFolder) ? _rootFolder : _currentFolder
        };
        DialogOptions options = new() {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<LoraUpdaterDialog>("Lora Updater", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && !string.IsNullOrWhiteSpace(_rootFolder)) {
            await LoadFolderAsync(_rootFolder);
        }
    }
