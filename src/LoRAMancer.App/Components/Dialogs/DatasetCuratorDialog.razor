    private string _radarTestToken = "";
    private string _radarFilter = "";
    private string _radarSeverityFilter = "all";
    private TokenCollisionReport? _singleTokenReport;
    private DatasetCollisionAudit? _datasetAudit;
    private bool _isAuditingDataset;
    private bool _isReplacingRadarToken;

    private List<TokenCollisionReport> FilteredAuditTokens {
        get {
            if (_datasetAudit?.HighRiskTokens == null) {
                return new();
            }

            var query = _datasetAudit.HighRiskTokens.AsEnumerable();

            if (_radarSeverityFilter == "critical_high") {
                query = query.Where(t => t.Severity is CollisionSeverity.CriticalBleed or CollisionSeverity.HighRisk);
            } else if (_radarSeverityFilter == "moderate") {
                query = query.Where(t => t.Severity == CollisionSeverity.ModerateRisk);
            }

            if (!string.IsNullOrWhiteSpace(_radarFilter)) {
                query = query.Where(t =>
                    t.Token.Contains(_radarFilter, StringComparison.OrdinalIgnoreCase) ||
                    t.Explanation.Contains(_radarFilter, StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains(_radarFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private void AnalyzeProposedToken() {
        if (string.IsNullOrWhiteSpace(_radarTestToken)) return;
        _singleTokenReport = CollisionService.AnalyzeToken(_radarTestToken);
    }

    private void AdoptSyntheticToken(string synthetic) {
        _radarTestToken = synthetic;
        _batchTagInput = synthetic;
        AnalyzeProposedToken();
        Snackbar.Add($"Copied '{synthetic}' to batch trigger input!", Severity.Success);
    }

    private async Task ScanDatasetRadarAsync() {
        if (string.IsNullOrWhiteSpace(_datasetFolder) || !Directory.Exists(_datasetFolder)) {
            Snackbar.Add("Please select a valid dataset directory first.", Severity.Warning);
            return;
        }

        _isAuditingDataset = true;
        StateHasChanged();
        try {
            _datasetAudit = await CollisionService.AuditDatasetFolderAsync(_datasetFolder, _cts.Token);
            if (_datasetAudit.HighRiskTokens.Count > 0) {
                Snackbar.Add($"Found {_datasetAudit.HighRiskTokens.Count} colliding tags in dataset!", Severity.Warning);
            } else {
                Snackbar.Add("All tags in dataset are clean!", Severity.Success);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Audit error: {ex.Message}", Severity.Error);
        } finally {
            _isAuditingDataset = false;
            StateHasChanged();
        }
    }

    private async Task CleanseCollidingTokenAsync(string oldToken, string newToken) {
        if (string.IsNullOrWhiteSpace(_datasetFolder)) return;

        _isReplacingRadarToken = true;
        StateHasChanged();
        try {
            int modified = await CollisionService.ReplaceCollidingTokenInDatasetAsync(_datasetFolder, oldToken, newToken, _cts.Token);
            Snackbar.Add($"Replaced '{oldToken}' with '{newToken}' across {modified} caption files!", Severity.Success);
            await ScanFolderAsync();
            await ScanDatasetRadarAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Cleanse error: {ex.Message}", Severity.Error);
        } finally {
            _isReplacingRadarToken = false;
            StateHasChanged();
        }
    }

    private static Color GetRadarSeverityColor(CollisionSeverity sev) {
        return sev switch {
            CollisionSeverity.Clean => Color.Success,
            CollisionSeverity.LowRisk => Color.Info,
            CollisionSeverity.ModerateRisk => Color.Warning,
            CollisionSeverity.HighRisk => Color.Error,
            CollisionSeverity.CriticalBleed => Color.Error,
            _ => Color.Default
        };
    }

    private static Color GetRadarProgressColor(int score) {
        if (score < 25) return Color.Success;
        if (score < 60) return Color.Warning;
        return Color.Error;
    }

    public void Dispose() {
        _cts?.Cancel();
        _cts?.Dispose();
    }
