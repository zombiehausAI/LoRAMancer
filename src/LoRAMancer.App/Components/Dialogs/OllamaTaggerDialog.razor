@using LoRAMancer.App.Models
@using LoRAMancer.App.Services
@using System.Text.Json
@inject HttpClient Http
@inject PluginManagerService PluginManager
@inject SettingsService Settings
@inject NativeFileDialogService FileDialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Ollama Vision LoRA Tagger & Captioner</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Auto-caption training images using local, remote LAN, or datacenter Ollama vision models</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- Ollama Endpoint & Model Config -->
        <MudCard Elevation="0" Class="p-3 mb-3" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
            <div class="d-flex align-center justify-space-between mb-2">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Ollama Service Endpoint</MudText>
                    @if (_isCheckingOllama) {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Probing...</MudChip>
                    } else if (_ollamaReachable) {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Connected (@_visionModels.Count model(s))</MudChip>
                    } else {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Unreachable</MudChip>
                    }
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CheckOllamaStatusAsync" Disabled="_isProcessing || _isCheckingOllama">
                    Test Connection
                </MudButton>
            </div>

            <MudGrid Spacing="2">
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_ollamaUrl" Label="Ollama URL (Local, Remote LAN, or Datacenter)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="http://localhost:11434" HelperText="Supports remote servers, LAN IPs, or datacenter Ollama proxies" Disabled="_isProcessing" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_apiKey" Label="API Key / Auth Token (Optional)" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Placeholder="Bearer token for cloud/datacenter" Disabled="_isProcessing" />
                </MudItem>
            </MudGrid>
        </MudCard>

        @if (!_ollamaReachable && !_isCheckingOllama) {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3" Style="font-size: 0.8rem;">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                @if (!string.IsNullOrEmpty(_errorMessage)) {
                    <span>@_errorMessage</span>
                } else {
                    <span>Could not connect to Ollama at <code>@_ollamaUrl</code>. Ensure Ollama is running or verify your network address/token.</span>
                }
            </MudAlert>
        }

        <MudGrid Spacing="2">
            <!-- Input Source -->
            <MudItem xs="12">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_inputPath" Label="Input Images Folder or ZIP Archive" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="C:\datasets\my_images or my_images.zip" FullWidth="true" Disabled="_isProcessing" />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseInputFolderAsync" Disabled="_isProcessing">Folder</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseInputZipAsync" Disabled="_isProcessing">ZIP</MudButton>
                </div>
            </MudItem>

            <!-- Output Destination & ZIP toggle -->
            <MudItem xs="12">
                <div class="d-flex align-center gap-2">
                    <MudTextField @bind-Value="_outputPath" Label="Output Destination (Folder or .zip)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Leave blank for auto-named output" FullWidth="true" Disabled="_isProcessing" />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseOutputFolderAsync" Disabled="_isProcessing">Browse</MudButton>
                </div>
                <MudCheckBox @bind-Value="_createZip" Label="Create compressed ZIP file output for training" Color="Color.Primary" Dense="true" Class="mt-1" Disabled="_isProcessing" />
            </MudItem>

            <!-- Tagging Options -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_triggerWord" Label="Trigger Word / Phrase" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. sks character, ohwx style" HelperText="Prepended to every generated caption" Disabled="_isProcessing" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_selectedModel" Label="Vision Model (Local or Cloud)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. llama3.2-vision, llava, qwen2-vl" HelperText="Type any local or cloud vision model tag" Disabled="_isProcessing" />
                @if (_visionModels.Count > 0) {
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var m in _visionModels) {
                            <MudChip T="string" Size="Size.Small" Variant="@(_selectedModel == m ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => _selectedModel = m)" Style="font-size: 0.7rem; height: 22px; cursor: pointer;">
                                @m
                            </MudChip>
                        }
                    </div>
                }
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_includedPhrases" Label="Included Words / Phrases (Comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. detailed eyes, masterpiece" HelperText="Ensures these tags are present in every caption" Disabled="_isProcessing" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_blacklistWords" Label="Blacklist / Excluded Words (Comma-separated)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. watermark, signature, blurry" HelperText="Strips these terms from generated captions" Disabled="_isProcessing" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_captionStyle" 
                           @bind-Value:after="OnCaptionStyleOrPresetChanged"
                           Label="Caption Style" 
                           Variant="Variant.Outlined" 
                           Margin="Margin.Dense" 
                           Disabled="_isProcessing">
                    <MudSelectItem Value="@("tags")">Visual Tags (Comma-separated descriptors for SDXL / Pony / Anime)</MudSelectItem>
                    <MudSelectItem Value="@("natural")">Natural Language (1-2 descriptive sentences for FLUX.1)</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_subjectFocus" 
                           @bind-Value:after="OnCaptionStyleOrPresetChanged"
                           Label="Subject Focus Preset" 
                           Variant="Variant.Outlined" 
                           Margin="Margin.Dense" 
                           Disabled="_isProcessing">
                    <MudSelectItem Value="@("general")">General / Balanced (Subject + Scene)</MudSelectItem>
                    <MudSelectItem Value="@("person")">Person / Character (Face, Hair, Clothing, Pose)</MudSelectItem>
                    <MudSelectItem Value="@("object")">Object / Prop (Materials, Shape, Geometry, Details)</MudSelectItem>
                    <MudSelectItem Value="@("scenery")">Scenery / Environment (Architecture, Lighting, Mood)</MudSelectItem>
                    <MudSelectItem Value="@("style")">Art Style / Aesthetic (Medium, Technique, Colors)</MudSelectItem>
                    <MudSelectItem Value="@("custom")">Custom User Prompt (Manual Instructions)</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex align-center justify-space-between mb-1">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Color="Color.Primary" />
                        <span style="font-size: 0.8rem; font-weight: 700; color: #cdd6f4;">Vision Model Prompt / Instructions</span>
                        @if (_subjectFocus != "custom") {
                            <span style="font-size: 0.7rem; color: #89b4fa; background: rgba(137,180,250,0.15); padding: 1px 6px; border-radius: 4px;">Preset: @_subjectFocus</span>
                        } else {
                            <span style="font-size: 0.7rem; color: #a6e3a1; background: rgba(166,227,161,0.15); padding: 1px 6px; border-radius: 4px;">Custom Prompt</span>
                        }
                    </div>
                    <div class="d-flex align-center gap-2">
                        <span style="font-size: 0.72rem; color: #a6adc8;">@_customPrompt.Length chars</span>
                        @if (_subjectFocus != "custom") {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.7rem; padding: 0 4px;" OnClick="ResetPromptToPreset">
                                Reset to Preset
                            </MudButton>
                        }
                    </div>
                </div>
                <MudTextField @bind-Value="_customPrompt" 
                              Lines="3" 
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense" 
                              Placeholder="Write custom prompt instructions to guide how Ollama analyzes and describes each image..." 
                              HelperText="Customize or override the instructions sent to the vision model for every image in the dataset." 
                              Disabled="_isProcessing" />
            </MudItem>
        </MudGrid>

        <!-- Progress or Results -->
        @if (_isProcessing) {
            <div class="mt-4 p-3 text-center" style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-2" />
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Ollama Vision is analyzing and tagging your images...</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Targeting model: <b>@_selectedModel</b> at <b>@_ollamaUrl</b></MudText>
            </div>
        } else if (_lastResult != null) {
            <MudCard Elevation="0" Class="mt-4 p-3" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
                <div class="d-flex align-center justify-space-between mb-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #a6e3a1;">
                            Tagging Complete! Processed @_lastResult.ProcessedCount image(s).
                        </MudText>
                    </div>
                    @if (!string.IsNullOrEmpty(_lastResult.OutputZip)) {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">ZIP Created</MudChip>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_lastResult.OutputZip)) {
                    <div style="font-size: 0.8rem; color: #89b4fa; word-break: break-all;" class="mb-2">
                        Output ZIP: <code>@_lastResult.OutputZip</code>
                    </div>
                } else if (!string.IsNullOrEmpty(_lastResult.OutputDirectory)) {
                    <div style="font-size: 0.8rem; color: #89b4fa; word-break: break-all;" class="mb-2">
                        Output Folder: <code>@_lastResult.OutputDirectory</code>
                    </div>
                }

                @if (_lastResult.SampleCaptions.Count > 0) {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">Sample Generated Captions:</MudText>
                    @foreach (var sample in _lastResult.SampleCaptions) {
                        <div style="font-size: 0.75rem; color: #cdd6f4; background-color: #181825; padding: 4px 8px; border-radius: 4px; margin-top: 4px;">
                            <b>@sample.Image:</b> @sample.Caption
                        </div>
                    }
                }
            </MudCard>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel" Disabled="_isProcessing">Close</MudButton>
        @if (_lastResult != null) {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Done" OnClick="ApplyToWizard">
                Use in Training Wizard
            </MudButton>
        } else {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartTaggingAsync" Disabled="@(_isProcessing || string.IsNullOrWhiteSpace(_inputPath))">
                Start Auto-Tagging
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string InitialInputPath { get; set; } = string.Empty;

    [Parameter]
    public string InitialTriggerWord { get; set; } = string.Empty;

    private string _ollamaUrl = "http://localhost:11434";
    private string _apiKey = string.Empty;
    private string _inputPath = string.Empty;
    private string _outputPath = string.Empty;
    private string _triggerWord = string.Empty;
    private string _includedPhrases = string.Empty;
    private string _blacklistWords = string.Empty;
    private string _selectedModel = "llama3.2-vision";
    private string _captionStyle = "tags";
    private string _subjectFocus = "general";
    private string _customPrompt = string.Empty;
    private bool _createZip = true;

    private bool _isCheckingOllama = true;
    private bool _ollamaReachable = false;
    private string _errorMessage = string.Empty;
    private readonly List<string> _visionModels = new();

    private bool _isProcessing = false;
    private TaggerResultViewModel? _lastResult;

    protected override async Task OnInitializedAsync() {
        _inputPath = InitialInputPath;
        _triggerWord = InitialTriggerWord;

        if (!string.IsNullOrWhiteSpace(Settings.Current.OllamaEndpointUrl)) {
            _ollamaUrl = Settings.Current.OllamaEndpointUrl;
        }
        if (!string.IsNullOrWhiteSpace(Settings.Current.OllamaApiKey)) {
            _apiKey = Settings.Current.OllamaApiKey;
        }
        if (!string.IsNullOrWhiteSpace(Settings.Current.OllamaDefaultModel)) {
            _selectedModel = Settings.Current.OllamaDefaultModel;
        }

        if (string.IsNullOrWhiteSpace(_customPrompt)) {
            _customPrompt = GetPresetPrompt(_subjectFocus, _captionStyle);
        }

        await CheckOllamaStatusAsync();
    }

    private async Task CheckOllamaStatusAsync() {
        _isCheckingOllama = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        string cleanUrl = (_ollamaUrl ?? "http://localhost:11434").Trim().TrimEnd('/');
        if (string.IsNullOrWhiteSpace(cleanUrl)) {
            cleanUrl = "http://localhost:11434";
        }

        var candidates = new List<string> { cleanUrl };
        if (cleanUrl.Contains("localhost")) {
            candidates.Add(cleanUrl.Replace("localhost", "127.0.0.1"));
        } else if (cleanUrl.Contains("127.0.0.1")) {
            candidates.Add(cleanUrl.Replace("127.0.0.1", "localhost"));
        }

        bool connected = false;
        string lastError = string.Empty;

        foreach (string candidate in candidates) {
            try {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                using var request = new HttpRequestMessage(HttpMethod.Get, $"{candidate}/api/tags");
                request.Headers.Add("User-Agent", "LoRAMancer-Tagger/1.0");
                if (!string.IsNullOrWhiteSpace(_apiKey)) {
                    request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _apiKey.Trim());
                }

                using var response = await Http.SendAsync(request, cts.Token);
                if (response.IsSuccessStatusCode) {
                    string json = await response.Content.ReadAsStringAsync(cts.Token);
                    using var doc = JsonDocument.Parse(json);

                    _visionModels.Clear();
                    var allModels = new List<string>();

                    if (doc.RootElement.TryGetProperty("models", out var modelsElem) && modelsElem.ValueKind == JsonValueKind.Array) {
                        foreach (var m in modelsElem.EnumerateArray()) {
                            string name = m.TryGetProperty("name", out var nElem) ? (nElem.GetString() ?? "") : "";
                            if (!string.IsNullOrWhiteSpace(name)) {
                                allModels.Add(name);

                                bool isVision = false;
                                string nameLower = name.ToLowerInvariant();
                                if (nameLower.Contains("vision") || nameLower.Contains("vl") || nameLower.Contains("llava") ||
                                    nameLower.Contains("minicpm") || nameLower.Contains("moondream") || nameLower.Contains("cogvlm") ||
                                    nameLower.Contains("bakllava") || nameLower.Contains("qwen")) {
                                    isVision = true;
                                }

                                if (!isVision && m.TryGetProperty("capabilities", out var capElem) && capElem.ValueKind == JsonValueKind.Array) {
                                    foreach (var cap in capElem.EnumerateArray()) {
                                        if (string.Equals(cap.GetString(), "vision", StringComparison.OrdinalIgnoreCase)) {
                                            isVision = true;
                                            break;
                                        }
                                    }
                                }

                                if (!isVision && m.TryGetProperty("details", out var detElem) && detElem.TryGetProperty("family", out var famElem)) {
                                    string fam = (famElem.GetString() ?? "").ToLowerInvariant();
                                    if (fam.Contains("vl") || fam.Contains("clip") || fam.Contains("vision")) {
                                        isVision = true;
                                    }
                                }

                                if (isVision) {
                                    _visionModels.Add(name);
                                }
                            }
                        }
                    }

                    if (_visionModels.Count == 0 && allModels.Count > 0) {
                        foreach (string m in allModels) {
                            _visionModels.Add(m);
                        }
                    }

                    if (_visionModels.Count > 0 && (string.IsNullOrWhiteSpace(_selectedModel) || !_visionModels.Contains(_selectedModel))) {
                        _selectedModel = _visionModels[0];
                    }

                    _ollamaReachable = true;
                    _ollamaUrl = candidate;
                    connected = true;
                    break;
                } else {
                    lastError = $"Ollama returned HTTP {(int)response.StatusCode}: {response.ReasonPhrase}";
                }
            } catch (Exception ex) {
                lastError = ex.Message;
            }
        }

        if (!connected) {
            // Fallback to plugin check in case of custom transport
            try {
                var result = await PluginManager.ExecutePluginAsync("ollama-lora-tagger", "check_ollama", new Dictionary<string, object?> {
                    ["ollama_url"] = (_ollamaUrl ?? string.Empty).Trim(),
                    ["api_key"] = (_apiKey ?? string.Empty).Trim()
                });

                if (result.Success && result.Data != null) {
                    using JsonDocument doc = JsonDocument.Parse(result.Data.ToString() ?? "{}");
                    JsonElement root = doc.RootElement;
                    _ollamaReachable = root.TryGetProperty("reachable", out var reachElem) && reachElem.GetBoolean();
                    if (_ollamaReachable) {
                        _visionModels.Clear();
                        if (root.TryGetProperty("vision_models", out var vElem) && vElem.ValueKind == JsonValueKind.Array) {
                            foreach (var item in vElem.EnumerateArray()) {
                                string m = item.GetString() ?? string.Empty;
                                if (!string.IsNullOrEmpty(m)) {
                                    _visionModels.Add(m);
                                }
                            }
                        }
                        if (root.TryGetProperty("default_model", out var defElem)) {
                            string def = defElem.GetString() ?? string.Empty;
                            if (!string.IsNullOrEmpty(def) && string.IsNullOrWhiteSpace(_selectedModel)) {
                                _selectedModel = def;
                            }
                        }
                        connected = true;
                    }
                }
            } catch { }
        }

        if (!connected) {
            _ollamaReachable = false;
            _errorMessage = !string.IsNullOrWhiteSpace(lastError)
                ? $"Could not connect to Ollama ({lastError}). Please verify Ollama is running (`ollama serve`)."
                : $"Could not reach Ollama at {_ollamaUrl}.";
        }

        _isCheckingOllama = false;
        StateHasChanged();
    }

    private async Task BrowseInputFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select Images Dataset Folder");
        if (!string.IsNullOrEmpty(folder)) {
            _inputPath = folder;
        }
    }

    private async Task BrowseInputZipAsync() {
        string? file = await FileDialogService.PickZipFileAsync("Select Dataset ZIP Archive");
        if (!string.IsNullOrEmpty(file)) {
            _inputPath = file;
        }
    }

    private async Task BrowseOutputFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select Output Destination Folder");
        if (!string.IsNullOrEmpty(folder)) {
            _outputPath = folder;
        }
    }

    private async Task StartTaggingAsync() {
        if (string.IsNullOrWhiteSpace(_inputPath)) {
            Snackbar.Add("Please specify an input folder or ZIP archive.", Severity.Warning);
            return;
        }

        _isProcessing = true;
        _lastResult = null;
        StateHasChanged();

        // Update settings in memory so user preferences persist
        Settings.Current.OllamaEndpointUrl = _ollamaUrl.Trim();
        Settings.Current.OllamaApiKey = _apiKey.Trim();
        Settings.Current.OllamaDefaultModel = _selectedModel.Trim();
        _ = Settings.SaveSettingsAsync(Settings.Current);

        try {
            var parameters = new Dictionary<string, object?> {
                ["input_path"] = _inputPath,
                ["output_path"] = _outputPath,
                ["trigger_word"] = _triggerWord,
                ["included_phrases"] = _includedPhrases,
                ["blacklist_words"] = _blacklistWords,
                ["model"] = _selectedModel,
                ["caption_style"] = _captionStyle,
                ["custom_prompt"] = _customPrompt.Trim(),
                ["create_zip"] = _createZip,
                ["ollama_url"] = (_ollamaUrl ?? string.Empty).Trim(),
                ["api_key"] = (_apiKey ?? string.Empty).Trim()
            };

            var pluginResult = await PluginManager.ExecutePluginAsync("ollama-lora-tagger", "tag_dataset", parameters);

            string dataStr = pluginResult.Data?.ToString() ?? string.Empty;
            if (!pluginResult.Success || string.IsNullOrEmpty(dataStr)) {
                throw new InvalidOperationException(pluginResult.Message ?? "Failed to execute tagger plugin.");
            }

            using JsonDocument doc = JsonDocument.Parse(dataStr);
            JsonElement root = doc.RootElement;

            string status = root.TryGetProperty("status", out var sElem) ? (sElem.GetString() ?? "") : "";
            if (status != "success") {
                string msg = root.TryGetProperty("message", out var mElem) ? (mElem.GetString() ?? "") : "Tagging failed";
                throw new InvalidOperationException(msg);
            }

            _lastResult = new TaggerResultViewModel {
                ProcessedCount = root.TryGetProperty("processed_count", out var pElem) ? pElem.GetInt32() : 0,
                OutputDirectory = root.TryGetProperty("output_directory", out var dElem) ? dElem.GetString() : null,
                OutputZip = root.TryGetProperty("output_zip", out var zElem) ? zElem.GetString() : null
            };

            if (root.TryGetProperty("sample_captions", out var capArr) && capArr.ValueKind == JsonValueKind.Array) {
                foreach (var item in capArr.EnumerateArray()) {
                    string img = item.TryGetProperty("image", out var iE) ? (iE.GetString() ?? "") : "";
                    string cap = item.TryGetProperty("caption", out var cE) ? (cE.GetString() ?? "") : "";
                    _lastResult.SampleCaptions.Add(new SampleCaptionItem { Image = img, Caption = cap });
                }
            }

            Snackbar.Add($"Tagging completed! {_lastResult.ProcessedCount} images tagged.", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Tagger error: {ex.Message}", Severity.Error);
        } finally {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private void ApplyToWizard() {
        if (_lastResult != null) {
            string finalTarget = !string.IsNullOrEmpty(_lastResult.OutputZip)
                ? _lastResult.OutputZip
                : (_lastResult.OutputDirectory ?? _inputPath);
            MudDialog.Close(DialogResult.Ok(new TaggerDialogResult {
                DatasetPath = finalTarget,
                TriggerWord = _triggerWord
            }));
        } else {
            MudDialog.Cancel();
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public sealed class TaggerResultViewModel {
        public int ProcessedCount { get; set; }
        public string? OutputDirectory { get; set; }
        public string? OutputZip { get; set; }
        public List<SampleCaptionItem> SampleCaptions { get; set; } = new();
    }

    public sealed class SampleCaptionItem {
        public string Image { get; set; } = string.Empty;
        public string Caption { get; set; } = string.Empty;
    }

    public sealed class TaggerDialogResult {
        public string DatasetPath { get; set; } = string.Empty;
        public string TriggerWord { get; set; } = string.Empty;
    }

    private void OnCaptionStyleOrPresetChanged() {
        if (_subjectFocus == "custom") return;
        _customPrompt = GetPresetPrompt(_subjectFocus, _captionStyle);
    }

    private void ResetPromptToPreset() {
        _customPrompt = GetPresetPrompt(_subjectFocus, _captionStyle);
    }

    private static string GetPresetPrompt(string focus, string style) {
        bool isNatural = style == "natural";
        return focus switch {
            "person" => isNatural
                ? "Describe this image in 1-2 detailed sentences for training a text-to-image AI model, focusing heavily on the person. Thoroughly describe their facial expression, eye direction, hairstyle, hair color, clothing and attire details, posture, lighting, and background setting. Do not say 'This is an image of'. Be descriptive and direct."
