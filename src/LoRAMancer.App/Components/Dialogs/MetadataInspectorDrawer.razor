@inject IDialogService DialogService
@inject CivitaiService Civitai
@inject LoraMetadataAggregatorService Aggregator
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudDrawer @bind-Open="IsOpen" Anchor="Anchor.Right" Elevation="3" Variant="DrawerVariant.Temporary" Width="540px" Style="background-color: #181825; border-left: 1px solid #313244;">
    <MudDrawerHeader Class="d-flex align-center justify-space-between pb-2" Style="border-bottom: 1px solid #313244;">
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">LoRA Metadata Inspector</MudText>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => IsOpen = false)" />
    </MudDrawerHeader>

    <div class="p-4" style="overflow-y: auto; max-height: calc(100vh - 80px);">
        @if (Metadata != null) {
            <MudCard Elevation="0" Class="mb-4" Style="background-color: #11111b; border: 1px solid #313244;">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#cba6f7;">@Metadata.FileName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Path: @Metadata.FilePath</MudText>
                    <div class="d-flex align-center gap-2 mt-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@Metadata.BaseModel</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@(Metadata.FileSizeBytes / (1024 * 1024)) MB</MudChip>
                    </div>
                </MudCardContent>
                <MudCardActions Class="d-flex flex-column gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="OpenCloneModalAsync">
                        Clone Configuration
                    </MudButton>
                    <div class="d-flex gap-2" style="width: 100%;">
                        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" FullWidth="true" StartIcon="@Icons.Material.Filled.DataObject" OnClick="SaveMetadataJsonAsync">
                            Save JSON File
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyMetadataJsonAsync">
                            Copy JSON
                        </MudButton>
                    </div>
                </MudCardActions>
            </MudCard>

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" Style="background-color: transparent;">
                <!-- Hyperparameters Tab -->
                <MudTabPanel Text="Hyperparameters" Icon="@Icons.Material.Filled.Tune">
                    <MudSimpleTable Dense="true" Hover="true" Style="background-color: #11111b; border-radius: 8px;">
                        <tbody>
                            <tr>
                                <td><b>Network Dim (Rank)</b></td>
                                <td style="color:#89b4fa;">@(Metadata.NetworkDim?.ToString() ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><b>Network Alpha</b></td>
                                <td style="color:#89b4fa;">@(Metadata.NetworkAlpha?.ToString() ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><b>Learning Rate</b></td>
                                <td style="color:#a6e3a1;">@(Metadata.LearningRate?.ToString("0.#####e+00") ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><b>UNet LR</b></td>
                                <td>@(Metadata.UnetLearningRate?.ToString("0.#####e+00") ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><b>Text Encoder LR</b></td>
                                <td>@(Metadata.TextEncoderLearningRate?.ToString("0.#####e+00") ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><b>Optimizer</b></td>
                                <td style="color:#f9e2af;">@(string.IsNullOrEmpty(Metadata.Optimizer) ? "N/A" : Metadata.Optimizer)</td>
                            </tr>
                            <tr>
                                <td><b>LR Scheduler</b></td>
                                <td>@(string.IsNullOrEmpty(Metadata.LrScheduler) ? "N/A" : Metadata.LrScheduler)</td>
                            </tr>
                            <tr>
                                <td><b>Epochs</b></td>
                                <td>@(Metadata.Epochs?.ToString() ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><b>Total Steps</b></td>
                                <td>@(Metadata.TotalSteps?.ToString() ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td><b>Resolution</b></td>
                                <td>@(string.IsNullOrEmpty(Metadata.Resolution) ? "N/A" : Metadata.Resolution)</td>
                            </tr>
                            <tr>
                                <td><b>Precision</b></td>
                                <td>@(string.IsNullOrEmpty(Metadata.Precision) ? "N/A" : Metadata.Precision)</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>

                <!-- Multi-Provider Lookup Tab -->
                <MudTabPanel Text="Provider Lookup" Icon="@Icons.Material.Filled.Hub">
                    @if (_isQueryingProviders) {
                        <div class="p-4 text-center">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-2" />
                            <MudText Typo="Typo.body2">@_lookupStatus</MudText>
                            @if (_hashProgress > 0 && _hashProgress < 100) {
                                <MudProgressLinear Color="Color.Primary" Value="@_hashProgress" Class="mt-2" />
                            }
                        </div>
                    } else if (EffectiveInfo != null) {
                        <MudCard Elevation="0" Style="background-color: #11111b; border: 1px solid #313244;" Class="mb-3">
                            @if (!string.IsNullOrEmpty(EffectiveInfo.PreviewImageUrl)) {
                                <MudCardMedia Image="@EffectiveInfo.PreviewImageUrl" Height="200" />
                            }
                            <MudCardContent>
                                @if (_contributingProviders.Count > 0) {
                                    <div class="d-flex align-center gap-1 mb-2 flex-wrap">
                                        <span style="font-size: 0.72rem; color: #a6adc8;">Sources:</span>
                                        @foreach (string p in _contributingProviders) {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Tertiary" Style="font-size: 0.7rem; height: 22px;">@p</MudChip>
                                        }
                                    </div>
                                }
                                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #cba6f7;">@EffectiveInfo.ModelName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Version: @EffectiveInfo.VersionName • Base: @EffectiveInfo.BaseModel</MudText>

                                @if (EffectiveInfo.TrainedWords.Count > 0) {
                                    <div class="mt-3">
                                        <MudText Typo="Typo.subtitle2" Class="mb-1" Color="Color.Primary">Trained Trigger Words (@EffectiveInfo.TrainedWords.Count):</MudText>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var word in EffectiveInfo.TrainedWords) {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@word</MudChip>
                                            }
                                        </div>
                                    </div>
                                }
                            </MudCardContent>
                            <MudCardActions Class="d-flex flex-wrap gap-2">
                                @if (!string.IsNullOrEmpty(EffectiveInfo.CivitaiUrl)) {
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" Href="@EffectiveInfo.CivitaiUrl" Target="_blank" StartIcon="@Icons.Material.Filled.OpenInNew">
                                        Open Source
                                    </MudButton>
                                }
                                @foreach (var kvp in _providerSourceUrls) {
                                    @if (!string.IsNullOrEmpty(kvp.Value) && kvp.Value != EffectiveInfo.CivitaiUrl) {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Size="Size.Small" Href="@kvp.Value" Target="_blank" StartIcon="@Icons.Material.Filled.OpenInNew">
                                            @kvp.Key
                                        </MudButton>
                                    }
                                }
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LookupProvidersAsync">
                                    Re-query
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    } else {
                        <div class="p-4 text-center" style="background-color: #11111b; border: 1px dashed #313244; border-radius: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Multi-Provider Enrichment</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                                Queries Civitai (SHA-256), Hugging Face Hub (Model Card &amp; README), and Danbooru (Tag Classifier) to fill in missing details.
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudSync" OnClick="LookupProvidersAsync">
                                Query All Providers
                            </MudButton>
                        </div>
                    }
                </MudTabPanel>

                <!-- Raw Header Tab -->
                <MudTabPanel Text="Raw Header" Icon="@Icons.Material.Filled.Code">
                    <MudTextField @bind-Value="_filterKey" Placeholder="Filter metadata keys..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <div style="max-height: 400px; overflow-y: auto;">
                        @foreach (var kvp in FilteredMetadata) {
                            <div class="mb-2 p-2 rounded" style="background-color: #11111b; border: 1px solid #313244; font-family: monospace; font-size: 0.8rem;">
                                <div style="color: #cba6f7; font-weight: 600;">@kvp.Key</div>
                                <div style="color: #a6adc8; word-break: break-all;">@kvp.Value</div>
                            </div>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
    </div>
</MudDrawer>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public LoraMetadata? Metadata { get; set; }

    private string _filterKey = string.Empty;
    private bool _isQueryingProviders;
    private string _lookupStatus = string.Empty;
    private int _hashProgress;
    private CivitaiModelVersionInfo? _civitaiInfo;
    private List<string> _contributingProviders = new();
    private Dictionary<string, string> _providerSourceUrls = new();

    private CivitaiModelVersionInfo? EffectiveInfo => Metadata?.CivitaiInfo ?? _civitaiInfo;

    private IEnumerable<KeyValuePair<string, string>> FilteredMetadata {
        get {
            if (Metadata == null) {
                return Enumerable.Empty<KeyValuePair<string, string>>();
            }
            if (string.IsNullOrWhiteSpace(_filterKey)) {
                return Metadata.RawHeaderMetadata;
            }
            return Metadata.RawHeaderMetadata.Where(k => k.Key.Contains(_filterKey, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task LookupProvidersAsync() {
        if (Metadata == null || !File.Exists(Metadata.FilePath)) {
            Snackbar.Add("LoRA file path not available.", Severity.Warning);
            return;
        }

        _isQueryingProviders = true;
        _lookupStatus = "Computing SHA256 model hash...";
        _hashProgress = 0;

        try {
            if (string.IsNullOrWhiteSpace(Metadata.Sha256Hash)) {
                Metadata.Sha256Hash = await Civitai.ComputeFileSha256Async(Metadata.FilePath, p => {
                    _hashProgress = p;
                    InvokeAsync(StateHasChanged);
                });
            }

            _lookupStatus = "Querying Civitai, Hugging Face Hub, and Danbooru...";
            StateHasChanged();

            AggregatedLoraEnrichmentResult result = await Aggregator.EnrichAsync(Metadata);
            _civitaiInfo = Metadata.CivitaiInfo;
            _contributingProviders = result.ContributingProviders;
            _providerSourceUrls = result.ProviderSourceUrls;

            if (result.Success) {
                string provs = string.Join(", ", result.ContributingProviders);
                Snackbar.Add($"Enriched from {provs}!", Severity.Success);
            } else {
                Snackbar.Add("No metadata found across active providers.", Severity.Info);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Multi-provider lookup failed: {ex.Message}", Severity.Error);
        } finally {
            _isQueryingProviders = false;
        }
    }

    private async Task OpenCloneModalAsync() {
        if (Metadata == null) {
            return;
        }

        DialogParameters parameters = new() {
            ["DonorLora"] = Metadata
        };

        DialogOptions options = new() {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<CloneConfigModal>("Clone LoRA Configuration", parameters, options);
    }

    private string BuildMetadataJson() {
        if (Metadata == null) {
            return "{}";
        }

        var exportData = new {
            loramancer_export_version = "1.0",
            exported_at_utc = DateTime.UtcNow.ToString("o"),
            file_info = new {
                file_name = Metadata.FileName,
                file_path = Metadata.FilePath,
                file_size_bytes = Metadata.FileSizeBytes,
                formatted_size = Metadata.FormattedSize,
                sha256_hash = Metadata.Sha256Hash
            },
            hyperparameters = new {
                base_model = Metadata.EffectiveBaseModel,
                network_dim = Metadata.NetworkDim,
                network_alpha = Metadata.NetworkAlpha,
                network_module = Metadata.NetworkModule,
                learning_rate = Metadata.LearningRate,
                unet_learning_rate = Metadata.UnetLearningRate,
                text_encoder_learning_rate = Metadata.TextEncoderLearningRate,
                optimizer = Metadata.Optimizer,
                lr_scheduler = Metadata.LrScheduler,
                epochs = Metadata.Epochs,
                total_steps = Metadata.TotalSteps,
                resolution = Metadata.Resolution,
                precision = Metadata.Precision
            },
            civitai = Metadata.CivitaiInfo != null ? new {
                model_name = Metadata.CivitaiInfo.ModelName,
                version_name = Metadata.CivitaiInfo.VersionName,
                base_model = Metadata.CivitaiInfo.BaseModel,
                civitai_url = Metadata.CivitaiInfo.CivitaiUrl,
                trained_words = Metadata.CivitaiInfo.TrainedWords
            } : null,
            raw_header_metadata = Metadata.RawHeaderMetadata
        };

        return System.Text.Json.JsonSerializer.Serialize(exportData, new System.Text.Json.JsonSerializerOptions {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }

    private async Task SaveMetadataJsonAsync() {
        if (Metadata == null) {
            return;
        }

        try {
            string json = BuildMetadataJson();
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);

            string? savedPath = null;
            if (!string.IsNullOrWhiteSpace(Metadata.FilePath)) {
                string? dir = Path.GetDirectoryName(Metadata.FilePath);
                if (!string.IsNullOrWhiteSpace(dir) && Directory.Exists(dir)) {
                    string baseName = Path.GetFileNameWithoutExtension(Metadata.FilePath);
                    savedPath = Path.Combine(dir, $"{baseName}_metadata.json");
                    await File.WriteAllTextAsync(savedPath, json);
                }
            }

            if (!string.IsNullOrWhiteSpace(savedPath)) {
                Snackbar.Add($"Saved {Path.GetFileName(savedPath)} and copied JSON to clipboard!", Severity.Success);
            } else {
                Snackbar.Add("Copied LoRA metadata JSON to clipboard!", Severity.Success);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Failed to save JSON: {ex.Message}", Severity.Error);
        }
    }

    private async Task CopyMetadataJsonAsync() {
        if (Metadata == null) {
            return;
        }

        try {
            string json = BuildMetadataJson();
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
            Snackbar.Add("Copied LoRA metadata JSON to clipboard!", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to copy JSON: {ex.Message}", Severity.Error);
        }
    }
}
