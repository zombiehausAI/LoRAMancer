@using LoRAMancer.App.Models
@using LoRAMancer.App.Services
@using System.Text.Json
@implements IDisposable
@inject LoraUpdaterService UpdaterService
@inject LoraLibraryService LibraryService
@inject SettingsService Settings
@inject NativeFileDialogService FileDialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Color="Color.Tertiary" />
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Lora Updater</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Verify and update local LoRAs to the newest Civitai versions with SHA256 integrity and automated backups
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- Configuration Card -->
        <MudCard Elevation="0" Class="pa-3 mb-3" Style="background-color: var(--bg-dark-surface, #11111b); border: 1px solid var(--border-dark, #313244); border-radius: 8px;">
            <MudGrid Spacing="2">
                @if (LibraryService.Libraries.Count > 0) {
                    <!-- Target Library Selector -->
                    <MudItem xs="12">
                        <MudSelect T="string" Value="_selectedLibraryId" ValueChanged="OnLibraryChanged" Label="Target Library" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="UpdaterService.IsRunning">
                            @foreach (var lib in LibraryService.Libraries) {
                                <MudSelectItem Value="@lib.Id">
                                    📚 @lib.Name (@lib.ModelCount models) - @lib.FolderPath
                                </MudSelectItem>
                            }
                            <MudSelectItem Value="@("custom")">📁 Custom Folder (Manual Selection)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                }

                <!-- Target Directory -->
                <MudItem xs="12" md="8">
                    <div class="d-flex align-center gap-2">
                        <MudTextField @bind-Value="_targetFolder" Label="LoRA Directory to Check" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="D:\models\loras" FullWidth="true" Disabled="UpdaterService.IsRunning" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="BrowseFolderAsync" Disabled="UpdaterService.IsRunning">Browse</MudButton>
                    </div>
                </MudItem>

                <!-- Civitai API Key -->
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_apiKey" Label="Civitai API Key (Optional)" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Placeholder="Bearer key for private/early models" Disabled="UpdaterService.IsRunning" />
                </MudItem>

                <!-- Backup Directory -->
                <MudItem xs="12" md="8">
                    <div class="d-flex align-center gap-2">
                        <MudTextField @bind-Value="_backupFolder" Label="Backup Directory (Optional - leaves .bak if empty)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="D:\models\loras_backup" FullWidth="true" Disabled="UpdaterService.IsRunning" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseBackupFolderAsync" Disabled="UpdaterService.IsRunning">Browse</MudButton>
                    </div>
                </MudItem>

                <!-- Options -->
                <MudItem xs="12" md="4" Class="d-flex align-center gap-3">
                    <MudCheckBox @bind-Value="_recursive" Label="Scan Subfolders" Color="Color.Tertiary" Dense="true" Disabled="UpdaterService.IsRunning" />
                    <MudCheckBox @bind-Value="_allowMismatch" Label="Allow Base Mismatch" Color="Color.Warning" Dense="true" Disabled="UpdaterService.IsRunning" />
                </MudItem>
            </MudGrid>
        </MudCard>

        <!-- Progress Indicator -->
        @if (UpdaterService.IsRunning) {
            <MudCard Elevation="0" Class="pa-3 mb-3" Style="background-color: rgba(203, 166, 247, 0.08); border: 1px solid #cba6f7; border-radius: 8px;">
                <div class="d-flex align-center justify-space-between mb-2">
                    <div class="d-flex align-center gap-2">
                        <MudProgressCircular Size="Size.Small" Color="Color.Tertiary" Indeterminate="@(UpdaterService.TotalFiles == 0)" />
                        <MudText Typo="Typo.body2" Style="color: #cdd6f4; font-weight: 600;">
                            @UpdaterService.CurrentStatus
                        </MudText>
                    </div>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowDownward" OnClick="RunInBackground">
                            Run in Background
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelOperation">
                            Cancel
                        </MudButton>
                    </div>
                </div>
                @if (UpdaterService.TotalFiles > 0) {
                    <MudProgressLinear Color="Color.Tertiary" Value="@((double)UpdaterService.ProcessedFiles / UpdaterService.TotalFiles * 100)" Class="my-1" />
                }
            </MudCard>
        }

        <!-- Summary & Stats Bar (if checked or updated) -->
        @if (_summary != null) {
            <MudCard Elevation="0" Class="pa-3 mb-3" Style="background-color: #181825; border: 1px solid #313244; border-radius: 8px;">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div class="d-flex align-center gap-3">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Total: @_summary.TotalFiles</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Updates Available: @_summary.UpdatesAvailable</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Up to Date: @_summary.UpToDate</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Not on Civitai: @_summary.NotFound</MudChip>
                        @if (_summary.SkippedBaseMismatch > 0) {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Base Mismatches: @_summary.SkippedBaseMismatch</MudChip>
                        }
                    </div>
                    @if (_summary.UpdatesAvailable > 0 && !UpdaterService.IsRunning) {
                        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="PerformUpdateAllAsync">
                            Update Available (@_summary.UpdatesAvailable)
                        </MudButton>
                    }
                </div>
            </MudCard>
        }

        <!-- Results Table -->
        @if (_items.Count > 0) {
            <MudTable Items="_items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Style="background-color: #181825; border: 1px solid #313244; border-radius: 8px; max-height: 340px; overflow-y: auto;">
                <HeaderContent>
                    <MudTh>File</MudTh>
                    <MudTh>Model on Civitai</MudTh>
                    <MudTh>Local Version</MudTh>
                    <MudTh>Latest Version</MudTh>
                    <MudTh>Base Model</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="File">
                        <div style="font-weight: 600; color: #cdd6f4;">@context.FileName</div>
                        <div style="font-size: 0.7rem; color: #6c7086;">@context.FilePath</div>
                    </MudTd>
                    <MudTd DataLabel="Model">@(context.ModelName ?? "-")</MudTd>
                    <MudTd DataLabel="Local Version">@(context.LocalVersion ?? "-")</MudTd>
                    <MudTd DataLabel="Latest Version">@(context.LatestVersion ?? "-")</MudTd>
                    <MudTd DataLabel="Base Model">
                        @if (!string.IsNullOrEmpty(context.BaseModel)) {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.BaseModel</MudChip>
                        } else {
                            <span>-</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @switch (context.Status) {
                            case "update_available":
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Update Available</MudChip>
                                break;
                            case "up_to_date":
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Up to Date</MudChip>
                                break;
                            case "updated":
                                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled">Updated</MudChip>
                                break;
                            case "base_mismatch":
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Base Mismatch</MudChip>
                                break;
                            case "not_found":
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Not on Civitai</MudChip>
                                break;
                            default:
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Status</MudChip>
                                break;
                        }
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        @if (context.Status == "update_available") {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => UpdateSingleFileAsync(context))" Disabled="UpdaterService.IsRunning">
                                Update
                            </MudButton>
                        } else if (context.Status == "updated") {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        <!-- Operation Log Output -->
        @if (UpdaterService.LiveLogs.Count > 0) {
            <MudExpansionPanels Class="mt-3">
                <MudExpansionPanel Text="@($"Live Output Log ({UpdaterService.LiveLogs.Count} lines)")" Style="background-color: #11111b; border: 1px solid #313244;">
                    <div style="max-height: 160px; overflow-y: auto; font-family: monospace; font-size: 0.75rem; color: #a6adc8;">
                        @foreach (var log in UpdaterService.LiveLogs) {
                            <div>@log</div>
                        }
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CheckUpdatesAsync" Disabled="UpdaterService.IsRunning || string.IsNullOrWhiteSpace(_targetFolder)" StartIcon="@Icons.Material.Filled.Search">
            Check for Updates (Dry Run)
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="PerformUpdateAllAsync" Disabled="UpdaterService.IsRunning || string.IsNullOrWhiteSpace(_targetFolder)" StartIcon="@Icons.Material.Filled.SystemUpdateAlt">
            Scan & Update All
        </MudButton>
        @if (UpdaterService.IsRunning) {
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="RunInBackground" StartIcon="@Icons.Material.Filled.ArrowDownward">
                Run in Background
            </MudButton>
        }
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseDialog">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string InitialFolder { get; set; } = string.Empty;

    private string _selectedLibraryId = string.Empty;
    private string _targetFolder = string.Empty;
    private string _apiKey = string.Empty;
    private string _backupFolder = string.Empty;
    private bool _recursive = true;
    private bool _allowMismatch;

    private UpdaterSummary? _summary;
    private readonly List<LoraItemModel> _items = new();

    private sealed class UpdaterSummary {
        public int TotalFiles { get; set; }
        public int UpdatesAvailable { get; set; }
        public int UpToDate { get; set; }
        public int NotFound { get; set; }
        public int SkippedWrongType { get; set; }
        public int SkippedBaseMismatch { get; set; }
    }

    private sealed class LoraItemModel {
        public string FilePath { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string? ModelName { get; set; }
        public string? LocalVersion { get; set; }
        public string? LatestVersion { get; set; }
        public string? BaseModel { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? DownloadUrl { get; set; }
        public string? NewFilename { get; set; }
        public string? ExpectedHash { get; set; }
    }

    protected override void OnInitialized() {
        UpdaterService.OnStateChanged += HandleStateChanged;

        if (LibraryService.ActiveLibrary != null) {
            _selectedLibraryId = LibraryService.ActiveLibrary.Id;
            _targetFolder = !string.IsNullOrWhiteSpace(UpdaterService.TargetFolder) 
                ? UpdaterService.TargetFolder 
                : (!string.IsNullOrWhiteSpace(InitialFolder) ? InitialFolder : LibraryService.ActiveLibrary.FolderPath);
        } else {
            _selectedLibraryId = "custom";
            _targetFolder = !string.IsNullOrWhiteSpace(UpdaterService.TargetFolder) ? UpdaterService.TargetFolder : InitialFolder;
        }

        _apiKey = Settings.Current.CivitaiApiKey;

        if (!string.IsNullOrWhiteSpace(UpdaterService.LastResultJson)) {
            ParseResults(UpdaterService.LastResultJson);
        }
    }

    private void OnLibraryChanged(string libraryId) {
        _selectedLibraryId = libraryId;
        if (libraryId != "custom") {
            var lib = LibraryService.Libraries.FirstOrDefault(l => l.Id == libraryId);
            if (lib != null && !string.IsNullOrWhiteSpace(lib.FolderPath)) {
                _targetFolder = lib.FolderPath;
            }
        }
    }

    private async void HandleStateChanged() {
        await InvokeAsync(() => {
            if (!string.IsNullOrWhiteSpace(UpdaterService.LastResultJson)) {
                ParseResults(UpdaterService.LastResultJson);
            }
            StateHasChanged();
        });
    }

    private async Task BrowseFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select LoRA Directory");
        if (!string.IsNullOrEmpty(folder)) {
            _targetFolder = folder;
            _selectedLibraryId = LibraryService.Libraries.FirstOrDefault(l => string.Equals(l.FolderPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar), folder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar), StringComparison.OrdinalIgnoreCase))?.Id ?? "custom";
        }
    }

    private async Task BrowseBackupFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select Backup Directory");
        if (!string.IsNullOrEmpty(folder)) {
            _backupFolder = folder;
        }
    }

    private async Task CheckUpdatesAsync() {
        if (string.IsNullOrWhiteSpace(_targetFolder) || !Directory.Exists(_targetFolder)) {
            Snackbar.Add("Please select a valid LoRA folder.", Severity.Warning);
            return;
        }

        _items.Clear();
        _summary = null;

        try {
            await UpdaterService.StartCheckUpdatesAsync(_targetFolder, _recursive, _apiKey);
            Snackbar.Add("Checking Civitai in background...", Severity.Info);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to start check: {ex.Message}", Severity.Error);
        }
    }

    private async Task PerformUpdateAllAsync() {
        if (string.IsNullOrWhiteSpace(_targetFolder) || !Directory.Exists(_targetFolder)) {
            Snackbar.Add("Please select a valid LoRA folder.", Severity.Warning);
            return;
        }

        try {
            await UpdaterService.StartScanAndUpdateAsync(_targetFolder, _recursive, _backupFolder, _apiKey, _allowMismatch);
            Snackbar.Add("Starting background update & backup...", Severity.Info);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to start update: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateSingleFileAsync(LoraItemModel item) {
        try {
            await UpdaterService.StartUpdateSingleAsync(item.FilePath, _backupFolder, _apiKey);
            Snackbar.Add($"Updating {item.FileName} in background...", Severity.Info);
        } catch (Exception ex) {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void CancelOperation() {
        UpdaterService.Cancel();
        Snackbar.Add("Stopping Lora Updater...", Severity.Warning);
    }

    private void RunInBackground() {
        MudDialog.Close(DialogResult.Ok(false));
        Snackbar.Add("Lora Updater is continuing in the background.", Severity.Info);
    }

    private void ParseResults(string? json) {
        if (string.IsNullOrWhiteSpace(json)) return;

        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("summary", out var sumEl)) {
                _summary = new UpdaterSummary {
                    TotalFiles = sumEl.TryGetProperty("total_files", out var tf) ? tf.GetInt32() : 0,
                    UpdatesAvailable = sumEl.TryGetProperty("updates_available", out var ua) ? ua.GetInt32() : 0,
                    UpToDate = sumEl.TryGetProperty("up_to_date", out var utd) ? utd.GetInt32() : 0,
                    NotFound = sumEl.TryGetProperty("not_found", out var nf) ? nf.GetInt32() : 0,
                    SkippedWrongType = sumEl.TryGetProperty("skipped_wrong_type", out var swt) ? swt.GetInt32() : 0,
                    SkippedBaseMismatch = sumEl.TryGetProperty("skipped_base_mismatch", out var sbm) ? sbm.GetInt32() : 0
                };
            }

            if (root.TryGetProperty("results", out var resArr) && resArr.ValueKind == JsonValueKind.Array) {
                _items.Clear();
                foreach (var el in resArr.EnumerateArray()) {
                    var item = new LoraItemModel {
                        FilePath = el.GetProperty("file_path").GetString() ?? string.Empty,
                        FileName = el.GetProperty("file_name").GetString() ?? string.Empty,
                        Status = el.GetProperty("status").GetString() ?? "unknown"
                    };

                    if (el.TryGetProperty("model_name", out var mn)) item.ModelName = mn.GetString();
                    if (el.TryGetProperty("version_name", out var vn)) item.LocalVersion = vn.GetString();
                    if (el.TryGetProperty("local_version", out var lvn)) item.LocalVersion = lvn.GetString();
                    if (el.TryGetProperty("latest_version", out var ltv)) item.LatestVersion = ltv.GetString();
                    if (el.TryGetProperty("base_model", out var bm)) item.BaseModel = bm.GetString();
                    if (el.TryGetProperty("download_url", out var du)) item.DownloadUrl = du.GetString();
                    if (el.TryGetProperty("new_filename", out var nf)) item.NewFilename = nf.GetString();
                    if (el.TryGetProperty("expected_hash", out var eh)) item.ExpectedHash = eh.GetString();

                    _items.Add(item);
                }
            }
        } catch {
            // Ignore parse errors
        }
    }

    private void CloseDialog() {
        MudDialog.Close(DialogResult.Ok(true));
    }

    public void Dispose() {
        UpdaterService.OnStateChanged -= HandleStateChanged;
    }
}
