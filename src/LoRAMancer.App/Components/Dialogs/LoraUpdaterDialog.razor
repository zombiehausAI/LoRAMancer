@using LoRAMancer.App.Models
@using LoRAMancer.App.Services
@using System.Text.Json
@inject PluginManagerService PluginManager
@inject SettingsService Settings
@inject NativeFileDialogService FileDialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Color="Color.Tertiary" />
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Lora Updater</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Verify and update local LoRAs to the newest Civitai versions with SHA256 integrity and automated backups
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- Configuration Card -->
        <MudCard Elevation="0" Class="pa-3 mb-3" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
            <MudGrid Spacing="2">
                <!-- Target Directory -->
                <MudItem xs="12" md="8">
                    <div class="d-flex align-center gap-2">
                        <MudTextField @bind-Value="_targetFolder" Label="LoRA Directory to Check" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="D:\models\loras" FullWidth="true" Disabled="_isBusy" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="BrowseFolderAsync" Disabled="_isBusy">Browse</MudButton>
                    </div>
                </MudItem>

                <!-- Civitai API Key -->
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_apiKey" Label="Civitai API Key (Optional)" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Placeholder="Bearer key for private/early models" Disabled="_isBusy" />
                </MudItem>

                <!-- Backup Directory -->
                <MudItem xs="12" md="8">
                    <div class="d-flex align-center gap-2">
                        <MudTextField @bind-Value="_backupFolder" Label="Backup Directory (Optional - leaves .bak if empty)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="D:\models\loras_backup" FullWidth="true" Disabled="_isBusy" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="BrowseBackupFolderAsync" Disabled="_isBusy">Browse</MudButton>
                    </div>
                </MudItem>

                <!-- Options -->
                <MudItem xs="12" md="4" Class="d-flex align-center gap-3">
                    <MudCheckBox @bind-Value="_recursive" Label="Scan Subfolders" Color="Color.Tertiary" Dense="true" Disabled="_isBusy" />
                    <MudCheckBox @bind-Value="_allowMismatch" Label="Allow Base Mismatch" Color="Color.Warning" Dense="true" Disabled="_isBusy" />
                </MudItem>
            </MudGrid>
        </MudCard>

        <!-- Progress Indicator -->
        @if (_isBusy) {
            <MudCard Elevation="0" Class="pa-3 mb-3" Style="background-color: rgba(203, 166, 247, 0.08); border: 1px solid #cba6f7; border-radius: 8px;">
                <div class="d-flex align-center gap-2">
                    <MudProgressCircular Size="Size.Small" Color="Color.Tertiary" Indeterminate="true" />
                    <MudText Typo="Typo.body2" Style="color: #cdd6f4; font-weight: 600;">@_statusMessage</MudText>
                </div>
            </MudCard>
        }

        <!-- Summary & Stats Bar (if checked or updated) -->
        @if (_summary != null) {
            <MudCard Elevation="0" Class="pa-3 mb-3" Style="background-color: #181825; border: 1px solid #313244; border-radius: 8px;">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div class="d-flex align-center gap-3">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Total: @_summary.TotalFiles</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Updates Available: @_summary.UpdatesAvailable</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Up to Date: @_summary.UpToDate</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Not on Civitai: @_summary.NotFound</MudChip>
                        @if (_summary.SkippedBaseMismatch > 0) {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Base Mismatches: @_summary.SkippedBaseMismatch</MudChip>
                        }
                    </div>
                    @if (_summary.UpdatesAvailable > 0) {
                        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="PerformUpdateAllAsync" Disabled="_isBusy">
                            Update Available (@_summary.UpdatesAvailable)
                        </MudButton>
                    }
                </div>
            </MudCard>
        }

        <!-- Results Table -->
        @if (_items.Count > 0) {
            <MudTable Items="_items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Style="background-color: #181825; border: 1px solid #313244; border-radius: 8px; max-height: 380px; overflow-y: auto;">
                <HeaderContent>
                    <MudTh>File</MudTh>
                    <MudTh>Model on Civitai</MudTh>
                    <MudTh>Local Version</MudTh>
                    <MudTh>Latest Version</MudTh>
                    <MudTh>Base Model</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="File">
                        <div style="font-weight: 600; color: #cdd6f4;">@context.FileName</div>
                        <div style="font-size: 0.7rem; color: #6c7086;">@context.FilePath</div>
                    </MudTd>
                    <MudTd DataLabel="Model">@(context.ModelName ?? "-")</MudTd>
                    <MudTd DataLabel="Local Version">@(context.LocalVersion ?? "-")</MudTd>
                    <MudTd DataLabel="Latest Version">@(context.LatestVersion ?? "-")</MudTd>
                    <MudTd DataLabel="Base Model">
                        @if (!string.IsNullOrEmpty(context.BaseModel)) {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.BaseModel</MudChip>
                        } else {
                            <span>-</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @switch (context.Status) {
                            case "update_available":
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Update Available</MudChip>
                                break;
                            case "up_to_date":
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Up to Date</MudChip>
                                break;
                            case "updated":
                                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled">Updated</MudChip>
                                break;
                            case "base_mismatch":
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Base Mismatch</MudChip>
                                break;
                            case "not_found":
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Not on Civitai</MudChip>
                                break;
                            default:
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Status</MudChip>
                                break;
                        }
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        @if (context.Status == "update_available") {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => UpdateSingleFileAsync(context))" Disabled="_isBusy">
                                Update
                            </MudButton>
                        } else if (context.Status == "updated") {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        <!-- Operation Log Output -->
        @if (_logLines.Count > 0) {
            <MudExpansionPanels Class="mt-3">
                <MudExpansionPanel Text="Execution Log Details" Style="background-color: #11111b; border: 1px solid #313244;">
                    <div style="max-height: 160px; overflow-y: auto; font-family: monospace; font-size: 0.75rem; color: #a6adc8;">
                        @foreach (var log in _logLines) {
                            <div>@log</div>
                        }
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CheckUpdatesAsync" Disabled="_isBusy || string.IsNullOrWhiteSpace(_targetFolder)" StartIcon="@Icons.Material.Filled.Search">
            Check for Updates (Dry Run)
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="PerformUpdateAllAsync" Disabled="_isBusy || string.IsNullOrWhiteSpace(_targetFolder)" StartIcon="@Icons.Material.Filled.SystemUpdateAlt">
            Scan & Update All
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseDialog" Disabled="_isBusy">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string InitialFolder { get; set; } = string.Empty;

    private string _targetFolder = string.Empty;
    private string _apiKey = string.Empty;
    private string _backupFolder = string.Empty;
    private bool _recursive = true;
    private bool _allowMismatch;

    private bool _isBusy;
    private string _statusMessage = string.Empty;
    private readonly List<string> _logLines = new();

    private UpdaterSummary? _summary;
    private readonly List<LoraItemModel> _items = new();

    private sealed class UpdaterSummary {
        public int TotalFiles { get; set; }
        public int UpdatesAvailable { get; set; }
        public int UpToDate { get; set; }
        public int NotFound { get; set; }
        public int SkippedWrongType { get; set; }
        public int SkippedBaseMismatch { get; set; }
    }

    private sealed class LoraItemModel {
        public string FilePath { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string? ModelName { get; set; }
        public string? LocalVersion { get; set; }
        public string? LatestVersion { get; set; }
        public string? BaseModel { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? DownloadUrl { get; set; }
        public string? NewFilename { get; set; }
        public string? ExpectedHash { get; set; }
    }

    protected override void OnInitialized() {
        _targetFolder = InitialFolder;
        _apiKey = Settings.Current.CivitaiApiKey;
    }

    private async Task BrowseFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select LoRA Directory");
        if (!string.IsNullOrEmpty(folder)) {
            _targetFolder = folder;
        }
    }

    private async Task BrowseBackupFolderAsync() {
        string? folder = await FileDialogService.PickFolderAsync("Select Backup Directory");
        if (!string.IsNullOrEmpty(folder)) {
            _backupFolder = folder;
        }
    }

    private async Task CheckUpdatesAsync() {
        if (string.IsNullOrWhiteSpace(_targetFolder) || !Directory.Exists(_targetFolder)) {
            Snackbar.Add("Please select a valid LoRA folder.", Severity.Warning);
            return;
        }

        _isBusy = true;
        _statusMessage = "Checking Civitai for updates across files...";
        _items.Clear();
        _summary = null;
        _logLines.Add($"[{DateTime.Now:T}] Starting update check on: {_targetFolder} (Recursive: {_recursive})");
        StateHasChanged();

        try {
            var parameters = new Dictionary<string, object?> {
                ["folder"] = _targetFolder,
                ["recursive"] = _recursive,
                ["api_key"] = _apiKey
            };

            var result = await PluginManager.ExecutePluginAsync("lora-updater", "check_updates", parameters);
            if (!result.Success) {
                Snackbar.Add($"Update check failed: {result.Message}", Severity.Error);
                _logLines.Add($"[Error] {result.Message}");
                return;
            }

            ParseResults(result.Data?.ToString());
            Snackbar.Add($"Check complete! Found {_summary?.UpdatesAvailable ?? 0} updates available.", Severity.Info);
        } catch (Exception ex) {
            Snackbar.Add($"Failed to execute plugin: {ex.Message}", Severity.Error);
            _logLines.Add($"[Exception] {ex.Message}");
        } finally {
            _isBusy = false;
            _statusMessage = string.Empty;
            StateHasChanged();
        }
    }

    private async Task PerformUpdateAllAsync() {
        if (string.IsNullOrWhiteSpace(_targetFolder) || !Directory.Exists(_targetFolder)) {
            Snackbar.Add("Please select a valid LoRA folder.", Severity.Warning);
            return;
        }

        _isBusy = true;
        _statusMessage = "Downloading updates and backing up old versions...";
        _logLines.Add($"[{DateTime.Now:T}] Starting scan & update on: {_targetFolder}");
        StateHasChanged();

        try {
            var parameters = new Dictionary<string, object?> {
                ["folder"] = _targetFolder,
                ["recursive"] = _recursive,
                ["backup_folder"] = _backupFolder,
                ["api_key"] = _apiKey,
                ["allow_base_mismatch"] = _allowMismatch
            };

            var result = await PluginManager.ExecutePluginAsync("lora-updater", "scan_and_update", parameters);
            if (!result.Success) {
                Snackbar.Add($"Update failed: {result.Message}", Severity.Error);
                _logLines.Add($"[Error] {result.Message}");
                return;
            }

            string? jsonStr = result.Data?.ToString();
            if (!string.IsNullOrWhiteSpace(jsonStr)) {
                using var doc = JsonDocument.Parse(jsonStr);
                var root = doc.RootElement;
                if (root.TryGetProperty("summary", out var sumEl)) {
                    int updated = sumEl.GetProperty("updated").GetInt32();
                    Snackbar.Add($"Successfully updated {updated} LoRA model(s)!", Severity.Success);
                    _logLines.Add($"[Success] Updated {updated} models. Re-checking folder status...");
                }
            }

            // Refresh check
            await CheckUpdatesAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Failed to execute update: {ex.Message}", Severity.Error);
            _logLines.Add($"[Exception] {ex.Message}");
        } finally {
            _isBusy = false;
            _statusMessage = string.Empty;
            StateHasChanged();
        }
    }

    private async Task UpdateSingleFileAsync(LoraItemModel item) {
        _isBusy = true;
        _statusMessage = $"Updating {item.FileName}...";
        _logLines.Add($"[{DateTime.Now:T}] Updating single file: {item.FileName}");
        StateHasChanged();

        try {
            var parameters = new Dictionary<string, object?> {
                ["file_path"] = item.FilePath,
                ["backup_folder"] = _backupFolder,
                ["api_key"] = _apiKey
            };

            var result = await PluginManager.ExecutePluginAsync("lora-updater", "update_single", parameters);
            if (!result.Success) {
                Snackbar.Add($"Failed to update {item.FileName}: {result.Message}", Severity.Error);
                _logLines.Add($"[Error] {result.Message}");
                return;
            }

            item.Status = "updated";
            Snackbar.Add($"Updated {item.FileName} successfully!", Severity.Success);
            _logLines.Add($"[Success] Updated {item.FileName}");
        } catch (Exception ex) {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        } finally {
            _isBusy = false;
            _statusMessage = string.Empty;
            StateHasChanged();
        }
    }

    private void ParseResults(string? json) {
        if (string.IsNullOrWhiteSpace(json)) return;

        try {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("summary", out var sumEl)) {
                _summary = new UpdaterSummary {
                    TotalFiles = sumEl.GetProperty("total_files").GetInt32(),
                    UpdatesAvailable = sumEl.GetProperty("updates_available").GetInt32(),
                    UpToDate = sumEl.GetProperty("up_to_date").GetInt32(),
                    NotFound = sumEl.GetProperty("not_found").GetInt32(),
                    SkippedWrongType = sumEl.GetProperty("skipped_wrong_type").GetInt32(),
                    SkippedBaseMismatch = sumEl.GetProperty("skipped_base_mismatch").GetInt32()
                };
            }

            if (root.TryGetProperty("results", out var resArr) && resArr.ValueKind == JsonValueKind.Array) {
                _items.Clear();
                foreach (var el in resArr.EnumerateArray()) {
                    var item = new LoraItemModel {
                        FilePath = el.GetProperty("file_path").GetString() ?? string.Empty,
                        FileName = el.GetProperty("file_name").GetString() ?? string.Empty,
                        Status = el.GetProperty("status").GetString() ?? "unknown"
                    };

                    if (el.TryGetProperty("model_name", out var mn)) item.ModelName = mn.GetString();
                    if (el.TryGetProperty("version_name", out var vn)) item.LocalVersion = vn.GetString();
                    if (el.TryGetProperty("local_version", out var lvn)) item.LocalVersion = lvn.GetString();
                    if (el.TryGetProperty("latest_version", out var ltv)) item.LatestVersion = ltv.GetString();
                    if (el.TryGetProperty("base_model", out var bm)) item.BaseModel = bm.GetString();
                    if (el.TryGetProperty("download_url", out var du)) item.DownloadUrl = du.GetString();
                    if (el.TryGetProperty("new_filename", out var nf)) item.NewFilename = nf.GetString();
                    if (el.TryGetProperty("expected_hash", out var eh)) item.ExpectedHash = eh.GetString();

                    _items.Add(item);
                }
            }
        } catch (Exception ex) {
            _logLines.Add($"[Parse Error] {ex.Message}");
        }
    }

    private void CloseDialog() {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
