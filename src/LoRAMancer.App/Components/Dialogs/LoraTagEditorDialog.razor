@using LoRAMancer.App.Engines
@using LoRAMancer.App.Models
@using LoRAMancer.App.Services
@inject ModelArchitectureRegistry ArchitectureRegistry
@inject LoraLibraryService LibraryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Assign Category &amp; Tags</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(Lora.CivitaiInfo?.ModelName ?? Lora.FileName)
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4" style="max-height: 70vh; overflow-y: auto;">
            <!-- Base Model Architecture -->
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">
                    Base Model Architecture:
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    Foundation checkpoint family (Auto-detected: <b>@Lora.BaseModel</b>)
                </MudText>

                <div class="d-flex align-center gap-2 mb-2">
                    <MudTextField @bind-Value="_selectedBaseModel" 
                                  Label="Architecture Name" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" 
                                  Placeholder="e.g. Pony, Illustrious, SD 3.5, FLUX.1, or custom model" 
                                  FullWidth="true" />
                    @if (!string.IsNullOrWhiteSpace(_selectedBaseModel) && !string.Equals(_selectedBaseModel, Lora.BaseModel, StringComparison.OrdinalIgnoreCase)) {
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => _selectedBaseModel = null)">
                            Reset Auto
                        </MudButton>
                    }
                </div>

                <div class="d-flex align-center gap-1 flex-wrap mb-1">
                    @foreach (var preset in _basePresets) {
                        bool isCur = string.Equals(_selectedBaseModel, preset, StringComparison.OrdinalIgnoreCase) || (string.IsNullOrWhiteSpace(_selectedBaseModel) && string.Equals(Lora.BaseModel, preset, StringComparison.OrdinalIgnoreCase));
                        <MudChip T="string" 
                                 Size="Size.Small" 
                                 Variant="@(isCur ? Variant.Filled : Variant.Outlined)" 
                                 Color="@(isCur ? Color.Primary : Color.Default)" 
                                 OnClick="@(() => _selectedBaseModel = preset)" 
                                 Style="cursor: pointer; font-size: 0.72rem;">
                            @preset
                        </MudChip>
                    }
                </div>
            </div>

            <MudDivider />

            <!-- Category Assignment -->
            <div>
                <div class="d-flex align-center justify-space-between mb-1">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: var(--text-primary);">
                        Primary Category:
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenCategoryManagerAsync">
                        Manage Categories
                    </MudButton>
                </div>

                <div class="d-flex align-center gap-2 flex-wrap mb-2">
                    <MudChip T="string" 
                             Variant="@(string.IsNullOrWhiteSpace(_selectedCategory) ? Variant.Filled : Variant.Outlined)" 
                             Color="@(string.IsNullOrWhiteSpace(_selectedCategory) ? Color.Primary : Color.Default)" 
                             Size="Size.Medium" 
                             OnClick="@(() => _selectedCategory = null)" 
                             Style="cursor: pointer;">
                        None (Uncategorized)
                    </MudChip>
                    @foreach (var cat in LibraryService.Categories) {
                        bool isSelected = string.Equals(_selectedCategory, cat.Name, StringComparison.OrdinalIgnoreCase);
                        <MudChip T="string" 
                                 Icon="@cat.Icon" 
                                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)" 
                                 Size="Size.Medium" 
                                 OnClick="@(() => _selectedCategory = cat.Name)" 
                                 Style="@($"cursor: pointer; font-weight: 600; border-color: {cat.Color}; {(isSelected ? $"background-color: {cat.Color}; color: #ffffff;" : $"color: {cat.Color};")}")">
                            @cat.Name
                        </MudChip>
                    }
                </div>
            </div>

            <MudDivider />

            <!-- Custom Tags -->
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">
                    Custom Model Tags:
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    Add searchable tags (e.g. "anime", "cyberpunk", "lighting", "detailed", "realistic")
                </MudText>

                <div class="d-flex align-center gap-2 mb-3">
                    <MudTextField @bind-Value="_newTagInput" 
                                  Placeholder="Type tag and press Enter..." 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" 
                                  OnKeyDown="HandleTagInputKeyDown" 
                                  Immediate="true" />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddTag">
                        Add
                    </MudButton>
                </div>

                <div class="d-flex align-center gap-1 flex-wrap" style="min-height: 36px; padding: 8px; background-color: var(--bg-dark-base, #18191d); border: 1px solid var(--border-dark, #363942); border-radius: 6px;">
                    @if (_tags.Count == 0) {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-1">No custom tags assigned yet. Add one above.</MudText>
                    } else {
                        @foreach (var tag in _tags) {
                            <MudChip T="string" 
                                     Color="Color.Info" 
                                     Variant="Variant.Filled" 
                                     Size="Size.Small" 
                                     OnClose="@(() => RemoveTag(tag))" 
                                     CloseIcon="@Icons.Material.Filled.Close">
                                @tag
                            </MudChip>
                        }
                    }
                </div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="SaveAsync">
            Save Changes
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public LoraMetadata Lora { get; set; } = default!;

    private string? _selectedCategory;
    private string? _selectedBaseModel;
    private List<string> _tags = new();
    private string _newTagInput = string.Empty;

    private List<string> _basePresets => ArchitectureRegistry.GetAll().Select(a => a.DisplayName).Distinct().ToList();

    protected override void OnInitialized() {
        if (Lora != null) {
            _selectedCategory = Lora.Category;
            _selectedBaseModel = !string.IsNullOrWhiteSpace(Lora.UserBaseModel) ? Lora.UserBaseModel : null;
            _tags = Lora.Tags != null ? new List<string>(Lora.Tags) : new List<string>();
        }
    }

    private void HandleTagInputKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            AddTag();
        }
    }

    private void AddTag() {
        if (string.IsNullOrWhiteSpace(_newTagInput)) {
            return;
        }

        string cleaned = _newTagInput.Trim().TrimStart('#', '@');
        if (!string.IsNullOrWhiteSpace(cleaned) && !_tags.Any(t => string.Equals(t, cleaned, StringComparison.OrdinalIgnoreCase))) {
            _tags.Add(cleaned);
        }
        _newTagInput = string.Empty;
    }

    private void RemoveTag(string tag) {
        _tags.RemoveAll(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase));
    }

    private async Task OpenCategoryManagerAsync() {
        var options = new DialogOptions {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };
        var dialog = await DialogService.ShowAsync<CategoryManagerDialog>("Category & Tag Manager", options);
        var res = await dialog.Result;
        if (res != null && !res.Canceled) {
            StateHasChanged();
        }
    }

    private async Task SaveAsync() {
        try {
            await LibraryService.SetLoraCategoryAndTagsAsync(Lora, _selectedCategory, _tags);
            string? normalizedBase = string.IsNullOrWhiteSpace(_selectedBaseModel) ? null : _selectedBaseModel.Trim();
            if (!string.Equals(normalizedBase, Lora.UserBaseModel, StringComparison.OrdinalIgnoreCase)) {
                await LibraryService.SetUserBaseModelAsync(Lora, normalizedBase);
            }
            Snackbar.Add($"Updated settings for {Lora.FileName}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        } catch (Exception ex) {
            Snackbar.Add($"Failed to update: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() {
        MudDialog.Cancel();
    }
}
