@using LoRAMancer.App.Models
@using LoRAMancer.App.Services
@inject ISnackbar Snackbar
@inject PostForgeShowcaseService ShowcaseService
@inject ShowcaseThumbnailService ThumbnailService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between pr-4">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@GetMediaTypeIcon(Item.MediaType)" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #cdd6f4;">@Item.FileName</MudText>
                @if (Item.IsAiGenerated) {
                    <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.AutoAwesome" Style="font-weight: 700;">
                        AI Generated (@(!string.IsNullOrWhiteSpace(Item.AiGenerator) ? Item.AiGenerator : "Verified"))
                    </MudChip>
                }
                <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small">
                    @Item.FileExtension.ToUpperInvariant()
                </MudChip>
            </div>
            <MudIconButton Icon="@(Item.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                           Color="@(Item.IsFavorite ? Color.Error : Color.Default)"
                           OnClick="ToggleFavoriteAsync"
                           Size="Size.Medium" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column flex-md-row" style="min-height: 520px; max-height: 82vh;">
            <!-- Left: Media Viewer -->
            <div class="d-flex flex-column align-center justify-center pa-4" style="flex: 1.4; background-color: #0b0b12; overflow: auto; min-width: 320px;">
                @if (Item.MediaType == ShowcaseMediaType.Image) {
                    @if (!string.IsNullOrEmpty(_imageSrc)) {
                        <img src="@_imageSrc"
                             alt="@Item.FileName"
                             style="max-width: 100%; max-height: 68vh; object-fit: contain; border-radius: 8px; box-shadow: 0 8px 32px rgba(0,0,0,0.6);" />
                    } else {
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    }
                } else if (Item.MediaType == ShowcaseMediaType.Video) {
                    <div style="position: relative; max-width: 100%; max-height: 68vh; display: flex; flex-direction: column; align-items: center;">
                        @if (!string.IsNullOrEmpty(_imageSrc)) {
                            <img src="@_imageSrc" alt="@Item.FileName" style="max-width: 100%; max-height: 60vh; object-fit: contain; border-radius: 8px;" />
                        }
                        <div class="mt-3 d-flex align-center gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="OpenFileDirectly">
                                Play Video in Default Player
                            </MudButton>
                        </div>
                    </div>
                } else if (Item.MediaType == ShowcaseMediaType.Audio) {
                    <div class="pa-6 text-center" style="background-color: #181825; border: 1px solid #313244; border-radius: 12px; width: 100%; max-width: 520px;">
                        @if (!string.IsNullOrEmpty(_imageSrc)) {
                            <img src="@_imageSrc" alt="Waveform" style="width: 100%; max-height: 180px; object-fit: cover; border-radius: 6px; margin-bottom: 12px;" />
                        } else {
                            <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Color="Color.Primary" Style="font-size: 4rem; opacity: 0.85;" Class="mb-3" />
                        }
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #cdd6f4;">@Item.FileName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">@Item.FormattedSize • @Item.FolderName</MudText>
                        <div class="d-flex justify-center mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="OpenFileDirectly">
                                Play Audio in Default Player
                            </MudButton>
                        </div>
                    </div>
                }

                <!-- Media Bottom Controls -->
                <div class="d-flex align-center gap-2 mt-3 flex-wrap justify-center">
                    @if (Item.MediaType == ShowcaseMediaType.Image) {
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CollectionsBookmark" OnClick="OpenAssignLoraDialogAsync">
                            Assign as LoRA Preview
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenFileInExplorer">
                        Open in Explorer
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyFilePathAsync">
                        Copy Path
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(Item.Prompt)) {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.SmartToy" OnClick="SendToComfyTestAsync">
                            Send to ComfyUI Test
                        </MudButton>
                    }
                </div>
            </div>

            <!-- Right: Metadata & Tagging Panel -->
            <div class="pa-4" style="flex: 1; background-color: #181825; border-left: 1px solid #313244; overflow-y: auto; max-height: 82vh;">
                <!-- AI Prompt Section -->
                @if (!string.IsNullOrWhiteSpace(Item.Prompt)) {
                    <div class="mb-3">
                        <div class="d-flex align-center justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Style="font-weight: 700; color: #a6adc8; text-transform: uppercase;">Positive Prompt</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopyTextAsync(Item.Prompt, "Prompt copied!"))">
                                Copy
                            </MudButton>
                        </div>
                        <div class="pa-2" style="background-color: #11111b; border: 1px solid #313244; border-radius: 6px; font-size: 0.85rem; color: #cdd6f4; max-height: 120px; overflow-y: auto; word-break: break-word; line-height: 1.4;">
                            @Item.Prompt
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Item.NegativePrompt)) {
                    <div class="mb-3">
                        <div class="d-flex align-center justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Style="font-weight: 700; color: #f38ba8; text-transform: uppercase;">Negative Prompt</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopyTextAsync(Item.NegativePrompt, "Negative prompt copied!"))">
                                Copy
                            </MudButton>
                        </div>
                        <div class="pa-2" style="background-color: #11111b; border: 1px solid #313244; border-radius: 6px; font-size: 0.82rem; color: #f38ba8; max-height: 90px; overflow-y: auto; word-break: break-word;">
                            @Item.NegativePrompt
                        </div>
                    </div>
                }

                <!-- Generation Parameters Table -->
                <MudCard Elevation="0" Class="pa-3 mb-3" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 6px;">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #cba6f7; text-transform: uppercase;" Class="mb-2 d-block">
                        Generation Matrix
                    </MudText>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.8rem;">
                        <div>
                            <span style="color: #6c7086;">Seed:</span>
                            <span style="font-weight: 600; color: #89b4fa; margin-left: 4px;">@(Item.Seed.HasValue ? Item.Seed.Value.ToString() : "N/A")</span>
                        </div>
                        <div>
                            <span style="color: #6c7086;">Steps:</span>
                            <span style="font-weight: 600; color: #cdd6f4; margin-left: 4px;">@(Item.Steps.HasValue ? Item.Steps.Value.ToString() : "N/A")</span>
                        </div>
                        <div>
                            <span style="color: #6c7086;">CFG Scale:</span>
                            <span style="font-weight: 600; color: #cdd6f4; margin-left: 4px;">@(Item.CfgScale.HasValue ? Item.CfgScale.Value.ToString("F1") : "N/A")</span>
                        </div>
                        <div>
                            <span style="color: #6c7086;">Sampler:</span>
                            <span style="font-weight: 600; color: #cdd6f4; margin-left: 4px;">@(!string.IsNullOrWhiteSpace(Item.Sampler) ? Item.Sampler : "N/A")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Item.ModelName)) {
                            <div style="grid-column: span 2;">
                                <span style="color: #6c7086;">Model:</span>
                                <span style="font-weight: 600; color: #a6e3a1; margin-left: 4px;">@Item.ModelName</span>
                            </div>
                        }
                        @if (Item.Width.HasValue && Item.Height.HasValue) {
                            <div>
                                <span style="color: #6c7086;">Dimensions:</span>
                                <span style="font-weight: 600; color: #cdd6f4; margin-left: 4px;">@Item.Width × @Item.Height</span>
                            </div>
                        }
                        <div>
                            <span style="color: #6c7086;">Size:</span>
                            <span style="font-weight: 600; color: #cdd6f4; margin-left: 4px;">@Item.FormattedSize</span>
                        </div>
                    </div>

                    @if (Item.UsedLoras.Count > 0) {
                        <div class="mt-2 pt-2" style="border-top: 1px solid #313244;">
                            <span style="color: #6c7086; font-size: 0.75rem; display: block; margin-bottom: 4px;">LoRAs Injected:</span>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var lora in Item.UsedLoras) {
                                    <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Outlined" Size="Size.Small" Style="font-size: 0.7rem; height: 20px;">
                                        @lora
                                    </MudChip>
                                }
                            </div>
                        </div>
                    }

                    @if (Item.AssociatedLoraNames.Count > 0) {
                        <div class="mt-2 pt-2" style="border-top: 1px solid #313244;">
                            <div class="d-flex align-center justify-space-between mb-1">
                                <span style="color: #fab387; font-size: 0.75rem; font-weight: 700;">LoRA Previews Connected:</span>
                                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenAssignLoraDialogAsync" Style="font-size: 0.7rem; padding: 0 4px; height: 20px;">
                                    Manage
                                </MudButton>
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var lora in Item.AssociatedLoraNames) {
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Style="font-size: 0.7rem; height: 20px;" Icon="@Icons.Material.Filled.BookmarkAdded">
                                        @lora
                                    </MudChip>
                                }
                            </div>
                        </div>
                    } else if (Item.MediaType == ShowcaseMediaType.Image) {
                        <div class="mt-2 pt-2" style="border-top: 1px solid #313244;">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Filled.CollectionsBookmark" OnClick="OpenAssignLoraDialogAsync" Style="font-size: 0.75rem;">
                                Assign as LoRA Preview Thumbnail
                            </MudButton>
                        </div>
                    }
                </MudCard>

                <!-- Category & Tagging Controls -->
                <div class="mb-3">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #a6adc8; text-transform: uppercase;" Class="mb-1 d-block">
                        Category &amp; Classification
                    </MudText>
                    <MudSelect T="string" @bind-Value="Item.Category" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="background-color: #11111b;">
                        @foreach (var cat in ShowcaseService.CustomCategories) {
                            <MudSelectItem Value="@cat">@cat</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <!-- Custom Tags -->
                <div class="mb-3">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #a6adc8; text-transform: uppercase;" Class="mb-1 d-block">
                        Assigned Tags
                    </MudText>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @if (Item.UserTags.Count == 0) {
                            <span style="font-size: 0.75rem; color: #6c7086;">No tags applied.</span>
                        } else {
                            @foreach (var tag in Item.UserTags) {
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClose="@(() => RemoveTag(tag))" Style="font-size: 0.75rem; height: 22px;">
                                    @tag
                                </MudChip>
                            }
                        }
                    </div>
                    <div class="d-flex gap-2 align-center">
                        <MudTextField @bind-Value="_newTagInput" Placeholder="Add tag (e.g. keeper, v1-epoch10)..." Variant="Variant.Outlined" Margin="Margin.Dense" Style="background-color: #11111b; flex: 1;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddTag" Disabled="@string.IsNullOrWhiteSpace(_newTagInput)">
                            Add
                        </MudButton>
                    </div>
                </div>

                <!-- Notes -->
                <div class="mb-3">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #a6adc8; text-transform: uppercase;" Class="mb-1 d-block">
                        Personal Notes
                    </MudText>
                    <MudTextField @bind-Value="Item.UserNotes" Placeholder="Observations, prompt tweaks, artifact notes..." Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Style="background-color: #11111b;" />
                </div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="d-flex justify-space-between align-center px-4 py-2 w-100">
            <span style="font-size: 0.75rem; color: #6c7086;">
                Created: @Item.CreatedDate.ToLocalTime().ToString("g") • @Item.FolderPath
            </span>
            <div class="d-flex gap-2">
                <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="Close">Dismiss</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAndCloseAsync">Save &amp; Close</MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ShowcaseMediaItem Item { get; set; } = null!;

    private string _imageSrc = string.Empty;
    private string _newTagInput = string.Empty;

    protected override async Task OnInitializedAsync() {
        if (Item.MediaType == ShowcaseMediaType.Image) {
            _imageSrc = await ThumbnailService.GetFullImageDataUriAsync(Item.FilePath);
            if (string.IsNullOrEmpty(_imageSrc)) {
                _imageSrc = await ThumbnailService.GetOrCreateThumbnailDataUriAsync(Item);
            }
        } else if (Item.MediaType == ShowcaseMediaType.Video || Item.MediaType == ShowcaseMediaType.Audio) {
            _imageSrc = await ThumbnailService.GetOrCreateThumbnailDataUriAsync(Item);
        }
    }

    private void OpenFileDirectly() {
        try {
            if (File.Exists(Item.FilePath)) {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo {
                    FileName = Item.FilePath,
                    UseShellExecute = true
                });
            }
        } catch (Exception ex) {
            Snackbar.Add($"Could not open file: {ex.Message}", Severity.Warning);
        }
    }

    private async Task ToggleFavoriteAsync() {
        await ShowcaseService.ToggleFavoriteAsync(Item.FilePath);
        Snackbar.Add(Item.IsFavorite ? "Added to favorites." : "Removed from favorites.", Severity.Info);
    }

    private void AddTag() {
        if (!string.IsNullOrWhiteSpace(_newTagInput)) {
            string clean = _newTagInput.Trim();
            if (!Item.UserTags.Contains(clean, StringComparer.OrdinalIgnoreCase)) {
                Item.UserTags.Add(clean);
                _ = ShowcaseService.AddCustomTagAsync(clean);
            }
            _newTagInput = string.Empty;
        }
    }

    private void RemoveTag(string tag) {
        Item.UserTags.RemoveAll(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SaveAndCloseAsync() {
        await ShowcaseService.UpdateMediaItemAsync(Item);
        Snackbar.Add("Metadata and tags saved.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Close() {
        MudDialog.Cancel();
    }

    private async Task CopyTextAsync(string text, string successMessage) {
        try {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add(successMessage, Severity.Success);
        } catch {
            try {
                await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(text);
                Snackbar.Add(successMessage, Severity.Success);
            } catch {
                Snackbar.Add("Could not write to clipboard.", Severity.Warning);
            }
        }
    }

    private async Task CopyFilePathAsync() {
        await CopyTextAsync(Item.FilePath, "File path copied to clipboard.");
    }

    private void OpenFileInExplorer() {
        try {
            if (File.Exists(Item.FilePath)) {
                System.Diagnostics.Process.Start("explorer.exe", $"/select,\"{Item.FilePath}\"");
            }
        } catch (Exception ex) {
            Snackbar.Add($"Could not open file explorer: {ex.Message}", Severity.Warning);
        }
    }

    private async Task SendToComfyTestAsync() {
        if (!string.IsNullOrWhiteSpace(Item.Prompt)) {
            await CopyTextAsync(Item.Prompt, "Prompt copied to clipboard! Opening ComfyUI Test Studio...");
        }
        MudDialog.Close();
        Navigation.NavigateTo("test");
    }

    private async Task OpenAssignLoraDialogAsync() {
        var parameters = new DialogParameters { ["MediaItem"] = Item };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AssignLoraPreviewDialog>("Assign LoRA Preview", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) {
            StateHasChanged();
        }
    }

    private string GetMediaTypeIcon(ShowcaseMediaType type) {
        return type switch {
            ShowcaseMediaType.Video => Icons.Material.Filled.Videocam,
            ShowcaseMediaType.Audio => Icons.Material.Filled.Audiotrack,
            _ => Icons.Material.Filled.Image
        };
    }
}
