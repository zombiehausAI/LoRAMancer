@using System.IO
@using System.IO.Compression
@using System.Diagnostics
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudDialog Style="background-color: #181825; border: 1px solid #313244; max-width: 640px; width: 100%; border-radius: 12px;">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(137, 180, 250, 0.15); border: 1px solid rgba(137, 180, 250, 0.35); display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.FolderZip" Color="Color.Primary" Size="Size.Medium" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #fff;">Zip Dataset Archive</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Compress dataset images and captions for training, backup, or cloud export</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- Dataset Context Card -->
        <MudCard Elevation="0" Class="pa-3 mb-3" Style="background-color: #11111b; border: 1px solid #313244; border-radius: 8px;">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Small" />
                    <span style="font-weight: 700; font-size: 0.9rem; color: #cdd6f4;">@FolderName</span>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@TotalImages Images</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@TotalCaptions Captions</MudChip>
                </div>
            </div>
            <div class="mt-2 text-truncate" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #a6adc8;" title="@DatasetFolder">
                @DatasetFolder
            </div>
        </MudCard>

        <!-- Destination Selection -->
        <div class="mb-3">
            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #cdd6f4; margin-bottom: 6px;">
                Destination Location
            </MudText>
            <MudRadioGroup T="string" @bind-Value="_destinationMode" Class="d-flex flex-column gap-2">
                <MudRadio Value="@("inside")" Color="Color.Primary" Dense="true">
                    <div class="d-flex flex-column">
                        <span style="font-weight: 600; font-size: 0.85rem; color: #cdd6f4;">Inside dataset folder</span>
                        <span style="font-size: 0.75rem; color: #a6adc8; font-family: 'JetBrains Mono', monospace;">@InsideDestinationPath</span>
                    </div>
                </MudRadio>
                <MudRadio Value="@("parent")" Color="Color.Primary" Dense="true">
                    <div class="d-flex flex-column">
                        <span style="font-weight: 600; font-size: 0.85rem; color: #cdd6f4;">In parent directory (alongside folder)</span>
                        <span style="font-size: 0.75rem; color: #a6adc8; font-family: 'JetBrains Mono', monospace;">@ParentDestinationPath</span>
                    </div>
                </MudRadio>
            </MudRadioGroup>
        </div>

        <!-- Target Destination Path Display -->
        <div class="pa-3 mb-3" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px;">
            <div class="d-flex align-center justify-space-between mb-1">
                <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-secondary);">Target Output Archive</span>
                @if (File.Exists(EffectiveDestinationPath)) {
                    <span style="font-size: 0.7rem; color: #f9e2af; font-weight: 600; background: rgba(249,226,175,0.15); padding: 1px 6px; border-radius: 4px;">
                        Will Overwrite Existing
                    </span>
                }
            </div>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Color="Color.Primary" />
                <span class="text-truncate flex-grow-1" style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #89b4fa; font-weight: 600;" title="@EffectiveDestinationPath">
                    @EffectiveDestinationPath
                </span>
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="CopyTargetPathAsync" Style="padding: 2px;" title="Copy path" />
            </div>
        </div>

        <!-- Inclusion Options -->
        <div class="d-flex align-center gap-4 flex-wrap mb-3">
            <MudCheckBox @bind-Value="_includeImages" Label="Images (*.png, *.jpg, *.webp)" Color="Color.Primary" Dense="true" Size="Size.Small" Disabled="_isZipping || _completed" />
            <MudCheckBox @bind-Value="_includeCaptions" Label="Captions (*.txt)" Color="Color.Primary" Dense="true" Size="Size.Small" Disabled="_isZipping || _completed" />
            <MudCheckBox @bind-Value="_includeSubdirectories" Label="Include Subfolders" Color="Color.Primary" Dense="true" Size="Size.Small" Disabled="_isZipping || _completed" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage)) {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3" Style="font-size: 0.8rem;">
                @_errorMessage
            </MudAlert>
        }

        <!-- Active Zipping Progress -->
        @if (_isZipping) {
            <div class="pa-3 mb-2" style="background: rgba(137, 180, 250, 0.08); border: 1px solid rgba(137, 180, 250, 0.2); border-radius: 8px;">
                <div class="d-flex align-center justify-space-between mb-2">
                    <span style="font-size: 0.8rem; color: #89b4fa; font-weight: 600;">@_progressMessage</span>
                    <span style="font-size: 0.75rem; color: #cdd6f4; font-weight: 700;">@_progressValue%</span>
                </div>
                <MudProgressLinear Color="Color.Primary" Value="@_progressValue" Size="Size.Medium" Rounded="true" />
            </div>
        }

        <!-- Completed State -->
        @if (_completed) {
            <div class="pa-4 mb-2 text-center" style="background: rgba(166, 227, 161, 0.1); border: 1px solid rgba(166, 227, 161, 0.3); border-radius: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #a6e3a1;">Archive Created Successfully!</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mb-3">
                    Compressed <b>@_compressedCount</b> files into <b>@Path.GetFileName(_createdZipPath)</b> (@FormattedFileSize).
                </MudText>
                <div class="d-flex justify-center gap-2">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Success" 
                               Size="Size.Small" 
                               StartIcon="@Icons.Material.Filled.FolderOpen" 
                               OnClick="OpenContainingFolder">
                        Open in File Explorer
                    </MudButton>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (!_completed) {
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel" Disabled="_isZipping">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Archive" 
                       OnClick="StartZipAsync" 
                       Disabled="_isZipping || string.IsNullOrWhiteSpace(EffectiveDestinationPath)">
                @(_isZipping ? "Compressing..." : $"Create {FolderName}.zip")
            </MudButton>
        } else {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseDialog">
                Done
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string DatasetFolder { get; set; } = string.Empty;

    [Parameter]
    public int TotalImages { get; set; }

    [Parameter]
    public int TotalCaptions { get; set; }

    private string _destinationMode = "inside";
    private bool _includeImages = true;
    private bool _includeCaptions = true;
    private bool _includeSubdirectories = true;

    private bool _isZipping;
    private bool _completed;
    private int _progressValue;
    private string _progressMessage = string.Empty;
    private string _errorMessage = string.Empty;
    private int _compressedCount;
    private long _finalSizeBytes;
    private string _createdZipPath = string.Empty;

    private string FolderName => !string.IsNullOrWhiteSpace(DatasetFolder)
        ? Path.GetFileName(DatasetFolder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
        : "dataset";

    private string InsideDestinationPath => !string.IsNullOrWhiteSpace(DatasetFolder)
        ? Path.Combine(DatasetFolder, $"{FolderName}.zip")
        : string.Empty;

    private string ParentDestinationPath {
        get {
            if (string.IsNullOrWhiteSpace(DatasetFolder)) return string.Empty;
            string clean = DatasetFolder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            string? parent = Directory.GetParent(clean)?.FullName;
            return !string.IsNullOrWhiteSpace(parent)
                ? Path.Combine(parent, $"{FolderName}.zip")
                : Path.Combine(clean, $"{FolderName}.zip");
        }
    }

    private string EffectiveDestinationPath => _destinationMode == "parent"
        ? ParentDestinationPath
        : InsideDestinationPath;

    private string FormattedFileSize {
        get {
            if (_finalSizeBytes <= 0) return "-";
            double mb = _finalSizeBytes / (1024.0 * 1024.0);
            return mb >= 1.0 ? $"{mb:F2} MB" : $"{(_finalSizeBytes / 1024.0):F1} KB";
        }
    }

    private async Task CopyTargetPathAsync() {
        if (!string.IsNullOrWhiteSpace(EffectiveDestinationPath)) {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", EffectiveDestinationPath);
            Snackbar.Add("Path copied to clipboard!", Severity.Info);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void CloseDialog() => MudDialog.Close(DialogResult.Ok(_createdZipPath));

    private void OpenContainingFolder() {
        if (!string.IsNullOrWhiteSpace(_createdZipPath) && File.Exists(_createdZipPath)) {
            try {
                Process.Start(new ProcessStartInfo {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{_createdZipPath}\"",
                    UseShellExecute = true
                });
            } catch (Exception ex) {
                Snackbar.Add($"Could not open file explorer: {ex.Message}", Severity.Warning);
            }
        }
    }

    private async Task StartZipAsync() {
        if (string.IsNullOrWhiteSpace(EffectiveDestinationPath) || string.IsNullOrWhiteSpace(DatasetFolder)) return;

        string targetPath = EffectiveDestinationPath;
        string? targetDir = Path.GetDirectoryName(targetPath);
        if (!string.IsNullOrWhiteSpace(targetDir) && !Directory.Exists(targetDir)) {
            Directory.CreateDirectory(targetDir);
        }

        _isZipping = true;
        _errorMessage = string.Empty;
        _progressValue = 0;
        _progressMessage = "Scanning files to compress...";
        StateHasChanged();

        try {
            await Task.Run(() => {
                var searchOption = _includeSubdirectories ? SearchOption.AllDirectories : SearchOption.TopDirectoryOnly;
                var allFiles = Directory.GetFiles(DatasetFolder, "*.*", searchOption);

                var filesToZip = allFiles.Where(f => {
                    string ext = Path.GetExtension(f).ToLowerInvariant();
                    if (ext == ".zip" || ext == ".tmp") return false;
                    bool isImage = ext is ".png" or ".jpg" or ".jpeg" or ".webp" or ".bmp";
                    bool isCaption = ext is ".txt";
                    return (_includeImages && isImage) || (_includeCaptions && isCaption);
                }).ToList();

                if (filesToZip.Count == 0) {
                    throw new InvalidOperationException("No matching image or caption files found in the dataset folder.");
                }

                string tempZip = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid():N}.tmp.zip");
                if (File.Exists(tempZip)) {
                    File.Delete(tempZip);
                }

                using (var archive = ZipFile.Open(tempZip, ZipArchiveMode.Create)) {
                    for (int i = 0; i < filesToZip.Count; i++) {
                        string filePath = filesToZip[i];
                        string relativePath = Path.GetRelativePath(DatasetFolder, filePath);
                        archive.CreateEntryFromFile(filePath, relativePath, CompressionLevel.Optimal);

                        int pct = (int)((i + 1) * 100.0 / filesToZip.Count);
                        int currentIdx = i + 1;
                        InvokeAsync(() => {
                            _progressValue = pct;
                            _progressMessage = $"Compressing {currentIdx} of {filesToZip.Count} files ({Path.GetFileName(filePath)})...";
                            StateHasChanged();
                        });
                    }
                }

                if (File.Exists(targetPath)) {
                    File.Delete(targetPath);
                }

                File.Move(tempZip, targetPath);

                var fi = new FileInfo(targetPath);
                _compressedCount = filesToZip.Count;
                _finalSizeBytes = fi.Length;
                _completed = true;
                _createdZipPath = targetPath;
            });

            Snackbar.Add($"Successfully created {Path.GetFileName(EffectiveDestinationPath)}!", Severity.Success);
        } catch (Exception ex) {
            _errorMessage = ex.Message;
            Snackbar.Add($"Zipping failed: {ex.Message}", Severity.Error);
        } finally {
            _isZipping = false;
            StateHasChanged();
        }
    }
}
