@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject TrainingRunnerService TrainingRunner
@inject ThemeService ThemeManager
@inject AmdVenvProvisioner Provisioner
@using LoRAMancer.App.Models
@implements IDisposable

<MudThemeProvider IsDarkMode="@ThemeManager.CurrentTheme.IsDark" Theme="@ThemeManager.GetMudTheme()" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<style>
    :root {
        --bg-dark-base: @ThemeManager.CurrentTheme.Background;
        --bg-dark-surface: @ThemeManager.CurrentTheme.Surface;
        --bg-dark-overlay: @ThemeManager.CurrentTheme.Overlay;
        --border-dark: @ThemeManager.CurrentTheme.Border;
        --accent-purple: @ThemeManager.CurrentTheme.Primary;
        --accent-blue: @ThemeManager.CurrentTheme.Secondary;
        --accent-green: @ThemeManager.CurrentTheme.Tertiary;
        --text-primary: @ThemeManager.CurrentTheme.TextPrimary;
        --text-secondary: @ThemeManager.CurrentTheme.TextSecondary;
    }
    body {
        background-color: @ThemeManager.CurrentTheme.Background !important;
        color: @ThemeManager.CurrentTheme.TextPrimary !important;
    }

    /* Global Dynamic Theming: Override hardcoded dark/Catppuccin color declarations */
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background-color: #181825"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background-color:#181825"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background-color: #11111b"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background-color:#11111b"] {
        background-color: var(--bg-dark-surface) !important;
    }

    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background-color: #1e1e2e"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background-color:#1e1e2e"] {
        background-color: var(--bg-dark-overlay) !important;
    }

    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background: linear-gradient(145deg, #1e1e2e, #181825)"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background:linear-gradient(145deg, #1e1e2e, #181825)"] {
        background: var(--bg-dark-surface) !important;
    }

    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background: rgba(17, 17, 27"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="background:rgba(17, 17, 27"] {
        background: var(--bg-dark-base) !important;
    }

    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border: 1px solid #313244"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border: 1px solid #45475a"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border: 1px dashed #313244"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border: 1px dashed #45475a"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border:1px solid #313244"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border:1px solid #45475a"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border:1px dashed #313244"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border:1px dashed #45475a"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border-color: #313244"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border-color:#313244"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="border-left: 1px solid #313244"] {
        border-color: var(--border-dark) !important;
    }

    :not(.theme-preview-card):not(.theme-preview-card *)[style*="color: #cdd6f4"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="color:#cdd6f4"] {
        color: var(--text-primary) !important;
    }

    :not(.theme-preview-card):not(.theme-preview-card *)[style*="color: #a6adc8"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="color:#a6adc8"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="color: #6c7086"],
    :not(.theme-preview-card):not(.theme-preview-card *)[style*="color:#6c7086"] {
        color: var(--text-secondary) !important;
    }

    /* MudBlazor Paper, Card, Dialog, Drawer theme bindings */
    .mud-card, .mud-paper {
        background-color: var(--bg-dark-surface);
        color: var(--text-primary);
    }

    .mud-dialog {
        background-color: var(--bg-dark-surface) !important;
        color: var(--text-primary) !important;
        border-color: var(--border-dark) !important;
    }

    .mud-input-outlined-border {
        border-color: var(--border-dark) !important;
    }
</style>

<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Class="px-2" Style="@($"background-color: {ThemeManager.CurrentTheme.AppbarBackground}; color: {ThemeManager.CurrentTheme.TextPrimary}; border-bottom: 1px solid {ThemeManager.CurrentTheme.Border}; padding-right: 14px;")">
        <div class="d-flex align-center flex-shrink-0">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            <img src="favicon.png" alt="LoRAMancer" style="width: 28px; height: 28px; border-radius: 6px; margin-right: 10px; box-shadow: 0 0 10px rgba(137, 180, 250, 0.4);" />
            <MudText Typo="Typo.h6" Style="@($"font-weight: 700; color: {ThemeManager.CurrentTheme.Primary}; letter-spacing: 0.5px;")">LoRAMancer</MudText>
            @if (_envInfo != null) {
                <MudTooltip Text="@($"{_envInfo.GpuName} | {GetAcceleratorDetail()}")">
                    <MudChip T="string" 
                             Size="Size.Small" 
                             Color="@GetAcceleratorChipColor()" 
                             Variant="Variant.Outlined" 
                             Icon="@Icons.Material.Filled.Bolt"
                             Class="ml-3 d-none d-md-inline-flex" 
                             OnClick="@(() => Navigation.NavigateTo("environment"))" 
                             Style="cursor: pointer; font-weight: 600;">
                        @GetAcceleratorLabel()
                    </MudChip>
                </MudTooltip>
            } else {
                <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined" Class="ml-3 d-none d-md-inline-flex" Style="@($"border-color: {ThemeManager.CurrentTheme.Border}; color: {ThemeManager.CurrentTheme.TextSecondary};")">
                    Detecting Hardware...
                </MudChip>
            }
        </div>

        <MudSpacer />

        <div class="d-flex align-center flex-shrink-0 gap-1" style="@($"color: {ThemeManager.CurrentTheme.TextPrimary};")">
            @if (TrainingRunner.IsRunning) {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.PlayArrow" Class="mr-2">
                    Training Active: @TrainingRunner.CurrentProgress.CurrentStep / @TrainingRunner.CurrentProgress.TotalSteps
                </MudChip>
            }

            <MudTooltip Text="Auto-Updates">
                <MudIconButton Icon="@Icons.Material.Filled.SystemUpdate" Color="Color.Inherit" OnClick="@(() => Navigation.NavigateTo("updates"))" />
            </MudTooltip>
            <MudTooltip Text="Plugins">
                <MudIconButton Icon="@Icons.Material.Filled.Extension" Color="Color.Inherit" OnClick="@(() => Navigation.NavigateTo("plugins"))" />
            </MudTooltip>
            <MudTooltip Text="Compute Environment Setup">
                <MudIconButton Icon="@Icons.Material.Filled.Memory" Color="Color.Inherit" OnClick="@(() => Navigation.NavigateTo("environment"))" />
            </MudTooltip>
            <MudTooltip Text="Settings & Themes">
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" OnClick="@(() => Navigation.NavigateTo("settings"))" />
            </MudTooltip>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Style="@($"background-color: {ThemeManager.CurrentTheme.DrawerBackground}; border-right: 1px solid {ThemeManager.CurrentTheme.Border};")">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Style="@($"background-color: {ThemeManager.CurrentTheme.Background}; min-height: 100vh; padding-top: calc(var(--mud-appbar-height, 48px) + 1.25rem) !important; padding-left: 1.5rem; padding-right: 1.5rem; padding-bottom: 2rem;")">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4" ShowCloseIcon="false">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                        <div>
                            <MudText Typo="Typo.h6">An unexpected UI error occurred</MudText>
                            <MudText Typo="Typo.body2" Style="font-family: monospace;">@ex.Message</MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="RecoverFromError" StartIcon="@Icons.Material.Filled.Refresh">
                            Recover View
                        </MudButton>
                    </div>
                </MudAlert>
            </ErrorContent>
        </ErrorBoundary>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private AmdEnvironmentInfo? _envInfo;
    private ErrorBoundary? _errorBoundary;
    private bool _disposed;

    protected override async Task OnInitializedAsync() {
        TrainingRunner.OnProgressUpdated += HandleProgressUpdated;
        ThemeManager.OnThemeChanged += HandleThemeChanged;
        try {
            _envInfo = await Provisioner.DetectEnvironmentAsync();
        } catch {
            // Fallback non-critical
        }
    }

    protected override void OnParametersSet() {
        _errorBoundary?.Recover();
    }

    private void RecoverFromError() {
        _errorBoundary?.Recover();
    }

    private string GetAcceleratorLabel() {
        if (_envInfo == null) {
            return "Hardware Ready";
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Amd) {
            return _envInfo.RocmDriverFound ? $"AMD ROCm {_envInfo.RocmVersion} Active" : "AMD Radeon Ready";
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Nvidia) {
            return "NVIDIA CUDA Ready";
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Intel) {
            return "Intel Arc XPU Ready";
        }
        return "CPU Mode";
    }

    private string GetAcceleratorDetail() {
        if (_envInfo == null) {
            return "Hardware Acceleration";
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Amd) {
            return _envInfo.RocmDriverFound ? $"ROCm {_envInfo.RocmVersion} Driver Installed" : "ROCm Driver Recommended";
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Nvidia) {
            return "CUDA Hardware Detected";
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Intel) {
            return "Intel XPU Detected";
        }
        return "CPU Compute Mode";
    }

    private Color GetAcceleratorChipColor() {
        if (_envInfo == null) {
            return Color.Default;
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Amd) {
            return _envInfo.RocmDriverFound ? Color.Success : Color.Warning;
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Nvidia) {
            return Color.Success;
        }
        if (_envInfo.DetectedVendor == HardwareVendor.Intel) {
            return Color.Info;
        }
        return Color.Default;
    }

    private void HandleProgressUpdated(TrainingProgress progress) {
        if (_disposed) {
            return;
        }
        try {
            _ = InvokeAsync(() => {
                if (!_disposed) {
                    StateHasChanged();
                }
            });
        } catch {
            // Defensive suppression during teardown
        }
    }

    private void HandleThemeChanged() {
        if (_disposed) {
            return;
        }
        try {
            _ = InvokeAsync(() => {
                if (!_disposed) {
                    StateHasChanged();
                }
            });
        } catch {
            // Defensive suppression during teardown
        }
    }

    public void Dispose() {
        _disposed = true;
        TrainingRunner.OnProgressUpdated -= HandleProgressUpdated;
        ThemeManager.OnThemeChanged -= HandleThemeChanged;
    }
}
