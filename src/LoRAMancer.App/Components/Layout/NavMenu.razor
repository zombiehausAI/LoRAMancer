@inject IDialogService DialogService

<MudNavMenu Class="pt-2">
    <MudText Typo="Typo.caption" Class="px-4 text-secondary mb-1" Style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Studio Pipeline</MudText>
    <MudNavLink Href="curate" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Collections">
        1. Curate &amp; Caption
    </MudNavLink>
    <MudNavLink Href="training" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Terminal">
        2. Train &amp; Forge
    </MudNavLink>
    <MudNavLink Href="lab" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Biotech">
        3. Diagnostic Lab
    </MudNavLink>
    <MudNavLink Href="test" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SmartToy">
        4. ComfyUI Test
    </MudNavLink>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FolderSpecial">
        5. Library &amp; Vault
    </MudNavLink>
    <MudNavLink Href="history" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HistoryEdu">
        Training History
    </MudNavLink>

    <MudDivider Class="my-3" Style="border-color: #313244;" />

    <MudText Typo="Typo.caption" Class="px-4 text-secondary mb-1" Style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Studio Modal Tools</MudText>
    <MudNavLink Icon="@Icons.Material.Filled.AutoAwesome" OnClick="OpenOllamaTaggerAsync">
        Ollama Vision Tagger
    </MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.ContentCut" OnClick="OpenLoraSurgeryAsync">
        LoRA Surgery &amp; Merger
    </MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.Healing" OnClick="OpenLoraGeneTherapyAsync">
        LoRA Gene Therapy
    </MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.Difference" OnClick="OpenLoraDiffAsync">
        LoRA Visual Diff
    </MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.Insights" OnClick="OpenLoraBenchmarkAsync">
        AI Benchmark Matrix
    </MudNavLink>

    <MudDivider Class="my-3" Style="border-color: #313244;" />

    <MudText Typo="Typo.caption" Class="px-4 text-secondary mb-1" Style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Subsystems</MudText>
    <MudNavLink Href="environment" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Memory">
        Compute Environment
    </MudNavLink>
    <MudNavLink Href="plugins" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Extension">
        Plugin Manager
    </MudNavLink>
    <MudNavLink Href="updates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SystemUpdate">
        Auto-Updates
    </MudNavLink>
    <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
        Settings &amp; Admin
    </MudNavLink>
    <MudNavLink Href="docs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">
        Documentation
    </MudNavLink>
</MudNavMenu>

@code {
    private async Task OpenOllamaTaggerAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<OllamaTaggerDialog>("Ollama Vision LoRA Tagger", options);
    }

    private async Task OpenDatasetCuratorAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.DatasetCuratorDialog>("Dataset Curator & Caption Studio", options);
    }

    private async Task OpenComfyUiTestAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.ComfyUiTestDialog>("ComfyUI Interactive Test Studio", options);
    }

    private async Task OpenLoraSurgeryAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraSurgeryDialog>("LoRA Surgery & Merger Studio", options);
    }

    private async Task OpenLoraGeneTherapyAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraGeneTherapyDialog>("LoRA Gene Therapy Studio", options);
    }

    private async Task OpenLoraDiffAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraDiffDialog>("LoRA Visual Diff Inspector", options);
    }

    private async Task OpenLoraBenchmarkAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraBenchmarkDialog>("AI Benchmark Matrix & Sweet Spot Finder", options);
    }
}
