@inject IDialogService DialogService

<MudNavMenu Class="pt-4">
    <MudText Typo="Typo.caption" Class="px-4 text-secondary mb-2" Style="font-weight: 600; text-transform: uppercase;">Workflows</MudText>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FolderSpecial">
        LoRA Library
    </MudNavLink>
    <MudNavLink Href="training" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Terminal">
        Training Console
    </MudNavLink>
    <MudNavLink Href="history" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HistoryEdu">
        History & Vault
    </MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.AutoAwesome" OnClick="OpenOllamaTaggerAsync">
        Ollama Vision Tagger
    </MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.Collections" OnClick="OpenDatasetCuratorAsync">
        Dataset Batch Curator
    </MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.SmartToy" OnClick="OpenComfyUiTestAsync">
        ComfyUI Test Studio
    </MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.ContentCut" OnClick="OpenLoraSurgeryAsync">
        LoRA Surgery & Merger
    </MudNavLink>

    <MudDivider Class="my-4" Style="border-color: #313244;" />

    <MudText Typo="Typo.caption" Class="px-4 text-secondary mb-2" Style="font-weight: 600; text-transform: uppercase;">Subsystems</MudText>
    <MudNavLink Href="environment" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Memory">
        Compute Environment
    </MudNavLink>
    <MudNavLink Href="plugins" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Extension">
        Plugin Manager
    </MudNavLink>
    <MudNavLink Href="updates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SystemUpdate">
        Auto-Updates
    </MudNavLink>
    <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
        Settings & Admin
    </MudNavLink>
    <MudNavLink Href="docs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">
        Documentation
    </MudNavLink>
</MudNavMenu>

@code {
    private async Task OpenOllamaTaggerAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<OllamaTaggerDialog>("Ollama Vision LoRA Tagger", options);
    }

    private async Task OpenDatasetCuratorAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.DatasetCuratorDialog>("Dataset Curator & Caption Studio", options);
    }

    private async Task OpenComfyUiTestAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.ComfyUiTestDialog>("ComfyUI Interactive Test Studio", options);
    }

    private async Task OpenLoraSurgeryAsync() {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<LoRAMancer.App.Components.Dialogs.LoraSurgeryDialog>("LoRA Surgery & Merger Studio", options);
    }
}
